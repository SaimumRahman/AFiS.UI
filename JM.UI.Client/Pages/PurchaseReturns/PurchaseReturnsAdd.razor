@page "/PurchaseReturnsAdd"
@page "/PurchaseReturnsAdd/{Id:int}"
@using JM.UI.Entities.Model.PurchaseReturns
@attribute [Authorize]
@inherits PurchaseReturnsAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenButton Icon="arrow_back"
                                  Variant="Variant.Text"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Click="@Cancel"
                                  Size="ButtonSize.Medium" />
                    <RadzenIcon Icon="assignment_return" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="Reset"
                                  Icon="refresh"
                                  ButtonStyle="ButtonStyle.Light"
                                  Variant="Variant.Outlined"
                                  Click="@Reset"
                                  Disabled="@IsProcessing" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <RadzenStack Gap="1rem">
            @* Top: Header Info *@
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" class="mb-4">General Information</RadzenText>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="Return Date" class="fw-bold" />
                            <RadzenDatePicker @bind-Value="@PurchaseReturn.ReturnDate" class="w-100" DateFormat="d" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="Store" class="fw-bold" />
                            <RadzenTextBox Value="@(WhStore?.Name ?? "WH")" ReadOnly="true" class="w-100" Style="background:#f0f0f0;" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        @* Supplier (auto-locked after first scan) *@
                        <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="Supplier" class="fw-bold" />
                            @if (IsSupplierLocked)
                            {
                                <RadzenTextBox Value="@LockedSupplierName" ReadOnly="true" class="w-100" Style="background:#e8f5e9;font-weight:600;" />
                            }
                            else
                            {
                                <RadzenTextBox Value="Awaiting scan…" ReadOnly="true" class="w-100" Style="background:#fafafa;color:#999;" />
                            }
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow class="mt-3">
                    <RadzenColumn Size="12">
                        <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="Remarks" class="fw-bold" />
                            <RadzenTextArea @bind-Value="@PurchaseReturn.Remarks" class="w-100" Rows="2" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>

            @* Bottom: Barcode Scan + Items Grid *@
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" class="mb-4">Return Items</RadzenText>

                    @* Barcode Scan Bar *@
                    <div class="mb-3 p-3 border rounded" Style="background:#fafafa;">
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenLabel Text="Scan / Enter Barcode or Return Ref No" class="fw-bold small" />
                                    <RadzenTextBox @bind-Value="ScanBarcodeText"
                                                   Placeholder="Scan barcode and press Enter..."
                                                   Style="width:100%;font-size:1rem;"
                                                   @onkeydown="OnScanBarcodeKeyDown" />
                                </RadzenStack>
                            </RadzenColumn>
                            <RadzenColumn Size="6" SizeMD="2" class="d-flex align-items-end">
                                <RadzenButton Text="Search"
                                              Icon="search"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Click="@ScanBarcode"
                                              Disabled="@IsScanning" />
                            </RadzenColumn>
                            <RadzenColumn Size="6" SizeMD="2" class="d-flex align-items-end">
                                @if (IsScanning)
                                {
                                    <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="height:24px;width:24px;" />
                                }
                            </RadzenColumn>
                        </RadzenRow>
                    </div>

                    @* Items Grid *@
                    <RadzenDataGrid Data="@ReturnItems"
                                    TItem="ReturnRefStockDetailDTO"
                                    AllowPaging="false"
                                    AllowSorting="true"
                                    AllowFiltering="true"
                                    Density="Density.Compact"
                                    GridLines="DataGridGridLines.Both">
                        <Columns>
                            <RadzenDataGridColumn TItem="ReturnRefStockDetailDTO" Property="ProductName" Title="Product Name" Width="160px" />
                            <RadzenDataGridColumn TItem="ReturnRefStockDetailDTO" Property="Barcode" Title="Barcode" Width="130px" />
                            <RadzenDataGridColumn TItem="ReturnRefStockDetailDTO" Property="CurrentStock" Title="Cur. Stock" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" AlignItems="AlignItems.Center">
                                        <span>@item.CurrentStock?.ToString("N0") ?? "0"</span>
                                        @if (item.CurrentStock.HasValue && item.Quantity > item.CurrentStock.Value)
                                        {
                                            <RadzenIcon Icon="warning" Style="color:var(--rz-danger);font-size:1rem;" />
                                        }
                                    </RadzenStack>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ReturnRefStockDetailDTO" Property="UOMName" Title="UOM" Width="60px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="ReturnRefStockDetailDTO" Property="InvoiceNo" Title="Invoice" Width="100px" />
                            <RadzenDataGridColumn TItem="ReturnRefStockDetailDTO" Property="Quantity" Title="Return Qty" Width="100px" TextAlign="TextAlign.Center">
                                <Template Context="item">
                                    <RadzenNumeric @bind-Value="item.Quantity"
                                                   Style="width:80px;"
                                                   Min="0"
                                                   ShowUpDown="true" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ReturnRefStockDetailDTO" Property="TradePrice" Title="Unit Price" Width="100px" FormatString="{0:N2}" TextAlign="TextAlign.Right">
                                <Template Context="item">
                                    <RadzenNumeric @bind-Value="item.TradePrice"
                                                   Style="width:90px;"
                                                   Min="0" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ReturnRefStockDetailDTO" Title="Total" Width="100px" TextAlign="TextAlign.Right">
                                <Template Context="item">
                                    <span style="font-weight:600;">@((item.Quantity * item.TradePrice).ToString("N2"))</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ReturnRefStockDetailDTO" Title="Action" Width="60px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                                <Template Context="item">
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Click="@(args => RemoveLineItem(item))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

                    @* Summary *@
                    @if (ReturnItems.Any())
                    {
                        <RadzenCard class="mt-3" Style="background:#f5f5f5;">
                            <RadzenRow JustifyContent="JustifyContent.End" Gap="2rem">
                                <RadzenColumn>
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.3rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="category" Style="color:var(--rz-primary);" />
                                        <RadzenText TextStyle="TextStyle.Body2" Style="font-weight:600;">Distinct Items:</RadzenText>
                                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@DistinctItemCount.ToString()" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.3rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="inventory_2" Style="color:var(--rz-secondary);" />
                                        <RadzenText TextStyle="TextStyle.Body2" Style="font-weight:600;">Total Qty:</RadzenText>
                                        <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@TotalQty.ToString("N0")" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.3rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="payments" Style="color:green;" />
                                        <RadzenText TextStyle="TextStyle.Body2" Style="font-weight:600;">Total Value:</RadzenText>
                                        <RadzenText TextStyle="TextStyle.H6" Style="color:var(--rz-primary);font-weight:700;">
                                            ৳ @TotalValue.ToString("N2")
                                        </RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenCard>
                    }

                    @* Action Buttons *@
                    <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem" class="mt-4">
                        <RadzenButton Text="Cancel"
                                      ButtonStyle="ButtonStyle.Light"
                                      Click="@Cancel"
                                      Icon="cancel"
                                      Disabled="@IsProcessing" />
                        <RadzenButton Text="Save Purchase Return"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="@Save"
                                      Icon="save"
                                      IsBusy="@IsProcessing"
                                      Disabled="@(!ReturnItems.Any())" />
                    </RadzenRow>
                </RadzenCard>
        </RadzenStack>
    }
</RadzenContent>
