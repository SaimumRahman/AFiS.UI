@page "/EcommerceItems"
@using JM.UI.Entities.Model.Ecommerce
@attribute [Authorize]
@inherits EcommerceItemsComponent

<PageTitle>Ecommerce Items</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="storefront" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Ecommerce Items</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenBadge Style="background-color: var(--rz-primary);">
                        Branch: @GetStoreDisplayName()
                    </RadzenBadge>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenCard class="mb-4">
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeSM="6" SizeXL="3">
                <RadzenLabel Text="Branch" class="fw-bold" />
                <RadzenDropDown @bind-Value="@Filter.StoreId"
                                Data="@StoresList"
                                TextProperty="Name"
                                ValueProperty="Id"
                                Placeholder="Select Branch"
                                AllowFiltering="true"
                                AllowClear="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                class="w-100" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeSM="6" SizeXL="3">
                <RadzenLabel Text="Group" class="fw-bold" />
                <RadzenDropDown @bind-Value="@Filter.GroupId"
                                Data="@GroupsList"
                                TextProperty="Name"
                                ValueProperty="Id"
                                Placeholder="All Groups"
                                AllowFiltering="true"
                                AllowClear="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Change="@OnGroupChange"
                                class="w-100" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeSM="6" SizeXL="3">
                <RadzenLabel Text="Sub Group" class="fw-bold" />
                <RadzenDropDown @bind-Value="@Filter.SubGroupId"
                                Data="@SubGroupsList"
                                TextProperty="Name"
                                ValueProperty="Id"
                                Placeholder="All Sub Groups"
                                AllowFiltering="true"
                                AllowClear="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Change="@OnSubGroupChange"
                                class="w-100" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeSM="6" SizeXL="3">
                <RadzenLabel Text="Design" class="fw-bold" />
                <RadzenDropDown @bind-Value="@Filter.DesignId"
                                Data="@DesignsList"
                                TextProperty="Name"
                                ValueProperty="Id"
                                Placeholder="All Designs"
                                AllowFiltering="true"
                                AllowClear="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                class="w-100" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow Gap="1rem" class="mt-3">
            <RadzenColumn Size="12" SizeSM="6" SizeXL="3">
                <RadzenLabel Text="Brand" class="fw-bold" />
                <RadzenDropDown @bind-Value="@Filter.BrandId"
                                Data="@BrandsList"
                                TextProperty="BrandName"
                                ValueProperty="BrandId"
                                Placeholder="All Brands"
                                AllowFiltering="true"
                                AllowClear="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                class="w-100" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeSM="6" SizeXL="3">
                <RadzenLabel Text="Color" class="fw-bold" />
                <RadzenDropDown @bind-Value="@Filter.ColorId"
                                Data="@ColorsList"
                                TextProperty="Name"
                                ValueProperty="Id"
                                Placeholder="All Colors"
                                AllowFiltering="true"
                                AllowClear="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                class="w-100" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeSM="6" SizeXL="3">
                <RadzenLabel Text="Size" class="fw-bold" />
                <RadzenDropDown @bind-Value="@Filter.SizeId"
                                Data="@SizesList"
                                TextProperty="Name"
                                ValueProperty="Id"
                                Placeholder="All Sizes"
                                AllowFiltering="true"
                                AllowClear="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                class="w-100" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeSM="6" SizeXL="3">
                <RadzenLabel Text="Return Ref No" class="fw-bold" />
                <RadzenTextBox @bind-Value="@Filter.ReturnRefNo" Placeholder="Return Ref No" class="w-100" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow Gap="1rem" class="mt-3">
            <RadzenColumn Size="12" SizeSM="6" SizeXL="6">
                <RadzenLabel Text="Barcode" class="fw-bold" />
                <RadzenTextBox @bind-Value="@Filter.Barcode" Placeholder="Barcode" class="w-100" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeSM="6" SizeXL="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="mt-4">
                    <RadzenButton Text="Clear"
                                  ButtonStyle="ButtonStyle.Light"
                                  Icon="refresh"
                                  Click="@ClearFilters" />
                    <RadzenButton Text="Apply Filters"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Icon="search"
                                  Click="@ApplyFilters" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @if (IsLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <RadzenCard>
            <RadzenDataGrid @ref="ItemsGrid"
                            Data="@ItemsList"
                            TItem="EcommerceItemDTO"
                            AllowFiltering="true"
                            AllowColumnResize="true"
                            AllowAlternatingRows="true"
                            AllowPaging="true"
                            AllowSorting="true"
                            PagerHorizontalAlign="HorizontalAlign.Center"
                            PageSize="20"
                            PageSizeOptions="@(new int[] { 10, 20, 50, 100 })"
                            FilterMode="FilterMode.Simple"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="@("Displaying page {0} of {1} (total {2} records)")"
                            IsLoading="@IsLoading"
                            GridLines="DataGridGridLines.Both"
                            Density="Density.Compact"
                            Responsive="true">
                <Columns>
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="Id" Visible="false" Title="ID" Width="80px" Frozen="true" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Title="Image" Width="60px" Filterable="false" Sortable="false">
                        <Template Context="item">
                            @if (!string.IsNullOrEmpty(item.ImageBase64))
                            {
                                <img src="@item.ImageBase64" alt="@item.Name" style="width: 45px; height: 45px; object-fit: cover; border-radius: 4px;" />
                            }
                            else
                            {
                                <RadzenIcon Icon="inventory_2" Style="font-size: 1.4rem; color: var(--rz-text-secondary-color);" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="Name" Title="Name" Width="220px" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="Barcode" Title="Barcode" Width="150px" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="GroupName" Title="Group" Width="130px" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="SubGroupName" Title="Sub Group" Width="130px" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="DesignName" Title="Design" Width="130px" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="BrandName" Title="Brand" Width="130px" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="ColorName" Title="Color" Width="100px" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="SizeName" Title="Size" Width="80px" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="UnitName" Title="Unit" Width="80px" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="SalePrice" Title="Sale Price" Width="110px" FormatString="{0:N2}" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="WholeSalePrice" Title="W.Sale Price" Width="110px" FormatString="{0:N2}" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="CurrentStock" Title="Stock" Width="90px" FormatString="{0:N2}" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Property="ReturnRefNo" Title="Return Ref No" Width="140px" />
                    <RadzenDataGridColumn TItem="EcommerceItemDTO" Title="Actions" Width="110px" Filterable="false" Sortable="false">
                        <Template Context="item">
                            <RadzenButton Icon="publish"
                                          ButtonStyle="ButtonStyle.Success"
                                          Size="ButtonSize.Small"
                                          Variant="Variant.Flat"
                                          Click="@(args => PostToProductApi(item))"
                                          MouseEnter="@(args => TooltipService.Open(args, "Post to Product API"))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
</RadzenContent>