@* ── Barcode Scanner Input ── *@@* BarcodePrintPreview.razor — Full-screen print preview dialog *@
@* Usage: inject as a dialog or route at /BarcodePrintPreview *@

@using JM.UI.Entities.Model.Barcodes
@namespace JM.UI.Client.Pages.Barcode

@* ── PRINT-ONLY STYLES (injected into host page via HeadContent) ─────────── *@
<style>
    /* ── Screen styles ─────────────────────────────────────── */
    .bp-preview-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.82);
        z-index: 9000;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .bp-preview-toolbar {
        background: #1a1a2e;
        border-bottom: 1px solid #2d2d4e;
        padding: 0.6rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-shrink: 0;
    }

    .bp-preview-toolbar-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .bp-preview-title {
        color: #e0e0ff;
        font-family: 'Courier New', monospace;
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .bp-preview-badge {
        background: #3b82f6;
        color: #fff;
        border-radius: 12px;
        padding: 2px 10px;
        font-size: 0.72rem;
        font-family: sans-serif;
        font-weight: 600;
    }

    .bp-preview-body {
        flex: 1;
        overflow-y: auto;
        padding: 2rem;
        display: flex;
        justify-content: center;
    }

    /* ── Paper sheet ──────────────────────────────────────── */
    .bp-paper {
        background: #fff;
        box-shadow: 0 8px 48px rgba(0,0,0,0.55);
        border-radius: 4px;
        padding: 1.5cm;
        width: 21cm;          /* A4 width */
        min-height: 29.7cm;
        box-sizing: border-box;
    }

    .bp-paper-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1cm;
        padding-bottom: 0.4cm;
        border-bottom: 0.5pt solid #ccc;
    }

    .bp-paper-company {
        font-family: 'Courier New', monospace;
        font-size: 9pt;
        color: #333;
        line-height: 1.5;
    }

    .bp-paper-meta {
        font-family: sans-serif;
        font-size: 7.5pt;
        color: #888;
        text-align: right;
        line-height: 1.6;
    }

    /* ── Label grid ───────────────────────────────────────── */
    .bp-label-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 4mm;
        align-items: flex-start;
    }

    /* ── Individual label card ────────────────────────────── */
    .bp-label {
        background: #fff;
        border: 0.8pt solid #aaa;
        border-radius: 2pt;
        box-shadow: 0.5pt 1pt 2pt rgba(0,0,0,0.12);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        font-family: 'Courier New', monospace;
        position: relative;
        box-sizing: border-box;
        /* width/height set inline via style binding */
    }

    .bp-label-stripe {
        height: 2.5pt;
        flex-shrink: 0;
    }

    .bp-label-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 2pt 3pt 2pt;
        overflow: hidden;
    }

    .bp-label-product {
        font-size: 7pt;
        font-weight: 700;
        color: #c0392b;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 0.5pt;
    }

    .bp-label-brand {
        font-size: 6pt;
        font-weight: 600;
        color: #111;
        line-height: 1.2;
        margin-bottom: 1pt;
    }

    .bp-label-bottom {
        flex: 1;
        display: flex;
        gap: 3pt;
        align-items: stretch;
        min-height: 0;
    }

    .bp-label-qr {
        border: 0.8pt solid #e74c3c;
        border-radius: 1.5pt;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #fff8f8;
    }

    .bp-label-details {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        min-width: 0;
    }

    .bp-label-barcode-val {
        font-size: 5.5pt;
        color: #222;
        letter-spacing: 0.08em;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .bp-label-price {
        font-size: 6pt;
        font-weight: 700;
        color: #111;
    }

    .bp-label-uom {
        font-size: 5pt;
        color: #555;
        font-family: sans-serif;
    }

    .bp-label-serial {
        font-size: 4.5pt;
        color: #555;
        font-family: sans-serif;
        text-align: center;
        letter-spacing: 0.04em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .bp-label-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5pt 3pt 1pt;
        border-top: 0.5pt solid #f0f0f0;
    }

    .bp-label-group-badge {
        font-size: 4.5pt;
        border-radius: 1.5pt;
        padding: 0px 2pt;
        font-family: sans-serif;
        font-weight: 600;
    }

    .bp-label-copy-num {
        font-size: 4.5pt;
        color: #aaa;
        font-family: sans-serif;
    }

    /* ── Toolbar buttons ──────────────────────────────────── */
    .bp-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 14px;
        border-radius: 5px;
        font-size: 0.8rem;
        font-family: sans-serif;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: opacity 0.15s;
    }

    .bp-btn:hover { opacity: 0.88; }

    .bp-btn-print {
        background: #22c55e;
        color: #fff;
    }

    .bp-btn-close {
        background: #dc2626;
        color: #fff;
    }

    .bp-btn-zoom {
        background: #334155;
        color: #e0e0ff;
        border: 1px solid #4f5e7a;
    }

    /* ── Print media ──────────────────────────────────────── */
    @@media print {
        body > *:not(.bp-print-root) { display: none !important; }
        .bp-preview-toolbar { display: none !important; }
        .bp-preview-overlay {
            position: static;
            background: none;
        }
        .bp-preview-body {
            padding: 0;
        }
        .bp-paper {
            box-shadow: none;
            width: 100%;
            min-height: 0;
        }
        .bp-label {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    }
</style>

@if (IsVisible)
{
    <div class="bp-preview-overlay bp-print-root">

        @* ── Toolbar ──────────────────────────────────────────── *@
        <div class="bp-preview-toolbar">
            <div class="bp-preview-toolbar-left">
                <span style="font-size:1.4rem;">🖨️</span>
                <span class="bp-preview-title">Print Preview</span>
                <span class="bp-preview-badge">@TotalLabels labels · @Items.Count unique</span>
                @if (TemplateName != null)
                {
                    <span class="bp-preview-badge" style="background:#7c3aed;">@TemplateName</span>
                }
            </div>
            <div style="display:flex; gap:0.5rem; align-items:center;">
                <button class="bp-btn bp-btn-zoom" @onclick="ZoomOut" title="Zoom out">−</button>
                <span style="color:#a0aec0; font-size:0.78rem; font-family:monospace; min-width:40px; text-align:center;">@ZoomPct%</span>
                <button class="bp-btn bp-btn-zoom" @onclick="ZoomIn" title="Zoom in">+</button>
                <button class="bp-btn bp-btn-zoom" @onclick="ResetZoom" title="Reset zoom">1:1</button>
                <button class="bp-btn bp-btn-print" @onclick="TriggerBrowserPrint">
                    <span class="material-icons" style="font-size:1rem;">print</span> Print
                </button>
                <button class="bp-btn bp-btn-close" @onclick="Close">
                    <span class="material-icons" style="font-size:1rem;">close</span> Close
                </button>
            </div>
        </div>

        @* ── Scrollable body ───────────────────────────────────── *@
        <div class="bp-preview-body" id="bp-preview-scroll">
            <div style="transform: scale(@ZoomScale); transform-origin: top center; transition: transform 0.2s;">
                <div class="bp-paper">

                    @* Paper header *@
                    <div class="bp-paper-header">
                        <div class="bp-paper-company">
                            <strong style="font-size:10pt;">BARCODE PRINT SHEET</strong><br />
                            Template: @(TemplateName ?? "—")<br />
                            Label size: @(LabelWidthMm)mm × @(LabelHeightMm)mm
                        </div>
                        <div class="bp-paper-meta">
                            Printed: @DateTime.Now.ToString("dd MMM yyyy HH:mm")<br />
                            Total labels: @TotalLabels<br />
                            Unique barcodes: @Items.Count
                        </div>
                    </div>

                    @* Label grid *@
                    <div class="bp-label-grid">
                        @foreach (var item in Items)
                        {
                            @for (int copy = 1; copy <= item.PrintQty; copy++)
                            {
                                var copyIndex = copy;
                                var isFabric = item.GroupId?.Equals("FABRIC", StringComparison.OrdinalIgnoreCase) == true;
                                var stripeColor = isFabric ? "#f59e0b" : "#3b82f6";
                                var badgeBg = isFabric ? "#fef3c7" : "#dbeafe";
                                var badgeColor = isFabric ? "#92400e" : "#1e40af";

                                @* Convert mm → pt (1mm ≈ 2.835pt) *@
                                var wPt = (int)(Convert.ToInt32(LabelWidthMm) * 2.835);
                                var hPt = (int)(Convert.ToInt32(LabelHeightMm) * 2.835);
                                var qrPt = (int)(hPt * 0.48);

                                <div class="bp-label" style="width:@(wPt)pt; height:@(hPt)pt;">
                                    <div class="bp-label-stripe" style="background:@stripeColor;"></div>
                                    <div class="bp-label-body">
                                        @if (ShowField("ProductName"))
                                        {
                                            <div class="bp-label-product">@item.ProductName</div>
                                        }
                                        @if (ShowField("Brand"))
                                        {
                                            <div class="bp-label-brand">@(string.IsNullOrWhiteSpace(item.Brand) ? "—" : item.Brand)</div>
                                        }

                                        <div class="bp-label-bottom">
                                            <div style="display:flex; flex-direction:column; align-items:center; gap:1pt; flex-shrink:0;">
                                                <div class="bp-label-qr" style="width:@(qrPt)pt; height:@(qrPt)pt;">
                                                    <svg width="@(qrPt - 4)" height="@(qrPt - 4)" viewBox="0 0 21 21">
                                                        @foreach (var cell in GetQrCells(item.BarcodeValue))
                                                        {
                                                            <rect x="@cell.X" y="@cell.Y" width="1" height="1" fill="#c0392b" />
                                                        }
                                                    </svg>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(item.ReturnRefNo))
                                                {
                                                    <div class="bp-label-serial" style="max-width:@(qrPt)pt;">
                                                        S/N: @item.ReturnRefNo
                                                    </div>
                                                }
                                            </div>
                                            <div class="bp-label-details">
                                                <div class="bp-label-barcode-val">@item.BarcodeValue</div>
                                                @if (ShowField("Price"))
                                                {
                                                    <div class="bp-label-price">@(item.Price.HasValue ? $"৳ {item.Price:N2}" : "৳ —")</div>
                                                }
                                                @if (ShowField("UOM") || ShowField("UoM"))
                                                {
                                                    <div class="bp-label-uom">@(string.IsNullOrWhiteSpace(item.UoM) ? "—" : item.UoM)</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="bp-label-footer">
                                        <span class="bp-label-group-badge" style="background:@badgeBg; color:@badgeColor;">@item.GroupName</span>
                                        <span class="bp-label-copy-num">@copyIndex/@item.PrintQty</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
}
