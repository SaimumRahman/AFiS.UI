@page "/BarcodePrint"
@using JM.UI.Client.Pages.Barcode
@attribute [Authorize]
@inherits BarcodePrintComponent

<PageTitle>Barcode Print</PageTitle>

<RadzenContent Container="main" class="p-4">

    @* ── Header Card ─────────────────────────────────────────── *@
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="qr_code_2" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Barcode Print</RadzenText>
                    @if (PrintItems.Any())
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Primary"
                                     Text="@($"{PrintItems.Sum(x => x.PrintQty)} labels queued")" />
                    }
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    @if (PrintItems.Any())
                    {
                        <RadzenButton Text="Clear All"
                                      Icon="clear_all"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Outlined"
                                      Click="@ClearAll"
                                      Disabled="@IsPrinting" />
                    }
                    <RadzenButton Text="Print Barcodes"
                                  Icon="print"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@PrintBarcodes"
                                  IsBusy="@IsPrinting"
                                  BusyText="Sending to Printer..."
                                  Disabled="@(!PrintItems.Any() || IsPrinting)" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @* ── Config Info Banner ───────────────────────────────────── *@
    @if (!IsLoadingConfig)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" class="mb-4">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" AlignItems="AlignItems.Center">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.4rem" AlignItems="AlignItems.Center">
                    <RadzenIcon Icon="straighten" />
                    <RadzenText TextStyle="TextStyle.Caption">
                        Label Size: <strong>@(PrintConfig.LabelWidthMm)mm × @(PrintConfig.LabelHeightMm)mm</strong>
                    </RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.4rem" AlignItems="AlignItems.Center">
                    <RadzenIcon Icon="repeat" />
                    <RadzenText TextStyle="TextStyle.Caption">
                        Fabric Repeat: <strong>@PrintConfig.FabricRepeatCount× per barcode</strong>
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenAlert>
    }

    @* ── Selection Fieldset ───────────────────────────────────── *@
    <RadzenCard class="mb-4">

        @* ── Purchase Filter ──────────────────────────────────── *@
        <RadzenFieldset Text="Purchase Selection" Icon="shopping_cart" class="mb-3">
            <RadzenStack Gap="1rem">

                @* Date Filter Row *@
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="From Date" Component="FromDate" />
                            <RadzenDatePicker @bind-Value="FromDate"
                                              Name="FromDate"
                                              DateFormat="dd/MM/yyyy"
                                              Style="width:100%;"
                                              Change="@(async (DateTime? _) => await OnDateFilterChanged())" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="To Date" Component="ToDate" />
                            <RadzenDatePicker @bind-Value="ToDate"
                                              Name="ToDate"
                                              DateFormat="dd/MM/yyyy"
                                              Style="width:100%;"
                                              Change="@(async (DateTime? _) => await OnDateFilterChanged())" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="2" class="d-flex align-items-end">
                        <RadzenButton Text="Refresh"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@(async () => await OnDateFilterChanged())"
                                      Style="width:100%; margin-top: 1.45rem;"
                                      Disabled="@IsLoadingPurchases" />
                    </RadzenColumn>
                </RadzenRow>

                @* Purchase Dropdown *@
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Purchase No *" Component="PurchaseNo" />
                            <RadzenDropDown @bind-Value="SelectedPurchaseId"
                                            Data="@PurchaseList"
                                            TextProperty="PurchaseNo"
                                            ValueProperty="Id"
                                            Name="PurchaseNo"
                                            Placeholder="-- Select Purchase No --"
                                            Style="width:100%;"
                                            AllowFiltering="true"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            IsLoading="@IsLoadingPurchases"
                                            Change="@OnPurchaseSelected">
                                @* TODO: Customize item template if needed *@
                            </RadzenDropDown>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                Showing purchases from @FromDate.ToString("dd MMM yyyy") to @ToDate.ToString("dd MMM yyyy")
                            </RadzenText>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4" class="d-flex align-items-end">
                        @*
                            TODO: Optionally show selected purchase summary:
                            purchase date, supplier name, total items 
                        *@
                        @if (SelectedPurchaseId.HasValue)
                        {
                            var selected = PurchaseList.FirstOrDefault(p => p.Id == SelectedPurchaseId);
                            @if (selected != null)
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false" Style="width:100%; margin-top:1.45rem; padding: 0.5rem 0.75rem;">
                                    <RadzenStack Gap="0.15rem">
                                        <RadzenText TextStyle="TextStyle.Subtitle2">@selected.PurchaseNo</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption">@selected.ItemCount item(s) · @selected.PurchaseDate.ToString("dd MMM yyyy")</RadzenText>
                                    </RadzenStack>
                                </RadzenAlert>
                            }
                        }
                    </RadzenColumn>
                </RadzenRow>

            </RadzenStack>
        </RadzenFieldset>

        @* ── Single Barcode Add ───────────────────────────────── *@
        <RadzenFieldset Text="Add Single Barcode" Icon="add_circle_outline">
            <RadzenRow Gap="1rem" AlignItems="AlignItems.End">

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="0.25rem">
                        <RadzenLabel Text="Select Barcode" Component="SingleBarcode" />
                        <RadzenDropDown @bind-Value="SelectedBarcodeId"
                                        Data="@AllBarcodes"
                                        TextProperty="DisplayLabel"
                                        ValueProperty="Id"
                                        Name="SingleBarcode"
                                        Placeholder="-- Search and select barcode --"
                                        Style="width:100%;"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        IsLoading="@IsLoadingBarcodes" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenStack Gap="0.25rem">
                        <RadzenLabel Text="Print Qty" Component="SinglePrintQty" />
                        <RadzenNumeric @bind-Value="SinglePrintQty"
                                       Name="SinglePrintQty"
                                       Min="1"
                                       Max="999"
                                       ShowUpDown="true"
                                       Style="width:100%;" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenButton Text="Add to Queue"
                                  Icon="add"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Click="@AddSingleBarcode"
                                  Style="width:100%;" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="2">
                    @if (SelectedBarcodeId.HasValue)
                    {
                        var bc = AllBarcodes.FirstOrDefault(b => b.Id == SelectedBarcodeId);
                        @if (bc != null)
                        {
                            <RadzenBadge BadgeStyle="@(bc.GroupId == "FABRIC" ? BadgeStyle.Warning : BadgeStyle.Info)"
                                         Text="@bc.GroupName"
                                         Style="font-size:0.85rem;" />
                        }
                    }
                </RadzenColumn>

            </RadzenRow>
        </RadzenFieldset>

    </RadzenCard>

    @* ── Print Queue Preview (Label Sheet) ──────────────────── *@
    <RadzenCard class="mt-0">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="mb-3">
            <RadzenColumn>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="preview" Style="color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H6" class="mb-0">Label Sheet Preview</RadzenText>
                    @if (PrintItems.Any())
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Secondary"
                                     Text="@($"{PrintItems.Count} unique · {PrintItems.Sum(x => x.PrintQty)} labels")" />
                    }
                </RadzenStack>
            </RadzenColumn>
            @if (PrintItems.Any())
            {
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-text-secondary-color);">
                        Each card = one physical label at @(PrintConfig.LabelWidthMm)×@(PrintConfig.LabelHeightMm)mm
                    </RadzenText>
                </RadzenColumn>
            }
        </RadzenRow>

        @if (!PrintItems.Any())
        {
            @* ── Empty State ─────────────────────────────────────────── *@
            <div style="background:var(--rz-base-100); border:2px dashed var(--rz-base-400); border-radius:8px; padding:3rem; text-align:center;">
                <RadzenIcon Icon="qr_code_scanner" Style="font-size:3.5rem; color:var(--rz-base-400);" />
                <RadzenText TextStyle="TextStyle.H6" Style="color:var(--rz-base-500); margin-top:0.75rem;">No labels in queue</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" Style="color:var(--rz-base-400); max-width:320px; margin:0.25rem auto 0;">
                    Select a purchase order above or add individual barcodes to see a live label preview.
                </RadzenText>
            </div>
        }
        else
        {
            @* ── Paper Sheet Simulation ───────────────────────────────── *@
            <div style="background:#e8e8e8; border-radius:8px; padding:1.5rem; box-shadow:inset 0 2px 8px rgba(0,0,0,0.10);">

                @* Sheet header ruler hint *@
                <div style="display:flex; justify-content:space-between; margin-bottom:0.75rem; padding:0 0.25rem;">
                    <RadzenText TextStyle="TextStyle.Overline" Style="color:#999; font-size:0.65rem; letter-spacing:0.08em;">
                        ▼ LABEL SHEET — @(PrintConfig.LabelWidthMm)mm × @(PrintConfig.LabelHeightMm)mm each
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Overline" Style="color:#999; font-size:0.65rem;">
                        @PrintItems.Sum(x => x.PrintQty) LABELS TOTAL
                    </RadzenText>
                </div>

                @* Label grid — each item repeated PrintQty times *@
                <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:flex-start;">

                    @foreach (var item in PrintItems)
                    {
                        @for (int copy = 1; copy <= item.PrintQty; copy++)
                        {
                            var copyIndex = copy; // capture for lambda
                            var isLastCopy = copyIndex == item.PrintQty;
                            var isFabric = item.GroupId?.Equals("FABRIC", StringComparison.OrdinalIgnoreCase) == true;

                            @* Physical label card *@
                            <div style="
                                background:#fff;
                                border:1px solid #ccc;
                                border-radius:4px;
                                width:@(LabelWidthPx)px;
                                height:@(LabelHeightPx)px;
                                box-shadow:1px 2px 6px rgba(0,0,0,0.13);
                                display:flex;
                                flex-direction:column;
                                overflow:hidden;
                                position:relative;
                                font-family:'Courier New', monospace;
                                ">
                                @* Top colour stripe by group *@
                                <div style="
                                height:5px;
                                background:@(isFabric ? "#f59e0b" : "#3b82f6");
                                flex-shrink:0;
                                "></div>

                                @* Label body *@
                                <div style="flex:1; display:flex; flex-direction:column; justify-content:space-between; padding:5px 7px 4px;">

                                    @* Product name *@
                                    <div style="font-size:@(NameFontSizePx)px; font-weight:700; color:#111; line-height:1.2; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">
                                        @item.ProductName
                                    </div>

                                    @* Simulated barcode stripes *@
                                    <div style="display:flex; align-items:flex-end; gap:1px; height:@(BarHeightPx)px; margin:3px 0;">
                                        @foreach (var w in GetBarcodeStripeWidths(item.BarcodeValue))
                                        {
                                            <div style="background:#111; width:@(w)px; height:100%;"></div>
                                            <div style="background:#fff; width:@(w == 1 ? 1 : 2)px; height:100%;"></div>
                                        }
                                    </div>

                                    @* Barcode value text *@
                                    <div style="font-size:@(BarcodeFontSizePx)px; color:#222; letter-spacing:0.12em; text-align:center;">
                                        @item.BarcodeValue
                                    </div>

                                    @* Footer row: group + size + copy indicator *@
                                    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:2px;">
                                        <span style="
                                        font-size:@(SmallFontPx)px;
                                        background:@(isFabric ? "#fef3c7" : "#dbeafe");
                                        color:@(isFabric ? "#92400e" : "#1e40af");
                                        border-radius:3px;
                                        padding:1px 4px;
                                        font-family:sans-serif;
                                        font-weight:600;
                                        ">@item.GroupName</span>
                                        <span style="font-size:@(SmallFontPx)px; color:#888; font-family:sans-serif;">
                                            @(item.LabelWidthMm)×@(item.LabelHeightMm)mm
                                        </span>
                                        <span style="font-size:@(SmallFontPx)px; color:#aaa; font-family:sans-serif;">
                                            @copyIndex/@item.PrintQty
                                        </span>
                                    </div>
                                </div>

                                @* Edit overlay on last copy (quantity controls) — avoids cluttering every repeated label *@
                                @if (isLastCopy)
                                {
                                    <div style="
                                        position:absolute; top:2px; right:2px;
                                        display:flex; gap:2px; align-items:center;
                                        ">
                                        <button onclick="@(() => UpdateQty(item, item.PrintQty - 1))"
                                                style="width:16px;height:16px;border:1px solid #ddd;border-radius:3px;background:#f5f5f5;font-size:10px;cursor:pointer;line-height:1;padding:0;display:flex;align-items:center;justify-content:center;"
                                                title="Decrease qty">
                                            −
                                        </button>
                                        <button onclick="@(() => UpdateQty(item, item.PrintQty + 1))"
                                                style="width:16px;height:16px;border:1px solid #ddd;border-radius:3px;background:#f5f5f5;font-size:10px;cursor:pointer;line-height:1;padding:0;display:flex;align-items:center;justify-content:center;"
                                                title="Increase qty">
                                            +
                                        </button>
                                        <button onclick="@(() => RemovePrintItem(item))"
                                                style="width:16px;height:16px;border:1px solid #fca5a5;border-radius:3px;background:#fee2e2;font-size:10px;cursor:pointer;line-height:1;padding:0;display:flex;align-items:center;justify-content:center; color:#dc2626;"
                                                title="Remove">
                                            ✕
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            @* ── Footer Summary ─────────────────────────────────────── *@
            <RadzenCard class="mt-3" Style="background:var(--rz-base-100);">
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem">
                            <RadzenStack Gap="0.1rem">
                                <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-text-secondary-color);">Unique Barcodes</RadzenText>
                                <RadzenText TextStyle="TextStyle.H6">@PrintItems.Count</RadzenText>
                            </RadzenStack>
                            <RadzenStack Gap="0.1rem">
                                <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-text-secondary-color);">Total Labels</RadzenText>
                                <RadzenText TextStyle="TextStyle.H6">@PrintItems.Sum(x => x.PrintQty)</RadzenText>
                            </RadzenStack>
                            <RadzenStack Gap="0.1rem">
                                <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-text-secondary-color);">Fabric Labels</RadzenText>
                                <RadzenText TextStyle="TextStyle.H6">@PrintItems.Where(x => x.GroupId == "FABRIC").Sum(x => x.PrintQty)</RadzenText>
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                            <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat" Click="@ClearAll" Disabled="@IsPrinting" />
                            <RadzenButton Text="Print Barcodes" Icon="print" ButtonStyle="ButtonStyle.Primary"
                                          Click="@PrintBarcodes" IsBusy="@IsPrinting"
                                          BusyText="Sending to Printer..."
                                          Disabled="@(!PrintItems.Any() || IsPrinting)" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        }
    </RadzenCard>
    <RadzenCard>
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="mb-3">
            <RadzenColumn>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="preview" Style="color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H6" class="mb-0">Print Queue Preview</RadzenText>
                    @if (PrintItems.Any())
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Secondary"
                                     Text="@($"{PrintItems.Count} unique barcode(s)")" />
                    }
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        @if (!PrintItems.Any())
        {
            @* ── Empty State ─────────────────────────────────────── *@
            <RadzenCard Style="background: var(--rz-base-100); border: 2px dashed var(--rz-base-400);">
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.75rem" class="py-5">
                    <RadzenIcon Icon="qr_code_scanner"
                                Style="font-size: 3.5rem; color: var(--rz-base-400);" />
                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-base-500);">No barcodes in queue</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-base-400); text-align:center; max-width:320px;">
                        Select a purchase order above to bulk-load barcodes, or add individual barcodes using the single barcode panel.
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        }
        else
        {
            @* ── Data Grid ────────────────────────────────────────── *@
            <RadzenDataGrid Data="@PrintItems"
                            TItem="BarcodePrintItemDTO"
                            AllowPaging="true"
                            PageSize="15"
                            AllowSorting="true"
                            GridLines="DataGridGridLines.Horizontal"
                            Density="Density.Compact"
                            Style="width:100%;">
                <Columns>

                    <RadzenDataGridColumn TItem="BarcodePrintItemDTO" Title="#" Width="50px" Frozen="true">
                        <Template Context="item">
                            <RadzenText TextStyle="TextStyle.Caption">
                                @(PrintItems.IndexOf(item) + 1)
                            </RadzenText>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="BarcodePrintItemDTO"
                                          Property="BarcodeValue"
                                          Title="Barcode"
                                          Width="160px">
                        <Template Context="item">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                <RadzenIcon Icon="qr_code" Style="font-size:1rem; color: var(--rz-text-secondary-color);" />
                                <strong>@item.BarcodeValue</strong>
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="BarcodePrintItemDTO"
                                          Property="ProductName"
                                          Title="Product Name" />

                    <RadzenDataGridColumn TItem="BarcodePrintItemDTO"
                                          Property="GroupName"
                                          Title="Group"
                                          Width="120px">
                        <Template Context="item">
                            <RadzenBadge BadgeStyle="@(item.GroupId == "FABRIC" ? BadgeStyle.Warning : BadgeStyle.Info)"
                                         Text="@item.GroupName" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="BarcodePrintItemDTO"
                                          Title="Label Size"
                                          Width="130px">
                        <Template Context="item">
                            <RadzenText TextStyle="TextStyle.Caption">
                                @(item.LabelWidthMm)mm × @(item.LabelHeightMm)mm
                            </RadzenText>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="BarcodePrintItemDTO"
                                          Title="Print Qty"
                                          Width="160px"
                                          TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center"
                                         Gap="0.3rem"
                                         JustifyContent="JustifyContent.Center">
                                <RadzenButton Icon="remove"
                                              ButtonStyle="ButtonStyle.Light"
                                              Variant="Variant.Text"
                                              Size="ButtonSize.ExtraSmall"
                                              Click="@(() => UpdateQty(item, item.PrintQty - 1))" />
                                <RadzenNumeric Value="@item.PrintQty"
                                               ValueChanged="@((int v) => UpdateQty(item, v))"
                                               Min="1"
                                               Max="999"
                                               ShowUpDown="false"
                                               Style="width:60px; text-align:center;" />
                                <RadzenButton Icon="add"
                                              ButtonStyle="ButtonStyle.Light"
                                              Variant="Variant.Text"
                                              Size="ButtonSize.ExtraSmall"
                                              Click="@(() => UpdateQty(item, item.PrintQty + 1))" />
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="BarcodePrintItemDTO"
                                          Title="Action"
                                          Width="80px"
                                          TextAlign="TextAlign.Center"
                                          Frozen="true"
                                          FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="item">
                            <RadzenButton Icon="delete_outline"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Variant="Variant.Text"
                                          Size="ButtonSize.Small"
                                          Click="@(() => RemovePrintItem(item))"
                                          Disabled="@IsPrinting" />
                        </Template>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>

            @* ── Footer Summary ───────────────────────────────────── *@
            <RadzenCard class="mt-3" Style="background: var(--rz-base-100);">
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem">
                            <RadzenStack Gap="0.1rem">
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                    Unique Barcodes
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.H6">@PrintItems.Count</RadzenText>
                            </RadzenStack>
                            <RadzenStack Gap="0.1rem">
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                    Total Labels
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.H6">@PrintItems.Sum(x => x.PrintQty)</RadzenText>
                            </RadzenStack>
                            <RadzenStack Gap="0.1rem">
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                    Fabric Labels
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.H6">
                                    @PrintItems.Where(x => x.GroupId == "FABRIC").Sum(x => x.PrintQty)
                                </RadzenText>
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     JustifyContent="JustifyContent.End"
                                     Gap="0.5rem">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat"
                                          Click="@ClearAll"
                                          Disabled="@IsPrinting" />
                            <RadzenButton Text="Print Barcodes"
                                          Icon="print"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Click="@PrintBarcodes"
                                          IsBusy="@IsPrinting"
                                          BusyText="Sending to Printer..."
                                          Disabled="@(!PrintItems.Any() || IsPrinting)" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        }
    </RadzenCard>

</RadzenContent>
