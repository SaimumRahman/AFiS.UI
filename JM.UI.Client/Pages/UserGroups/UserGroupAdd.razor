@page "/UserGroupAdd"
@page "/UserGroupAdd/{Id:int}"
@using JM.UI.Entities.Model.UserGroup
@attribute [Authorize]
@inherits UserGroupAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header Card -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@Cancel"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="@PageIcon" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                        @if (IsEditMode)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Edit Mode" />
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Reset"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Form Card -->
        <RadzenCard>
            <RadzenTemplateForm TItem="UserGroupDTO" Data="@UserGroup" Submit="@Save">
                <RadzenStack Gap="1.5rem">
                    <!-- User Group Assignment Section -->
                    <RadzenFieldset Text="@(IsEditMode ? "Modify Group Users" : "User Group Assignment")" Icon="group_add">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Group *" Component="GroupId" />
                                        <RadzenDropDown @bind-Value="UserGroup.GroupId"
                                                        Data="@Groups"
                                                        TextProperty="GroupName"
                                                        ValueProperty="GroupId"
                                                        Name="GroupId"
                                                        Placeholder="Select group"
                                                        Style="width: 100%;"
                                                        AllowFiltering="true"
                                                        Disabled="@IsEditMode"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                                        <RadzenRequiredValidator Component="GroupId" Text="Group is required" />
                                        @if (IsEditMode)
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-warning-darker">
                                                Group cannot be changed in edit mode
                                            </RadzenText>
                                        }
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Select Users *" Component="UserIds" />
                                        <RadzenDropDown @bind-Value="SelectedUserIds"
                                                        Data="@Users"
                                                        TextProperty="UserName"
                                                        ValueProperty="UserId"
                                                        Name="UserIds"
                                                        Placeholder="Select users"
                                                        Style="width: 100%;"
                                                        AllowFiltering="true"
                                                        Multiple="true"
                                                        Chips="true"
                                                        AllowClear="true"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-info-darker">
                                            @(IsEditMode ? "Add or remove users from this group" : "Select multiple users to assign to the group")
                                        </RadzenText>
                                        <RadzenRequiredValidator Component="UserIds" Text="At least one user is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            @if (SelectedUserIds != null && SelectedUserIds.Any() && UserGroup.GroupId > 0)
                            {
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12">
                                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter">
                                            <RadzenStack Gap="0.5rem">
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                    <RadzenIcon Icon="info" />
                                                    <RadzenText TextStyle="TextStyle.Body2">
                                                        <strong>@SelectedUserIds.Count() user(s)</strong> @(IsEditMode ? "in" : "will be assigned to") <strong>@GetSelectedGroupName()</strong>
                                                    </RadzenText>
                                                </RadzenStack>
                                                <RadzenText TextStyle="TextStyle.Caption">
                                                    Selected users: @string.Join(", ", GetSelectedUserNames())
                                                </RadzenText>
                                            </RadzenStack>
                                        </RadzenAlert>
                                    </RadzenColumn>
                                </RadzenRow>
                            }
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Assignment Preview (Only for non-edit mode) -->
                    @if (!IsEditMode && SelectedUserIds != null && SelectedUserIds.Any())
                    {
                        <RadzenFieldset Text="Assignment Preview" Icon="preview">
                            <RadzenStack Gap="0.5rem">
                                @foreach (var userId in SelectedUserIds)
                                {
                                    var userName = Users.FirstOrDefault(u => u.UserId == userId)?.UserName ?? "Unknown";
                                    <RadzenCard class="p-2" Style="background-color: var(--rz-secondary-lighter);">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                            <RadzenIcon Icon="person" Style="color: var(--rz-primary);" />
                                            <RadzenText TextStyle="TextStyle.Body2">
                                                <strong>@userName</strong>
                                            </RadzenText>
                                            <RadzenIcon Icon="arrow_forward" Style="font-size: 1rem;" />
                                            <RadzenIcon Icon="group" Style="color: var(--rz-success);" />
                                            <RadzenText TextStyle="TextStyle.Body2">
                                                <strong>@GetSelectedGroupName()</strong>
                                            </RadzenText>
                                        </RadzenStack>
                                    </RadzenCard>
                                }
                            </RadzenStack>
                        </RadzenFieldset>
                    }

                    <!-- Action Buttons -->
                    <RadzenCard class="mt-2">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat"
                                          Click="@Cancel"
                                          Disabled="@IsProcessing" />
                            @if (!IsEditMode)
                            {
                                <RadzenButton Text="Save & Add New"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Click="@SaveAndNew"
                                              IsBusy="@IsProcessing"
                                              Disabled="@IsProcessing" />
                            }
                            <RadzenButton Text="@(IsEditMode ? "Update Group Users" : "Assign Users")"
                                          Icon="@(IsEditMode ? "update" : "group_add")"
                                          ButtonStyle="ButtonStyle.Primary"
                                          ButtonType="ButtonType.Submit"
                                          IsBusy="@IsProcessing"
                                          BusyText="@(IsEditMode ? "Updating..." : "Assigning...")" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenContent>