@page "/GroupUserAssignment/{GroupId:int}"
@using JM.UI.Client.Pages.UserGroup
@using JM.UI.Entities.Model.UserGroup
@using JM.UI.Entities.Model.CoreUsers
@inherits GroupUserAssignmentComponent

<PageTitle>Assign Users to Group</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading group details...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header Card -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@GoBack"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="group_add" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H4" class="mb-0">Assign Users to Group</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-color-secondary">
                                @GroupUsers.GroupName
                            </RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Refresh"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@LoadGroupUsers"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Main Content -->
        <RadzenRow Gap="1rem">
            <!-- Available Users -->
            <RadzenColumn Size="12" SizeLG="6">
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText TextStyle="TextStyle.H6" class="mb-0">
                                <RadzenIcon Icon="people_outline" Style="vertical-align: middle; margin-right: 0.5rem;" />
                                Available Users (@GroupUsers.AvailableUsers.Count)
                            </RadzenText>
                            @if (SelectedAvailableUsers.Any())
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{SelectedAvailableUsers.Count} selected")" />
                            }
                        </RadzenStack>

                        <!-- Search Box -->
                        <RadzenTextBox @bind-Value="@AvailableSearchText"
                                       Placeholder="Search users..."
                                       Style="width: 100%;"
                                       @oninput="@((args) => AvailableSearchText = args.Value?.ToString() ?? string.Empty)" />

                        <!-- Available Users List -->
                        <div style="max-height: 500px; overflow-y: auto; border: 1px solid var(--rz-border-color); border-radius: 4px;">
                            @if (FilteredAvailableUsers.Any())
                            {
                                <RadzenDataGrid Data="@FilteredAvailableUsers" TItem="CoreUserDTO"
                                                AllowPaging="false"
                                                AllowSorting="true"
                                                SelectionMode="DataGridSelectionMode.Multiple"
                                                @bind-Value="@SelectedAvailableUsers"
                                                GridLines="DataGridGridLines.Horizontal"
                                                Density="Density.Compact">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="CoreUserDTO" Width="60px" Sortable="false" TextAlign="TextAlign.Center">
                                            <HeaderTemplate>
                                                <RadzenCheckBox TriState="false"
                                                                TValue="bool"
                                                                Value="@(SelectedAvailableUsers.Count == FilteredAvailableUsers.Count())"
                                                                Change="@((args) => SelectAllAvailable(args))" />
                                            </HeaderTemplate>
                                            <Template Context="user">
                                                <RadzenCheckBox TriState="false"
                                                                TValue="bool"
                                                                Value="@(SelectedAvailableUsers.Contains(user))"
                                                                Change="@((args) => ToggleUserSelection(user, args, true))" />
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="CoreUserDTO" Property="UserName" Title="Username" Width="150px">
                                            <Template Context="user">
                                                <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: 500;">@user.UserName</RadzenText>
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="CoreUserDTO" Property="FullName" Title="Full Name">
                                            <Template Context="user">
                                                <RadzenText TextStyle="TextStyle.Body2">@(user.FullName ?? "N/A")</RadzenText>
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="CoreUserDTO" Property="Email" Title="Email">
                                            <Template Context="user">
                                                <RadzenText TextStyle="TextStyle.Caption">@(user.Email ?? "N/A")</RadzenText>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            }
                            else
                            {
                                <div class="p-4 text-center">
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                                        No available users found
                                    </RadzenText>
                                </div>
                            }
                        </div>

                        <!-- Assign Button -->
                        <RadzenButton Text="Assign Selected Users →"
                                      Icon="arrow_forward"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="@AssignSelectedUsers"
                                      Disabled="@(!SelectedAvailableUsers.Any() || IsProcessing)"
                                      IsBusy="@IsProcessing"
                                      BusyText="Assigning..."
                                      Style="width: 100%;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <!-- Assigned Users -->
            <RadzenColumn Size="12" SizeLG="6">
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText TextStyle="TextStyle.H6" class="mb-0">
                                <RadzenIcon Icon="group" Style="vertical-align: middle; margin-right: 0.5rem;" />
                                Assigned Users (@GroupUsers.AssignedUsers.Count)
                            </RadzenText>
                        </RadzenStack>

                        <!-- Search Box -->
                        <RadzenTextBox @bind-Value="@AssignedSearchText"
                                       Placeholder="Search assigned users..."
                                       Style="width: 100%;"
                                       @oninput="@((args) => AssignedSearchText = args.Value?.ToString() ?? string.Empty)" />

                        <!-- Assigned Users List -->
                        <div style="max-height: 500px; overflow-y: auto; border: 1px solid var(--rz-border-color); border-radius: 4px;">
                            @if (FilteredAssignedUsers.Any())
                            {
                                <RadzenDataList Data="@FilteredAssignedUsers" TItem="CoreUserDTO" AllowPaging="false">
                                    <Template Context="user">
                                        <RadzenCard class="mb-2" Style="padding: 0.75rem;">
                                            <RadzenRow AlignItems="AlignItems.Center" Gap="0.5rem">
                                                <RadzenColumn Size="2" SizeSM="1">
                                                    <RadzenIcon Icon="account_circle" Style="font-size: 2rem; color: var(--rz-primary);" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="8" SizeSM="10">
                                                    <RadzenStack Gap="0.25rem">
                                                        <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 500;">
                                                            @user.UserName
                                                        </RadzenText>
                                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                                                            @(user.FullName ?? "No full name")
                                                        </RadzenText>
                                                        @if (!string.IsNullOrEmpty(user.Email))
                                                        {
                                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-info-darker">
                                                                @user.Email
                                                            </RadzenText>
                                                        }
                                                    </RadzenStack>
                                                </RadzenColumn>
                                                <RadzenColumn Size="2" SizeSM="1">
                                                    <RadzenButton Icon="remove_circle"
                                                                  ButtonStyle="ButtonStyle.Danger"
                                                                  Size="ButtonSize.Small"
                                                                  Variant="Variant.Flat"
                                                                  Click="@(() => RemoveUser(user))"
                                                                  Disabled="@IsProcessing"
                                                                  MouseEnter="@(args => ShowTooltip(args, "Remove from group"))" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                        </RadzenCard>
                                    </Template>
                                </RadzenDataList>
                            }
                            else
                            {
                                <div class="p-4 text-center">
                                    <RadzenIcon Icon="group_off" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary mt-2">
                                        No users assigned to this group yet
                                    </RadzenText>
                                </div>
                            }
                        </div>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
}
</RadzenContent>