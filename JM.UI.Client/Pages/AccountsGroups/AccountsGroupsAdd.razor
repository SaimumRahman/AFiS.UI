@page "/AccountsGroupsAdd"
@page "/AccountsGroupsAdd/{Id:int}"

@using JM.UI.Entities.Model.AccountsGroups
@using JM.UI.Entities.Model.Bank
@attribute [Authorize]
@inherits AccountsGroupsAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">

    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">
                Loading Accounts Groups...
            </RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="6">
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 Gap="0.5rem">
                        <RadzenIcon Icon="account_tree"
                                    Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4">@PageTitle</RadzenText>

                        @if (IsEditMode)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info"
                                         Text="@($"#{AccountsGroups.Id}")" />
                        }
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="6">
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 JustifyContent="JustifyContent.End">
                        <RadzenButton Text="@(IsEditMode ? "Reset Changes" : "Reset")"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- FORM -->
        <RadzenTemplateForm TItem="AccountsGroupsDTO"
                            Data="@AccountsGroups"
                            Submit="@Save">

            <RadzenCard>
                <RadzenStack Gap="1.5rem">

                    <RadzenFieldset Text="Accounts Groups Information" Icon="work">
                        <RadzenRow Gap="1rem">

                            <!-- Group Name -->
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Accounts Group Name" Component="Name" />
                                    <RadzenTextBox Name="Name"
                                                   @bind-Value="AccountsGroups.Name"
                                                   MaxLength="20"
                                                   class="w-100" />
                                    <RadzenRequiredValidator Component="Name"
                                                             Text="Name is required" />
                                </RadzenStack>
                            </RadzenColumn>

                            <!-- Store -->
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Store" Component="StoreId" />
                                    <RadzenDropDown TValue="int"
                                                    Name="StoreId"
                                                    @bind-Value="AccountsGroups.StoreId"
                                                    Data="@Stores"
                                                    TextProperty="Name"
                                                    ValueProperty="Id"
                                                    Placeholder="Select Store..."
                                                    class="w-100" />
                                    <RadzenRequiredValidator Component="StoreId"
                                                             Text="Store is required"
                                                             DefaultValue="0" />
                                </RadzenStack>
                            </RadzenColumn>

                        </RadzenRow>
                    </RadzenFieldset>

                    <!-- Actions -->
                    <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem">
                        <RadzenButton Text="Cancel"
                                      Icon="cancel"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Flat"
                                      Click="@Cancel"
                                      Disabled="@IsProcessing" />

                        <RadzenButton ButtonType="ButtonType.Submit"
                                      Text="@(IsEditMode ? "Update" : "Save")"
                                      Icon="save"
                                      ButtonStyle="ButtonStyle.Primary"
                                      IsBusy="@IsProcessing" />
                    </RadzenRow>

                </RadzenStack>
            </RadzenCard>

        </RadzenTemplateForm>
    }

</RadzenContent>
