@page "/CustomerAdd"
@page "/CustomerAdd/{CustomerID:int}"
@using JM.UI.Entities.Model.Customer
@inherits CustomerAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading customer...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header Card -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@Cancel"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="@PageIcon" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                        @if (IsEditMode)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"#{Customer.CustomerID}")" />
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="@(IsEditMode ? "Reset Changes" : "Reset")"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Form Card -->
        <RadzenCard>
            <RadzenTemplateForm TItem="CustomerModelDTO" Data="@Customer" Submit="@Save">
                <RadzenStack Gap="1.5rem">
                    <!-- Customer Information Section -->
                    <RadzenFieldset Text="Customer Information" Icon="person">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Customer Code" Component="CustomerCode" />
                                        <RadzenTextBox @bind-Value="Customer.CustomerCode"
                                                       Name="CustomerCode"
                                                       Placeholder="Enter customer code"
                                                       Style="width: 100%;" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Customer Name *" Component="CustomerName" />
                                        <RadzenTextBox @bind-Value="Customer.CustomerName"
                                                       Name="CustomerName"
                                                       Placeholder="Enter customer name"
                                                       Style="width: 100%;"
                                                       MaxLength="200" />
                                        <RadzenRequiredValidator Component="CustomerName" Text="Customer name is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Customer Type" Component="CustomerType" />
                                        <RadzenDropDown @bind-Value="Customer.CustomerType"
                                                        Data="@CustomerTypes"
                                                        Name="CustomerType"
                                                        Placeholder="Select type"
                                                        Style="width: 100%;" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Contact Information Section -->
                    <RadzenFieldset Text="Contact Information" Icon="contact_phone">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Phone Number" Component="PhoneNumber" />
                                        <RadzenTextBox @bind-Value="Customer.PhoneNumber"
                                                       Name="PhoneNumber"
                                                       Placeholder="Enter phone number"
                                                       Style="width: 100%;"
                                                       MaxLength="20" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Email" Component="Email" />
                                        <RadzenTextBox @bind-Value="Customer.Email"
                                                       Name="Email"
                                                       Placeholder="Enter email address"
                                                       Style="width: 100%;"
                                                       MaxLength="100" />
                                        <RadzenEmailValidator Component="Email" Text="Enter a valid email" Style="position: absolute" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow>
                                <RadzenColumn Size="12">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Address" Component="Address" />
                                        <RadzenTextArea @bind-Value="Customer.Address"
                                                        Name="Address"
                                                        Placeholder="Enter full address"
                                                        Rows="3"
                                                        Style="width: 100%;"
                                                        MaxLength="500" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Financial Information Section -->
                    <RadzenFieldset Text="Financial Information" Icon="account_balance_wallet">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="@(IsEditMode ? "Current Balance" : "Opening Balance")" Component="CurrentBalance" />
                                        <RadzenNumeric @bind-Value="Customer.CurrentBalance"
                                                       Name="CurrentBalance"
                                                       Placeholder="0.00"
                                                       Style="width: 100%;"
                                                       Min="Decimal.MinValue" />
                                    </RadzenStack>
                                </RadzenColumn>
                                @if (IsEditMode)
                                {
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Created Date" />
                                            <RadzenTextBox Value="@Customer.CreatedDate?.ToString("dd MMM yyyy")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                }
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Status" Component="IsActive" />
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="height: 36px;">
                                            <RadzenSwitch @bind-Value="Customer.IsActive" Name="IsActive" />
                                            <RadzenBadge BadgeStyle="@(Customer.IsActive? BadgeStyle.Success: BadgeStyle.Danger)"
                                                         Text="@(Customer.IsActive ? "Active" : "Inactive")" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Action Buttons -->
                    <RadzenCard class="mt-2">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat"
                                          Click="@Cancel"
                                          Disabled="@IsProcessing" />
                            @if (!IsEditMode)
                            {
                                <RadzenButton Text="Save & Add New"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Click="@SaveAndNew"
                                              IsBusy="@IsProcessing"
                                              Disabled="@IsProcessing" />
                            }
                            <RadzenButton Text="@(IsEditMode ? "Update" : "Save")"
                                          Icon="@(IsEditMode ? "update" : "save")"
                                          ButtonStyle="ButtonStyle.Primary"
                                          ButtonType="ButtonType.Submit"
                                          IsBusy="@IsProcessing"
                                          BusyText="@(IsEditMode ? "Updating..." : "Saving...")" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenContent>