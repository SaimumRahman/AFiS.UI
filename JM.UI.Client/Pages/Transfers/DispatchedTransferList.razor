@page "/DispatchedTransferList"
@using JM.UI.Client.Pages.Transfer
@using JM.UI.Entities.Model.Transfer
@inherits DispatchedTransferListComponent
@attribute [Authorize]
<PageTitle>Dispatched Transfer List</PageTitle>

<RadzenContent Container="main" class="p-4">

    <!-- Header Card -->
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="swap_horiz" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Transfer Management</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenDropDown @bind-Value="StoreId"
                                    Data="@Stores"
                                    TextProperty="Name" ValueProperty="Id"
                                    Placeholder="Select store..."
                                    Style="width:200px; font-size:0.75rem;" AllowFiltering="true"
                                    Change="@(args => OnStoreChanged((int)args))"
                                    Disabled="@IsLoading" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <!-- Barcode Scan Card (scoped to selected transfer) -->
    <RadzenCard class="mb-4">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap">
            <RadzenIcon Icon="qr_code_scanner" Style="font-size: 1.5rem; color: var(--rz-info);" />
            <RadzenText TextStyle="TextStyle.Body1" Style="font-weight:600; white-space:nowrap;">Scan Barcode:</RadzenText>

            @if (HasSelectedTransfer)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Primary" Style="font-size:0.85rem; padding:0.25rem 0.75rem;">
                    <RadzenIcon Icon="receipt" Style="margin-right:4px; vertical-align:middle;" />
                    @SelectedTransfer!.TransferNo
                </RadzenBadge>
                <RadzenTextBox @bind-Value="BarcodeInput"
                               Placeholder="Scan or type barcode and press Enter..."
                               Style="width: 320px;"
                               @onkeydown="@OnBarcodeKeyDown" />
                <RadzenButton Text="Search"
                              Icon="search"
                              ButtonStyle="ButtonStyle.Info"
                              Click="@OnBarcodeSearch"
                              Disabled="@(string.IsNullOrWhiteSpace(BarcodeInput))" />
                if (!string.IsNullOrWhiteSpace(BarcodeInput))
                {
                    <RadzenButton Text="Clear"
                                  Icon="clear"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@ClearBarcodeSearch" />
                }
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-disabled-color); font-style: italic;">
                    Select a transfer from the list to enable barcode scanning.
                </RadzenText>
            }

            @if (BarcodeMatchMessage != null)
            {
                <RadzenBadge BadgeStyle="@BarcodeMatchBadgeStyle" Text="@BarcodeMatchMessage" />
            }
        </RadzenStack>
    </RadzenCard>

    <!-- Dispatch / Final Save Action Bar -->
    @if (HasPendingReceivedDetails)
    {
        <RadzenCard class="mb-3">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.End">
                <RadzenButton Text="Final Save – Confirm Receipt"
                              Icon="task_alt"
                              ButtonStyle="ButtonStyle.Success"
                              Click="@SaveReceivedDetails"
                              IsBusy="@IsSaving"
                              BusyText="Saving..." />
            </RadzenStack>
        </RadzenCard>
    }

    <!-- Data Grid Card -->
    <RadzenCard>
        <RadzenDataGrid @ref="TransferGrid"
                        Data="@FilteredTransfers"
                        TItem="TransferMasterDTO"
                        AllowFiltering="true"
                        AllowColumnResize="true"
                        AllowAlternatingRows="true"
                        AllowPaging="true"
                        AllowSorting="true"
                        PagerHorizontalAlign="HorizontalAlign.Center"
                        PageSize="10"
                        PageSizeOptions="@(new int[] { 5, 10, 20, 50 })"
                        FilterMode="FilterMode.Advanced"
                        ShowPagingSummary="true"
                        PagingSummaryFormat="@("Displaying page {0} of {1} (total {2} records)")"
                        IsLoading="@IsLoading"
                        GridLines="DataGridGridLines.Both"
                        Density="Density.Compact"
                        RowExpand="@OnRowExpand"
                        ExpandMode="DataGridExpandMode.Single">

            <Columns>

                <!-- Selection (radio button — single transfer) -->
                <RadzenDataGridColumn TItem="TransferMasterDTO" Width="60px"
                                      Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="transfer">
                        <RadzenButton Size="ButtonSize.ExtraSmall"
                                      ButtonStyle="@(SelectedTransfer?.TransferId == transfer.TransferId ? ButtonStyle.Primary : ButtonStyle.Light)"
                                      Variant="Variant.Flat"
                                      Icon="@(SelectedTransfer?.TransferId == transfer.TransferId ? "radio_button_checked" : "radio_button_unchecked")"
                                      Click="@(() => SelectTransfer(transfer))" />
                    </Template>
                </RadzenDataGridColumn>

                <!-- Transfer No -->
                <RadzenDataGridColumn TItem="TransferMasterDTO" Property="TransferNo" Title="Transfer No" Width="140px" Frozen="true">
                    <Template Context="transfer">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="receipt_long" Style="color: var(--rz-primary);" />
                            <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 500;">
                                @transfer.TransferNo
                            </RadzenText>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Transfer Date -->
                <RadzenDataGridColumn TItem="TransferMasterDTO" Property="TransferDate" Title="Date" Width="120px" TextAlign="TextAlign.Center">
                    <Template Context="transfer">
                        <RadzenText TextStyle="TextStyle.Caption">
                            @(transfer.TransferDate.ToString("dd MMM yyyy"))
                        </RadzenText>
                    </Template>
                </RadzenDataGridColumn>

                <!-- From Store -->
                <RadzenDataGridColumn TItem="TransferMasterDTO" Property="StoreName" Title="From Store" Width="160px">
                    <Template Context="transfer">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                            <RadzenIcon Icon="store" Style="color: var(--rz-info);" />
                            <span>@(transfer.StoreName ?? "N/A")</span>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>

                <!-- To Store -->
                <RadzenDataGridColumn TItem="TransferMasterDTO" Property="ToStoreName" Title="To Store" Width="160px">
                    <Template Context="transfer">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                            <RadzenIcon Icon="store" Style="color: var(--rz-success);" />
                            <span>@(transfer.ToStoreName ?? "N/A")</span>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>


                <!-- Comments -->
                <RadzenDataGridColumn TItem="TransferMasterDTO" Property="Comments" Title="Comments" Width="200px">
                    <Template Context="transfer">
                        <div title="@transfer.Comments">
                            @(Truncate(transfer.Comments, 40))
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Actions -->
                <RadzenDataGridColumn TItem="TransferMasterDTO" Title="Actions" Width="140px"
                                      Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                    <Template Context="transfer">
                        @if (transfer.IsReceived != true)
                        {
                            <RadzenButton Text="Mark Received"
                                          Icon="check_circle"
                                          ButtonStyle="ButtonStyle.Success"
                                          Size="ButtonSize.Small"
                                          Click="@(() => MarkMasterReceived(transfer))"
                                          Disabled="@(IsLoading || !CanMarkReceived(transfer))" />
                        }
                        else
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                <RadzenIcon Icon="verified" Style="color: var(--rz-success);" />
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-success);">Done</RadzenText>
                            </RadzenStack>
                        }
                    </Template>
                </RadzenDataGridColumn>

            </Columns>

            <!-- Expandable Detail Grid -->
            <Template Context="master">
                <RadzenCard class="m-2" Style="background: var(--rz-base-background-color);">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.SpaceBetween" class="mb-2">
                        <RadzenText TextStyle="TextStyle.Subtitle2">
                            <RadzenIcon Icon="list_alt" Style="color: var(--rz-primary); vertical-align: middle;" />
                            Items for <strong>@master.TransferNo</strong>
                        </RadzenText>
                        @if (master.Details != null && master.Details.Any() && master.Details.Any(d => d.IsReceived == true))
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info"
                                         Text="@($"{master.Details.Count(d => d.IsReceived == true)}/{master.Details.Count} received")" />
                        }
                    </RadzenStack>

                    @if (master.Details == null)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="p-2">
                            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                            <RadzenText>Loading items...</RadzenText>
                        </RadzenStack>
                    }
                    else if (!master.Details.Any())
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-disabled-color);">
                            No items found for this transfer.
                        </RadzenText>
                    }
                    else
                    {
                        <RadzenDataGrid Data="@master.Details"
                                        TItem="TransferDetailDTO"
                                        GridLines="DataGridGridLines.Both"
                                        Density="Density.Compact"
                                        AllowAlternatingRows="true"
                                        AllowSorting="true">
                            <Columns>
                                <!-- Detail Checkbox -->
                                <RadzenDataGridColumn TItem="TransferDetailDTO" Width="50px"
                                                      Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                                    <HeaderTemplate>
                                        <RadzenCheckBox TValue="bool"
                                                        Value="@(master.Details.Any() && master.Details.All(d => d.IsReceived == true))"
                                                        Change="@(val => ToggleAllDetailReceived(master, val))" />
                                    </HeaderTemplate>
                                    <Template Context="detail">
                                        <RadzenCheckBox TValue="bool"
                                                        Value="@(detail.IsReceived == true)"
                                                        Change="@(val => ToggleDetailReceived(master, detail, val))" />
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="TransferDetailDTO" Property="ItemName" Title="Item Name" Width="200px">
                                    <Template Context="detail">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                            <RadzenIcon Icon="inventory_2" Style="color: var(--rz-primary);" />
                                            <span>@detail.ItemName</span>
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="TransferDetailDTO" Property="Barcode" Title="Barcode" Width="130px" TextAlign="TextAlign.Center">
                                    <Template Context="detail">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@(detail.Barcode ?? "N/A")" />
                                    </Template>
                                </RadzenDataGridColumn>

                                <!-- Scanned Qty (barcode scan progress) -->
                                <RadzenDataGridColumn TItem="TransferDetailDTO" Title="Scanned" Width="100px" TextAlign="TextAlign.Center"
                                                      Filterable="false" Sortable="false">
                                    <Template Context="detail">
                                        @{
                                            var scanned = BarcodeScanCounts.GetValueOrDefault(detail.TransferDetailID, 0);
                                            var qty = (int)detail.IssueQty;
                                            var isComplete = scanned >= qty;
                                            <RadzenBadge BadgeStyle="@(isComplete ? BadgeStyle.Success : (scanned > 0 ? BadgeStyle.Info : BadgeStyle.Light))"
                                                         Text="@($"{scanned}/{qty}")" />
                                        }
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="TransferDetailDTO" Property="IssueQty" Title="Qty" Width="90px" TextAlign="TextAlign.Center">
                                    <Template Context="detail">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="@detail.IssueQty.ToString()" />
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="TransferDetailDTO" Property="UnitName" Title="Unit" Width="100px" TextAlign="TextAlign.Center" />

                                <RadzenDataGridColumn TItem="TransferDetailDTO" Property="SalePrice" Title="Price" Width="110px" TextAlign="TextAlign.Right">
                                    <Template Context="detail">
                                        @(detail.SalePrice.ToString("N2"))
                                    </Template>
                                </RadzenDataGridColumn>

                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenCard>
            </Template>

        </RadzenDataGrid>
    </RadzenCard>
</RadzenContent>
