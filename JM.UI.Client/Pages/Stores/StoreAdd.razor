@page "/StoreAdd"
@page "/StoreAdd/{Id:int}"
@using JM.UI.Client.Pages.Store
@using JM.UI.Entities.Model.Stores
@attribute [Authorize]
@inherits StoreAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading store...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header Card -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@Cancel"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="@PageIcon" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                        @if (IsEditMode)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"#{Store.Id}")" />
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="@(IsEditMode ? "Reset Changes" : "Reset")"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Form Card -->
        <RadzenCard>
            <RadzenTemplateForm TItem="StoreDTO" Data="@Store" Submit="@Save">
                <RadzenStack Gap="1.5rem">
                    <!-- Store Information Section -->
                    <RadzenFieldset Text="Store Information" Icon="store">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Store Name *" Component="Name" />
                                        <RadzenTextBox @bind-Value="Store.Name"
                                                       Name="Name"
                                                       Placeholder="Enter store name"
                                                       Style="width: 100%;"
                                                       MaxLength="250" />
                                        <RadzenRequiredValidator Component="Name" Text="Store name is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Store Code" Component="Code" />
                                        <RadzenTextBox @bind-Value="Store.Code"
                                                       Name="Code"
                                                       Placeholder="Enter store code"
                                                       Style="width: 100%;"
                                                       MaxLength="50" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Address" Component="Address" />
                                        <RadzenTextArea @bind-Value="Store.Address"
                                                        Name="Address"
                                                        Placeholder="Enter store address"
                                                        Style="width: 100%;"
                                                        Rows="3"
                                                        MaxLength="500" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Contact" Component="Contact" />
                                        <RadzenTextBox @bind-Value="Store.Contact"
                                                       Name="Contact"
                                                       Placeholder="Enter contact number"
                                                       Style="width: 100%;"
                                                       MaxLength="50" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Email" Component="Email" />
                                        <RadzenTextBox @bind-Value="Store.Email"
                                                       Name="Email"
                                                       Placeholder="Enter email address"
                                                       Style="width: 100%;"
                                                       MaxLength="100" />
                                        <RadzenEmailValidator Component="Email" Text="Invalid email format" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="VAT Number" Component="VAT" />
                                        <RadzenTextBox @bind-Value="Store.VAT"
                                                       Name="VAT"
                                                       Placeholder="Enter VAT number"
                                                       Style="width: 100%;"
                                                       MaxLength="50" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="TIN Number" Component="TIN" />
                                        <RadzenTextBox @bind-Value="Store.TIN"
                                                       Name="TIN"
                                                       Placeholder="Enter TIN number"
                                                       Style="width: 100%;"
                                                       MaxLength="50" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>
                    <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="Upload Letterhead File" Component="LetterHeadFile" />
                        @if (!string.IsNullOrEmpty(Store.LetterHeadFile))
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenIcon Icon="attach_file" Style="color: var(--rz-primary);" />
                                <RadzenText TextStyle="TextStyle.Body2">@LetterHeadFileName</RadzenText>
                                <RadzenButton Icon="close"
                                              Variant="Variant.Text"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.ExtraSmall"
                                              Click="@ClearLetterHeadFile" />
                            </RadzenStack>

                            <!-- Preview if image -->
                            @if (IsImageFile)
                            {
                                <img src="@Store.LetterHeadFile"
                                     style="max-height: 120px; max-width: 100%; object-fit: contain; border: 1px solid var(--rz-border-disabled-color); border-radius: 4px; padding: 4px;" />
                            }
                        }

                        <InputFile id="letterheadInput"
                                   OnChange="@OnLetterHeadFileSelected"
                                   accept=".jpg,.jpeg,.png,.pdf,.bmp,.gif,.webp"
                                   style="display:none" />

                        <RadzenButton Text="@(string.IsNullOrEmpty(Store.LetterHeadFile) ? "Choose File" : "Replace File")"
                                      Icon="upload_file"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Size="ButtonSize.Small"
                                      Click="@TriggerFileInput"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                    <!-- Letterhead Settings Section -->
                    <RadzenFieldset Text="Letterhead Settings" Icon="description" Visible="false">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Letterhead File" Component="LetterHeadFile" />
                                        <RadzenTextBox @bind-Value="Store.LetterHeadFile"
                                                       Name="LetterHeadFile"
                                                       Placeholder="Enter letterhead file path"
                                                       Style="width: 100%;"
                                                       MaxLength="500" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Use Letterhead" Component="UseLetterHead" />
                                        <RadzenCheckBox @bind-Value="Store.UseLetterHead"
                                                        Name="UseLetterHead" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Metadata Section (Only in Edit Mode) -->
                   @*  @if (IsEditMode)
                    {
                        <RadzenFieldset Text="Metadata" Icon="info">
                            <RadzenStack Gap="1rem">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Created Date" />
                                            <RadzenTextBox Value="@Store.CreatedOn.ToString("dd MMM yyyy HH:mm")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Created By" />
                                            <RadzenTextBox Value="@Store.CreatedBy"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Modified Date" />
                                            <RadzenTextBox Value="@(Store.ModifiedOn?.ToString("dd MMM yyyy HH:mm") ?? "N/A")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Modified By" />
                                            <RadzenTextBox Value="@(Store.ModifiedBy ?? "N/A")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenFieldset>
                    } *@

                    <!-- Action Buttons -->
                    <RadzenCard class="mt-2">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat"
                                          Click="@Cancel"
                                          Disabled="@IsProcessing" />
                            @if (!IsEditMode)
                            {
                                <RadzenButton Text="Save & Add New"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Click="@SaveAndNew"
                                              IsBusy="@IsProcessing"
                                              Disabled="@IsProcessing" />
                            }
                            <RadzenButton Text="@(IsEditMode ? "Update" : "Save")"
                                          Icon="@(IsEditMode ? "update" : "save")"
                                          ButtonStyle="ButtonStyle.Primary"
                                          ButtonType="ButtonType.Submit"
                                          IsBusy="@IsProcessing"
                                          BusyText="@(IsEditMode ? "Updating..." : "Saving...")" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenContent>