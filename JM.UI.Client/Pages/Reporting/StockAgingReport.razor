@page "/StockAgingReport"
@using JM.UI.Entities.Model.Stock
@attribute [Authorize]
@inherits StockAgingReportComponent

<PageTitle>Stock Aging Report</PageTitle>

<style>
    .sa-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: 0 1px 3px rgba(15,23,42,.08); padding: 1.25rem 1.5rem; margin-bottom: 1.25rem; }
    .sa-head { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: .9rem; margin-bottom: 1rem; }
    .sa-title { font-size: 1.45rem; font-weight: 700; color: #0f172a; }
    .sa-sub { font-size: .82rem; color: #64748b; margin-top: .25rem; }
    .sa-sub b { color: #334155; }
    .sa-head-right { text-align: left; font-size: .82rem; color: #475569; }
    .sa-filters { display: flex; flex-wrap: wrap; gap: .75rem; align-items: flex-end; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: .85rem; }
    .sa-field { flex: 0 0 150px; min-width: 150px; }
    .sa-field label { display: block; font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #64748b; margin-bottom: .25rem; }
    .sa-field .rz-dropdown, .sa-field .rz-textbox { height: 2.35rem; min-height: 2.35rem; border-radius: 6px; font-size: .85rem; }
    .sa-kpi { border: 1px solid #e2e8f0; border-radius: 8px; padding: .75rem .9rem; background: #fff; box-shadow: 0 1px 2px rgba(15,23,42,.06); border-left: 4px solid #cbd5e1; }
    .sa-kpi .lbl { font-size: .64rem; text-transform: uppercase; letter-spacing: .06em; color: #64748b; font-weight: 700; }
    .sa-kpi .val { font-size: 1.15rem; font-weight: 700; color: #0f172a; margin-top: .15rem; }
    .sa-kpi .hint { font-size: .7rem; color: #64748b; margin-top: .1rem; }
    .sa-wrap { overflow-x: auto; }
    .sa-table { width: 100%; border-collapse: collapse; font-size: .76rem; min-width: 900px; }
    .sa-table th, .sa-table td { border: 1px solid #e5e7eb; padding: .32rem .45rem; vertical-align: top; }
    .sa-table th { background: #f9fafb; font-weight: 700; font-size: .66rem; text-transform: uppercase; letter-spacing: .04em; color: #6b7280; text-align: center; white-space: nowrap; }
    .sa-table td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .sa-table td.center { text-align: center; white-space: nowrap; }
    .sa-muted { color: #6b7280; }
    .sa-total td { background: #f1f5f9; font-weight: 700; }
    .sa-empty { text-align: center; color: #94a3b8; padding: 1.5rem; }
    .sa-mode-btn { padding: .35rem .7rem; border-radius: 6px; font-size: .75rem; font-weight: 600; cursor: pointer; border: 1px solid #e2e8f0; background: #f1f5f9; color: #475569; }
    .sa-mode-btn.active { background: #0f172a; color: #fff; border-color: #0f172a; }
    .sa-pill { display: inline-block; padding: .15rem .45rem; border-radius: 999px; font-size: .68rem; font-weight: 700; }
    .sa-cell-stockout { background: #fef2f2; }
    .sa-cell-excess { background: #fffbeb; }
    .sa-cell-healthy { background: #ecfdf5; }
    .sa-action { display: flex; align-items: center; justify-content: space-between; gap: .4rem; border-radius: 6px; padding: .3rem .5rem; font-size: .7rem; }
    .sa-action.transfer { background: #eff6ff; border: 1px solid #bfdbfe; color: #1e3a8a; }
    .sa-action.dead { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
    .sa-action.orphan { background: #faf5ff; border: 1px solid #e9d5ff; color: #6b21a8; }
</style>

<RadzenContent Container="main" class="p-4">
    <div class="sa-card">
        <div class="sa-head">
            <div>
                <div class="sa-title">Stock Aging Report</div>
                <div class="sa-sub">System: AFiS WebAPP &nbsp;|&nbsp; Branch: <b>@SelectedStoreName</b> &nbsp;|&nbsp; HO Management View (Cost Visible)</div>
            </div>
            <div class="sa-head-right">
                <div><b>Print Date:</b> @DateTime.Now.ToString("dd MMM yyyy")</div>
                <div><b>Generated By:</b> @CurrentUserName</div>
                <div style="margin-top:.4rem;">
                    <RadzenButton Icon="picture_as_pdf" Text="Download PDF"
                                  ButtonStyle="ButtonStyle.Success" Click="PrintReport" IsBusy="@IsPrinting" />
                </div>
            </div>
        </div>

        <!-- KPI strip -->
        @if (HasGenerated)
        {
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:.75rem; margin-bottom:1rem;">
                <div class="sa-kpi" style="border-left-color:#2563eb;">
                    <div class="lbl">Transfer Opportunities</div>
                    <div class="val">@Report.Kpi.TransferSkuCount SKUs</div>
                    <div class="hint">@Report.Kpi.TransferPcs.ToString("N0") pcs • Est. MRP @Money(Report.Kpi.TransferMrp)</div>
                </div>
                <div class="sa-kpi" style="border-left-color:#dc2626;">
                    <div class="lbl">Fast-Mover Stockouts</div>
                    <div class="val" style="color:#dc2626;">@Report.Kpi.StockoutCount SKUs</div>
                    <div class="hint">@(string.IsNullOrWhiteSpace(Report.Kpi.StockoutByBranch) ? "None" : Report.Kpi.StockoutByBranch)</div>
                </div>
                <div class="sa-kpi" style="border-left-color:#d97706;">
                    <div class="lbl">Dead Stock (90+ Days)</div>
                    <div class="val">@Money(Report.Kpi.DeadCost)</div>
                    <div class="hint">@Report.Kpi.DeadPcs.ToString("N0") pcs (Cost)</div>
                </div>
                <div class="sa-kpi" style="border-left-color:#7c3aed;">
                    <div class="lbl">Broken Size-Runs</div>
                    <div class="val">@Report.Kpi.OrphanDesignCount Designs</div>
                    <div class="hint">Orphan sizes only</div>
                </div>
            </div>
        }

        <!-- Filters -->
        <div class="sa-filters">
            <div class="sa-field">
                <label>Group</label>
                <RadzenDropDown @bind-Value="SelectedGroupId" TValue="int?"
                                Data="@Groups" TextProperty="Name" ValueProperty="Id"
                                AllowClear="true" ClearValue="null" Placeholder="All Groups"
                                Style="width:100%" />
            </div>
            <div class="sa-field">
                <label>Brand</label>
                <RadzenDropDown @bind-Value="SelectedBrandId" TValue="int?"
                                Data="@Brands" TextProperty="BrandName" ValueProperty="BrandId"
                                AllowClear="true" ClearValue="null" Placeholder="All Brands"
                                Style="width:100%" />
            </div>
            <div class="sa-field">
                <label>Aging Bucket</label>
                <RadzenDropDown @bind-Value="SelectedAgingBucket" TValue="string"
                                Data="@AgingBuckets" Style="width:100%" />
            </div>
            <div class="sa-field">
                <label>Source Branch (Excess)</label>
                <RadzenDropDown @bind-Value="SelectedSourceStoreId" TValue="int?"
                                Data="@Stores" TextProperty="Name" ValueProperty="Id"
                                AllowClear="true" ClearValue="null" Placeholder="Any Source"
                                Style="width:100%" />
            </div>
            <div class="sa-field" style="flex:0 0 220px; min-width:220px;">
                <label>Barcode / Ref / Item Name</label>
                <RadzenTextBox @bind-Value="SearchText" Placeholder="Search..." Style="width:100%" />
            </div>
            <div style="display:flex; gap:.5rem; align-items:center; padding-bottom:1px;">
                <RadzenCheckBox @bind-Value="IncludeHealthy" TValue="bool" Name="incHealthy" />
                <label for="incHealthy" style="font-size:.8rem; margin:0;">Include healthy SKUs</label>
                <RadzenButton Icon="search" Text="Generate" ButtonStyle="ButtonStyle.Primary" Click="Generate" IsBusy="@IsLoading" />
                <RadzenButton Icon="filter_alt_off" Text="Clear" ButtonStyle="ButtonStyle.Light" Click="ClearFilters" />
            </div>
        </div>

        @if (HasGenerated)
        {
            <!-- Mode tabs -->
            <div style="display:flex; flex-wrap:wrap; gap:.5rem; margin:1rem 0 .5rem; align-items:center;">
                <button class="sa-mode-btn @(ActiveMode=="all"?"active":"")" @onclick='() => SetMode("all")'>All Actionable (@CountAll)</button>
                <button class="sa-mode-btn @(ActiveMode=="transfer"?"active":"")" @onclick='() => SetMode("transfer")'>Inter-Branch Transfer (@CountTransfer)</button>
                <button class="sa-mode-btn @(ActiveMode=="dead"?"active":"")" @onclick='() => SetMode("dead")'>Dead Stock 90+ (@CountDead)</button>
                <button class="sa-mode-btn @(ActiveMode=="orphan"?"active":"")" @onclick='() => SetMode("orphan")'>Broken Size-Runs (@CountOrphan)</button>
                <div style="margin-left:auto; display:flex; gap:.75rem; font-size:.7rem; color:#64748b; align-items:center;">
                    <span style="display:inline-flex; align-items:center; gap:.3rem;"><span style="width:10px;height:10px;border-radius:3px;background:#fef2f2;border:1px solid #fca5a5;"></span> Stockout / Urgent</span>
                    <span style="display:inline-flex; align-items:center; gap:.3rem;"><span style="width:10px;height:10px;border-radius:3px;background:#fffbeb;border:1px solid #fcd34d;"></span> Excess / Slow</span>
                    <span style="display:inline-flex; align-items:center; gap:.3rem;"><span style="width:10px;height:10px;border-radius:3px;background:#ecfdf5;border:1px solid #6ee7b7;"></span> Healthy</span>
                </div>
            </div>

            <!-- Action bar -->
          @*   <div style="display:flex; align-items:center; gap:.75rem; margin-bottom:.75rem;">
                <button @onclick="GenerateTransferDraft"
                        style="padding:.45rem .9rem; border-radius:6px; background:#4f46e5; color:#fff; font-size:.78rem; font-weight:700; border:none; cursor:pointer;">
                    Generate Transfer Draft (@SelectedIds.Count)
                </button>
                <span style="font-size:.75rem; color:#64748b;">Tick rows to queue them.</span>
            </div> *@

            <!-- Matrix table -->
            <div class="sa-wrap">
                <table class="sa-table">
                    <thead>
                        <tr style="background:#1e293b; color:#fff; font-size:.7rem; text-transform:uppercase; letter-spacing:.04em;">
                            <th rowspan="2" style="width:2rem; text-align:center; border-right:1px solid #334155;">
                                <input type="checkbox" @onchange="e => ToggleAll((bool)(e.Value ?? false))" />
                            </th>
                            <th rowspan="2" style="min-width:200px; border-right:1px solid #334155;">Barcode &amp; Product Info</th>
                            <th rowspan="2" style="text-align:right; border-right:1px solid #334155; width:5rem;">Cost / MRP</th>
                            <th colspan="@Report.Stores.Count" style="text-align:center; border-right:1px solid #334155; background:#334155;">
                                Branch Rack Stock (Qty | 30D Sold)
                            </th>
                            <th rowspan="2" style="text-align:right; border-right:1px solid #334155; width:6rem;">Total &amp; Blocked Cost</th>
                            <th rowspan="2" style="text-align:center; border-right:1px solid #334155; width:4.5rem;">Stock Age</th>
                            <th rowspan="2" style="min-width:200px;">Recommended Action</th>
                        </tr>
                        <tr style="background:#334155; color:#e2e8f0; font-size:.68rem; font-weight:600;">
                            @foreach (var st in Report.Stores)
                            {
                                <th style="text-align:center; border-right:1px solid #475569; width:4.5rem;">@st.StoreCode</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredRows.Any())
                        {
                            <tr><td colspan="@(7 + Report.Stores.Count)" class="sa-empty">No actionable stock for the selected filters.</td></tr>
                        }
                        else
                        {
                            foreach (var row in FilteredRows)
                            {
                                <tr>
                                    <td style="text-align:center; border-right:1px solid #e5e7eb;">
                                        <input type="checkbox" checked="@SelectedIds.Contains(row.ItemId)"
                                               @onchange="e => { if ((bool)(e.Value ?? false)) SelectedIds.Add(row.ItemId); else SelectedIds.Remove(row.ItemId); }" />
                                    </td>
                                    <td style="border-right:1px solid #e5e7eb;">
                                        <div style="display:flex; align-items:center; gap:.35rem;">
                                            <span style="font-family:monospace; font-weight:700; color:#2563eb; font-size:.78rem;">@row.Barcode</span>
                                            <span style="font-size:.62rem; font-weight:700; background:#f1f5f9; border:1px solid #e2e8f0; border-radius:4px; padding:0 .25rem;">@row.BrandName</span>
                                        </div>
                                        <div style="font-weight:600; color:#0f172a; margin-top:.2rem; font-size:.78rem;">@row.ProductName</div>
                                        <div style="font-size:.68rem; color:#64748b;">@row.GroupName</div>
                                    </td>
                                    <td style="text-align:right; border-right:1px solid #e5e7eb; font-variant-numeric:tabular-nums;">
                                        <div style="color:#64748b; font-size:.68rem;">@Money(row.Cost)</div>
                                        <div style="font-weight:600;">@Money(row.Mrp)</div>
                                    </td>
                                    @foreach (var st in Report.Stores)
                                    {
                                        var cell = row.Cells.FirstOrDefault(c => c.StoreId == st.StoreId);
                                        var qty = cell?.Qty ?? 0;
                                        var sold = cell?.Sold30 ?? 0;
                                        var cls = cell?.Status == "Stockout" ? "sa-cell-stockout"
                                                : cell?.Status == "Excess" ? "sa-cell-excess" : "sa-cell-healthy";
                                        <td class="@cls" style="text-align:center; border-right:1px solid #e5e7eb; font-variant-numeric:tabular-nums;">
                                            <div style="font-weight:700;">@qty.ToString("N0")</div>
                                            <div style="font-size:.62rem; color:#64748b;">@sold.ToString("N0") sold</div>
                                        </td>
                                    }
                                    <td style="text-align:right; border-right:1px solid #e5e7eb; font-variant-numeric:tabular-nums;">
                                        <div style="font-weight:700;">@row.TotalQty.ToString("N0") pcs</div>
                                        <div style="font-size:.7rem; color:#dc2626; font-weight:700;">@Money(row.TotalCost)</div>
                                    </td>
                                    <td style="text-align:center; border-right:1px solid #e5e7eb;">
                                        <span class="sa-pill" style="background:@(row.AgeDays >= 180 ? "#fee2e2" : row.AgeDays >= 90 ? "#fef3c7" : "#d1fae5"); color:@(row.AgeDays >= 180 ? "#991b1b" : row.AgeDays >= 90 ? "#92400e" : "#065f46");">
                                            @row.AgeDays Days
                                        </span>
                                    </td>
                                    <td>
                                        <div class="sa-action @(row.Category == "Transfer" ? "transfer" : row.Category == "Dead" ? "dead" : "orphan")">
                                            <div>
                                                <div style="font-weight:700;">@row.ActionText</div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="sa-total">
                            <td colspan="3" style="text-align:right; font-size:.7rem; text-transform:uppercase; letter-spacing:.04em; color:#64748b;">Filtered View Totals:</td>
                            @foreach (var st in Report.Stores)
                            {
                                var q = FilteredRows.Sum(r => r.Cells.FirstOrDefault(c => c.StoreId == st.StoreId)?.Qty ?? 0);
                                var s = FilteredRows.Sum(r => r.Cells.FirstOrDefault(c => c.StoreId == st.StoreId)?.Sold30 ?? 0);
                                <td style="text-align:center; font-variant-numeric:tabular-nums;">
                                    <div>@q.ToString("N0")</div>
                                    <div style="font-size:.62rem; color:#64748b;">@s.ToString("N0") sold</div>
                                </td>
                            }
                            <td style="text-align:right; font-variant-numeric:tabular-nums;">
                                <div>@FilteredRows.Sum(r => r.TotalQty).ToString("N0") pcs</div>
                                <div style="font-size:.7rem; color:#2563eb; font-weight:700;">@Money(FilteredRows.Sum(r => r.TotalCost))</div>
                            </td>
                            <td colspan="2" style="font-size:.7rem; color:#64748b;">
                                Avg Age: <b style="color:#0f172a;">@(FilteredRows.Any() ? FilteredRows.Average(r => r.AgeDays).ToString("0") : "0") Days</b>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else if (IsLoading)
        {
            <div class="sa-card"><RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" /></div>
        }
        else
        {
            <div class="sa-card"><div class="sa-empty">Choose the filters and press Generate.</div></div>
        }
    </div>
</RadzenContent>