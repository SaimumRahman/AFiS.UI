@page "/SalesBookingReport"
@using JM.UI.Entities.Model.Reporting_D
@attribute [Authorize]
@inherits SalesBookingReportComponent

<PageTitle>Sales &amp; Booking Report</PageTitle>

<style>
    .sb-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: 0 1px 3px rgba(15,23,42,.08); padding: 1.25rem 1.5rem; margin-bottom: 1.25rem; }
    .sb-head { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: .9rem; margin-bottom: 1rem; }
    .sb-title { font-size: 1.45rem; font-weight: 700; color: #0f172a; }
    .sb-sub { font-size: .82rem; color: #64748b; margin-top: .25rem; }
    .sb-sub b { color: #334155; }
    .sb-head-right { text-align: left; font-size: .82rem; color: #475569; }
    .sb-filters { display: flex; flex-wrap: wrap; gap: .75rem; align-items: flex-end; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: .85rem; }
    .sb-field { flex: 0 0 165px; min-width: 165px; }
    .sb-field.sb-wide { flex: 0 0 200px; min-width: 200px; }
    .sb-field label { display: block; font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #64748b; margin-bottom: .25rem; }
    .sb-field .rz-datepicker-input, .sb-field .rz-dropdown { height: 2.35rem; min-height: 2.35rem; border-radius: 6px; font-size: .85rem; }
    .sb-section-title { font-size: 1.05rem; font-weight: 700; color: #1e293b; margin: 0 0 .5rem; }
    .sb-wrap { overflow-x: auto; }
    .sb-table { width: 100%; border-collapse: collapse; font-size: .76rem; min-width: 1080px; }
    .sb-table th, .sb-table td { border: 1px solid #e5e7eb; padding: .32rem .45rem; vertical-align: top; }
    .sb-table th { background: #f9fafb; font-weight: 700; font-size: .66rem; text-transform: uppercase; letter-spacing: .04em; color: #6b7280; text-align: center; white-space: nowrap; }
    .sb-table td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .sb-table td.center { text-align: center; white-space: nowrap; }
    .sb-inv { font-weight: 700; color: #2563eb; display: block; font-size: .78rem; }
    .sb-bk { font-weight: 700; color: #0d9488; display: block; font-size: .78rem; }
    .sb-muted { color: #6b7280; }
    .sb-line + .sb-line { margin-top: .35rem; padding-top: .35rem; border-top: 1px dashed #e5e7eb; }
    .sb-cost { color: #92400e; }
    .sb-chip { display: inline-block; margin-left: .25rem; font-size: .68rem; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 4px; padding: 0 .25rem; }
    .sb-exchange { color: #dc2626; font-size: .7rem; margin-top: .15rem; }
    .sb-pay { font-size: .68rem; display: flex; justify-content: space-between; gap: .4rem; background: #f1f5f9; border-radius: 4px; padding: 0 .3rem; margin-top: .15rem; }
    .sb-pay.mfs { background: #f0fdf4; color: #15803d; }
    .sb-pay.bank { background: #eff6ff; color: #1d4ed8; }
    .sb-total td { background: #f1f5f9; font-weight: 700; }
    .sb-empty { text-align: center; color: #94a3b8; padding: 1.5rem; }
    .sb-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: .9rem; margin-top: .35rem; }
    .sb-sum-card { border: 1px solid #e2e8f0; border-radius: 8px; padding: .75rem .9rem; background: #f8fafc; }
    .sb-sum-card .lbl { font-size: .64rem; text-transform: uppercase; letter-spacing: .06em; color: #64748b; font-weight: 700; }
    .sb-sum-card .val { font-size: 1.15rem; font-weight: 700; color: #0f172a; margin-top: .15rem; }
    .sb-sum-card.grand { background: #ecfdf5; border-color: #a7f3d0; }
    .sb-sum-card.grand .val { color: #047857; }
    .sb-sum-card.info { background: #eff6ff; border-color: #bfdbfe; }
    .sb-sum-card.info .val { color: #1d4ed8; }
</style>

<RadzenContent Container="main" class="p-4">
    <!-- Header -->
    <div class="sb-card">
        <div class="sb-head">
            <div>
                <div class="sb-title">Sales &amp; Booking Report</div>
                <div class="sb-sub">System: AFiS WebAPP &nbsp;|&nbsp; Branch: <b>@SelectedStoreName</b></div>
            </div>
            <div class="sb-head-right">
                <div><b>Print Date:</b> @DateTime.Now.ToString("dd MMM yyyy")</div>
                <div><b>Generated By:</b> @CurrentUserName</div>
                <div style="margin-top:.4rem;">
                    <RadzenButton Icon="picture_as_pdf" Text="Download PDF"
                                  ButtonStyle="ButtonStyle.Success" Click="PrintReport" IsBusy="@IsPrinting" />
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="sb-filters">
            <div class="sb-field">
                <label>Date From</label>
                <RadzenDatePicker @bind-Value="FromDate" AllowClear="false" DateFormat="dd/MM/yyyy" Style="width:100%" />
            </div>
            <div class="sb-field">
                <label>Date To</label>
                <RadzenDatePicker @bind-Value="ToDate" AllowClear="false" DateFormat="dd/MM/yyyy" Style="width:100%" />
            </div>

            @if (CanSelectAnyStore)
            {
                <div class="sb-field sb-wide">
                    <label>Branch</label>
                    <RadzenDropDown @bind-Value="SelectedStoreId"
                                    TValue="int?"
                                    Data="@Stores"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    AllowClear="false"
                                    Change="@((object v) => OnStoreChanged())"
                                    Style="width:100%" />
                </div>
            }

            <div class="sb-field sb-wide">
                <label>Group</label>
                <RadzenDropDown @bind-Value="SelectedGroupId" TValue="int?"
                                Data="@Groups" TextProperty="Name" ValueProperty="Id"
                                AllowClear="true" ClearValue="null" Placeholder="All Groups"
                                Change="@((object v) => OnGroupChanged())" Style="width:100%" />
            </div>
            <div class="sb-field sb-wide">
                <label>Product</label>
                <RadzenDropDown @bind-Value="SelectedDesignId" TValue="int?"
                                Data="@Designs" TextProperty="Name" ValueProperty="Id"
                                AllowClear="true" ClearValue="null" Placeholder="All Products"
                                Style="width:100%" />
            </div>
            <div class="sb-field sb-wide">
                <label>Sub Product</label>
                <RadzenDropDown @bind-Value="SelectedSubGroupId" TValue="int?"
                                Data="@SubGroups" TextProperty="Name" ValueProperty="Id"
                                AllowClear="true" ClearValue="null" Placeholder="All Sub Products"
                                Change="@((object v) => OnSubGroupChanged())" Style="width:100%" />
            </div>
            <div class="sb-field sb-wide">
                <label>Catalogue</label>
                <RadzenDropDown @bind-Value="SelectedCatalogueId" TValue="int?"
                                Data="@Catalogues" TextProperty="CatalogueName" ValueProperty="CatalogueId"
                                AllowClear="true" ClearValue="null" Placeholder="All Catalogues"
                                Style="width:100%" />
            </div>
            <div class="sb-field sb-wide">
                <label>Salesman (Item Level)</label>
                <RadzenDropDown @bind-Value="SelectedSalesmanName" TValue="string"
                                Data="@Employees" TextProperty="Name" ValueProperty="Name"
                                AllowClear="true" ClearValue="null" Placeholder="All Salesmen"
                                Style="width:100%" />
            </div>
            <div class="sb-field sb-wide">
                <label>Served By (Counter)</label>
                <RadzenDropDown @bind-Value="SelectedServedByUserId" TValue="int?"
                                Data="@Users" TextProperty="UserName" ValueProperty="UserId"
                                AllowClear="true" ClearValue="null" Placeholder="All Users"
                                Style="width:100%" />
            </div>
            <div style="display:flex; gap:.5rem; padding-bottom:1px;">
                <RadzenButton Icon="search" Text="Generate" ButtonStyle="ButtonStyle.Primary" Click="Generate" IsBusy="@IsLoading" />
                <RadzenButton Icon="filter_alt_off" Text="Clear" ButtonStyle="ButtonStyle.Light" Click="ClearFilters" />
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="sb-card"><RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" /></div>
    }
    else if (!HasGenerated)
    {
        <div class="sb-card"><div class="sb-empty">Choose the filters and press Generate.</div></div>
    }
    else
    {
        <!-- 1. Sales & Exchanges -->
        <div class="sb-card">
            <div class="sb-section-title">1. Sales &amp; Exchanges</div>
            @if (!Report.Invoices.Any())
            {
                <div class="sb-empty">No sales found for the selected filters.</div>
            }
            else
            {
                <div class="sb-wrap">
                    <table class="sb-table">
                        <thead>
                            <tr>
                                <th style="width:8rem;">Invoice No</th>
                                <th style="width:10rem;">Customer</th>
                                <th>Item Details &amp; Salesman</th>
                                <th style="width:5.5rem;">Bill Amt</th>
                                <th style="width:5rem;">Camp Disc</th>
                                <th style="width:5rem;">Inv Disc</th>
                                <th style="width:5.5rem;">Net Amt</th>
                                <th style="width:5.5rem;">Exc Amt</th>
                                <th style="width:9rem;">Paid &amp; Breakdown</th>
                                <th style="width:4.5rem;">Due</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Report.Invoices)
                            {
                                <tr>
                                    <td class="center">
                                        <span class="sb-inv">@inv.InvoiceNo</span>
                                        <span class="sb-muted">@inv.CreatedDate.ToString("dd MMM yyyy")</span><br />
                                        <span class="sb-muted">@inv.CreatedDate.ToString("HH:mm")</span>
                                        @if (!string.IsNullOrWhiteSpace(inv.ReturnInvoiceNo))
                                        {
                                            <span class="sb-muted" style="font-size:.66rem;">Ref: @inv.ReturnInvoiceNo</span>
                                        }
                                    </td>
                                    <td>
                                        <span style="font-weight:600;">@CustomerLabel(inv.CustomerId, inv.CustomerName)</span><br />
                                        <span class="sb-muted" style="font-size:.7rem;">Served By: <b>@inv.ServedByName</b></span>
                                    </td>
                                    <td>
                                        @foreach (var line in inv.Lines)
                                        {
                                            <div class="sb-line">
                                                <div style="font-weight:500;">
                                                    @line.Barcode @line.ProductName [@line.Qty.ToString("N0")] x @Money2(line.UnitPrice)
                                                    @if (!string.IsNullOrWhiteSpace(line.SalesPersonName))
                                                    {
                                                        <span class="sb-chip">Sales: @line.SalesPersonName</span>
                                                    }
                                                </div>
                                                @if (line.IsReturn)
                                                {
                                                    <div class="sb-exchange">(Return/Exchange) prev ref: @line.ReturnRefNo</div>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="num">@Money(inv.TotalBill)</td>
                                    <td class="num" style="color:#dc2626;">@Money(inv.CampaignDiscount)</td>
                                    <td class="num" style="color:#dc2626;">@Money(inv.InvoiceDiscount)</td>
                                    <td class="num" style="font-weight:600;">@Money(inv.NetAmount)</td>
                                    <td class="num" style="color:@(inv.ExchangeAmount != 0 ? "#dc2626" : "inherit");">
                                        @(inv.ExchangeAmount != 0 ? "- " + Money(Math.Abs(inv.ExchangeAmount)) : "0")
                                    </td>
                                    <td class="num">
                                        <div style="font-weight:700;">@Money(inv.TotalPaid)</div>
                                        @foreach (var pay in inv.Payments)
                                        {
                                            <div class="sb-pay @(pay.PaymentType == "MFS" ? "mfs" : pay.PaymentType == "Bank" ? "bank" : "")">
                                                <span>@pay.PaymentMethod:</span>
                                                <span style="font-weight:700;">@Money(pay.Amount)</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="num">@Money(inv.TotalDue)</td>
                                </tr>
                            }

                            <tr class="sb-total">
                                <td colspan="3" style="text-align:right;">MAIN GRID TOTALS:</td>
                                <td class="num">@Money(TotalBill)</td>
                                <td class="num" style="color:#dc2626;">@Money(TotalCampaignDiscount)</td>
                                <td class="num" style="color:#dc2626;">@Money(TotalInvoiceDiscount)</td>
                                <td class="num">@Money(TotalNet)</td>
                                <td class="num">@(TotalExchange != 0 ? "- " + Money(Math.Abs(TotalExchange)) : "0")</td>
                                <td class="num">@Money(TotalPaid)</td>
                                <td class="num">@Money(TotalDue)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- 2. New Bookings -->
        <div class="sb-card">
            <div class="sb-section-title">2. New Bookings</div>
            @if (!Report.Bookings.Any())
            {
                <div class="sb-empty">No new bookings for the selected filters.</div>
            }
            else
            {
                <div class="sb-wrap">
                    <table class="sb-table" style="min-width:900px;">
                        <thead>
                            <tr>
                                <th style="width:8rem;">Booking No.</th>
                                <th style="width:10rem;">Customer</th>
                                <th>Booked Items &amp; Salesman</th>
                                <th style="width:6rem;">Total Value</th>
                                <th style="width:9rem;">Advance Paid</th>
                                <th style="width:6rem;">Due Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bk in Report.Bookings)
                            {
                                <tr>
                                    <td class="center">
                                        <span class="sb-bk">@bk.BookingNo</span>
                                        <span class="sb-muted">@bk.CreatedDate.ToString("dd MMM yyyy")</span><br />
                                        <span class="sb-muted">@bk.CreatedDate.ToString("HH:mm")</span>
                                    </td>
                                    <td>
                                        <span style="font-weight:600;">@CustomerLabel(bk.CustomerId, bk.CustomerName)</span><br />
                                        <span class="sb-muted" style="font-size:.7rem;">Served By: <b>@bk.ServedByName</b></span>
                                    </td>
                                    <td>
                                        @foreach (var line in bk.Lines)
                                        {
                                            <div class="sb-line">
                                                <div style="font-weight:500;">
                                                    @line.Barcode @line.ProductName [@line.Qty.ToString("N0")] x @Money2(line.UnitPrice)
                                                    @if (!string.IsNullOrWhiteSpace(line.SalesPersonName))
                                                    {
                                                        <span class="sb-chip">Sales: @line.SalesPersonName</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </td>
                                    <td class="num">@Money(bk.TotalBill)</td>
                                    <td class="num">
                                        <div style="font-weight:700;color:#15803d;">@Money(bk.AdvancePaid)</div>
                                        @foreach (var pay in bk.Payments)
                                        {
                                            <div class="sb-pay @(pay.PaymentType == "MFS" ? "mfs" : pay.PaymentType == "Bank" ? "bank" : "")">
                                                <span>@pay.PaymentMethod:</span>
                                                <span style="font-weight:700;">@Money(pay.Amount)</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="num" style="color:#dc2626;font-weight:600;">@Money(bk.DueBalance)</td>
                                </tr>
                            }

                            <tr class="sb-total">
                                <td colspan="3" style="text-align:right;">BOOKING TOTALS:</td>
                                <td class="num">@Money(BookingTotalValue)</td>
                                <td class="num" style="color:#15803d;">@Money(BookingTotalAdvance)</td>
                                <td class="num" style="color:#dc2626;">@Money(BookingTotalDue)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- 3. Collection Summary -->
        <div class="sb-card">
            <div class="sb-section-title">Collection Summary</div>
            <div class="sb-summary">
                <div class="sb-sum-card">
                    <div class="lbl">Total Cash (Drawer)</div>
                    <div class="val">@Money(CollectionCash)</div>
                </div>
                <div class="sb-sum-card">
                    <div class="lbl">Total MFS (bKash, Nagad)</div>
                    <div class="val">@Money(CollectionMfs)</div>
                </div>
                <div class="sb-sum-card">
                    <div class="lbl">Total Cards (Bank POS)</div>
                    <div class="val">@Money(CollectionBank)</div>
                </div>
                <div class="sb-sum-card grand">
                    <div class="lbl">Total Physical Collection</div>
                    <div class="val">@Money(CollectionTotal)</div>
                </div>
                <div class="sb-sum-card info">
                    <div class="lbl">Total Invoices Created</div>
                    <div class="val">@Report.Invoices.Count</div>
                </div>
                <div class="sb-sum-card info">
                    <div class="lbl">Gross Sales (Items Sold)</div>
                    <div class="val">@Money(TotalBill)</div>
                </div>
            </div>
        </div>
    }
</RadzenContent>
