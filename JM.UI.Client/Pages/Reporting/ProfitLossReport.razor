@page "/ProfitLossReport"
@using JM.UI.Entities.Model.Reporting_D
@using JM.UI.Entities.Model.Stores
@attribute [Authorize]
@inherits ProfitLossReportComponent

<PageTitle>Profit / Loss Report</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="trending_up" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Profit / Loss Report</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenDatePicker @bind-Value="FromDate"
                                      AllowClear="true"
                                      Placeholder="From Date"
                                      Style="width: 160px" />
                    <RadzenDatePicker @bind-Value="ToDate"
                                      AllowClear="true"
                                      Placeholder="To Date"
                                      Style="width: 160px" />
                    <RadzenDropDown @bind-Value="SelectedStoreId"
                                    Data="@Stores"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    AllowClear="true"
                                    ClearValue="null"
                                    Placeholder="All Stores"
                                    Style="width: 220px" />
                    <RadzenButton Icon="refresh"
                                  Text="Load"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="LoadReport" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @if (IsLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <RadzenCard>
            <RadzenDataGrid @ref="ReportGrid"
                            Data="@Report"
                            TItem="ProfitLossReportDTO"
                            AllowFiltering="true"
                            AllowColumnResize="true"
                            AllowAlternatingRows="true"
                            AllowPaging="true"
                            AllowSorting="true"
                            PageSize="20"
                            PageSizeOptions="@(new int[] { 10, 20, 50, 100 })"
                            FilterMode="FilterMode.Advanced"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="@("Displaying page {0} of {1} (total {2} records)")"
                            IsLoading="@IsLoading"
                            GridLines="DataGridGridLines.Both"
                            Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="ProfitLossReportDTO" Property="Barcode" Title="Barcode" Frozen="true" Width="160px" />
                    <RadzenDataGridColumn TItem="ProfitLossReportDTO" Property="ItemName" Title="Item" Width="260px" />
                    <RadzenDataGridColumn TItem="ProfitLossReportDTO" Property="TotalIn" Title="Total In">
                        <Template Context="r">@r.TotalIn.ToString("N2")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ProfitLossReportDTO" Property="TotalOut" Title="Total Out">
                        <Template Context="r">@r.TotalOut.ToString("N2")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ProfitLossReportDTO" Property="AvgPurchasePrice" Title="Avg Purchase">
                        <Template Context="r">@r.AvgPurchasePrice.ToString("N2")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ProfitLossReportDTO" Property="PurchaseValue" Title="Total Purchase">
                        <Template Context="r">@r.PurchaseValue.ToString("N2")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ProfitLossReportDTO" Property="TotalSaleQty" Title="Sale Qty">
                        <Template Context="r">@r.TotalSaleQty.ToString("N2")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ProfitLossReportDTO" Property="TotalSaleAmount" Title="Total Sale">
                        <Template Context="r">@r.TotalSaleAmount.ToString("N2")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ProfitLossReportDTO" Property="CurrentStock" Title="Current Stock">
                        <Template Context="r">@r.CurrentStock.ToString("N2")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ProfitLossReportDTO" Property="Profit" Title="Profit">
                        <Template Context="r">
                            <span style="@(r.Profit < 0 ? "color:var(--rz-danger);font-weight:600" : "color:var(--rz-success);font-weight:600")">
                                @r.Profit.ToString("N2")
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
                <FooterTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Style="width:100%;font-weight:600">
                        <span>Total In: @TotalInSum.ToString("N2")</span>
                        <span>Total Out: @TotalOutSum.ToString("N2")</span>
                        <span>Grand Total Purchase: @TotalPurchaseValue.ToString("N2")</span>
                        <span>Total Sale: @TotalSaleSum.ToString("N2")</span>
                        <span>Current Stock: @CurrentStockSum.ToString("N2")</span>
                        <span>Total Profit: @TotalProfitSum.ToString("N2")</span>
                    </RadzenStack>
                </FooterTemplate>
            </RadzenDataGrid>
        </RadzenCard>
    }
</RadzenContent>
