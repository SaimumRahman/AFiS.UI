@page "/SalesmanWiseDetailedReport"
@using JM.UI.Entities.Model.Reporting_D
@attribute [Authorize]
@inherits SalesmanWiseDetailedReportComponent

<PageTitle>Salesman-wise Detailed Report</PageTitle>

<style>
    :root {
        --sw-primary: #0f766e;
        --sw-primary-soft: #ccfbf1;
        --sw-primary-strong: #115e59;
        --sw-border: #e2e8f0;
        --sw-text: #1e293b;
        --sw-muted: #64748b;
        --sw-subtotal: #f1f5f9;
        --sw-challan: #ccfbf1;
        --sw-radius: 10px;
        --sw-shadow: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    .sw-paper { background: #fff; border: 1px solid var(--sw-border); border-radius: var(--sw-radius); box-shadow: var(--sw-shadow); padding: 1.75rem 1.5rem; }

    .sw-doc-header { text-align: center; margin-bottom: 1.25rem; }
    .sw-doc-header .company { font-size: 1.45rem; font-weight: 700; color: var(--sw-text); letter-spacing: 0.02em; }
    .sw-doc-header .address { font-size: 0.85rem; color: var(--sw-muted); margin-top: 2px; }
    .sw-doc-header .title { display: inline-block; margin-top: 0.5rem; font-weight: 700; font-size: 1rem; color: var(--sw-primary-strong); letter-spacing: 0.04em; padding: 2px 14px; border-radius: 999px; background: var(--sw-primary-soft); }
    .sw-doc-header .range { font-size: 0.85rem; color: var(--sw-muted); margin-top: 6px; font-weight: 600; }

    .sw-salesman { margin-top: 1.25rem; border: 1px solid var(--sw-border); border-radius: var(--sw-radius); overflow: hidden; }
    .sw-salesman-head { background: linear-gradient(135deg, var(--sw-primary) 0%, var(--sw-primary-strong) 100%); color: #fff; padding: 0.6rem 1rem; font-weight: 700; font-size: 0.95rem; letter-spacing: 0.02em; }

    .sw-table { width: 100%; border-collapse: collapse; font-size: 0.78rem; }
    .sw-table thead th { text-align: left; font-weight: 700; color: var(--sw-muted); text-transform: uppercase; font-size: 0.66rem; letter-spacing: 0.05em; padding: 0.45rem 0.5rem; background: #f8fafc; border-bottom: 1px solid var(--sw-border); white-space: nowrap; }
    .sw-table thead th.num, .sw-table td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .sw-table tbody td { padding: 0.45rem 0.5rem; border-bottom: 1px solid #f1f5f9; color: var(--sw-text); vertical-align: top; }
    .sw-table .code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.74rem; color: var(--sw-primary-strong); font-weight: 600; white-space: nowrap; }
    .sw-table .muted { color: var(--sw-muted); }
    .sw-table .first-line { border-top: 2px solid #e2e8f0; }

    .sw-badge { display: inline-block; font-size: 0.68rem; font-weight: 700; padding: 1px 8px; border-radius: 999px; letter-spacing: 0.02em; }
    .sw-badge.sale { background: #dcfce7; color: #166534; }
    .sw-badge.booking { background: #fef3c7; color: #92400e; }
    .sw-badge.exchange { background: #dbeafe; color: #1e40af; }

    .sw-subtotal td { background: var(--sw-subtotal); font-weight: 700; border-top: 1px solid var(--sw-border); }
    .sw-grand td { background: var(--sw-challan); font-weight: 700; border-top: 1px solid var(--sw-border); }
    .sw-label { text-align: right; color: var(--sw-primary-strong); font-weight: 700; }

    .sw-empty { text-align: center; color: var(--sw-muted); padding: 2rem; }
</style>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="badge" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Salesman-wise Detailed Report</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End" Style="flex-wrap: wrap;">
                    <RadzenDatePicker @bind-Value="FromDate" AllowClear="true" Placeholder="From Date" Style="width: 150px" />
                    <RadzenDatePicker @bind-Value="ToDate" AllowClear="true" Placeholder="To Date" Style="width: 150px" />
                    <RadzenButton Icon="refresh" Text="Load" ButtonStyle="ButtonStyle.Primary" Click="LoadReport" />
                    <RadzenButton Icon="print" Text="Print / PDF" ButtonStyle="ButtonStyle.Secondary" Click="PrintReport" IsBusy="@IsPrinting" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @if (IsLoading)
    {
        <RadzenCard><RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" /></RadzenCard>
    }
    else
    {
        <div class="sw-paper">
            <div class="sw-doc-header">
                <div class="company">ASIA FASHION</div>
                <div class="address">HOSSAIN PLAZA (1ST FLOOR), BANDARTILA, CHATTOGRAM.</div>
                <div><span class="title">SALESMAN-WISE DETAILED REPORT</span></div>
                <div class="range">@DateRangeText</div>
            </div>

            @if (!Salesmen.Any())
            {
                <div class="sw-empty">No sales records found for the selected period.</div>
            }
            else
            {
                @foreach (var salesman in Salesmen)
                {
                    <div class="sw-salesman">
                        <div class="sw-salesman-head">@Dash(salesman.Name)</div>
                        <div style="overflow-x:auto;">
                            <table class="sw-table">
                                <thead>
                                    <tr>
                                        <th>Invoice No</th>
                                        <th>Date</th>
                                        <th>Remarks</th>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Qty</th>
                                        <th class="num">Rate</th>
                                        <th class="num">Gross</th>
                                        <th class="num">Camp.Disc</th>
                                        <th class="num">Inv.Disc</th>
                                        <th class="num">Total Amt</th>
                                        <th class="num">ExchngeAmt</th>
                                        <th class="num">Net Paid</th>
                                        <th class="num">DUES</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invoice in salesman.Invoices)
                                    {
                                        @for (var i = 0; i < invoice.Lines.Count; i++)
                                        {
                                            var line = invoice.Lines[i];
                                            var first = i == 0;
                                            <tr class="@(first ? "first-line" : "")">
                                                <td>@(first ? Dash(invoice.InvoiceNo) : "")</td>
                                                <td class="muted">@(first ? invoice.SaleDate.ToString("dd-MMM-yy") : "")</td>
                                                <td>
                                                    @if (first)
                                                    {
                                                        var cls = invoice.Remarks switch
                                                        {
                                                            "BOOKING" => "booking",
                                                            "Exchange" => "exchange",
                                                            _ => "sale"
                                                        };
                                                        <span class="sw-badge @cls">@Dash(invoice.Remarks)</span>
                                                    }
                                                </td>
                                                <td class="code">@Dash(line.ItemCode)</td>
                                                <td>@Dash(line.ItemName)</td>
                                                <td>@QtyDisplay(line.Quantity, line.Uom)</td>
                                                <td class="num">@Fmt(line.Rate)</td>
                                                <td class="num">@Fmt(line.GrossAmount)</td>
                                                <td class="num">@Fmt(line.CampDisc)</td>
                                                <td class="num">@(first ? Fmt(invoice.InvDisc) : "-")</td>
                                                <td class="num">@(first ? Fmt(invoice.TotalAmt) : "-")</td>
                                                <td class="num">@(first ? ExchangeFmt(invoice.ExchangeAmt) : "-")</td>
                                                <td class="num">@(first ? Fmt(invoice.NetPaid) : "-")</td>
                                                <td class="num">@(first ? Fmt(invoice.Dues) : "-")</td>
                                            </tr>
                                        }
                                    }
                                    <tr class="sw-subtotal">
                                        <td colspan="6" class="sw-label">SubTotal</td>
                                        <td></td>
                                        <td class="num">@Fmt(salesman.GrossTotal)</td>
                                        <td class="num">@Fmt(salesman.CampDiscTotal)</td>
                                        <td class="num">@Fmt(salesman.InvDiscTotal)</td>
                                        <td class="num">@Fmt(salesman.TotalAmtTotal)</td>
                                        <td class="num">@ExchangeFmt(salesman.ExchangeTotal)</td>
                                        <td class="num">@Fmt(salesman.NetPaidTotal)</td>
                                        <td class="num">@Fmt(salesman.DuesTotal)</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <div class="sw-salesman">
                    <div style="overflow-x:auto;">
                        <table class="sw-table">
                            <tbody>
                                <tr class="sw-grand">
                                    <td colspan="6" class="sw-label">GRAND TOTAL</td>
                                    <td></td>
                                    <td class="num">@Fmt(Salesmen.Sum(s => s.GrossTotal))</td>
                                    <td class="num">@Fmt(Salesmen.Sum(s => s.CampDiscTotal))</td>
                                    <td class="num">@Fmt(Salesmen.Sum(s => s.InvDiscTotal))</td>
                                    <td class="num">@Fmt(Salesmen.Sum(s => s.TotalAmtTotal))</td>
                                    <td class="num">@ExchangeFmt(Salesmen.Sum(s => s.ExchangeTotal))</td>
                                    <td class="num">@Fmt(Salesmen.Sum(s => s.NetPaidTotal))</td>
                                    <td class="num">@Fmt(Salesmen.Sum(s => s.DuesTotal))</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</RadzenContent>
