@page "/AccountingTrialBalance"
@using JM.UI.Entities.Model.Reporting_D
@using JM.UIWeb.CustomBase
@attribute [Authorize]
@inherits AccountingTrialBalanceComponent

<PageTitle>Trial Balance</PageTitle>

<style>
    .acc-doc-header { text-align: center; font-family: Arial, Helvetica, sans-serif; }
    .acc-doc-header .title { font-size: 1.4rem; font-weight: bold; }
    .acc-doc-header .subtitle { font-size: 0.9rem; }
    .acc-doc-header .doc-name { font-weight: bold; font-size: 1rem; }
    .acc-doc-header .doc-range { font-size: 0.9rem; }
    .acc-report-wrap { overflow-x: auto; }
    .acc-report-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px;
        border: 1px solid #444;
    }
    .acc-report-table thead th {
        font-weight: bold;
        text-align: left;
        padding: 6px 8px;
        background: #f5f5f5;
        border-bottom: 2px solid #444;
        white-space: nowrap;
    }
    .acc-report-table tbody td { padding: 6px 8px; border-bottom: 1px solid #e0e0e0; white-space: nowrap; }
    .acc-report-table th.num, .acc-report-table td.num { text-align: right; }
    .acc-report-table tfoot td { font-weight: 600; border-top: 2px solid #444; background: #f9f9f9; padding: 6px 8px; white-space: nowrap; }
    .acc-note { font-size: 0.78rem; color: #616161; margin-top: 10px; text-align: left; }
</style>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="account_balance" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Trial Balance</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="flex-wrap: wrap;">
                    <RadzenDatePicker @bind-Value="FromDate"
                                      AllowClear="true"
                                      Placeholder="From Date"
                                      Style="width: 150px" />
                    <RadzenDatePicker @bind-Value="ToDate"
                                      AllowClear="true"
                                      Placeholder="To Date"
                                      Style="width: 150px" />
                    <RadzenDropDown @bind-Value="SelectedBranchCode"
                                    Data="@AccountingReportOptions.BranchCodes"
                                    AllowClear="true"
                                    ClearValue="null"
                                    Placeholder="All Branches"
                                    Style="width: 160px" />
                    <RadzenButton Icon="refresh"
                                  Text="Load"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="LoadReport" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenCard>
        @if (IsLoading)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        }
        else
        {
            <div class="acc-doc-header mb-3">
                <div class="title">ASIA FASHION</div>
                <div class="subtitle">HOSSAIN PLAZA (1ST FLOOR), BANDARTILA, CHATTOGRAM.</div>
                <div class="doc-name">TRIAL BALANCE</div>
                <div class="doc-range">@DateRangeText</div>
                <hr style="border-top: 1px solid #000; margin-top: 8px;" />
            </div>

            @if (Rows.Any())
            {
                <div class="acc-report-wrap">
                    <table class="acc-report-table">
                        <thead>
                            <tr>
                                <th>Account Code</th>
                                <th>Account Name</th>
                                <th>Nature</th>
                                <th class="num">Opening</th>
                                <th class="num">Period Debit</th>
                                <th class="num">Period Credit</th>
                                <th class="num">Closing</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Rows)
                            {
                                <tr>
                                    <td>@row.Code</td>
                                    <td>@row.Name</td>
                                    <td>@row.Nature</td>
                                    <td class="num">@row.Opening.ToString("N2")</td>
                                    <td class="num">@row.PeriodDebit.ToString("N2")</td>
                                    <td class="num">@row.PeriodCredit.ToString("N2")</td>
                                    <td class="num" style="font-weight:600">@row.Closing.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="num">TOTAL</td>
                                <td class="num">@Rows.Sum(r => r.Opening).ToString("N2")</td>
                                <td class="num">@Rows.Sum(r => r.PeriodDebit).ToString("N2")</td>
                                <td class="num">@Rows.Sum(r => r.PeriodCredit).ToString("N2")</td>
                                <td class="num">@Rows.Sum(r => r.Closing).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="acc-note">
                    NOTE: BALANCE SHEET (ASSET / LIABILITY / EQUITY) ACCOUNTS SHOW ALL POSTED HISTORY AS OPENING. PROFIT &amp; LOSS ACCOUNTS OPEN FROM THE START OF THE FISCAL YEAR. SIGN IS +DR / -CR.
                </div>
            }
            else
            {
                <div class="text-center p-4" style="color: #616161;">
                    No entries found for the selected filters.
                </div>
            }
        }
    </RadzenCard>
</RadzenContent>