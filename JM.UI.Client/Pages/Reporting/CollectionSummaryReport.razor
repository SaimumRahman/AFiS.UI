@page "/CollectionSummaryReport"
@using JM.UI.Entities.Model.Reporting_D
@using JM.UI.Entities.Model.Stores
@attribute [Authorize]
@inherits CollectionSummaryReportComponent

<PageTitle>Collection Summary</PageTitle>

<style>
    .cs-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: 0 1px 3px rgba(15,23,42,.08); padding: 1.25rem 1.5rem; margin-bottom: 1.25rem; }
    .cs-head { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: .9rem; margin-bottom: 1rem; }
    .cs-title { font-size: 1.45rem; font-weight: 700; color: #0f172a; }
    .cs-sub { font-size: .82rem; color: #64748b; margin-top: .25rem; }
    .cs-sub b { color: #334155; }
    .cs-head-right { text-align: left; font-size: .82rem; color: #475569; }
    .cs-filters { display: flex; flex-wrap: wrap; gap: .75rem; align-items: flex-end; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: .85rem; }
    .cs-field { flex: 0 0 150px; min-width: 150px; }
    .cs-field.cs-wide { flex: 0 0 180px; min-width: 180px; }
    .cs-field label { display: block; font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #64748b; margin-bottom: .25rem; }
    .cs-field .rz-datepicker-input, .cs-field .rz-dropdown, .cs-field .rz-textbox { height: 2.35rem; min-height: 2.35rem; border-radius: 6px; font-size: .85rem; }
    .cs-ribbon { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .75rem; margin-bottom: 1.25rem; }
    .cs-kpi { border: 1px solid #e2e8f0; border-radius: 8px; padding: .75rem .9rem; background: #fff; box-shadow: 0 1px 2px rgba(15,23,42,.06); }
    .cs-kpi .lbl { font-size: .64rem; text-transform: uppercase; letter-spacing: .06em; color: #64748b; font-weight: 700; }
    .cs-kpi .val { font-size: 1.15rem; font-weight: 700; color: #0f172a; margin-top: .15rem; }
    .cs-kpi.grand { background: #ecfdf5; border-color: #a7f3d0; }
    .cs-kpi.grand .val { color: #047857; }
    .cs-wrap { overflow-x: auto; }
    .cs-table { width: 100%; border-collapse: collapse; font-size: .76rem; min-width: 900px; }
    .cs-table th, .cs-table td { border: 1px solid #e5e7eb; padding: .32rem .45rem; vertical-align: top; }
    .cs-table th { background: #f9fafb; font-weight: 700; font-size: .66rem; text-transform: uppercase; letter-spacing: .04em; color: #6b7280; text-align: center; white-space: nowrap; }
    .cs-table td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .cs-table td.center { text-align: center; white-space: nowrap; }
    .cs-inv { font-weight: 700; color: #2563eb; display: block; font-size: .78rem; }
    .cs-bk { font-weight: 700; color: #0d9488; display: block; font-size: .78rem; }
    .cs-muted { color: #6b7280; }
    .cs-chip { display: inline-block; margin-left: .25rem; font-size: .68rem; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 4px; padding: 0 .25rem; }
    .cs-pay { font-size: .68rem; display: flex; justify-content: space-between; gap: .4rem; background: #f1f5f9; border-radius: 4px; padding: 0 .3rem; margin-top: .15rem; }
    .cs-pay.mfs { background: #f0fdf4; color: #15803d; }
    .cs-pay.bank { background: #eff6ff; color: #1d4ed8; }
    .cs-total td { background: #f1f5f9; font-weight: 700; }
    .cs-empty { text-align: center; color: #94a3b8; padding: 1.5rem; }
    .cs-chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .5rem; }
    .cs-chip2 { display: inline-flex; align-items: center; gap: .35rem; background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; padding: .25rem .5rem; font-size: .72rem; }
</style>

<RadzenContent Container="main" class="p-4">
    <div class="cs-card">
        <div class="cs-head">
            <div>
                <div class="cs-title">Collection Summary</div>
                <div class="cs-sub">System: AFiS WebAPP &nbsp;|&nbsp; Branch: <b>@SelectedStoreName</b></div>
            </div>
            <div class="cs-head-right">
                <div><b>Print Date:</b> @DateTime.Now.ToString("dd MMM yyyy")</div>
                <div><b>Generated By:</b> @CurrentUserName</div>
                <div style="margin-top:.4rem;">
                    <RadzenButton Icon="picture_as_pdf" Text="Download PDF"
                                  ButtonStyle="ButtonStyle.Success" Click="PrintReport" IsBusy="@IsPrinting" />
                </div>
            </div>
        </div>

        <div class="cs-filters">
            <div class="cs-field">
                <label>Date From</label>
                <RadzenDatePicker @bind-Value="FromDate" AllowClear="false" DateFormat="dd/MM/yyyy" Style="width:100%" />
            </div>
            <div class="cs-field">
                <label>Date To</label>
                <RadzenDatePicker @bind-Value="ToDate" AllowClear="false" DateFormat="dd/MM/yyyy" Style="width:100%" />
            </div>

            @if (CanSelectAnyStore)
            {
                <div class="cs-field cs-wide">
                    <label>Branch</label>
                    <RadzenDropDown @bind-Value="SelectedStoreId"
                                    TValue="int?"
                                    Data="@Stores"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    AllowClear="false"
                                    Style="width:100%" />
                </div>
            }

            <div class="cs-field cs-wide">
                <label>Type</label>
                <RadzenDropDown @bind-Value="SelectedSourceType" TValue="string"
                                Data="@SourceTypes" Style="width:100%" />
            </div>

            <div class="cs-field cs-wide">
                <label>Payment Mode</label>
                <RadzenDropDown @bind-Value="SelectedChannel" TValue="string"
                                Data="@(new[] { "ALL" }.Concat(Report.Channels).ToList())" Style="width:100%" />
            </div>

            <div class="cs-field cs-wide">
                <label>Search</label>
                <RadzenTextBox @bind-Value="SearchText" Placeholder="Invoice / Cashier / Account / TrxID" Style="width:100%" />
            </div>

            <div class="cs-field" style="flex:0 0 120px; min-width:120px;">
                <label>View</label>
                <RadzenSwitch @bind-Value="ShowDetails" />
                <span style="font-size:.75rem; margin-left:.35rem;">@(ShowDetails ? "Details" : "Summary")</span>
            </div>

            <div style="display:flex; gap:.5rem; padding-bottom:1px;">
                <RadzenButton Icon="search" Text="Generate" ButtonStyle="ButtonStyle.Primary" Click="Generate" IsBusy="@IsLoading" />
                <RadzenButton Icon="filter_alt_off" Text="Clear" ButtonStyle="ButtonStyle.Light" Click="ClearFilters" />
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="cs-card"><RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" /></div>
    }
    else if (!HasGenerated)
    {
        <div class="cs-card"><div class="cs-empty">Choose the filters and press Generate.</div></div>
    }
    else
    {
        <!-- KPI ribbon -->
        <div class="cs-ribbon">
            <div class="cs-kpi grand">
                <div class="lbl">Total NET Paid (@TotalCount Bills)</div>
                <div class="val">@Money(TotalNet)</div>
            </div>
            @foreach (var ch in Report.Channels)
            {
                <div class="cs-kpi">
                    <div class="lbl">@ch Total</div>
                    <div class="val">@Money(ChannelTotal(ch))</div>
                </div>
            }
            <div class="cs-kpi">
                <div class="lbl">Physical (Cash+MFS+Bank)</div>
                <div class="val">@Money(TotalPhysical)</div>
            </div>
        </div>

        <!-- Main table -->
        <div class="cs-card">
            <div class="cs-wrap">
                <table class="cs-table">
                    <thead>
                        <tr>
                            <th style="width:2rem;">#</th>
                            <th style="width:9rem;">Date &amp; Time</th>
                            <th style="width:4.5rem;">Branch</th>
                            <th style="width:7rem;">Type</th>
                            <th style="width:10rem;">Invoice / Ref No</th>
                            <th style="width:8rem;">Cashier</th>
                            <th style="width:7rem;">NET Paid</th>
                            @foreach (var ch in Report.Channels)
                            {
                                <th style="width:7rem;">@ch</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Report.Rows.Any())
                        {
                            <tr><td colspan="@(7 + Report.Channels.Count)" class="cs-empty">No collections match the selected filters.</td></tr>
                        }
                        else
                        {
                            int idx = 0;
                            foreach (var row in Report.Rows)
                            {
                                idx++;
                                var isExpanded = ExpandedIds.Contains(row.RefId);
                                <tr @onclick="() => ToggleRow(row.RefId)" style="cursor:pointer;">
                                    <td class="center">@(idx)</td>
                                    <td class="center">
                                        <span class="cs-muted">@row.CreatedDate.ToString("dd MMM yyyy")</span><br />
                                        <span class="cs-muted">@row.CreatedDate.ToString("HH:mm")</span>
                                    </td>
                                    <td class="center"><span class="cs-chip">@row.StoreCode</span></td>
                                    <td class="center">
                                        <span class="cs-chip">@row.SourceType</span>
                                    </td>
                                    <td>
                                        @if (row.IsBooking)
                                        {
                                            <span class="cs-bk">@row.RefNo</span>
                                        }
                                        else
                                        {
                                            <span class="cs-inv">@row.RefNo</span>
                                        }
                                    </td>
                                    <td>@row.Cashier</td>
                                    <td class="num" style="font-weight:700;">@Money(row.NetPaid)</td>
                                    @foreach (var ch in Report.Channels)
                                    {
                                        var chPays = row.Payments.Where(p => p.Channel == ch).ToList();
                                        <td class="num">
                                            @if (!chPays.Any())
                                            {
                                                <span class="cs-muted">—</span>
                                            }
                                            else if (!ShowDetails)
                                            {
                                                <span style="font-weight:600;">@Money(chPays.Sum(p => p.Amount))</span>
                                            }
                                            else
                                            {
                                                <div style="display:flex; flex-direction:column; align-items:flex-end; gap:.15rem;">
                                                    @foreach (var p in chPays)
                                                    {
                                                        <span style="font-size:.68rem;"><b>@p.AccountName</b> @Money(p.Amount)</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>

                                @if (isExpanded)
                                {
                                    <tr style="background:#eff6ff;">
                                        <td colspan="@(7 + Report.Channels.Count)" style="padding:.5rem 1rem;">
                                            <div style="font-size:.72rem; font-weight:700; color:#1e3a8a; margin-bottom:.35rem;">Receipt Split Details (@row.RefNo):</div>
                                            <div class="cs-chips">
                                                @foreach (var p in row.Payments)
                                                {
                                                    <span class="cs-chip2">
                                                        <b>@p.AccountName</b>
                                                        <span style="color:#6b7280;">|</span>
                                                        <span style="font-weight:700; color:#2563eb;">@Money(p.Amount)</span>
                                                        <span style="color:#6b7280;">|</span>
                                                        <span style="font-family:monospace; font-size:.66rem; color:#6b7280;">Ref: @(string.IsNullOrWhiteSpace(p.TrxId) ? "-" : p.TrxId)</span>
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="cs-total">
                            <td colspan="6" style="text-align:right;">Total Collection (@TotalCount Bills):</td>
                            <td class="num">@Money(TotalNet)</td>
                            @foreach (var ch in Report.Channels)
                            {
                                <td class="num">@Money(ChannelTotal(ch))</td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (ShowDetails)
            {
                <div style="margin-top:.75rem; padding:.6rem .75rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px;">
                    <div style="font-size:.72rem; font-weight:700; color:#1e3a8a; margin-bottom:.4rem;">Account-Wise Collection Totals:</div>
                    <div class="cs-chips">
                        @foreach (var acc in AllPayments.Select(p => p.AccountName).Distinct().OrderBy(a => a))
                        {
                            <span class="cs-chip2">
                                <span style="font-weight:600;">@acc</span>
                                <span style="color:#6b7280;">–</span>
                                <span style="font-weight:700; color:#2563eb;">@Money(AllPayments.Where(p => p.AccountName == acc).Sum(p => p.Amount))</span>
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</RadzenContent>