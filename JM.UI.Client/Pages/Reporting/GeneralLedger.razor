@page "/AccountingGeneralLedger"
@using JM.UI.Entities.Model.Reporting_D
@using JM.UIWeb.CustomBase
@attribute [Authorize]
@inherits AccountingGeneralLedgerComponent

<PageTitle>General Ledger</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="receipt_long" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">General Ledger</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="flex-wrap: wrap;">
                    <RadzenDatePicker @bind-Value="FromDate"
                                      AllowClear="true"
                                      Placeholder="From Date"
                                      Style="width: 150px" />
                    <RadzenDatePicker @bind-Value="ToDate"
                                      AllowClear="true"
                                      Placeholder="To Date"
                                      Style="width: 150px" />
                    <RadzenDropDown @bind-Value="SelectedBranchCode"
                                    Data="@AccountingReportOptions.BranchCodes"
                                    AllowClear="true"
                                    ClearValue="null"
                                    Placeholder="All Branches"
                                    Style="width: 160px" />
                    <RadzenButton Icon="refresh"
                                  Text="Load"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="LoadReport" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenCard>
        @if (IsLoading)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        }
        else
        {
            <RadzenDataGrid @ref="ReportGrid"
                            Data="@Rows"
                            TItem="GeneralLedgerDTO"
                            AllowFiltering="true"
                            AllowColumnResize="true"
                            AllowAlternatingRows="true"
                            AllowPaging="true"
                            AllowSorting="true"
                            PageSize="25"
                            PageSizeOptions="@(new int[] { 25, 50, 100 })"
                            FilterMode="FilterMode.Advanced"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="@("Displaying page {0} of {1} (total {2} records)")"
                            IsLoading="@IsLoading"
                            GridLines="DataGridGridLines.Both"
                            Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="EntryDate" Title="Date" Width="110px">
                        <Template Context="r">@r.EntryDate.ToString("dd-MMM-yy")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="VoucherTypeCode" Title="Type" Width="70px" />
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="VoucherNo" Title="Voucher No" Width="90px" />
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="LineNo" Title="#">
                        <Template Context="r">@r.LineNo</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="AccountCode" Title="Account Code" Width="110px" />
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="AccountName" Title="Account Name" Width="240px" />
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="PartyCode" Title="Party Code" Width="100px" />
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="PartyName" Title="Party Name" Width="200px" />
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="Debit" Title="Debit">
                        <Template Context="r">@r.Debit.ToString("N2")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="Credit" Title="Credit">
                        <Template Context="r">@r.Credit.ToString("N2")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="Net" Title="Net">
                        <Template Context="r">
                            <span style="@(r.Net < 0 ? "color:var(--rz-danger);font-weight:600" : "color:var(--rz-success);font-weight:600")">
                                @r.Net.ToString("N2")
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="Narration" Title="Narration" Width="220px" />
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="Memo" Title="Memo" Width="200px" />
                    <RadzenDataGridColumn TItem="GeneralLedgerDTO" Property="Status" Title="Status" Width="90px" />
                </Columns>
                <FooterTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Style="width:100%;font-weight:600">
                        <span>Total Lines: @Rows.Count</span>
                        <span>Total Debit: @Rows.Sum(r => r.Debit).ToString("N2")</span>
                        <span>Total Credit: @Rows.Sum(r => r.Credit).ToString("N2")</span>
                        <span>Net: @Rows.Sum(r => r.Net).ToString("N2")</span>
                    </RadzenStack>
                </FooterTemplate>
            </RadzenDataGrid>
        }
    </RadzenCard>
</RadzenContent>