@page "/StockLedger"
@using JM.UI.Entities.Model.Stock
@attribute [Authorize]
@inherits StockLedgerComponent

<PageTitle>Stock Ledger</PageTitle>

<style>
    .sl-item-name {
        font-weight: 600;
        white-space: normal;
        line-height: 1.35;
    }

    .sl-item-meta {
        margin-top: 2px;
        font-size: 11px;
        font-weight: 600;
        color: #198754;
        white-space: normal;
        line-height: 1.3;
    }

    /* Column band headers */
    .sl-band {
        display: block;
        padding: 2px 6px;
        border-radius: 4px;
        text-align: center;
        font-weight: 700;
        font-size: 12px;
        white-space: normal;
    }

    .sl-band-ho {
        background: #d1e7dd;
        color: #0f5132;
    }

    .sl-band-branch {
        background: #e9ecef;
        color: var(--rz-text-color);
    }

    .sl-band-total {
        background: #fff3cd;
        color: #664d03;
    }

    /* Grand-total data cells */
    .sl-total-cell {
        display: block;
        background: #fff8e1;
        color: #856404;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 3px;
    }

    .sl-cell-negative {
        color: var(--rz-danger);
        font-weight: 700;
    }
</style>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="inventory" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Stock Ledger</RadzenText>
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenDatePicker @bind-Value="FromDate" Placeholder="From Date" DateFormat="dd/MM/yyyy" Style="width:140px;" />
                    <RadzenDatePicker @bind-Value="ToDate" Placeholder="To Date" DateFormat="dd/MM/yyyy" Style="width:140px;" />
                    <RadzenDropDown Data="@StoreList"
                                    @bind-Value="SelectedStoreId"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    Placeholder="All Stores"
                                    AllowClear="@CanSelectAnyStore"
                                    Disabled="@IsStoreDropdownDisabled"
                                    Style="width:150px;" />
                    <RadzenButton Icon="search"
                                  Text="Search"
                                  Click="@LoadStockLedger"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Medium" />
                    <RadzenButton Icon="clear"
                                  Text="Clear"
                                  Click="@ClearFilters"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Medium" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        @* Item attribute filters. Leave a dropdown blank to include everything. *@
        <RadzenRow Gap="1rem" Style="margin-top:1rem;">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Group" Component="GroupFilter" />
                    <RadzenDropDown Data="@Groups"
                                    @bind-Value="SelectedGroupId"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    Placeholder="All Groups"
                                    AllowClear="true"
                                    Change="@(args => OnGroupChanged(args as int?))"
                                    Style="width:100%;" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Sub Group" Component="SubGroupFilter" />
                    <RadzenDropDown Data="@FilteredSubGroups"
                                    @bind-Value="SelectedSubGroupId"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    Placeholder="All Sub Groups"
                                    AllowClear="true"
                                    Change="@(args => OnSubGroupChanged(args as int?))"
                                    Style="width:100%;" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Design" Component="DesignFilter" />
                    <RadzenDropDown Data="@FilteredDesigns"
                                    @bind-Value="SelectedDesignId"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    Placeholder="All Designs"
                                    AllowClear="true"
                                    Change="@(args => OnDesignChanged(args as int?))"
                                    Style="width:100%;" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Brand" Component="BrandFilter" />
                    <RadzenDropDown Data="@Brands"
                                    @bind-Value="SelectedBrandId"
                                    TextProperty="BrandName"
                                    ValueProperty="BrandId"
                                    Placeholder="All Brands"
                                    AllowClear="true"
                                    Change="@(args => OnBrandChanged(args as int?))"
                                    Style="width:100%;" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenCard>
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="mb-2">
            <RadzenColumn Size="12" SizeMD="7">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="table_chart" Style="color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H6" class="mb-0">Consolidated Branch Stock Report</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="mb-0">
                        Opening / Receive / Issue / Balance per branch
                    </RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="5">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenBadge Text="@($"{PivotItemCount} item(s)")" BadgeStyle="BadgeStyle.Light" />
                    <RadzenBadge Text="@($"{StoreGroups.Count} branch(es)")" BadgeStyle="BadgeStyle.Secondary" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenDataGrid @ref="StockLedgerGrid"
                        Data="@PivotRows"
                        TItem="StockLedgerPivotRow"
                        AllowSorting="true"
                        AllowPaging="true"
                        AllowAlternatingRows="true"
                        PageSize="25"
                        PageSizeOptions="@(new int[] { 10, 25, 50, 100 })"
                        ShowPagingSummary="true"
                        PagingSummaryFormat="@("Displaying page {0} of {1} (total {2} records)")"
                        Density="Density.Compact"
                        GridLines="DataGridGridLines.Both"
                        IsLoading="@IsLoading"
                        EmptyText="No stock ledger entries for the selected filters.">
            <Columns>
                <RadzenDataGridColumn TItem="StockLedgerPivotRow"
                                      Property="@nameof(StockLedgerPivotRow.Barcode)"
                                      Title="Barcode"
                                      Width="120px"
                                      Frozen="true">
                    <Template Context="row">
                        <span style="cursor:pointer;" @onclick="@(() => OpenItemDetails(row))">
                            <RadzenBadge Text="@row.Barcode" BadgeStyle="BadgeStyle.Light" />
                        </span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="StockLedgerPivotRow"
                                      Property="@nameof(StockLedgerPivotRow.ItemName)"
                                      Title="Item Name"
                                      Width="300px"
                                      Frozen="true">
                    <Template Context="row">
                        <div class="sl-item-name">@row.ItemName</div>
                        @if (row.HasMeta)
                        {
                            <div class="sl-item-meta">@row.MetaText</div>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="StockLedgerPivotRow"
                                      Property="@nameof(StockLedgerPivotRow.SalePrice)"
                                      Title="Sale Price"
                                      Width="110px"
                                      TextAlign="TextAlign.Right"
                                      FormatString="৳ {0:N2}" />

                @* One banded header per branch, each holding Opn / Rec / Iss / Bal. *@
                @foreach (var store in StoreGroups)
                {
                    <RadzenDataGridColumn TItem="StockLedgerPivotRow"
                                          Title="@store.StoreName"
                                          Width="340px"
                                          Sortable="false"
                                          Filterable="false">
                        <HeaderTemplate>
                            <div class="sl-band @(store.IsHeadOffice ? "sl-band-ho" : "sl-band-branch")">
                                @store.StoreName
                            </div>
                        </HeaderTemplate>
                        <Columns>
                            <RadzenDataGridColumn TItem="StockLedgerPivotRow" Title="Opn" Width="85px"
                                                  TextAlign="TextAlign.Right" Sortable="false" Filterable="false">
                                <Template Context="row">@Qty(row.GetCell(store.StoreName).OpeningStock)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="StockLedgerPivotRow" Title="Rec" Width="85px"
                                                  TextAlign="TextAlign.Right" Sortable="false" Filterable="false">
                                <Template Context="row">@Qty(row.GetCell(store.StoreName).ReceiveQty)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="StockLedgerPivotRow" Title="Iss" Width="85px"
                                                  TextAlign="TextAlign.Right" Sortable="false" Filterable="false">
                                <Template Context="row">@Qty(row.GetCell(store.StoreName).IssueQty)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="StockLedgerPivotRow" Title="Bal" Width="85px"
                                                  TextAlign="TextAlign.Right" Sortable="false" Filterable="false">
                                <Template Context="row">
                                    <span class="@(row.GetCell(store.StoreName).ClosingStock < 0 ? "sl-cell-negative" : "")"
                                          style="font-weight:700;">
                                        @Qty(row.GetCell(store.StoreName).ClosingStock)
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGridColumn>
                }

                @* Grand total across every branch. *@
                <RadzenDataGridColumn TItem="StockLedgerPivotRow"
                                      Title="Grand Total"
                                      Width="340px"
                                      Sortable="false"
                                      Filterable="false">
                    <HeaderTemplate>
                        <div class="sl-band sl-band-total">Grand Total</div>
                    </HeaderTemplate>
                    <Columns>
                        <RadzenDataGridColumn TItem="StockLedgerPivotRow"
                                              Property="@nameof(StockLedgerPivotRow.TotalOpening)"
                                              Title="Opn" Width="85px" TextAlign="TextAlign.Right">
                            <Template Context="row"><span class="sl-total-cell">@Qty(row.TotalOpening)</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="StockLedgerPivotRow"
                                              Property="@nameof(StockLedgerPivotRow.TotalReceive)"
                                              Title="Rec" Width="85px" TextAlign="TextAlign.Right">
                            <Template Context="row"><span class="sl-total-cell">@Qty(row.TotalReceive)</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="StockLedgerPivotRow"
                                              Property="@nameof(StockLedgerPivotRow.TotalIssue)"
                                              Title="Iss" Width="85px" TextAlign="TextAlign.Right">
                            <Template Context="row"><span class="sl-total-cell">@Qty(row.TotalIssue)</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="StockLedgerPivotRow"
                                              Property="@nameof(StockLedgerPivotRow.TotalClosing)"
                                              Title="Bal" Width="85px" TextAlign="TextAlign.Right">
                            <Template Context="row">
                                <span class="sl-total-cell @(row.TotalClosing < 0 ? "sl-cell-negative" : "")">
                                    @Qty(row.TotalClosing)
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenContent>

