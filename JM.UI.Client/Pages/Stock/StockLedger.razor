@page "/StockLedger"
@using JM.UI.Entities.Model.Stock
@attribute [Authorize]
@inherits StockLedgerComponent

<PageTitle>Stock Ledger</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="inventory" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Stock Ledger</RadzenText>
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenDatePicker @bind-Value="FromDate" Placeholder="From Date" DateFormat="dd/MM/yyyy" Style="width:140px;" />
                    <RadzenDatePicker @bind-Value="ToDate" Placeholder="To Date" DateFormat="dd/MM/yyyy" Style="width:140px;" />
                    <RadzenDropDown Data="@StoreList"
                                    @bind-Value="SelectedStoreId"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    Placeholder="All Stores"
                                    AllowClear="@CanSelectAnyStore"
                                    Disabled="@IsStoreDropdownDisabled"
                                    Style="width:150px;" />
                    <RadzenButton Icon="search"
                                  Text="Search"
                                  Click="@LoadStockLedger"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Medium" />
                    <RadzenButton Icon="clear"
                                  Text="Clear"
                                  Click="@ClearFilters"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Medium" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        @* Item attribute filters. Leave a dropdown blank to include everything. *@
        <RadzenRow Gap="1rem" Style="margin-top:1rem;">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Group" Component="GroupFilter" />
                    <RadzenDropDown Data="@Groups"
                                    @bind-Value="SelectedGroupId"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    Placeholder="All Groups"
                                    AllowClear="true"
                                    Change="@(args => OnGroupChanged(args as int?))"
                                    Style="width:100%;" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Sub Group" Component="SubGroupFilter" />
                    <RadzenDropDown Data="@FilteredSubGroups"
                                    @bind-Value="SelectedSubGroupId"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    Placeholder="All Sub Groups"
                                    AllowClear="true"
                                    Change="@(args => OnSubGroupChanged(args as int?))"
                                    Style="width:100%;" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Design" Component="DesignFilter" />
                    <RadzenDropDown Data="@FilteredDesigns"
                                    @bind-Value="SelectedDesignId"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    Placeholder="All Designs"
                                    AllowClear="true"
                                    Change="@(args => OnDesignChanged(args as int?))"
                                    Style="width:100%;" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Brand" Component="BrandFilter" />
                    <RadzenDropDown Data="@Brands"
                                    @bind-Value="SelectedBrandId"
                                    TextProperty="BrandName"
                                    ValueProperty="BrandId"
                                    Placeholder="All Brands"
                                    AllowClear="true"
                                    Change="@(args => OnBrandChanged(args as int?))"
                                    Style="width:100%;" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenCard>
        <RadzenDataGrid @ref="StockLedgerGrid"
                        Data="@StockLedgerList"
                        TItem="StockLedgerDTO"
                        AllowFiltering="true"
                        AllowColumnResize="true"
                        AllowAlternatingRows="true"
                        AllowPaging="true"
                        AllowSorting="true"
                        PagerHorizontalAlign="HorizontalAlign.Center"
                        PageSize="15"
                        FilterMode="FilterMode.Advanced"
                        ShowPagingSummary="true"
                        IsLoading="@IsLoading"
                        GridLines="DataGridGridLines.Both"
                        Density="Density.Compact">
            <Columns>
               @*  <RadzenDataGridColumn TItem="StockLedgerDTO" Property="LastTransactionDate" Title="Date" /> *@
                <RadzenDataGridColumn TItem="StockLedgerDTO" Property="StoreName" Title="Store" />
                <RadzenDataGridColumn TItem="StockLedgerDTO" Property="ItemCode" Title="Item Code"  />
                <RadzenDataGridColumn TItem="StockLedgerDTO" Property="ItemName" Width="450px" Title="Item Name" />
                <RadzenDataGridColumn TItem="StockLedgerDTO" Property="GroupName" Title="Group" Width="140px" />
                <RadzenDataGridColumn TItem="StockLedgerDTO" Property="SubGroupName" Title="Sub Group" Width="140px" />
                <RadzenDataGridColumn TItem="StockLedgerDTO" Property="DesignName" Title="Design" Width="140px" />
                <RadzenDataGridColumn TItem="StockLedgerDTO" Property="BrandName" Title="Brand" Width="140px" />
                <RadzenDataGridColumn TItem="StockLedgerDTO" Property="OpeningStock" Title="Opening Stock" FormatString="{0:N2}" />
                <RadzenDataGridColumn TItem="StockLedgerDTO" Property="ReceiveQty" Title="Receive Qty" FormatString="{0:N2}" />
                <RadzenDataGridColumn TItem="StockLedgerDTO" Property="IssueQty" Title="Issue Qty" FormatString="{0:N2}" />
                <RadzenDataGridColumn TItem="StockLedgerDTO" Property="ClosingStock" Title="Closing Stock" FormatString="{0:N2}">
                    <Template Context="row">
                        <span style="font-weight:600; color: @(row.ClosingStock < 0 ? "red" : "inherit")">
                            @row.ClosingStock.ToString("N2")
                        </span>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenContent>
