@page "/ColorsList"
@using JM.UI.Entities.Model.Colors
@attribute [Authorize]
@inherits ColorsListComponent

<PageTitle>Colors</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="palette" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Colors Management</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Icon="add_circle_outline"
                                  Text="Add New Color"
                                  Click="@(args => NavigationManager.NavigateTo("/ColorsAdd"))"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Medium" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @if (IsLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <RadzenCard>
            <RadzenDataGrid @ref="ColorssGrid" 
                            Data="@Colorss" 
                            TItem="ColorsDTO" 
                            AllowFiltering="true" 
                            AllowColumnResize="true"
                            AllowAlternatingRows="true"
                            AllowPaging="true" 
                            AllowSorting="true"
                            PagerHorizontalAlign="HorizontalAlign.Center"
                            PageSize="10"
                            PageSizeOptions="@(new int[] { 5, 10, 20, 50 })"
                            FilterMode="FilterMode.Advanced"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="@("Displaying page {0} of {1} (total {2} records)")"
                            IsLoading="@IsLoading"
                            GridLines="DataGridGridLines.Both"
                            Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="ColorsDTO" Property="Id" Visible="false" Title="ID" Frozen="true" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="ColorsDTO" Title="Color">
                        <Template Context="color">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">

                                <div style="
                                width: 30px;
                                height: 30px;
                                background-color:@(string.IsNullOrWhiteSpace(color.ColorCode) ? "#ffffff" : color.ColorCode);
                                border-radius: 6px;
                                border: 1px solid #ccc;">
                                </div>

                                 <span>@color.Name</span> 

                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="ColorsDTO" Title="Actions" Width="120px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                        <Template Context="color">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                                <RadzenButton Icon="edit" 
                                              ButtonStyle="ButtonStyle.Info" 
                                              Size="ButtonSize.Small" 
                                              Variant="Variant.Flat"
                                              Click="@(args => EditColors(color))" 
                                              MouseEnter="@(args => TooltipService.Open(args, "Edit Color"))" />
                                <RadzenButton Icon="delete" 
                                              ButtonStyle="ButtonStyle.Danger" 
                                              Size="ButtonSize.Small" 
                                              Variant="Variant.Flat"
                                              Click="@(args => DeleteColors(color))" 
                                              MouseEnter="@(args => TooltipService.Open(args, "Delete Color"))" />
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
</RadzenContent>