@page "/GroupRoleAdd"
@page "/GroupRoleAdd/{Id:int}"
@using JM.UI.Entities.Model.GroupRole
@inherits GroupRoleAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading group role...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header Card -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@Cancel"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="@PageIcon" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                        @if (IsEditMode)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"#{GroupRole.GroupId}")" />
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="@(IsEditMode ? "Reset Changes" : "Reset")"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Form Card -->
        <RadzenCard>
            <RadzenTemplateForm TItem="GroupRoleDTO" Data="@GroupRole" Submit="@Save">
                <RadzenStack Gap="1.5rem">
                    <!-- Group Role Information Section -->
                    <RadzenFieldset Text="Group Role Information" Icon="group">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Group Name *" Component="GroupName" />
                                        <RadzenTextBox @bind-Value="GroupRole.GroupName"
                                                       Name="GroupName"
                                                       Placeholder="Enter group name"
                                                       Style="width: 100%;"
                                                       MaxLength="100" />
                                        <RadzenRequiredValidator Component="GroupName" Text="Group name is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Is System Group" Component="IsSystem" />
                                        <RadzenCheckBox @bind-Value="GroupRole.IsSystem"
                                                        Name="IsSystem" />
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-info-darker">
                                            Check if this is a system-defined group
                                        </RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Description" Component="Description" />
                                        <RadzenTextArea @bind-Value="GroupRole.Description"
                                                        Name="Description"
                                                        Placeholder="Enter group description"
                                                        Style="width: 100%;"
                                                        Rows="3"
                                                        MaxLength="250" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Metadata Section (Only in Edit Mode) -->
                    @if (IsEditMode)
                    {
                        <RadzenFieldset Text="Metadata" Icon="info">
                            <RadzenStack Gap="1rem">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Created Date" />
                                            <RadzenTextBox Value="@GroupRole.CreatedAt.ToString("dd MMM yyyy HH:mm")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenFieldset>
                    }

                    <!-- Action Buttons -->
                    <RadzenCard class="mt-2">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat"
                                          Click="@Cancel"
                                          Disabled="@IsProcessing" />
                            @if (!IsEditMode)
                            {
                                <RadzenButton Text="Save & Add New"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Click="@SaveAndNew"
                                              IsBusy="@IsProcessing"
                                              Disabled="@IsProcessing" />
                            }
                            <RadzenButton Text="@(IsEditMode ? "Update" : "Save")"
                                          Icon="@(IsEditMode ? "update" : "save")"
                                          ButtonStyle="ButtonStyle.Primary"
                                          ButtonType="ButtonType.Submit"
                                          IsBusy="@IsProcessing"
                                          BusyText="@(IsEditMode ? "Updating..." : "Saving...")" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenContent>