<div style="text-align:center; padding:0.5rem;">
    <img src="@ImageBase64"
         alt="@ItemName"
         style="max-width:100%; max-height:70vh; object-fit:contain; border-radius:6px;" />
</div>

@code {
    [Parameter] public string ImageBase64 { get; set; } = string.Empty;
    [Parameter] public string ItemName { get; set; } = string.Empty;
}