@page "/AlertDialog"
@using JM.UIWeb.Pages.Dialog
@attribute [Authorize]
@inherits AlertDialogComponent

<style>
    .rz-dialog-titlebar {
        background-color: #7a1818db;
        padding: 0.6875rem 1.25rem;
        font-size: 1.50rem;
        line-height: 1.875rem;
        border-bottom: none;
    }

    .rz-dialog {
        background-color: #ffffffe0
    }
</style>

<div class="col-xl-12 col-lg-12 col-md-12 col-sm-12" runat="server" id="New">

    <div class="form-row">
        <div class="col-sm-12">
            <div class="form-group row gutters" style="text-align:center; font-size:larger; color:#000104">
                @Messages
            </div>
        </div>
    </div>

</div>




