@namespace JM.UI.Client.Pages.Dialog.Discount
@using JM.UI.Entities.Model.Discount
@inject DialogService DialogService

<style>
    .ccd-wrap { display: flex; flex-direction: column; gap: 14px; }
    .ccd-list { display: flex; flex-direction: column; gap: 8px; max-height: 320px; overflow-y: auto; padding-right: 4px; }
    .ccd-block {
        background: #fff7ed;
        border: 1px solid #f3ddb7;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 13px;
        line-height: 1.6;
        color: #212529;
    }
    .ccd-line { display: block; }
    .ccd-headline { font-weight: 700; font-size: 14px; color: #1f2937; }
    .ccd-campaign { font-weight: 700; color: #8a5a11; }
    .ccd-context { font-size: 11.5px; color: #6c7480; margin-top: 4px; }
    .ccd-note {
        background: #eef2f7;
        border: 1px solid #dbe2ec;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 12.5px;
        color: #33415c;
    }
    .ccd-actions { display: flex; justify-content: flex-end; gap: 8px; }
</style>

<div class="ccd-wrap">
    <div class="ccd-list">
        @foreach (var c in Conflicts)
        {
            <div class="ccd-block">
                <span class="ccd-line">
                    This item is already on
                    <span class="ccd-campaign">@c.DiscountName</span>
                    - @c.DiscountText
                    - @c.StartDate.ToString("dd MMM yyyy")
                    - @c.EndDate.ToString("dd MMM yyyy")
                </span>
                @if (!string.IsNullOrWhiteSpace(c.ItemName) || !string.IsNullOrWhiteSpace(c.StoreName))
                {
                    <span class="ccd-line ccd-context">
                        @c.ItemName@(string.IsNullOrWhiteSpace(c.StoreName) ? "" : " · " + c.StoreName)
                    </span>
                }
            </div>
        }
    </div>

    <div class="ccd-headline">
        Do you want to add @(Conflicts.Count == 1 ? "this item" : "these items") to this campaign?
    </div>

    <div class="ccd-note">
        Note: system will delete the item from the
        <b>@string.Join(", ", Conflicts.Select(c => c.DiscountName).Distinct())</b>
        and add to this campaign.
    </div>

    <div class="ccd-actions">
        <RadzenButton Text="No" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
        <RadzenButton Text="Yes" ButtonStyle="ButtonStyle.Primary" Click="@(() => DialogService.Close(true))" />
    </div>
</div>

@code {
    [Parameter] public List<CampaignConflictDTO> Conflicts { get; set; } = new();
}
