@using JM.UI.Entities.Model.MesurementUnits
@using JM.UI.Entities.Model.SalesPOS
@using Radzen
@using Radzen.Blazor
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenCard>
    <RadzenStack Gap="1rem">
        <div>
            <div style="font-size:0.75rem;color:#666;margin-bottom:2px">Item</div>
            <div style="font-weight:600;font-size:1rem">@Product?.ProductName</div>
        </div>

        <div>
            <div style="font-size:0.75rem;color:#666;margin-bottom:2px">Unit</div>
            <div style="font-weight:600">@Product?.UomName</div>
        </div>

        <div>
            <div style="font-size:0.75rem;color:#666;margin-bottom:2px">Barcode</div>
            <div style="font-weight:600">@Product?.Barcode</div>
        </div>

        <div>
            <RadzenLabel Text="Sale Price" Component="UnitPrice" />
            <RadzenNumeric @bind-Value="UnitPrice" Min="@(Product?.UnitPrice ?? 0)" Max="999999" Step="0.01" Name="UnitPrice" Style="width:100%" ShowButtons="true" Change="@((decimal v) => OnUnitPriceChanged(v))" />
            <div style="font-size:0.75rem;color:#666;margin-top:2px">Loaded price @(Product?.UnitPrice.ToString("N2")) &mdash; can be raised, never lowered below it.</div>
        </div>

        <div>
            <div style="font-size:0.75rem;color:#666;margin-bottom:2px">Stock Available</div>
            <div style="font-weight:600;color:#28a745">@Product?.StockQuantity.ToString("N2")</div>
        </div>

        @if (Product?.HasDiscount == true && (Product?.Discount ?? 0) > 0)
        {
            <div>
                <div style="font-size:0.75rem;color:#666;margin-bottom:2px">Campaign Discount</div>
                <div style="font-weight:600;color:#c62828">
                    @(Product.DiscountTypeId == 2 ? Product.Discount.ToString("N2") : Product.Discount.ToString("N2") + "%")
                </div>
            </div>
        }

        @if (RemainingQty > 0)
        {
            <div>
                <div style="font-size:0.75rem;color:#666;margin-bottom:2px">Remaining Available</div>
                <div style="font-weight:600;color:#ff9800">@RemainingQty.ToString(QuantityFormat)</div>
            </div>
        }
        else
        {
            <div style="background:#fdecea;border:1px solid #f5c6cb;color:#c62828;padding:8px 10px;border-radius:6px;font-size:0.85rem">
                No stock remaining. @ExistingQty.ToString("N2") already in the cart.
            </div>
        }

        <div>
            <RadzenLabel Text="Quantity" Component="Qty" />
            <RadzenNumeric @ref="QtyInput" @bind-Value="Qty" Min="1" Max="@MaxQty" Step="@QuantityStep" Format="@QuantityFormat"
                           Name="Qty" Style="width:100%" ShowButtons="true" Change="@((decimal _) => OnQtyChanged())" />
            @if (!AllowsDecimal)
            {
                <div style="font-size:0.75rem;color:#666;margin-top:2px">@(Product?.UomName ?? "This unit") allows whole numbers only.</div>
            }
        </div>

        <div style="display:flex;gap:6px;justify-content:flex-end">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
            <RadzenButton Text="Add to Cart" ButtonStyle="ButtonStyle.Primary" Click="@Confirm" Disabled="@(Qty <= 0 || RemainingQty <= 0)" />
        </div>
    </RadzenStack>
</RadzenCard>

@code {
    public sealed class ItemQuantityDialogResult
    {
        public decimal Qty { get; set; }
        public decimal UnitPrice { get; set; }
    }

    [Parameter] public ProductSearchDTO Product { get; set; } = new();
    [Parameter] public decimal ExistingQty { get; set; }

    decimal Qty { get; set; } = 1;
    decimal UnitPrice { get; set; }
    decimal RemainingQty => Math.Max(0, (Product?.StockQuantity ?? 0) - ExistingQty);

    // Yards / Meter accept decimals; every other unit is whole numbers only.
    bool AllowsDecimal => UomRules.AllowsDecimalQuantity(Product?.UomName);
    decimal MaxQty => AllowsDecimal ? RemainingQty : Math.Floor(RemainingQty);
    string QuantityStep => UomRules.StepFor(AllowsDecimal);
    string QuantityFormat => UomRules.FormatFor(AllowsDecimal);

    // Quantity input, focused as soon as the dialog opens.
    RadzenNumeric<decimal> QtyInput = default!;
    bool _focusApplied;

    protected override void OnInitialized()
    {
        Qty = 1;
        UnitPrice = Product?.UnitPrice ?? 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_focusApplied)
        {
            _focusApplied = true;
            try
            {
                // The dialog's own post-render JS runs right after the first render;
                // yield briefly so the Quantity focus is the last one applied.
                await Task.Delay(50);
                await QtyInput.FocusAsync();
            }
            catch (Exception)
            {
                // Dialog may already be closing; focus is best-effort.
            }
        }
    }

    // The sale price may be raised, but never reduced below the loaded price.
    void OnUnitPriceChanged(decimal value)
    {
        var floor = Product?.UnitPrice ?? 0;
        if (value < floor)
        {
            UnitPrice = floor;
            NotificationService.Notify(NotificationSeverity.Warning, "Price Restriction",
                $"Sale price cannot be set below the loaded price ({floor:N2}).", 3000);
        }
    }

    // Whole-unit items: snap anything fractional back to a whole number.
    void OnQtyChanged()
    {
        var qty = Qty;
        if (UomRules.Normalize(AllowsDecimal, ref qty) && qty > 0)
        {
            Qty = qty;
            NotificationService.Notify(NotificationSeverity.Warning, "Whole Units Only",
                $"{Product?.UomName ?? "This unit"} does not allow decimals. Quantity rounded to {Qty:N0}.", 3000);
        }
    }

    void Confirm()
    {
        // Re-apply the unit rule so a value typed straight into the box cannot slip through.
        var qty = Qty;
        if (UomRules.Normalize(AllowsDecimal, ref qty))
        {
            Qty = qty;
            NotificationService.Notify(NotificationSeverity.Warning, "Whole Units Only",
                $"{Product?.UomName ?? "This unit"} does not allow decimals. Quantity rounded to {Qty:N0}.", 3000);
        }

        if (Qty <= 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Invalid Quantity",
                "Quantity must be greater than zero.", 3000);
            return;
        }

        // Never allow more than the stock remaining for this item.
        if (Qty > MaxQty)
        {
            Qty = Math.Max(0, MaxQty);
            NotificationService.Notify(NotificationSeverity.Warning, "Stock Limit",
                MaxQty > 0
                    ? $"Maximum available is {MaxQty.ToString(QuantityFormat)}. Quantity has been set to {MaxQty.ToString(QuantityFormat)}."
                    : "No stock is available for this item.",
                4000);
            StateHasChanged();
            return;
        }

        DialogService.Close(new ItemQuantityDialogResult { Qty = Qty, UnitPrice = UnitPrice });
    }

    void Cancel()
    {
        DialogService.Close(null);
    }
}
