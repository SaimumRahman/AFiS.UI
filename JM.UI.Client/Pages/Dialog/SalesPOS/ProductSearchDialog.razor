@using JM.UI.Entities.Model.SalesPOS
@using Radzen
@inherits ProductSearchDialogComponent

<div style="display:flex;gap:8px;margin-bottom:12px">
    <RadzenTextBox @bind-Value="GlobalSearchTerm" Placeholder="Search by name or barcode..." class="rz-w-100" @onkeydown="@OnGlobalSearchKeyPress" />
    <RadzenButton Text="Search" ButtonStyle="ButtonStyle.Primary" @onclick="OnGlobalSearch" />
</div>
<RadzenDataGrid @ref="ProductSearchGrid" Data="@GlobalSearchResults" AllowColumnResize="true" RowAlternate="true" ShowPaging="true" PageSize="8">
    <Columns>
        <RadzenDataGridColumn TItem="ProductSearchDTO" Property="ItemName" Title="Name" Width="200" />
        <RadzenDataGridColumn TItem="ProductSearchDTO" Property="Barcode" Title="Barcode" Width="120" />
        <RadzenDataGridColumn TItem="ProductSearchDTO" Title="Price" Width="80">
            <Template Context="p"><span style="font-weight:600">@p.SalePrice?.ToString("N2")</span></Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ProductSearchDTO" Property="StockQuantity" Title="Stock" Width="60" />
        <RadzenDataGridColumn TItem="ProductSearchDTO" Title="" Width="60">
            <Template Context="p">
                <RadzenButton Text="Add" ButtonStyle="ButtonStyle.Success" ButtonSize="ExtraSmall" @onclick="() => SelectSearchedProduct(p)" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
<div style="margin-top:8px;display:flex;justify-content:flex-end">
    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" @onclick="Cancel" />
</div>
