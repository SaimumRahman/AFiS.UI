@using JM.UI.Entities.Model.MesurementUnits
@using JM.UI.Entities.Model.SalesPOS
@using JM.UI.Service.UnitOfWork
@using Radzen
@using Radzen.Blazor
@inject IServiceUnitOfWork ServiceUnitOfWork
@inject DialogService DialogService
@inject NotificationService NotificationService

<div style="display:flex;flex-direction:column;gap:12px;min-width:640px">

    @* ── Step 1: search the original invoice ── *@
    <div>
        <label style="font-size:0.8rem;font-weight:600">Original Invoice</label>
        <div style="display:flex;gap:8px">
            <RadzenTextBox @bind-Value="InvoiceSearch" Placeholder="Enter invoice number..." class="rz-w-100" @onkeydown="@OnInvoiceKeyPress" />
            <RadzenButton Text="Search" ButtonStyle="ButtonStyle.Primary" Click="@SearchInvoice" />
        </div>
    </div>

    @if (OriginalSale != null)
    {
        <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.78rem;color:#555">
            <span>
                Invoice <strong>@OriginalSale.InvoiceNo</strong> | @OriginalSale.CreatedDate.ToString("dd/MM/yyyy")
                | Customer: <strong>@OriginalSale.CustomerName</strong>
            </span>
        </div>

        @if (IsExchangeBlocked)
        {
            <div style="background:#fff3cd;border:1px solid #ffe69c;border-radius:6px;padding:8px 10px;font-size:0.78rem;color:#856404">
                <RadzenIcon Icon="block" Style="vertical-align:middle;margin-right:0.25rem;" />
                <strong>Exchange unavailable:</strong> @ExchangeBlockReason
            </div>
        }

        @if (HasCustomerMismatch)
        {
            <div style="background:#f8d7da;border:1px solid #f5c2c7;border-radius:6px;padding:8px 10px;font-size:0.78rem;color:#842029">
                <RadzenIcon Icon="person_off" Style="vertical-align:middle;margin-right:0.25rem;" />
                <strong>Customer mismatch:</strong> @CustomerMismatchMessage
            </div>
        }

        @* ── Items of the invoice to exchange ── *@
        <div>
            <div class="pos-card-title" style="margin-bottom:4px">Items to Exchange</div>
            @if (ReturnLines.Count == 0)
            {
                <div style="color:#856404">No exchangeable items on this invoice.</div>
            }
            else
            {
                <RadzenDataGrid Data="@ReturnLines" AllowColumnResize="true" ShowPaging="false" TItem="ReturnEditLine" Density="Density.Compact">
                    <Columns>
                        <RadzenDataGridColumn TItem="ReturnEditLine" Property="ProductName" Title="Item" Width="200" />
                        <RadzenDataGridColumn TItem="ReturnEditLine" Property="Barcode" Title="Barcode" Width="110" />
                        <RadzenDataGridColumn TItem="ReturnEditLine" Title="Available" Width="70">
                            <Template Context="e"><span>@e.Available.ToString(UomRules.FormatFor(e.UomName))</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ReturnEditLine" Title="Qty" Width="100">
                            <Template Context="e">
                                <RadzenNumeric TValue="decimal" @bind-Value="e.ReturnQty" Min="0" Max="@e.Available"
                                               Step="@(UomRules.StepFor(e.UomName))" Format="@(UomRules.FormatFor(e.UomName))" ShowButtons="true"
                                               Change="@((decimal v) => OnReturnQtyChanged(e, v))" Style="width:80px" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ReturnEditLine" Property="UnitPrice" Title="Price" Width="80" />
                        <RadzenDataGridColumn TItem="ReturnEditLine" Title="Credit" Width="90">
                            <Template Context="e"><span style="font-weight:600;color:#28a745">@e.Credit.ToString("N2")</span></Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </div>

        @* ── Summary ── *@
        <div style="background:#f8f9fa;border-radius:6px;padding:10px;font-size:0.8rem">
            <div style="display:flex;justify-content:space-between"><span>Exchange Credit</span><span style="color:#28a745;font-weight:600">@TotalCredit.ToString("N2")</span></div>
            <div style="display:flex;justify-content:space-between;margin-top:4px">
                <span>Remaining Payable</span>
                <span style="font-weight:700;color:@(RemainingPayable > 0 ? "#dc3545" : "#28a745")">@RemainingPayable.ToString("N2")</span>
            </div>
            <div style="font-size:0.7rem;color:#856404;margin-top:4px">
                Billing total is @BillingTotal.ToString("N2"). The exchange credit cannot exceed the billing total.
            </div>
        </div>

        <div style="display:flex;gap:8px;justify-content:flex-end">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="@Cancel" />
            <RadzenButton Text="Apply Exchange" ButtonStyle="ButtonStyle.Warning" Click="@ApplyExchange"
                          Disabled="@(TotalCredit <= 0 || TotalCredit > BillingTotal || IsExchangeBlocked || HasCustomerMismatch)" />
        </div>
    }
    else
    {
        <div style="display:flex;justify-content:flex-end">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="@Cancel" />
        </div>
    }
</div>

@code {
    [Parameter] public int StoreId { get; set; }
    [Parameter] public int UserId { get; set; }
    [Parameter] public decimal BillingTotal { get; set; }

    /// <summary>Customer currently selected in the SalesPOS cart (0 = none).</summary>
    [Parameter] public int CartCustomerId { get; set; }
    [Parameter] public string? CartCustomerName { get; set; }

    protected string InvoiceSearch { get; set; } = "";
    protected SaleMasterDTO? OriginalSale { get; set; }
    protected List<ReturnEditLine> ReturnLines { get; set; } = new();
    protected string? ExchangeBlockReason { get; set; }
    protected bool IsExchangeBlocked => !string.IsNullOrEmpty(ExchangeBlockReason);

    /// <summary>
    /// True when the cart already has a customer and the invoice being exchanged
    /// belongs to a different one. The exchange must not be applied in that case:
    /// the cart customer has to be changed first.
    /// </summary>
    protected bool HasCustomerMismatch =>
        CartCustomerId > 0
        && (OriginalSale?.CustomerId ?? 0) > 0
        && CartCustomerId != OriginalSale!.CustomerId;

    protected string CustomerMismatchMessage =>
        $"The customer in the cart ({CartCustomerName}) does not match the customer on invoice "
        + $"{OriginalSale?.InvoiceNo} ({OriginalSale?.CustomerName}). "
        + "Please change the customer in the cart before proceeding with the exchange.";

    protected decimal TotalCredit => ReturnLines.Sum(r => r.Credit);
    protected decimal RemainingPayable => Math.Max(BillingTotal - TotalCredit, 0);

    protected override async Task OnInitializedAsync()
    {
        // nothing extra
    }

    protected async Task OnInvoiceKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchInvoice();
    }

    protected async Task SearchInvoice()
    {
        if (string.IsNullOrWhiteSpace(InvoiceSearch))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Invoice Number", "Please enter an invoice number", 3000);
            return;
        }

        try
        {
            OriginalSale = await ServiceUnitOfWork.SaleService.GetSaleByInvoiceNo(InvoiceSearch.Trim());
        }
        catch (Exception ex)
        {
            OriginalSale = null;
            NotificationService.Notify(NotificationSeverity.Error, "Search Failed", ex.Message, 4000);
            return;
        }

        if (OriginalSale == null)
        {
            ExchangeBlockReason = null;
            NotificationService.Notify(NotificationSeverity.Warning, "Not Found", "Invoice not found", 3000);
            return;
        }

        ReturnLines = OriginalSale.SaleDetails
            .Where(d => (d.IsBooking ?? 0) != 1 && (d.Qty - (d.ReturnedQty ?? 0)) > 0)
            .Select(d => new ReturnEditLine
            {
                SalesDetailsId = d.SalesDetailsId,
                ProductName = d.ProductName,
                Barcode = d.Barcode,
                UomName = d.UomName,
                UnitPrice = d.UnitPrice,
                Discount = d.Discount ?? 0,
                TotalQty = d.Qty,
                ReturnedQty = d.ReturnedQty ?? 0
            })
            .ToList();

        await CheckExchangeWindow();
    }

    void OnReturnQtyChanged(ReturnEditLine line, decimal value)
    {
        var qty = value;
        UomRules.Normalize(line.UomName, ref qty);
        line.ReturnQty = qty;
        StateHasChanged();
    }

    protected async Task CheckExchangeWindow()
    {
        ExchangeBlockReason = null;
        try
        {
            if (OriginalSale?.StoreId is not int storeId || storeId <= 0)
                return;

            var store = await ServiceUnitOfWork.StoreService.GetStoreById(storeId);
            var days = store?.ExchangeDay ?? 0;
            if (days <= 0)
            {
                ExchangeBlockReason = "The exchange window is not configured for this store. Please contact an administrator.";
            }
            else
            {
                var ageDays = (DateTime.Now.Date - OriginalSale.CreatedDate.Date).TotalDays;
                if (ageDays > days)
                    ExchangeBlockReason = $"This invoice is {ageDays:0} day(s) old. Exchange is allowed only within {days} day(s) of the invoice date ({store!.Name}).";
            }
        }
        catch
        {
            // best-effort only; the server enforces the rule authoritatively
        }
    }

    protected void ApplyExchange()
    {
        if (TotalCredit <= 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "No Items", "Select at least one item to exchange", 3000);
            return;
        }

        // The exchange invoice belongs to a different customer than the one already
        // in the cart: refuse to apply and ask the cashier to change the cart
        // customer first.
        if (HasCustomerMismatch)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Customer Mismatch",
                CustomerMismatchMessage, 7000);
            return;
        }

        if (TotalCredit > BillingTotal)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Exchange Credit Exceeds Billing Total",
                $"Exchange credit of {TotalCredit:N2} cannot exceed the current billing total of {BillingTotal:N2}.", 6000);
            return;
        }

        foreach (var line in ReturnLines)
        {
            var qty = line.ReturnQty;
            if (UomRules.Normalize(line.UomName, ref qty))
                line.ReturnQty = qty;
        }

        var selected = ReturnLines.Where(r => r.ReturnQty > 0).ToList();

        var result = new ExchangeApplyResult
        {
            ReturnInvoiceNo = OriginalSale!.InvoiceNo,
            ExchangeAmount = TotalCredit,
            InvoiceCustomerId = OriginalSale.CustomerId ?? 0,
            InvoiceCustomerName = OriginalSale.CustomerName,
            ReturnedItems = selected.Select(r => new ReturnedItemDTO
            {
                SalesDetailsId = r.SalesDetailsId,
                Qty = r.ReturnQty
            }).ToList()
        };
        DialogService.Close(result);
    }

    protected void Cancel()
    {
        DialogService.Close(null);
    }

    public class ReturnEditLine
    {
        public int SalesDetailsId { get; set; }
        public string? ProductName { get; set; }
        public string? Barcode { get; set; }
        public string? UomName { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal Discount { get; set; }
        public decimal TotalQty { get; set; }
        public decimal ReturnedQty { get; set; }
        public decimal ReturnQty { get; set; }
        public decimal Available => TotalQty - ReturnedQty;
        public decimal Credit => ReturnQty > 0
            ? Math.Round(UnitPrice * ReturnQty - Discount * (ReturnQty / (TotalQty > 0 ? TotalQty : 1)), 2)
            : 0;
    }
}
