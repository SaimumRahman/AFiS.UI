@using JM.UI.Entities.Model.CustomerDetails
@using JM.UI.Entities.Model.MembershipType
@using JM.UI.Service.UnitOfWork
@using Radzen
@using Radzen.Blazor
@inject IServiceUnitOfWork ServiceUnitOfWork
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenCard>
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </RadzenCard>
    }
    else
    {
        <RadzenTemplateForm TItem="CustomerDetailsDTO" Data="@Customer" Submit="@Save">
            <RadzenStack Gap="1.5rem">
                <RadzenFieldset Text="Customer Information" Icon="person">
                    <RadzenStack Gap="1rem">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenLabel Text="Name *" Component="Name" />
                                    <RadzenTextBox @bind-Value="Customer.Name"
                                                   Name="Name"
                                                   Placeholder="Enter customer name"
                                                   Style="width: 100%;"
                                                   MaxLength="100" />
                                    <RadzenRequiredValidator Component="Name" Text="Customer name is required" />
                                </RadzenStack>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenLabel Text="Email" Component="Email" />
                                    <RadzenTextBox @bind-Value="Customer.Email"
                                                   Name="Email"
                                                   Placeholder="Enter email address"
                                                   Style="width: 100%;"
                                                   MaxLength="100" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenLabel Text="Phone *" Component="Phone" />
                                    <RadzenTextBox @bind-Value="Customer.Phone"
                                                   Name="Phone"
                                                   Placeholder="Enter phone number"
                                                   Style="width: 100%;"
                                                   MaxLength="20"
                                                   @oninput="ValidatePhone"
                                                   @onchange="ValidatePhone" />
                                    <RadzenRequiredValidator Component="Phone" Text="Phone number is required" />
                                    @if (!IsPhoneValid && !string.IsNullOrEmpty(PhoneValidationMessage))
                                    {
                                        <div style="color: #dc3545; font-size: 0.85rem; margin-top: 2px;">
                                            <i class="fa fa-exclamation-triangle"></i> @PhoneValidationMessage
                                        </div>
                                    }
                                </RadzenStack>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenLabel Text="Member Type" Component="MemberTypeId" />
                                    <RadzenDropDown @bind-Value="Customer.MemberTypeId"
                                                    Data="@MembershipTypes"
                                                    TextProperty="Name"
                                                    ValueProperty="Id"
                                                    Placeholder="Select Membership Type"
                                                    Style="width: 100%;"
                                                    AllowClear="IsAdmin"
                                                    AllowFiltering="IsAdmin"
                                                    Disabled="!IsAdmin" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow>
                            <RadzenColumn Size="12">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenLabel Text="Address" Component="Address" />
                                    <RadzenTextArea @bind-Value="Customer.Address"
                                                    Name="Address"
                                                    Placeholder="Enter address"
                                                    Rows="3"
                                                    MaxLength="200"
                                                    Style="width: 100%;" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </RadzenFieldset>

                <RadzenCard class="mt-2">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                        <RadzenButton Text="Cancel"
                                      Icon="cancel"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Flat"
                                      Click="@Cancel"
                                      Disabled="@IsProcessing" />
                        <RadzenButton Text="Save & Add New"
                                      Icon="add"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@SaveAndNew"
                                      IsBusy="@IsProcessing"
                                      Disabled="@IsSaveButtonDisabled" />
                        <RadzenButton Text="Save"
                                      Icon="save"
                                      ButtonStyle="ButtonStyle.Primary"
                                      ButtonType="ButtonType.Submit"
                                      IsBusy="@IsProcessing"
                                      BusyText="Saving..."
                                      Disabled="@IsSaveButtonDisabled" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
        </RadzenTemplateForm>
    }
</RadzenCard>

@code {
    [Parameter] public int CurrentUserId { get; set; }
    [Parameter] public string? PreFilledPhone { get; set; }

    protected CustomerDetailsDTO Customer { get; set; } = new() { IsForceAdd = true };
    protected bool IsProcessing { get; set; }
    protected bool IsLoading { get; set; } = true;
    protected List<MembershipTypeDTO> MembershipTypes { get; set; } = new();
    protected bool IsPhoneValid { get; set; } = true;
    protected string PhoneValidationMessage { get; set; } = string.Empty;
    protected bool IsSaveButtonDisabled => IsProcessing || !IsPhoneValid;

    protected bool IsAdmin => CurrentUserId == 1;
    // Non-admins can only be a General member: the dropdown shows only General and is locked.
    protected bool IsMemberTypeLocked => !IsAdmin;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var allTypes = (await ServiceUnitOfWork.MembershipTypeService.GetAll()).ToList();

            if (IsAdmin)
            {
                // Admin may choose any membership type.
                MembershipTypes = allTypes;
            }
            else
            {
                // Non-admin: restrict to General so the membership type cannot be changed.
                var general = allTypes
                    .FirstOrDefault(m => string.Equals(m.Name?.Trim(), "General", StringComparison.OrdinalIgnoreCase))
                    ?? allTypes.FirstOrDefault();
                MembershipTypes = general != null ? new List<MembershipTypeDTO> { general } : new();
            }

            Customer = ServiceUnitOfWork.CustomerDetailsService.CreateNew();
            Customer.IsForceAdd = true;
            if (!string.IsNullOrEmpty(PreFilledPhone))
                Customer.Phone = PreFilledPhone;
            SetDefaultMembershipType();
            ValidatePhone();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SetDefaultMembershipType()
    {
        // Default to "General" membership type so the customer is eligible for the general discount.
        var general = MembershipTypes
            .FirstOrDefault(m => string.Equals(m.Name?.Trim(), "General", StringComparison.OrdinalIgnoreCase))
            ?? MembershipTypes.FirstOrDefault();
        Customer.MemberTypeId = general?.Id;
    }

    protected void ValidatePhone()
    {
        if (string.IsNullOrEmpty(Customer.Phone))
        {
            IsPhoneValid = false;
            PhoneValidationMessage = "Phone number is required";
            return;
        }

        // Phone must be 11 digits including the leading 0 (e.g. 01XXXXXXXXX).
        var digitsOnly = new string(Customer.Phone.Where(char.IsDigit).ToArray());

        if (digitsOnly.Length == 11 && digitsOnly.StartsWith("01"))
        {
            IsPhoneValid = true;
            PhoneValidationMessage = "";
        }
        else
        {
            IsPhoneValid = false;
            if (digitsOnly.Length != 11)
                PhoneValidationMessage = "Phone must be 11 digits including the leading 0 (e.g. 01XXXXXXXXX)";
            else if (!digitsOnly.StartsWith("01"))
                PhoneValidationMessage = "Phone must start with '01'";
            else
                PhoneValidationMessage = "Invalid phone number format";
        }
    }

    protected async Task Save()
    {
        ValidatePhone();
        if (!IsPhoneValid)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", PhoneValidationMessage);
            return;
        }

        var validation = await ServiceUnitOfWork.CustomerDetailsService.Validate(Customer);
        if (!validation.IsValid)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", validation.ErrorMessage);
            return;
        }

        try
        {
            IsProcessing = true;
            var result = await ServiceUnitOfWork.CustomerDetailsService.InsertUpdateCustomer(Customer);

            if (result.IsSuccessStatus)
            {
                var all = await ServiceUnitOfWork.CustomerDetailsService.GetAllCustomers();
                var saved = all.OrderByDescending(c => c.Id).FirstOrDefault();
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Customer created successfully!");
                DialogService.Close(saved);
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", result.Message);
                if (result.StatusCode == StatusCodes.Status304NotModified)
                {
                    var confirmed = await DialogService.Confirm(
                        "Do you want to create a new Customer?",
                        "Duplicate",
                        new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" }
                    );

                    if (confirmed == true)
                    {
                        Customer.IsForceAdd = true;
                        var retryResult = await ServiceUnitOfWork.CustomerDetailsService.InsertUpdateCustomer(Customer);
                        if (retryResult.IsSuccessStatus)
                        {
                            var all = await ServiceUnitOfWork.CustomerDetailsService.GetAllCustomers();
                            var saved = all.OrderByDescending(c => c.Id).FirstOrDefault();
                            NotificationService.Notify(NotificationSeverity.Success, "Success", "Customer created successfully!");
                            DialogService.Close(saved);
                        }
                        else
                        {
                            NotificationService.Notify(NotificationSeverity.Error, "Error", retryResult.Message);
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to save customer: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
        }
    }

    protected async Task SaveAndNew()
    {
        ValidatePhone();
        if (!IsPhoneValid)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", PhoneValidationMessage);
            return;
        }

        var validation = await ServiceUnitOfWork.CustomerDetailsService.Validate(Customer);
        if (!validation.IsValid)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", validation.ErrorMessage);
            return;
        }

        try
        {
            IsProcessing = true;
            var result = await ServiceUnitOfWork.CustomerDetailsService.InsertUpdateCustomer(Customer);

            if (result.IsSuccessStatus)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Customer created successfully!");
                Customer = ServiceUnitOfWork.CustomerDetailsService.CreateNew();
                Customer.IsForceAdd = true;
                SetDefaultMembershipType();
                ValidatePhone();
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", result.Message);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to save customer: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
        }
    }

    protected void Cancel()
    {
        DialogService.Close(null);
    }
}