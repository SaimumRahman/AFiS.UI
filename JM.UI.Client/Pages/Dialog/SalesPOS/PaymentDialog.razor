@using JM.UI.Entities.Model.FinancialAccounts
@using JM.UI.Entities.Model.SalesPOS
@using JM.UI.Service.UnitOfWork
@using Radzen
@using Radzen.Blazor
@inject IServiceUnitOfWork _serviceUnitOfWork
@inject DialogService DialogService
@inject NotificationService NotificationService

<div style="display:flex;flex-direction:column;gap:10px">

    @if (ExistingPayments != null && ExistingPayments.Any())
    {
        <div class="payment-summary" style="background:#f0fdf4;border-radius:6px;padding:8px">
            <div style="font-size:0.8rem;font-weight:600;margin-bottom:4px;color:#15803d">Previously Paid</div>
            @foreach (var p in ExistingPayments)
            {
                <div style="display:flex;justify-content:space-between;padding:2px 0;font-size:0.75rem">
                    <span style="color:#666">@GetPaymentTypeName(p.TransactionTypeId)</span>
                    <span style="font-weight:600">@((p.PaidAmount ?? 0).ToString("N2"))</span>
                </div>
            }
            <div style="display:flex;justify-content:space-between;padding:3px 0;font-size:0.8rem;border-top:1px solid #bbf7d0;margin-top:4px">
                <span style="color:#666;font-weight:600">Total Paid</span>
                <span style="font-weight:700;color:#15803d">@ExistingPayments.Sum(p => p.PaidAmount ?? 0).ToString("N2")</span>
            </div>
        </div>
    }

    <div class="payment-summary" style="background:#f0f9ff;border-radius:6px;padding:8px">
        <div style="display:flex;justify-content:space-between;padding:3px 0;font-size:0.8rem">
            <span style="color:#666">Net Payable</span>
            <span style="font-weight:600">@NetPayable.ToString("N2")</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:3px 0;font-size:0.8rem">
            <span style="color:#666">Paid</span>
            <span style="font-weight:600;color:#28a745">@PaidAmount.ToString("N2")</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:3px 0;font-size:0.8rem">
            <span style="color:#666">Remaining</span>
            <span style="font-weight:700;color:@(RemainingAmount > 0 ? "#dc3545" : "#28a745")">@RemainingAmount.ToString("N2")</span>
        </div>
    </div>

    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <label style="display:flex;align-items:center;gap:4px">
            <RadzenCheckBox TValue="bool" @bind-Value="IsCash" Change="@OnCashChanged" />
            <span>Cash</span>
        </label>
        <RadzenDropDownDataGrid TValue="int?" @bind-Value="SelectedFinancialAccountId" Data="@FinancialAccounts"
                                TextProperty="AccountName" ValueProperty="Id" Change="@OnFinancialAccountChanged"
                                Placeholder="Select Financial Account"
                                AllowFiltering="true" AllowFilteringByAllStringColumns="true"
                                FilterOperator="StringFilterOperator.Contains"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                AllowClear="true" Style="width:320px"
                                EmptyText="No financial account for this store">
            <Columns>
                <RadzenDropDownDataGridColumn Property="AccountName" Title="MFS / Bank" Width="150px" />
                <RadzenDropDownDataGridColumn Property="AccountNo" Title="Account No" Width="170px" />
                <RadzenDropDownDataGridColumn Property="StoreName" Title="Store" Width="150px" />
            </Columns>
        </RadzenDropDownDataGrid>
        @if (!FinancialAccounts.Any())
        {
            <span style="color:#b26a00;font-size:0.75rem;max-width:220px">
                No financial account with a ledger is set up for this store. Cash only until one is configured.
            </span>
        }
        <RadzenNumeric @bind-Value="PaymentAmount" Min="0" Style="width:120px" />
        <RadzenButton Text="Fill Remaining" ButtonStyle="ButtonStyle.Info" ButtonSize="Small" Click="@FillRemaining" Disabled="@(RemainingAmount <= 0)" />
        @if (!IsCash)
        {
            <RadzenTextBox @bind-Value="TransactionNo" Placeholder="Transaction ID" Style="width:150px" />
        }
        <RadzenButton Text="Add Payment" ButtonStyle="ButtonStyle.Success" ButtonSize="Small" Click="@AddTempPayment" Disabled="@(PaymentAmount <= 0)" />
    </div>

    @* A plain table is used for the payment rows. The previous RadzenDataGrid was bound to a
       List that was mutated in place, so it kept its cached view and showed no rows even
       though the totals and the payment counter below updated. *@
    <table style="width:100%;border-collapse:collapse;font-size:0.8rem;border:1px solid #e5e7eb;border-radius:6px">
        <thead>
            <tr style="background:#f8fafc;text-align:left">
                <th style="padding:6px 8px;width:36px;border-bottom:1px solid #e5e7eb">#</th>
                <th style="padding:6px 8px;border-bottom:1px solid #e5e7eb">Type</th>
                <th style="padding:6px 8px;width:110px;text-align:right;border-bottom:1px solid #e5e7eb">Amount</th>
                <th style="padding:6px 8px;width:150px;border-bottom:1px solid #e5e7eb">Ref</th>
                <th style="padding:6px 8px;width:44px;border-bottom:1px solid #e5e7eb"></th>
            </tr>
        </thead>
        <tbody>
            @if (!TempPayments.Any())
            {
                <tr>
                    <td colspan="5" style="padding:10px 8px;color:#9ca3af;text-align:center">
                        No payment added yet. Enter an amount, choose Cash or a financial account, then press Add Payment.
                    </td>
                </tr>
            }
            else
            {
                @for (int i = 0; i < TempPayments.Count; i++)
                {
                    var row = TempPayments[i];
                    var index = i;
                    <tr style="border-bottom:1px solid #f1f5f9">
                        <td style="padding:6px 8px;color:#6b7280">@(index + 1)</td>
                        <td style="padding:6px 8px">@GetPaymentTypeName(row.TransactionTypeId)</td>
                        <td style="padding:6px 8px;text-align:right;font-weight:600">@((row.PaidAmount ?? 0).ToString("N2"))</td>
                        <td style="padding:6px 8px;color:#6b7280">@row.TransactionNo</td>
                        <td style="padding:6px 8px">
                            <RadzenButton ButtonStyle="ButtonStyle.Danger" ButtonSize="ExtraSmall" Icon="close" Click="@(() => RemoveTempPayment(index))" />
                        </td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr style="background:#f8fafc">
                <td colspan="2" style="padding:6px 8px;font-weight:600">Total</td>
                <td style="padding:6px 8px;text-align:right;font-weight:700">@PaidAmount.ToString("N2")</td>
                <td colspan="2" style="padding:6px 8px;color:#6b7280">
                    @TempPayments.Count payment(s)
                </td>
            </tr>
        </tfoot>
    </table>

    @if (TempPayments.Any() && RemainingAmount > 0 && !CustomerSelected)
    {
        <div style="background:#fff7ed;border:1px solid #fed7aa;border-radius:6px;padding:8px;font-size:0.78rem;color:#b45309">
            A balance of @RemainingAmount.ToString("N2") will remain on this invoice, so a customer must be
            selected before it can be saved. Select a customer on the POS screen or collect the full amount.
        </div>
    }

    <div style="display:flex;gap:6px;margin-top:8px">
        @if (ShowDeliveredOption)
        {
            <label><RadzenCheckBox @bind-Value="IsDelivered" /> Delivered</label>
        }
        @if (AllowBookingOption)
        {
            <label><RadzenCheckBox @bind-Value="IsBookingPayment" /> Book (partial payment)</label>
        }
    </div>

    <div style="display:flex;gap:6px;justify-content:flex-end">
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
        <RadzenButton Text="@($"Confirm Payment ({TempPayments.Count})")" ButtonStyle="ButtonStyle.Primary"
                      Click="@ConfirmPayment"
                      Disabled="@(TempPayments.Count == 0 || (RemainingAmount > 0 && !CustomerSelected))" />
    </div>
</div>

@code {
    [Parameter] public decimal NetPayable { get; set; }
    [Parameter] public bool AllowBookingOption { get; set; } = true;
    [Parameter] public bool ShowDeliveredOption { get; set; }
    [Parameter] public List<PaymentTransactionDTO>? ExistingPayments { get; set; }

    /// <summary>
    /// True when the POS screen already has a customer selected. A remaining balance (due)
    /// cannot be saved without one, so the dialog blocks Confirm instead of letting the
    /// caller reject the sale after the entered payments have been discarded.
    /// </summary>
    [Parameter] public bool CustomerSelected { get; set; } = true;

    /// <summary>Store of the invoice being paid: financial accounts are scoped to it.</summary>
    [Parameter] public int? StoreId { get; set; }

    decimal PaymentAmount { get; set; }
    bool IsCash { get; set; } = true;
    int? SelectedFinancialAccountId { get; set; }
    string TransactionNo { get; set; } = "";

    // Never mutated in place: every change replaces the list so the markup above always
    // re-renders and any grid/binding sees a new reference.
    List<PaymentTransactionDTO> TempPayments { get; set; } = new();

    decimal PaidAmount => TempPayments.Sum(p => p.PaidAmount ?? 0);
    decimal RemainingAmount => NetPayable - PaidAmount;

    bool IsBookingPayment { get; set; }
    bool IsDelivered { get; set; } = true;

    List<FinancialAccountDropdownDTO> FinancialAccounts { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        PaymentAmount = NetPayable;
        await LoadFinancialAccounts();
    }

    private async Task LoadFinancialAccounts()
    {
        try
        {
            var accounts = await _serviceUnitOfWork.FinancialAccountsService.GetFinancialAccountsForDropdown(StoreId);

            // Only accounts with a ledger attached can be posted to: the server posts MFS / bank
            // payments to that ledger and rejects the account when it is not set, so an unusable
            // account is not offered here at all.
            FinancialAccounts = accounts
                .Where(a => !string.IsNullOrWhiteSpace(a.LedgerCode))
                .ToList();
        }
        catch
        {
            FinancialAccounts = new();
        }
    }

    void OnCashChanged(bool isCash)
    {
        if (isCash) SelectedFinancialAccountId = null;
    }

    void OnFinancialAccountChanged(object value)
    {
        if (value != null) IsCash = false;
    }

    void AddTempPayment()
    {
        if (PaymentAmount <= 0)
        {
            Notify("Enter a payment amount before adding it.");
            return;
        }

        if (!IsCash && (SelectedFinancialAccountId == null || SelectedFinancialAccountId <= 0))
        {
            Notify("Select a financial account, or tick Cash for a cash payment.");
            return;
        }

        int typeId = IsCash ? 0 : SelectedFinancialAccountId!.Value;
        string? refNo = IsCash ? null : (string.IsNullOrWhiteSpace(TransactionNo) ? null : TransactionNo.Trim());

        if (TempPayments.Any(p => p.TransactionTypeId == typeId
                                  && string.Equals(p.TransactionNo ?? "", refNo ?? "", StringComparison.OrdinalIgnoreCase)))
        {
            Notify("This payment is already in the list. Change the reference or the account to add another one.");
            return;
        }

        decimal amount = PaymentAmount;
        if (RemainingAmount <= 0)
        {
            Notify("The invoice is already fully covered by the payments in the list.");
            return;
        }

        if (amount > RemainingAmount)
        {
            decimal reduced = RemainingAmount;
            Notify($"Amount reduced to the remaining balance of {reduced:N2}.");
            amount = reduced;
        }

        var newRow = new PaymentTransactionDTO
        {
            TransactionTypeId = typeId,
            PaidAmount = amount,
            TransactionNo = refNo
        };

        // Replace the list instead of appending to it (see the field comment above).
        TempPayments = new List<PaymentTransactionDTO>(TempPayments) { newRow };

        // Keep the cash/account choice so consecutive payments need only an amount,
        // only the amount and reference are reset.
        TransactionNo = "";
        PaymentAmount = RemainingAmount > 0 ? RemainingAmount : 0;
        StateHasChanged();
    }

    void FillRemaining()
    {
        if (RemainingAmount > 0)
            PaymentAmount = RemainingAmount;
    }

    string GetPaymentTypeName(int transactionTypeId)
    {
        if (transactionTypeId == 0) return "Cash";

        var account = FinancialAccounts.FirstOrDefault(f => f.Id == transactionTypeId);
        if (account == null) return "Account";

        return string.IsNullOrWhiteSpace(account.AccountNo)
            ? account.AccountName
            : $"{account.AccountName} · {account.AccountNo}";
    }

    void RemoveTempPayment(int index)
    {
        if (index < 0 || index >= TempPayments.Count) return;

        var remaining = new List<PaymentTransactionDTO>(TempPayments);
        remaining.RemoveAt(index);
        TempPayments = remaining;

        if (RemainingAmount > 0 && PaymentAmount <= 0)
            PaymentAmount = RemainingAmount;

        StateHasChanged();
    }

    void ConfirmPayment()
    {
        if (TempPayments.Count == 0)
        {
            Notify("Add at least one payment before confirming.");
            return;
        }

        if (RemainingAmount > 0 && !CustomerSelected)
        {
            Notify($"A customer is required because {RemainingAmount:N2} would remain unpaid.", NotificationSeverity.Warning);
            return;
        }

        DialogService.Close(new PaymentResultDTO
        {
            Payments = TempPayments.ToList(),
            IsBookingPayment = IsBookingPayment,
            IsDelivered = IsDelivered
        });
    }

    void Cancel()
    {
        DialogService.Close(null);
    }

    void Notify(string message, NotificationSeverity severity = NotificationSeverity.Warning)
    {
        NotificationService.Notify(severity, "Payment", message, 4000);
    }
}
