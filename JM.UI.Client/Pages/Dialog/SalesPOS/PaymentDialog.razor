@using JM.UI.Entities.Model.FinancialAccounts
@using JM.UI.Entities.Model.SalesPOS
@using JM.UI.Service.UnitOfWork
@using Radzen
@using Radzen.Blazor
@inject IServiceUnitOfWork _serviceUnitOfWork
@inject DialogService DialogService

<div style="display:flex;flex-direction:column;gap:10px">
    <div class="payment-summary" style="background:#f0f9ff;border-radius:6px;padding:8px">
        <div style="display:flex;justify-content:space-between;padding:3px 0;font-size:0.8rem">
            <span style="color:#666">Net Payable</span>
            <span style="font-weight:600">@NetPayable.ToString("N2")</span>
        </div>
        @if (TempPayments.Any())
        {
            <div style="display:flex;justify-content:space-between;padding:3px 0;font-size:0.8rem;color:#28a745">
                <span style="color:#666">Paid</span>
                <span style="font-weight:600">@TempPayments.Sum(p => p.PaidAmount ?? 0).ToString("N2")</span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:3px 0;font-size:0.8rem;color:#dc3545">
                <span style="color:#666">Due</span>
                <span style="font-weight:600;font-weight:700">@RemainingAmount.ToString("N2")</span>
            </div>
        }
    </div>

    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <label style="display:flex;align-items:center;gap:4px">
            <RadzenCheckBox TValue="bool" @bind-Value="IsCash" Change="@OnCashChanged" />
            <span>Cash</span>
        </label>
        <RadzenDropDown @bind-Value="SelectedFinancialAccountId" Data="@FinancialAccounts"
                        TextProperty="AccountName" ValueProperty="Id" Change="@OnFinancialAccountChanged"
                        Placeholder="Select Financial Account" Filterable="true" AllowClear="true" Style="width:200px" />
        <RadzenNumeric @bind-Value="PaymentAmount" Min="0" Style="width:120px" />
        @if (!IsCash)
        {
            <RadzenTextBox @bind-Value="TransactionNo" Placeholder="Transaction ID" Style="width:150px" />
        }
        <RadzenButton Text="Add Payment" ButtonStyle="ButtonStyle.Success" ButtonSize="Small" Click="@AddTempPayment" Disabled="@(PaymentAmount <= 0)" />
    </div>

    @if (TempPayments.Any())
    {
        <RadzenDataGrid Data="@TempPayments" TItem="PaymentTransactionDTO" ShowPaging="false">
            <Columns>
                <RadzenDataGridColumn TItem="PaymentTransactionDTO" Title="Type" Width="160">
                    <Template Context="p">
                        @GetPaymentTypeName(p.TransactionTypeId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PaymentTransactionDTO" Title="Amount" Width="100">
                    <Template Context="p">
                        @(p.PaidAmount?.ToString("N2") ?? "0.00")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PaymentTransactionDTO" Property="TransactionNo" Title="Ref" Width="140" />
                <RadzenDataGridColumn TItem="PaymentTransactionDTO" Title="" Width="50">
                    <Template Context="p">
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" ButtonSize="ExtraSmall" Click="@(() => RemoveTempPayment(p))">X</RadzenButton>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }

    <div style="display:flex;gap:6px;margin-top:8px">
        @if (AllowBookingOption)
        {
            <label><RadzenCheckBox @bind-Value="IsBookingPayment" /> Book (partial payment)</label>
        }
    </div>

    <div style="display:flex;gap:6px;justify-content:flex-end">
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
        <RadzenButton Text="Confirm Payment" ButtonStyle="ButtonStyle.Primary" Click="@ConfirmPayment" Disabled="@(TempPayments.Count == 0)" />
    </div>
</div>

@code {
    [Parameter] public decimal NetPayable { get; set; }
    [Parameter] public bool AllowBookingOption { get; set; } = true;

    decimal PaymentAmount { get; set; }
    bool IsCash { get; set; } = true;
    int? SelectedFinancialAccountId { get; set; }
    string TransactionNo { get; set; } = "";
    List<PaymentTransactionDTO> TempPayments { get; set; } = new();
    decimal RemainingAmount => NetPayable - TempPayments.Sum(p => p.PaidAmount ?? 0);
    bool IsBookingPayment { get; set; }

    List<FinancialAccountDropdownDTO> FinancialAccounts { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        PaymentAmount = NetPayable;
        await LoadFinancialAccounts();
    }

    private async Task LoadFinancialAccounts()
    {
        try
        {
            FinancialAccounts = (await _serviceUnitOfWork.FinancialAccountsService.GetFinancialAccountsForDropdown()).ToList();
        }
        catch
        {
            FinancialAccounts = new();
        }
    }

    void OnCashChanged(bool isCash)
    {
        if (isCash) SelectedFinancialAccountId = null;
    }

    void OnFinancialAccountChanged(object value)
    {
        if (value != null) IsCash = false;
    }

    void AddTempPayment()
    {
        if (PaymentAmount <= 0) return;
        if (!IsCash && (SelectedFinancialAccountId == null || SelectedFinancialAccountId <= 0)) return;
        TempPayments.Add(new PaymentTransactionDTO
        {
            TransactionTypeId = IsCash ? 0 : SelectedFinancialAccountId.Value,
            PaidAmount = Math.Min(PaymentAmount, RemainingAmount > 0 ? RemainingAmount : PaymentAmount),
            TransactionNo = !IsCash ? TransactionNo : null
        });
        IsCash = true;
        SelectedFinancialAccountId = null;
        TransactionNo = "";
        PaymentAmount = RemainingAmount;
    }

    string GetPaymentTypeName(int transactionTypeId)
    {
        if (transactionTypeId == 0) return "Cash";
        return FinancialAccounts.FirstOrDefault(f => f.Id == transactionTypeId)?.AccountName ?? "Account";
    }

    void RemoveTempPayment(PaymentTransactionDTO payment)
    {
        TempPayments.Remove(payment);
    }

    void ConfirmPayment()
    {
        DialogService.Close(new PaymentResultDTO
        {
            Payments = TempPayments.ToList(),
            IsBookingPayment = IsBookingPayment
        });
    }

    void Cancel()
    {
        DialogService.Close(null);
    }
}
