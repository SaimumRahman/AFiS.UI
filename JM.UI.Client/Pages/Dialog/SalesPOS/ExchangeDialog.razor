@using JM.UI.Entities.Model.SalesPOS
@using JM.UI.Service.UnitOfWork
@using Radzen
@using Radzen.Blazor
@inject IServiceUnitOfWork ServiceUnitOfWork
@inject DialogService DialogService
@inject NotificationService NotificationService

<div style="display:flex;gap:8px;margin-bottom:12px">
    <RadzenTextBox @bind-Value="ExchangeInvoiceNo" Placeholder="Enter invoice number..." class="rz-w-100" @onkeydown="@OnExchangeSearchKeyPress" />
    <RadzenButton Text="Search" ButtonStyle="ButtonStyle.Primary" Click="@SearchExchangeInvoice" />
</div>
@if (ExchangeSale != null)
{
    <div style="font-size:0.8rem;margin-bottom:8px">
        Invoice: @ExchangeSale.InvoiceNo | Date: @ExchangeSale.SalesDate.ToString("dd/MM/yyyy") | Customer: @ExchangeSale.CustomerName
    </div>
    @if (ExchangeItems.Count == 0)
    {
        <div style="color:#856404">No line items available to exchange on this invoice.</div>
    }
    else
    {
        <RadzenDataGrid Data="@ExchangeItems" AllowColumnResize="true" ShowPaging="false" TItem="ExchangeLineEdit">
            <Columns>
                <RadzenDataGridColumn TItem="ExchangeLineEdit" Property="ProductName" Title="Item" Width="170" />
                <RadzenDataGridColumn TItem="ExchangeLineEdit" Property="Barcode" Title="Barcode" Width="90" />
                <RadzenDataGridColumn TItem="ExchangeLineEdit" Title="Available" Width="70">
                    <Template Context="e">
                        <span>@e.Available.ToString("0.##")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ExchangeLineEdit" Title="Return Qty" Width="90">
                    <Template Context="e">
                        <RadzenNumeric TValue="decimal" @bind-Value="e.ReturnQty" Min="0" Max="@e.Available" Step="1"
                                       ShowButtons="true" Change="@((decimal value) => OnReturnQtyChanged(value))" Style="width:80px" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ExchangeLineEdit" Title="Credit" Width="80">
                    <Template Context="e">
                        <span>@e.Credit.ToString("N2")</span>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
        <div style="margin-top:8px;display:flex;gap:6px;align-items:center;justify-content:flex-end">
            <div style="margin-right:auto;font-weight:600">
                Total Credit: @TotalCredit.ToString("N2")
            </div>
            <RadzenButton Text="Apply Exchange" ButtonStyle="ButtonStyle.Warning" Disabled="@(TotalCredit <= 0)" Click="@ApplyExchange" />
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="@Cancel" />
        </div>
    }
}
else
{
    <div style="margin-top:8px;display:flex;justify-content:flex-end">
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="@Cancel" />
    </div>
}

@code {
    protected string ExchangeInvoiceNo { get; set; } = "";
    protected SaleMasterDTO? ExchangeSale { get; set; }
    protected List<ExchangeLineEdit> ExchangeItems { get; set; } = new();
    protected decimal TotalCredit => ExchangeItems.Sum(e => e.Credit);

    protected async Task OnExchangeSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchExchangeInvoice();
    }

    protected async Task SearchExchangeInvoice()
    {
        if (string.IsNullOrWhiteSpace(ExchangeInvoiceNo))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Invoice Number",
                "Please enter an invoice number", 3000);
            return;
        }

        try
        {
            ExchangeSale = await ServiceUnitOfWork.SaleService.GetSaleByInvoiceNo(ExchangeInvoiceNo.Trim());
        }
        catch (Exception ex)
        {
            ExchangeSale = null;
            ExchangeItems = new();
            NotificationService.Notify(NotificationSeverity.Error, "Search Failed",
                ex.Message, 4000);
            return;
        }

        if (ExchangeSale != null)
        {
            ExchangeItems = ExchangeSale.SaleDetails
                .Where(d => (d.IsBooking ?? 0) != 1 && (d.Qty - (d.ReturnedQty ?? 0)) > 0)
                .Select(d => new ExchangeLineEdit
                {
                    SalesDetailsId = d.SalesDetailsId,
                    ProductName = d.ProductName,
                    Barcode = d.Barcode,
                    UnitPrice = d.UnitPrice,
                    TotalQty = d.Qty,
                    ReturnedQty = d.ReturnedQty ?? 0,
                    Discount = d.Discount ?? 0,
                    IsBooking = d.IsBooking ?? 0
                })
                .ToList();
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Not Found",
                "Invoice not found", 3000);
        }
    }

    protected void OnReturnQtyChanged(decimal value)
    {
        StateHasChanged();
    }

    protected void ApplyExchange()
    {
        var selected = ExchangeItems.Where(e => e.ReturnQty > 0).ToList();
        if (selected.Count == 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "No Items",
                "Select at least one item to exchange", 3000);
            return;
        }

        try
        {
            DialogService.Close(new ExchangeResultDTO
            {
                InvoiceNo = ExchangeInvoiceNo,
            ExchangeAmount = TotalCredit,
            IsReturnExchange = true,
            ExchangeItems = selected.Select(e => new ExchangeItemDTO
            {
                SalesDetailsId = e.SalesDetailsId,
                Qty = e.ReturnQty,
                Credit = e.Credit
            }).ToList(),
            SaleLines = selected.Select(e =>
            {
                var source = ExchangeSale!.SaleDetails.FirstOrDefault(d => d.SalesDetailsId == e.SalesDetailsId);
                var line = source == null ? new SaleDetailDTO() : new SaleDetailDTO
                {
                    SalesDetailsId = source.SalesDetailsId,
                    SalesMasterId = source.SalesMasterId,
                    ItemId = source.ItemId,
                    Barcode = source.Barcode,
                    ReturnRefNo = source.ReturnRefNo,
                    ProductName = source.ProductName,
                    SalesPersonId = source.SalesPersonId,
                    SalesPersonName = source.SalesPersonName,
                    UomId = source.UomId,
                    UomName = source.UomName,
                    UnitPrice = source.UnitPrice,
                    BaseUnitPrice = source.UnitPrice,
                    ReturnedQty = source.ReturnedQty,
                    Discount = source.Discount,
                    IsBooking = 0,
                    Vat = source.Vat,
                    HasDiscount = source.HasDiscount,
                    StoreId = source.StoreId
                };
                line.Qty = e.ReturnQty;
                line.TotalAmount = e.Credit;
                line.IsExchangeReturn = true;
                line.SourceSalesDetailsId = e.SalesDetailsId;
                line.SourceInvoiceNo = ExchangeInvoiceNo.Trim();
                line.AvailableQty = e.Available;
                return line;
            }).ToList()
        });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Apply Failed",
                ex.Message, 4000);
        }
    }

    protected void Cancel()
    {
        DialogService.Close(null);
    }

    public class ExchangeLineEdit
    {
        public int SalesDetailsId { get; set; }
        public string? ProductName { get; set; }
        public string? Barcode { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal TotalQty { get; set; }
        public decimal ReturnedQty { get; set; }
        public decimal Discount { get; set; }
        public decimal ReturnQty { get; set; }
        public int IsBooking { get; set; }
        public decimal Available => TotalQty - ReturnedQty;
        public decimal Credit => ReturnQty > 0
            ? Math.Round(UnitPrice * ReturnQty - Discount * (ReturnQty / (TotalQty > 0 ? TotalQty : 1)), 2)
            : 0;
    }
}