@using JM.Infrastructure.Models
@using JM.UI.Entities.Model.Accounting_D
@using JM.UI.Entities.Model.DailyExpense
@using JM.UI.Entities.Model.FinancialAccounts
@using JM.UI.Entities.Model.Stores
@using JM.UI.Service.UnitOfWork
@using Radzen
@using Radzen.Blazor
@inject IServiceUnitOfWork ServiceUnitOfWork
@inject DialogService DialogService
@inject NotificationService NotificationService

<style>
    .rz-dropdown-tree-popup {
        display: none;
        position: absolute;
        overflow: hidden;
        width: 380px;
        border: var(--rz-panel-border);
        background-color: var(--rz-panel-background-color);
        box-shadow: var(--rz-panel-shadow);
        border-radius: var(--rz-border-radius);
        z-index: 1000;
    }
</style>

<RadzenCard>
    <RadzenStack Gap="1.25rem">
        <RadzenFieldset Text="@(IsEditMode ? "Edit Expense" : "New Expense")" Icon="request_quote">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Expense Date *" Component="ExpenseDate" />
                    <RadzenDatePicker @bind-Value="Expense.ExpenseDate" DateFormat="dd/MM/yyyy" Style="width:100%" Disabled="@(!CanChooseStore)" />
@if (!CanChooseStore)
{
    <RadzenText TextStyle="TextStyle.Caption" Style="color:#64748b;">
        You can only enter expenses for today. Contact an administrator to change the date.
    </RadzenText>
}
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Store *" Component="StoreId" />
                    <RadzenDropDown @bind-Value="Expense.StoreId"
                                    Data="Stores"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    Placeholder="Select Store"
                                    Style="width:100%"
                                    Disabled="@(!CanChooseStore)"
                                    Change="@(async (object _) => await LoadAvailableCashAsync())" />
                    @if (!CanChooseStore)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Style="color:#64748b;">
                            You can only enter expenses for your own store. Contact an administrator to change this.
                        </RadzenText>
                    }
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Amount *" Component="ExpenseAmount" />
                    <RadzenNumeric @bind-Value="Expense.Amount" Min="0" Style="width:100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Auto-Post Threshold" />
                    @if (SelectedStore == null)
                    {
                        <div style="padding:9px 12px;border:1px dashed var(--rz-border);border-radius:4px;color:var(--rz-text-secondary)">
                            Select a store to see its auto-post threshold.
                        </div>
                    }
                    else if (!HasLimit)
                    {
                        <div style="padding:9px 12px;border:1px solid var(--rz-border);border-radius:4px;background:var(--rz-base-200);color:#15803d">
                            @SelectedStore.Name: no threshold set — every expense posts to the ledger immediately.
                        </div>
                    }
                    else
                    {
                        <div style="padding:9px 12px;border:1px solid var(--rz-border);border-radius:4px;background:var(--rz-base-200)">
                            <div>
                                @SelectedStore.Name — limit <b>@AutoPostLimit!.Value.ToString("N2")</b>
                            </div>
                            @if (Expense.Amount <= 0)
                            {
                                <div style="color:var(--rz-text-secondary);font-size:0.78rem">
                                    Amounts up to this post to the ledger; above it goes to Post Ledger.
                                </div>
                            }
                            else if (WillAutoPost)
                            {
                                <div style="color:#15803d;font-size:0.78rem">
                                    This expense (@Expense.Amount.ToString("N2")) will post to the ledger automatically.
                                </div>
                            }
                            else
                            {
                                <div style="color:#b26a00;font-size:0.78rem">
                                    This expense (@Expense.Amount.ToString("N2")) exceeds the limit and will be sent to Post Ledger.
                                </div>
                            }
                        </div>
                    }
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12">
                    <RadzenLabel Text="Expense Account (Ledger) *" />
                    <div style="display:flex; gap:0.3rem; align-items:center; width:100%;">
                        <div @ref="expenseAccountTrigger" @onclick="ToggleExpenseAccount" style="position:relative; flex:1; cursor:pointer;">
                            <RadzenTextBox ReadOnly="true" Value="@ExpenseAccountText"
                                           Placeholder="Select expense ledger"
                                           Style="width:100%; cursor:pointer;" />
                            <RadzenIcon Icon="arrow_drop_down" Style="position:absolute; right:8px; top:50%; transform:translateY(-50%); pointer-events:none; color:var(--rz-text-tertiary-color);" />
                        </div>
                        @if (!string.IsNullOrEmpty(ExpenseAccountText))
                        {
                            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                          Click="ClearExpenseAccount" Title="Clear" />
                        }
                    </div>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Paid From" />
                    <div style="display:flex;gap:8px;align-items:center">
                        <RadzenButton Text="Cash"
                                      ButtonSize="ButtonSize.Small"
                                      ButtonStyle="@(IsCash ? ButtonStyle.Primary : ButtonStyle.Secondary)"
                                      Click="@(() => SetPaidFrom(true))" />
                        @* <RadzenButton Text="Bank / MFS"
                                      ButtonSize="ButtonSize.Small"
                                      ButtonStyle="@(!IsCash ? ButtonStyle.Primary : ButtonStyle.Secondary)"
                                      Click="@(() => SetPaidFrom(false))" /> *@
                    </div>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Account" Component="FinancialAccountId" />
                    @if (IsCash)
                    {
                        <div style="padding:9px 12px;border:1px solid var(--rz-border);border-radius:4px;color:var(--rz-text-secondary);background:var(--rz-base-200)">Cash</div>
                    }
                    else
                    {
                        <RadzenDropDown @bind-Value="Expense.FinancialAccountId"
                                        Data="FinancialAccounts"
                                        TextProperty="AccountName"
                                        ValueProperty="Id"
                                        Placeholder="Select Account"
                                        Style="width:100%" />
                    }
                </RadzenColumn>
            </RadzenRow>

            <!-- Available cash (ledger × cost center) -->
            @if (Expense.StoreId > 0 && Expense.LedgerAccountId.HasValue && Expense.LedgerAccountId.Value > 0)
            {
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12">
                        @if (IsLoadingCash)
                        {
                            <div style="padding:9px 12px;border:1px solid var(--rz-border);border-radius:4px">
                                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                                <span style="margin-left:8px;color:var(--rz-text-secondary)">Loading available cash…</span>
                            </div>
                        }
                        else if (AvailableCash == null)
                        {
                            <div style="padding:9px 12px;border:1px dashed var(--rz-border);border-radius:4px;color:var(--rz-text-secondary)">
                                Available cash could not be loaded.
                            </div>
                        }
                        else if (!AvailableCash.CostCenterLinked)
                        {
                            <div style="padding:9px 12px;border:1px solid var(--rz-danger);border-radius:4px;background:var(--rz-danger-lighter);color:var(--rz-danger)">
                                This store has no cost center linked — expenses cannot be saved until a cost center is assigned.
                            </div>
                        }
                        else
                        {
                            <div style="padding:9px 12px;border:1px solid var(--rz-border);border-radius:4px;background:var(--rz-base-200)">
                                <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px">
                                    <span>
                                        Cost Center: <b>@AvailableCash.CostCenterName (@AvailableCash.CostCenterCode)</b>
                                    </span>
                                    <span>
                                        Available Cash:
                                        <b style="color:@(AvailableCash.AvailableCash > 0 ? "#15803d" : "var(--rz-danger)")">
                                            @AvailableCash.AvailableCash.ToString("N2")
                                        </b>
                                    </span>
                                    <span style="color:var(--rz-text-secondary);font-size:0.78rem">
                                        Funded @AvailableCash.Funded.ToString("N2") − Spent @AvailableCash.Spent.ToString("N2")
                                    </span>
                                </div>
                                @if (Expense.Amount > 0 && Expense.Amount > AvailableCash.AvailableCash)
                                {
                                    <div style="color:var(--rz-danger);font-size:0.78rem;margin-top:6px">
                                        Amount @Expense.Amount.ToString("N2") exceeds the available cash @AvailableCash.AvailableCash.ToString("N2") for this ledger / cost center.
                                    </div>
                                }
                            </div>
                        }
                    </RadzenColumn>
                </RadzenRow>
            }

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Receipt / Bill No" Component="ReceiptBillNo" />
                    <RadzenTextBox @bind-Value="Expense.ReceiptBillNo" Placeholder="Optional supplier / receipt no" Style="width:100%" MaxLength="50" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    @if (!IsCash)
                    {
                        <RadzenLabel Text="Reference No" Component="ReferenceNo" />
                        <RadzenTextBox @bind-Value="Expense.ReferenceNo" Placeholder="Bank / MFS transaction no" Style="width:100%" MaxLength="50" />
                    }
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenLabel Text="Description *" Component="Description" />
                    <RadzenTextArea @bind-Value="Expense.Description" Rows="3" Placeholder="Describe the expense" Style="width:100%" MaxLength="500" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        <div style="display:flex;justify-content:flex-end;gap:8px">
            <RadzenButton Text="Cancel"
                          Icon="cancel"
                          ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Flat"
                          Click="@Cancel"
                          Disabled="@IsProcessing" />
            <RadzenButton Text="Save"
                          Icon="save"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@Save"
                          IsBusy="@IsProcessing" />
        </div>
    </RadzenStack>
</RadzenCard>

<RadzenPopup @ref="expenseAccountPopup" Style="padding:0;" class="rz-dropdown-tree-popup"
             CloseOnClickOutside="true" Close="OnExpenseAccountPopupClose">
    <RadzenTree Style="width:100%; max-height:300px; overflow:auto;" Data="@ExpenseAccountTree"
                @bind-Value="@ExpenseAccountSelection" Change="@OnExpenseAccountSelect">
        <RadzenTreeLevel Text="@(e => ((AccountNode)e).Display)" ChildrenProperty="Children"
                         HasChildren="@(e => ((AccountNode)e).Children.Any())" Expanded="@(e => true)" />
    </RadzenTree>
</RadzenPopup>

@code {
    [Parameter] public int StoreId { get; set; }
    [Parameter] public int UserId { get; set; }
    [Parameter] public int EditId { get; set; }

    protected DailyExpenseDTO Expense { get; set; } = new();
    protected List<StoreDTO> Stores { get; set; } = new();
    protected List<FinancialAccountDropdownDTO> FinancialAccounts { get; set; } = new();
    protected List<AccountNode> ExpenseAccountTree { get; set; } = new();
    protected bool IsCash { get; set; } = true;
    protected bool IsPettyCash { get; set; } = false;
    protected bool IsProcessing { get; set; }

    protected ElementReference expenseAccountTrigger;
    protected RadzenPopup expenseAccountPopup;
    protected object? ExpenseAccountSelection;
    protected string? ExpenseAccountText;
    protected DailyExpenseAvailableCashDTO? AvailableCash { get; set; }
    protected bool IsLoadingCash { get; set; }
    protected bool isExpenseAccountOpen;

    protected bool IsEditMode => EditId > 0;

    // Users in a system group (GroupsRole.IsSystem = 1) - plus the built-in super
    // admin - may enter an expense against any store. Everyone else is pinned to
    // the store they are signed in to.
    protected bool CanChooseStore { get; set; }

    protected StoreDTO? SelectedStore => Stores.FirstOrDefault(s => s.Id == Expense.StoreId);

    protected decimal? AutoPostLimit => SelectedStore?.DailyExpenseLimit;

    protected bool HasLimit => AutoPostLimit is > 0;

    // Mirrors the server rule (InsertUpdateDailyExpenseHandler): a NULL or 0 threshold
    // means "no threshold configured", so every expense auto-posts.
    protected bool WillAutoPost => Expense.Amount <= 0 || !HasLimit || Expense.Amount <= AutoPostLimit!.Value;

    protected class AccountNode
    {
        public int AccountId { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public bool IsGroup { get; set; }
        public List<AccountNode> Children { get; set; } = new();
        public string Display => $"{Code} - {Name}";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            try
            {
                CanChooseStore = UserId == 1
                    || await ServiceUnitOfWork.UserGroupService.GetSystemGroupCountByUserId(UserId) > 0;
            }
            catch
            {
                CanChooseStore = false;
            }

            Stores = (await ServiceUnitOfWork.StoreService.GetStores()).ToList();
            FinancialAccounts = (await ServiceUnitOfWork.FinancialAccountsService.GetFinancialAccountsForDropdown()).ToList();

            var expenseAccounts = await ServiceUnitOfWork.ChartOfAccountService.GetExpenseAccounts();
            ExpenseAccountTree = BuildExpenseTree(expenseAccounts?.ToList() ?? new List<ChartOfAccountDTO>());

            if (IsEditMode)
            {
                var existing = await ServiceUnitOfWork.DailyExpenseService.GetDailyExpenseById(EditId);
                if (existing == null)
                {
                    NotificationService.Notify(NotificationSeverity.Error, "Error", "Expense record not found.");
                    DialogService.Close(null);
                    return;
                }

                Expense = existing;
                SetPaidFrom(!(existing.FinancialAccountId.HasValue && existing.FinancialAccountId.Value > 0));

                ExpenseAccountText = existing.LedgerAccountId.HasValue
                    ? (string.IsNullOrWhiteSpace(existing.LedgerAccountCode)
                        ? existing.LedgerAccountName
                        : $"{existing.LedgerAccountCode} - {existing.LedgerAccountName}")
                    : null;
            }
            else
            {
                Expense.ExpenseDate = DateTime.Today;
                Expense.StoreId = StoreId > 0 ? StoreId : Expense.StoreId;
            }

            // A user who may not choose a store is pinned to the one they are signed in to.
            if (!CanChooseStore && StoreId > 0)
                Expense.StoreId = StoreId;

            // Never leave the disabled dropdown empty.
            if (!CanChooseStore && Expense.StoreId <= 0 && Stores.Count > 0)
                Expense.StoreId = Stores[0].Id;

            await LoadAvailableCashAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
            DialogService.Close(null);
        }
    }

    protected void SetPaidFrom(bool cash)
    {
        IsCash = cash;
        if (cash) Expense.FinancialAccountId = null;
    }

    private static List<AccountNode> BuildExpenseTree(List<ChartOfAccountDTO> accounts)
    {
        var nodes = new Dictionary<int, AccountNode>();
        foreach (var a in accounts)
            nodes[a.AccountId] = new AccountNode { AccountId = a.AccountId, Code = a.Code, Name = a.Name, IsGroup = a.IsGroup };

        var roots = new List<AccountNode>();
        foreach (var a in accounts)
        {
            var node = nodes[a.AccountId];
            if (a.ParentId.HasValue && nodes.TryGetValue(a.ParentId.Value, out var parent))
                parent.Children.Add(node);
            else
                roots.Add(node);
        }
        return roots;
    }

    protected async Task ToggleExpenseAccount()
    {
        isExpenseAccountOpen = !isExpenseAccountOpen;
        await expenseAccountPopup.ToggleAsync(expenseAccountTrigger);
    }

    protected async Task OnExpenseAccountSelect()
    {
        if (isExpenseAccountOpen)
        {
            if (ExpenseAccountSelection is AccountNode node && !node.IsGroup)
            {
                Expense.LedgerAccountId = node.AccountId;
                ExpenseAccountText = node.Display;

                await LoadAvailableCashAsync();
            }

            isExpenseAccountOpen = false;
            await expenseAccountPopup.CloseAsync(expenseAccountTrigger);
        }
    }

    protected void OnExpenseAccountPopupClose()
    {
        isExpenseAccountOpen = false;
    }

    protected void ClearExpenseAccount()
    {
        Expense.LedgerAccountId = null;
        ExpenseAccountText = null;
        ExpenseAccountSelection = null;
        AvailableCash = null;
    }

    protected async Task LoadAvailableCashAsync()
    {
        AvailableCash = null;
        if (Expense.StoreId <= 0 || !Expense.LedgerAccountId.HasValue || Expense.LedgerAccountId.Value <= 0)
            return;

        IsLoadingCash = true;
        try
        {
            AvailableCash = await ServiceUnitOfWork.DailyExpenseService.GetAvailableCash(Expense.StoreId, Expense.LedgerAccountId.Value, IsPettyCash);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            IsLoadingCash = false;
            StateHasChanged();
        }
    }

    protected async Task Save()
    {
        if (Expense.StoreId <= 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", "Select a store.");
            return;
        }

        if (!Expense.LedgerAccountId.HasValue || Expense.LedgerAccountId.Value <= 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", "Select an expense account (ledger).");
            return;
        }

        if (Expense.Amount <= 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", "Amount must be greater than zero.");
            return;
        }

        if (string.IsNullOrWhiteSpace(Expense.Description))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", "Description is required.");
            return;
        }

        if (!IsCash && (!Expense.FinancialAccountId.HasValue || Expense.FinancialAccountId.Value <= 0))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", "Select a bank / MFS account.");
            return;
        }

        // The server owns the routing decision: an expense within the store's
        // auto-post threshold is posted to the ledger immediately, otherwise it
        // is saved unposted for the Post Ledger page. There is no daily cap to
        // enforce here.
        Expense.CreatedBy = UserId;
        Expense.UpdatedBy = IsEditMode ? (int?)UserId : null;
        Expense.FinancialAccountId = null;
        Expense.IsPettyCash = IsPettyCash;

        // Available-cash (ledger × cost center) hard limit.
        if (Expense.StoreId > 0 && Expense.LedgerAccountId.HasValue && Expense.LedgerAccountId.Value > 0)
        {
            AvailableCash ??= await ServiceUnitOfWork.DailyExpenseService.GetAvailableCash(Expense.StoreId, Expense.LedgerAccountId.Value, IsPettyCash);
            if (AvailableCash == null || !AvailableCash.CostCenterLinked)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Validation",
                    "This store has no cost center linked, so the available cash cannot be validated.", 5000);
                return;
            }
            if (Expense.Amount > AvailableCash.AvailableCash)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Validation",
                    $"Amount {Expense.Amount:N2} exceeds the available cash {AvailableCash.AvailableCash:N2} of ledger {AvailableCash.LedgerCode} for cost center {AvailableCash.CostCenterName}.", 5000);
                return;
            }
        }

        try
        {
            IsProcessing = true;
            var result = await ServiceUnitOfWork.DailyExpenseService.SaveUpdateDailyExpense(Expense);
            if (result.IsSuccessStatus)
            {
                DialogService.Close(result);
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Failed", result.Message, 5000);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message, 5000);
        }
        finally
        {
            IsProcessing = false;
        }
    }

    protected void Cancel() => DialogService.Close(null);
}