@page "/FinancialAccountsAdd"
@page "/FinancialAccountsAdd/{Id:int}"
@attribute [Authorize]
@using JM.UI.Entities.Model.Bank
@using JM.UI.Entities.Model.FinancialAccounts
@inherits FinancialAccountsAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading Financial Account...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header Card -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@Cancel"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="account_balance" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                        @if (IsEditMode)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"#{FinancialAccount.Id}")" />
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="@(IsEditMode ? "Reset Changes" : "Reset")"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Form Card -->
        <RadzenCard>
            <RadzenTemplateForm TItem="FinancialAccountDTO" Data="@FinancialAccount" Submit="@Save">
                <RadzenStack Gap="1.5rem">
                    <RadzenFieldset Text="Financial Account Information" Icon="account_balance">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Account Type *" Component="FinancialAccountTypeId" />
                                        <RadzenDropDown @bind-Value="@FinancialAccount.FinancialAccountTypeId"
                                                        Name="FinancialAccountTypeId"
                                                        Data="@AccountTypes"
                                                        TextProperty="Name"
                                                        ValueProperty="Id"
                                                        Placeholder="Select account type"
                                                        Style="width: 100%;"
                                                        Change="@OnAccountTypeChanged"
                                                        AllowClear="true" />
                                        <RadzenRequiredValidator Component="FinancialAccountTypeId" Text="Account Type is required" />
                                    </RadzenStack>
                                </RadzenColumn>

                                @if (IsMFSType)
                                {
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="MFS Type" Component="MFSTypeId" />
                                            <RadzenDropDown @bind-Value="@FinancialAccount.MFSTypeId"
                                                            Data="@MFSTypes"
                                                            TextProperty="Name"
                                                            ValueProperty="Id"
                                                            Placeholder="Select MFS type (optional)"
                                                            Style="width: 100%;"
                                                            AllowClear="true" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                }

                                @if (IsBankType)
                                {
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Bank" Component="BankId" />
                                            <RadzenDropDown @bind-Value="@FinancialAccount.BankId"
                                                            Data="@Banks"
                                                            TextProperty="Name"
                                                            ValueProperty="Id"
                                                            Placeholder="Select bank (optional)"
                                                            Style="width: 100%;"
                                                            AllowClear="true" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                }

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Account No *" Component="AccountNo" />
                                        <RadzenTextBox @bind-Value="@FinancialAccount.AccountNo"
                                                       Name="AccountNo"
                                                       Placeholder="e.g. 1234-5678-9012"
                                                       Style="width: 100%;"
                                                       MaxLength="100" />
                                        <RadzenRequiredValidator Component="AccountNo" Text="Account No is required" />
                                    </RadzenStack>
                                </RadzenColumn>

                                <RadzenColumn Size="12">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Remarks" Component="Remarks" />
                                        <RadzenTextArea @bind-Value="@FinancialAccount.Remarks"
                                                        Name="Remarks"
                                                        Placeholder="Additional remarks (optional)"
                                                        Style="width: 100%; min-height: 80px;"
                                                        MaxLength="500" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Action Buttons -->
                    <RadzenCard class="mt-2">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat"
                                          Click="@Cancel"
                                          Disabled="@IsProcessing" />
                            @if (!IsEditMode)
                            {
                                <RadzenButton Text="Save & Add New"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Click="@SaveAndNew"
                                              IsBusy="@IsProcessing"
                                              Disabled="@IsProcessing" />
                            }
                            <RadzenButton Text="@(IsEditMode ? "Update" : "Save")"
                                          Icon="@(IsEditMode ? "update" : "save")"
                                          ButtonStyle="ButtonStyle.Primary"
                                          ButtonType="ButtonType.Submit"
                                          IsBusy="@IsProcessing"
                                          BusyText="@(IsEditMode ? "Updating..." : "Saving...")" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenContent>