@page "/PurchaseOrdersAdd"
@page "/PurchaseOrdersAdd/{Id:int}"
@using JM.UI.Entities.Model.PurchaseOrders
@attribute [Authorize]
@inherits PurchaseOrdersAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="shopping_cart" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenTemplateForm TItem="PurchaseOrderModelDTO" Data="@PurchaseOrder" Submit="@Save">
        @if (IsLoading)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        }
        else
        {
            <RadzenCard>
                <RadzenRow Gap="1rem">
                    <!-- Header Information -->
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFieldset Text="Header Information">
                            <RadzenStack Gap="1rem">
                                
                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Date" Component="PurchaseOrderDate" />
                                    <RadzenDatePicker Name="PurchaseOrderDate" @bind-Value="@PurchaseOrder.PurchaseOrderDate" DateFormat="d" class="w-100" />
                                    <RadzenRequiredValidator Component="PurchaseOrderDate" Text="Date is required" />
                                </RadzenStack>

                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Supplier" Component="SupplierId" />
                                    <RadzenDropDown TValue="int" @bind-Value="@PurchaseOrder.SupplierId" 
                                                    Data="@Suppliers" TextProperty="Name" ValueProperty="Id"
                                                    Placeholder="Select Supplier..." class="w-100" Name="SupplierId"
                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" />
                                    <RadzenRequiredValidator Component="SupplierId" Text="Supplier is required" DefaultValue="0" />
                                </RadzenStack>

                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Store" Component="StoreId" />
                                    <RadzenDropDown TValue="int" @bind-Value="@PurchaseOrder.StoreId" 
                                                    Data="@Stores" TextProperty="Name" ValueProperty="Id"
                                                    Placeholder="Select Store..." class="w-100" Name="StoreId" />
                                    <RadzenRequiredValidator Component="StoreId" Text="Store is required" DefaultValue="0" />
                                </RadzenStack>

                                 <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="User Name" Component="UserName" />
                                    <RadzenTextBox Name="UserName" @bind-Value="@PurchaseOrder.UserName" class="w-100" />
                                </RadzenStack>

                            </RadzenStack>
                        </RadzenFieldset>
                    </RadzenColumn>

                    <!-- Financials & Status -->
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFieldset Text="Financials & Remarks">
                            <RadzenStack Gap="1rem">
                                
                                <RadzenRow>
                                    <RadzenColumn Size="6">
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenLabel Text="Discount %" Component="DiscountPercentage" />
                                            <RadzenNumeric Name="DiscountPercentage" @bind-Value="@PurchaseOrder.DiscountPercentage" TValue="decimal" class="w-100" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenLabel Text="Discount Amt" Component="Discount" />
                                            <RadzenNumeric Name="Discount" @bind-Value="@PurchaseOrder.Discount" TValue="decimal" class="w-100" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow>
                                    <RadzenColumn Size="6">
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenLabel Text="VAT %" Component="VATPercentage" />
                                            <RadzenNumeric Name="VATPercentage" @bind-Value="@PurchaseOrder.VATPercentage" TValue="decimal" class="w-100" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenLabel Text="VAT Amt" Component="VAT" />
                                            <RadzenNumeric Name="VAT" @bind-Value="@PurchaseOrder.VAT" TValue="decimal" class="w-100" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Status" Component="PurchaseOrderStatus" />
                                    <RadzenNumeric Name="PurchaseOrderStatus" @bind-Value="@PurchaseOrder.PurchaseOrderStatus" TValue="int" class="w-100" />
                                </RadzenStack>

                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Remarks" Component="Remarks" />
                                    <RadzenTextArea Name="Remarks" @bind-Value="@PurchaseOrder.Remarks" Rows="3" class="w-100" />
                                </RadzenStack>

                            </RadzenStack>
                        </RadzenFieldset>
                    </RadzenColumn>
                </RadzenRow>

                <!-- Purchase Order Items Section -->
                <RadzenRow Gap="1rem" class="mt-4">
                    <RadzenColumn Size="12">
                        <RadzenCard>
                            <RadzenText TextStyle="TextStyle.H6" class="mb-4">Order Items</RadzenText>
                            
                            <!-- Add Item Row -->
                            <div class="mb-4 p-3 border rounded">
                                <RadzenRow AlignItems="AlignItems.End" Gap="0.5rem">
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenLabel Text="Item" class="fw-bold small" />
                                        <RadzenDropDown @bind-Value="@NewItem.ItemId" 
                                                        Data="@ItemsList" 
                                                        TextProperty="Name" 
                                                        ValueProperty="Id" 
                                                        Placeholder="Search Item..." 
                                                        class="w-100" 
                                                        AllowFiltering="true" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="2">
                                        <RadzenLabel Text="Color" class="fw-bold small" />
                                        <RadzenDropDown @bind-Value="@NewItem.ColorId" 
                                                        Data="@ColorsList" 
                                                        TextProperty="Name" 
                                                        ValueProperty="Id" 
                                                        Placeholder="Color" 
                                                        class="w-100" 
                                                        AllowFiltering="true"
                                                        AllowClear="true" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="2">
                                        <RadzenLabel Text="Size" class="fw-bold small" />
                                        <RadzenDropDown @bind-Value="@NewItem.SizeId" 
                                                        Data="@SizesList" 
                                                        TextProperty="Name" 
                                                        ValueProperty="Id" 
                                                        Placeholder="Size" 
                                                        class="w-100" 
                                                        AllowFiltering="true"
                                                        AllowClear="true" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="2">
                                        <RadzenLabel Text="Qty" class="fw-bold small" />
                                        <RadzenNumeric @bind-Value="@NewItem.Quantity" class="w-100" ShowStep="false" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="2">
                                        <RadzenLabel Text="Price" class="fw-bold small" />
                                        <RadzenNumeric @bind-Value="@NewItem.TradePrice" class="w-100" ShowStep="false" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="1">
                                        <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Click="@AddLineItem" class="w-100" />
                                    </RadzenColumn>
                                </RadzenRow>
                            </div>

                            <RadzenDataGrid TItem="JM.UI.Entities.Model.PurchaseOrderItems.PurchaseOrderItemsDTO" Data="@PurchaseOrder.PurchaseOrderItems" AllowPaging="false" AllowSorting="false" Density="Density.Compact" GridLines="DataGridGridLines.Both">
                                <Columns>
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseOrderItems.PurchaseOrderItemsDTO" Property="ItemName" Title="Item" />
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseOrderItems.PurchaseOrderItemsDTO" Property="ColorName" Title="Color" Width="100px" />
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseOrderItems.PurchaseOrderItemsDTO" Property="SizeName" Title="Size" Width="80px" />
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseOrderItems.PurchaseOrderItemsDTO" Property="Quantity" Title="Qty" Width="80px" TextAlign="TextAlign.Right" />
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseOrderItems.PurchaseOrderItemsDTO" Property="TradePrice" Title="Price" Width="100px" FormatString="{0:N2}" TextAlign="TextAlign.Right" />
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseOrderItems.PurchaseOrderItemsDTO" Title="Total" Width="100px" TextAlign="TextAlign.Right">
                                        <Template Context="item">
                                            @((item.Quantity * item.TradePrice).ToString("N2"))
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseOrderItems.PurchaseOrderItemsDTO" Title="Action" Width="60px" TextAlign="TextAlign.Center">
                                        <Template Context="item">
                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Click="@(args => RemoveLineItem(item))" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>

                            <RadzenRow JustifyContent="JustifyContent.End" class="mt-4">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                                    <RadzenText TextStyle="TextStyle.H6" class="mb-0">Items Total:</RadzenText>
                                    <RadzenText TextStyle="TextStyle.H5" class="mb-0 fw-bold" Style="color: var(--rz-primary);">
                                        @(PurchaseOrder.PurchaseOrderItems.Sum(i => i.Quantity * i.TradePrice).ToString("N2"))
                                    </RadzenText>
                                </RadzenStack>
                            </RadzenRow>
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>

                <!-- Action Buttons -->
                <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem" class="mt-4">
                    <RadzenButton Text="Cancel" 
                                  ButtonStyle="ButtonStyle.Light" 
                                  Click="@Cancel" 
                                  Icon="cancel" 
                                  Disabled="@IsProcessing" />
                    
                    <RadzenButton ButtonType="ButtonType.Submit" 
                                  Text="@(IsEditMode ? "Update" : "Create")" 
                                  ButtonStyle="ButtonStyle.Primary" 
                                  Icon="save" 
                                  IsBusy="@IsProcessing" />
                </RadzenRow>
            </RadzenCard>
        }
    </RadzenTemplateForm>
</RadzenContent>
