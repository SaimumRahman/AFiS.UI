@page "/PurchasesAdd"
@page "/PurchasesAdd/{Id:int}"
@using JM.UI.Entities.Model.Purchases
@attribute [Authorize]
@inherits PurchasesAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="receipt" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenTemplateForm TItem="PurchaseModelDTO" Data="@Purchase" Submit="@Save">
        @if (IsLoading)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        }
        else
        {
            <RadzenCard>
                <RadzenRow Gap="1rem">
                    <!-- General Details -->
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFieldset Text="General Information">
                            <RadzenStack Gap="1rem">
                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Date" Component="PurchaseDate" />
                                    <RadzenDatePicker Name="PurchaseDate" @bind-Value="@Purchase.PurchaseDate" DateFormat="d" class="w-100" />
                                    <RadzenRequiredValidator Component="PurchaseDate" Text="Date is required" />
                                </RadzenStack>

                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Store Purchase ID" Component="StorePurchaseId" />
                                    <RadzenNumeric Name="StorePurchaseId" @bind-Value="@Purchase.StorePurchaseId" TValue="int" class="w-100" />
                                    <RadzenRequiredValidator Component="StorePurchaseId" Text="Store Purchase ID is required" DefaultValue="0" />
                                </RadzenStack>

                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Supplier" Component="SupplierId" />
                                    <RadzenDropDown TValue="int" @bind-Value="@Purchase.SupplierId" 
                                                    Data="@Suppliers" TextProperty="Name" ValueProperty="Id"
                                                    Placeholder="Select Supplier..." class="w-100" Name="SupplierId"
                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" />
                                    <RadzenRequiredValidator Component="SupplierId" Text="Supplier is required" DefaultValue="0" />
                                </RadzenStack>

                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Store" Component="StoreId" />
                                    <RadzenDropDown TValue="int" @bind-Value="@Purchase.StoreId" 
                                                    Data="@Stores" TextProperty="Name" ValueProperty="Id"
                                                    Placeholder="Select Store..." class="w-100" Name="StoreId" />
                                    <RadzenRequiredValidator Component="StoreId" Text="Store is required" DefaultValue="0" />
                                </RadzenStack>

                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Purchase Order (Optional)" Component="PurchaseOrderId" />
                                    <RadzenDropDown TValue="int?" @bind-Value="@Purchase.PurchaseOrderId" 
                                                    Data="@PurchaseOrders" TextProperty="Id" ValueProperty="Id"
                                                    Placeholder="Select PO..." class="w-100" Name="PurchaseOrderId"
                                                    AllowClear="true"/>
                                </RadzenStack>

                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Voucher" Component="VoucherId" />
                                    <RadzenDropDown TValue="int" @bind-Value="@Purchase.VoucherId" 
                                                    Data="@Vouchers" TextProperty="VoucherNo" ValueProperty="Id"
                                                    Placeholder="Select Voucher..." class="w-100" Name="VoucherId"
                                                    AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                                    <RadzenRequiredValidator Component="VoucherId" Text="Voucher is required" DefaultValue="0" />
                                </RadzenStack>

                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Invoice No" Component="InvoiceNo" />
                                    <RadzenTextBox Name="InvoiceNo" @bind-Value="@Purchase.InvoiceNo" class="w-100" />
                                </RadzenStack>
                                
                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="User Name" Component="UserName" />
                                    <RadzenTextBox Name="UserName" @bind-Value="@Purchase.UserName" class="w-100" />
                                </RadzenStack>

                            </RadzenStack>
                        </RadzenFieldset>
                    </RadzenColumn>

                    <!-- Financial Details -->
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFieldset Text="Financial Details">
                            <RadzenStack Gap="1rem">
                                
                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Sub Total" Component="Total" />
                                    <RadzenNumeric Name="Total" @bind-Value="@Purchase.Total" TValue="decimal" class="w-100" Disabled="true" Style="background-color: #f8f9fa;" />
                                </RadzenStack>

                                <RadzenRow>
                                    <RadzenColumn Size="6">
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenLabel Text="Discount %" Component="DiscountPercentage" />
                                            <RadzenNumeric Name="DiscountPercentage" @bind-Value="@Purchase.DiscountPercentage" TValue="decimal" class="w-100" Change="@CalculateTotals" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenLabel Text="Discount Amt" Component="Discount" />
                                            <RadzenNumeric Name="Discount" @bind-Value="@Purchase.Discount" TValue="decimal" class="w-100" Change="@CalculateTotals" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow>
                                    <RadzenColumn Size="6">
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenLabel Text="VAT %" Component="VATPercentage" />
                                            <RadzenNumeric Name="VATPercentage" @bind-Value="@Purchase.VATPercentage" TValue="decimal" class="w-100" Change="@CalculateTotals" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenLabel Text="VAT Amt" Component="VAT" />
                                            <RadzenNumeric Name="VAT" @bind-Value="@Purchase.VAT" TValue="decimal" class="w-100" Change="@CalculateTotals" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow>
                                    <RadzenColumn Size="6">
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenLabel Text="Labour Charge" Component="LabourCharge" />
                                            <RadzenNumeric Name="LabourCharge" @bind-Value="@Purchase.LabourCharge" TValue="decimal" class="w-100" Change="@CalculateTotals" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenLabel Text="Transport Cost" Component="TransportCost" />
                                            <RadzenNumeric Name="TransportCost" @bind-Value="@Purchase.TransportCost" TValue="decimal" class="w-100" Change="@CalculateTotals" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Net Total" Component="NetTotal" />
                                    <RadzenNumeric Name="NetTotal" @bind-Value="@Purchase.NetTotal" TValue="decimal" class="w-100" Disabled="true"  />
                                </RadzenStack>

                            </RadzenStack>
                        </RadzenFieldset>
                    </RadzenColumn>
                </RadzenRow>

                <!-- Purchase Items Section -->
                <RadzenRow Gap="1rem" class="mt-4">
                    <RadzenColumn Size="12">
                        <RadzenCard>
                            <RadzenText TextStyle="TextStyle.H6" class="mb-4">Purchase Items</RadzenText>
                            
                            <!-- Add Item Row -->
                            <div class="mb-4 p-3 border rounded">
                                <RadzenRow AlignItems="AlignItems.End" Gap="0.5rem">
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenLabel Text="Item" class="fw-bold small" />
                                        <RadzenDropDown @bind-Value="@NewItem.ItemId" 
                                                        Data="@ItemsList" 
                                                        TextProperty="Name" 
                                                        ValueProperty="Id" 
                                                        Placeholder="Search Item..." 
                                                        class="w-100" 
                                                        AllowFiltering="true" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="2">
                                        <RadzenLabel Text="Color" class="fw-bold small" />
                                        <RadzenDropDown @bind-Value="@NewItem.ColorId" 
                                                        Data="@ColorsList" 
                                                        TextProperty="Name" 
                                                        ValueProperty="Id" 
                                                        Placeholder="Color" 
                                                        class="w-100" 
                                                        AllowFiltering="true"
                                                        AllowClear="true" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="2">
                                        <RadzenLabel Text="Size" class="fw-bold small" />
                                        <RadzenDropDown @bind-Value="@NewItem.SizeId" 
                                                        Data="@SizesList" 
                                                        TextProperty="Name" 
                                                        ValueProperty="Id" 
                                                        Placeholder="Size" 
                                                        class="w-100" 
                                                        AllowFiltering="true"
                                                        AllowClear="true" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="2">
                                        <RadzenLabel Text="Qty" class="fw-bold small" />
                                        <RadzenNumeric @bind-Value="@NewItem.Quantity" class="w-100" ShowStep="false" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="2">
                                        <RadzenLabel Text="Price" class="fw-bold small" />
                                        <RadzenNumeric @bind-Value="@NewItem.TradePrice" class="w-100" ShowStep="false" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="1">
                                        <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Click="@AddLineItem" class="w-100" />
                                    </RadzenColumn>
                                </RadzenRow>
                            </div>

                            <RadzenDataGrid TItem="JM.UI.Entities.Model.PurchaseItems.PurchaseItemsDTO" Data="@Purchase.PurchaseItems" AllowPaging="false" AllowSorting="false" Density="Density.Compact" GridLines="DataGridGridLines.Both">
                                <Columns>
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseItems.PurchaseItemsDTO" Property="ItemName" Title="Item" />
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseItems.PurchaseItemsDTO" Property="ColorName" Title="Color" Width="100px" />
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseItems.PurchaseItemsDTO" Property="SizeName" Title="Size" Width="80px" />
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseItems.PurchaseItemsDTO" Property="Quantity" Title="Qty" Width="80px" TextAlign="TextAlign.Right" />
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseItems.PurchaseItemsDTO" Property="TradePrice" Title="Price" Width="100px" FormatString="{0:N2}" TextAlign="TextAlign.Right" />
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseItems.PurchaseItemsDTO" Title="Total" Width="100px" TextAlign="TextAlign.Right">
                                        <Template Context="item">
                                            @((item.Quantity * item.TradePrice).ToString("N2"))
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="JM.UI.Entities.Model.PurchaseItems.PurchaseItemsDTO" Title="Action" Width="60px" TextAlign="TextAlign.Center">
                                        <Template Context="item">
                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Click="@(args => RemoveLineItem(item))" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>

                            <RadzenRow JustifyContent="JustifyContent.End" class="mt-4">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                                    <RadzenText TextStyle="TextStyle.H6" class="mb-0">Items Total:</RadzenText>
                                    <RadzenText TextStyle="TextStyle.H5" class="mb-0 fw-bold" Style="color: var(--rz-primary);">
                                        @(Purchase.PurchaseItems.Sum(i => i.Quantity * i.TradePrice).ToString("N2"))
                                    </RadzenText>
                                </RadzenStack>
                            </RadzenRow>
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>

                <!-- Action Buttons -->
                <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem" class="mt-4">
                    <RadzenButton Text="Cancel" 
                                  ButtonStyle="ButtonStyle.Light" 
                                  Click="@Cancel" 
                                  Icon="cancel" 
                                  Disabled="@IsProcessing" />
                    
                    <RadzenButton ButtonType="ButtonType.Submit" 
                                  Text="@(IsEditMode ? "Update" : "Create")" 
                                  ButtonStyle="ButtonStyle.Primary" 
                                  Icon="save" 
                                  IsBusy="@IsProcessing" />
                </RadzenRow>
            </RadzenCard>
        }
    </RadzenTemplateForm>
</RadzenContent>
