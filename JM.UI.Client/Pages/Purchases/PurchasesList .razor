@page "/PurchaseList"
@using JM.UI.Entities.Model.Purchases
@using JM.UI.Entities.Model.PurchaseItems
@inherits PurchaseListComponent
@attribute [Authorize]

<PageTitle>Purchase List</PageTitle>

<RadzenContent Container="main" class="p-4">

    <!-- HEADER -->
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="receipt_long" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Purchase Management</RadzenText>
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">

                    <RadzenButton Icon="print"
                                  Text="@(IsPrinting ? "Generating..." : "Print Report")"
                                  Click="@PrintReport"
                                  ButtonStyle="ButtonStyle.Info"
                                  Disabled="@IsPrinting"
                                  IsBusy="@IsPrinting" />

                    <RadzenButton Icon="add_circle_outline"
                                  Text="New Purchase"
                                  Click="@AddPurchase"
                                  ButtonStyle="ButtonStyle.Primary" />

                    <RadzenButton Icon="refresh"
                                  Text="Refresh"
                                  Click="@LoadPurchases"
                                  ButtonStyle="ButtonStyle.Light" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <!-- MAIN GRID -->
    <RadzenCard>
        <RadzenDataGrid @ref="PurchasesGrid"
                        Data="@Purchases"
                        TItem="PurchaseSummaryDTO"
                        AllowFiltering="true"
                        AllowPaging="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        ShowExpandColumn="true"
                        ExpandMode="DataGridExpandMode.Single"
                        RowExpand="@OnRowExpand"
                        PageSize="10"
                        IsLoading="@IsLoading"
                        Density="Density.Compact">

            <!-- EXPANDED ROW -->
            <Template Context="purchase">
                <RadzenCard class="m-3">

                    <RadzenText TextStyle="TextStyle.H6" class="mb-3">
                        Purchase Items — Invoice: @purchase.BillInvoiceNumber
                    </RadzenText>

                    @{
                        var items = GetPurchaseItems(purchase);
                    }

                    <RadzenDataGrid Data="@items"
                                    TItem="PurchaseItemDTO"
                                    AllowFiltering="true"
                                    AllowSorting="true"
                                    Density="Density.Compact">

                        <Columns>
                            <RadzenDataGridColumn TItem="PurchaseItemDTO"
                                                  Title="Image"
                                                  Width="60px"
                                                  Sortable="false"
                                                  Filterable="false">
                                <Template Context="item">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageBase64))
                                    {
                                        <img src="@item.ImageBase64"
                                             alt="@item.ItemName"
                                             style="width:40px; height:40px; object-fit:cover; border-radius:4px; border:1px solid #dee2e6; cursor:pointer;"
                                             @onclick="@(() => OpenImagePreview(item.ImageBase64, item.ItemName))" />
                                    }
                                    else
                                    {
                                        <div style="width:40px; height:40px; border:1px dashed #ccc; border-radius:4px;
                                            display:flex; align-items:center; justify-content:center; background:#f9f9f9;">
                                            <RadzenIcon Icon="image_not_supported" Style="font-size:1rem; color:#bbb;" />
                                        </div>
                                    }
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="PurchaseItemDTO"
                                                  Title="#"
                                                  Width="60px">
                                <Template Context="item">
                                    @(items.IndexOf(item) + 1)
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="PurchaseItemDTO"
                                                  Property="ItemName"
                                                  Title="Item Name" />

                            <RadzenDataGridColumn TItem="PurchaseItemDTO"
                                                  Property="Barcode"
                                                  Title="Barcode" />

                            <RadzenDataGridColumn TItem="PurchaseItemDTO"
                                                  Property="Quantity"
                                                  Title="Qty"
                                                  TextAlign="TextAlign.Right" />

                            <RadzenDataGridColumn TItem="PurchaseItemDTO"
                                                  Property="PurchasePrice"
                                                  Title="Purchase Price"
                                                  TextAlign="TextAlign.Right" />

                            <RadzenDataGridColumn TItem="PurchaseItemDTO"
                                                  Property="VatAmount"
                                                  Title="VAT"
                                                  TextAlign="TextAlign.Right"
                                                  FormatString="{0:C}" />

                            <RadzenDataGridColumn TItem="PurchaseItemDTO"
                                                  Property="TotalAmount"
                                                  Title="Total"
                                                  TextAlign="TextAlign.Right" />
                        </Columns>
                    </RadzenDataGrid>

                </RadzenCard>
            </Template>

            <!-- MASTER COLUMNS -->
            <Columns>

                <RadzenDataGridColumn TItem="PurchaseSummaryDTO"
                                      Property="BillInvoiceNumber"
                                      Title="Invoice No"
                                      Width="180px" />

                <RadzenDataGridColumn TItem="PurchaseSummaryDTO"
                                      Property="PurchaseDate"
                                      Title="Date"
                                      Width="140px"
                                      FormatString="{0:dd-MMM-yyyy}" />

                <RadzenDataGridColumn TItem="PurchaseSummaryDTO"
                                      Property="SupplierName"
                                      Width="140px"
                                      Title="Supplier" />

                <RadzenDataGridColumn TItem="PurchaseSummaryDTO"
                                      Property="TotalItems"
                                      Title="Items"
                                      Width="90px"
                                      TextAlign="TextAlign.Center" />

                <RadzenDataGridColumn TItem="PurchaseSummaryDTO"
                                      Property="NetAmount"
                                      Title="Net Amount"
                                      Width="150px"
                                      TextAlign="TextAlign.Right" />

                <RadzenDataGridColumn TItem="PurchaseSummaryDTO"
                                      Width="120px"
                                      TextAlign="TextAlign.Center">
                    @* Action buttons can be re-enabled here when needed *@
                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>
    </RadzenCard>
</RadzenContent>
