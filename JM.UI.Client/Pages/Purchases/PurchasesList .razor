@page "/PurchaseList"
@using JM.UI.Entities.Model.Purchases
@using JM.UI.Entities.Model.PurchaseItems
@inherits PurchaseListComponent
@attribute [Authorize]

<PageTitle>Purchase List</PageTitle>

<RadzenContent Container="main" class="p-4">

    <!-- HEADER -->
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="receipt_long" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Purchase Management</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Icon="add_circle_outline"
                                  Text="New Purchase"
                                  Click="@AddPurchase"
                                  ButtonStyle="ButtonStyle.Primary" />
                    <RadzenButton Icon="refresh"
                                  Text="Refresh"
                                  Click="@LoadPurchases"
                                  ButtonStyle="ButtonStyle.Light" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <!-- DATE FILTER + PRINT BAR -->
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.End" Gap="0.75rem">

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="From Date" />
                    <RadzenDatePicker @bind-Value="FilterDateFrom"
                                      DateFormat="dd-MMM-yyyy"
                                      Placeholder="Select from date"
                                      Style="width:100%"
                                      Change="@(async (DateTime? value) => await OnDateFilterChanged())" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="To Date" />
                    <RadzenDatePicker @bind-Value="FilterDateTo"
                                      DateFormat="dd-MMM-yyyy"
                                      Placeholder="Select to date"
                                      Style="width:100%"
                                      Change="@(async (DateTime? value) => await OnDateFilterChanged())" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Return Ref No" />
                    <RadzenTextBox @bind-Value="ReferenceNo"
                                   Placeholder="Enter Ref No"
                                      Style="width:100%" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">

                    <RadzenButton Icon="filter_alt"
                                  Text="Apply Filter"
                                  Click="@ApplyDateFilter"
                                  ButtonStyle="ButtonStyle.Secondary" />

                    <RadzenButton Icon="filter_alt_off"
                                  Text="Clear"
                                  Click="@ClearDateFilter"
                                  ButtonStyle="ButtonStyle.Light" />

                    <RadzenButton Icon="print"
                                  Text="@(IsPrinting ? "Generating..." : "Print Report")"
                                  Click="@PrintReport"
                                  ButtonStyle="ButtonStyle.Info"
                                  Disabled="@(IsPrinting || !FilteredPurchases.Any())"
                                  IsBusy="@IsPrinting" />

                </RadzenStack>
            </RadzenColumn>

        </RadzenRow>

        @if (IsFiltered)
        {
            <RadzenRow class="mt-2">
                <RadzenColumn>
                    <RadzenBadge BadgeStyle="BadgeStyle.Info"
                                 IsPill="true"
                                 Text="@GetActiveFilterLabel()" />
                    <RadzenText TagName="TagName.Span" class="ms-2" TextStyle="TextStyle.Caption">
                        @FilteredPurchases.Count() record(s) found
                    </RadzenText>
                </RadzenColumn>
            </RadzenRow>
        }
    </RadzenCard>

    <!-- MAIN GRID -->
    <RadzenCard>
        <RadzenDataGrid @ref="PurchasesGrid"
                        Data="@FilteredPurchases"
                        TItem="PurchaseSummaryDTO"
                        AllowFiltering="true"
                        AllowPaging="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        ShowExpandColumn="true"
                        ExpandMode="DataGridExpandMode.Single"
                        RowExpand="@OnRowExpand"
                        PageSize="10"
                        IsLoading="@IsLoading"
                        Density="Density.Compact">

            <!-- EXPANDED ROW -->
            <Template Context="purchase">
                <RadzenCard class="m-3">
                    <RadzenText TextStyle="TextStyle.H6" class="mb-3">
                        Purchase Items — Invoice: @purchase.BillInvoiceNumber
                    </RadzenText>

                    @{
                        var items = GetPurchaseItems(purchase);
                    }

                    <RadzenDataGrid Data="@items"
                                    TItem="PurchaseItemDTO"
                                    AllowFiltering="true"
                                    AllowSorting="true"
                                    Density="Density.Compact">
                        <Columns>
                            <RadzenDataGridColumn TItem="PurchaseItemDTO" Title="Image" Width="60px"
                                                  Sortable="false" Filterable="false">
                                <!-- existing template -->
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="PurchaseItemDTO" Title="#" Width="50px">
                                <Template Context="item">@(items.IndexOf(item) + 1)</Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="ItemName" Title="Item Name" Width="150px" />
                            <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="Barcode" Title="Barcode" Width="90px" />
                            <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="Quantity" Title="Qty" Width="50px" TextAlign="TextAlign.Right" />
                            <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="PurchasePrice" Title="Purchase Price" Width="90px" TextAlign="TextAlign.Right" />
                            <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="VatAmount" Title="VAT" Width="90px" TextAlign="TextAlign.Right" FormatString="{0:C}" />
                            <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="TotalAmount" Title="Total" Width="90px" TextAlign="TextAlign.Right" />
                            <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="ReturnRefNo" Title="Return Ref No" Width="140px" />
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            </Template>

            <!-- MASTER COLUMNS -->
            <Columns>
                <RadzenDataGridColumn TItem="PurchaseSummaryDTO" Property="SystemInvoiceNo" Title="Purchase No" Width="180px" />
                <RadzenDataGridColumn TItem="PurchaseSummaryDTO" Property="BillInvoiceNumber" Title="Invoice No" Width="180px" />
                <RadzenDataGridColumn TItem="PurchaseSummaryDTO" Property="PurchaseDate" Title="PurchaseDate" Width="120px" FormatString="{0:dd-MMM-yyyy}" />
                <RadzenDataGridColumn TItem="PurchaseSummaryDTO" Property="BillDate" Title="Bill Date" Width="120px" FormatString="{0:dd-MMM-yyyy}" />
                <RadzenDataGridColumn TItem="PurchaseSummaryDTO" Property="SupplierName" Title="Supplier" Width="140px" />
      @*           <RadzenDataGridColumn TItem="PurchaseSummaryDTO" Property="TotalItems" Title="Total Items" Width="90px" TextAlign="TextAlign.Center" /> *@
                <RadzenDataGridColumn TItem="PurchaseSummaryDTO" Property="NetAmount" Title="Net Amount" Width="150px" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="PurchaseSummaryDTO" Property="Remarks" Title="Remarks" Width="150px" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="PurchaseSummaryDTO" Width="130px" TextAlign="TextAlign.Center">
                    <Template Context="p">
                        <RadzenButton Text=@(IsPrintingId == p.Id ? "Printing..." : "Print Purchase")
                                      ButtonStyle="ButtonStyle.Info"
                                      ButtonSize="ExtraSmall"
                                      IsBusy="@(IsPrintingId == p.Id)"
                                      Disabled="@(IsPrintingId.HasValue && IsPrintingId != p.Id)"
                                      Click="@(() => PrintSingleReport(p))" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="PurchaseSummaryDTO" Width="110px" TextAlign="TextAlign.Center">
                    <Template Context="p">
                        <RadzenButton Text="Print Barcode"
                                      ButtonStyle="ButtonStyle.Light"
                                      ButtonSize="ExtraSmall"
                                      Click="@(() => NavigateToBarcodePrint(p.Id))" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="PurchaseSummaryDTO" Width="60px" TextAlign="TextAlign.Center">
                    <Template Context="p">
                        <RadzenButton Icon="delete"
                                      ButtonStyle="ButtonStyle.Danger"
                                      ButtonSize="ExtraSmall"
                                      Tooltip="Delete Purchase"
                                      Click="@(() => DeletePurchase(p))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>
    </RadzenCard>

</RadzenContent>
