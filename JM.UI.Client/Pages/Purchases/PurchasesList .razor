@page "/PurchasesList"
@using JM.UI.Entities.Model.Purchases
@inherits PurchasesListComponent

<PageTitle>Purchases</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="receipt_long" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Purchases</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Icon="add_circle_outline"
                                  Text="New Purchase"
                                  Click="@AddPurchase"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Medium" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenCard>
        <RadzenDataGrid @ref="PurchasesGrid"
                        Data="@PurchasesList"
                        TItem="PurchaseModelDTO"
                        AllowFiltering="true"
                        AllowColumnResize="true"
                        AllowAlternatingRows="true"
                        AllowPaging="true"
                        AllowSorting="true"
                        PagerHorizontalAlign="HorizontalAlign.Center"
                        PageSize="15"
                        FilterMode="FilterMode.Advanced"
                        ShowPagingSummary="true"
                        IsLoading="@IsLoading"
                        GridLines="DataGridGridLines.Both"
                        Density="Density.Compact">

            <Columns>
                <RadzenDataGridColumn TItem="PurchaseModelDTO" Property="Id" Title="ID" Width="70px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="PurchaseModelDTO" Property="PurchaseDate" Title="Date" Width="100px" FormatString="{0:d}" />
                <RadzenDataGridColumn TItem="PurchaseModelDTO" Property="SupplierName" Title="Supplier" Width="150px" />
                <RadzenDataGridColumn TItem="PurchaseModelDTO" Property="StoreName" Title="Store" Width="150px" />
                <RadzenDataGridColumn TItem="PurchaseModelDTO" Property="InvoiceNo" Title="Invoice No" Width="120px" />
                <RadzenDataGridColumn TItem="PurchaseModelDTO" Property="NetTotal" Title="Net Total" Width="100px" FormatString="{0:C}" TextAlign="TextAlign.Right" />
                
                <RadzenDataGridColumn TItem="PurchaseModelDTO" Title="Actions" Width="100px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                    <Template Context="purchase">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                            <RadzenButton Icon="edit"
                                          ButtonStyle="ButtonStyle.Info"
                                          Size="ButtonSize.Small"
                                          Variant="Variant.Flat"
                                          Click="@(() => EditPurchase(purchase))" />

                            <RadzenButton Icon="delete"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Size="ButtonSize.Small"
                                          Variant="Variant.Flat"
                                          Click="@(() => DeletePurchase(purchase))" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenContent>
