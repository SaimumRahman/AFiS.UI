@page "/PurchaseEntry"
@page "/PurchaseEntry/Edit/{Id:int}"
@page "/PurchaseEntry/Draft/{DraftId:int}"

@using JM.UI.Entities.Model.PurchaseItems
@inherits PurchaseEntryComponent

<PageTitle>@PageTitle</PageTitle>

<style>
    /* ── Compact form: reduce all Radzen input/select/datepicker heights ── */
    .rz-text-box,
    .rz-autocomplete-input,
    .rz-dropdown,
    .rz-dropdowndatagrid,
    .rz-numeric,
    .rz-datepicker .rz-inputtext,
    .rz-textarea {
        --rz-input-height: 26px;
        min-height: 26px !important;
        height: 26px !important;
        font-size: 0.75rem !important;
        padding-top: 2px !important;
        padding-bottom: 2px !important;
        padding-left: 6px !important;
        padding-right: 6px !important;
        line-height: 1.3 !important;
    }

    /* Textarea gets auto height override */
    .rz-textarea {
        height: auto !important;
        min-height: 42px !important;
    }

    /* Inner native inputs inside Radzen wrappers */
    .rz-text-box input,
    .rz-autocomplete input,
    .rz-numeric input,
    .rz-datepicker input,
    .rz-dropdown .rz-dropdown-label,
    .rz-dropdowndatagrid .rz-dropdown-label {
        height: 26px !important;
        min-height: 26px !important;
        font-size: 0.75rem !important;
        padding: 2px 6px !important;
        line-height: 1.3 !important;
    }

    /* Radzen dropdown trigger label */
    .rz-dropdown-label,
    .rz-dropdowndatagrid-label {
        height: 26px !important;
        min-height: 26px !important;
        font-size: 0.75rem !important;
        padding: 2px 6px !important;
        line-height: 22px !important;
    }

    /* Dropdown/datepicker icons inside inputs */
    .rz-dropdown .rz-dropdown-trigger,
    .rz-dropdowndatagrid .rz-dropdown-trigger,
    .rz-datepicker .rz-calendar-button {
        height: 26px !important;
        width: 26px !important;
        line-height: 26px !important;
    }

    /* Radzen label line-height tightening */
    .rz-form-field label,
    label.rz-label {
        font-size: 0.75rem !important;
        line-height: 1.2 !important;
        margin-bottom: 1px !important;
    }

    /* Row gaps inside cards */
    .rz-card .rz-stack > * {
        margin-bottom: 0 !important;
    }

    /* Compact alert banners */
    .rz-messages .rz-message,
    .rz-alert {
        padding: 3px 8px !important;
        font-size: 0.72rem !important;
    }

    /* Compact datagrid rows */
    .rz-data-grid .rz-datatable-tbody > tr > td {
        padding: 3px 6px !important;
        font-size: 0.75rem !important;
    }

    .rz-data-grid .rz-datatable-thead > tr > th {
        padding: 3px 6px !important;
        font-size: 0.73rem !important;
    }

    .compact-grid {
        font-size: 0.65rem !important;
    }

        .compact-grid .rz-cell-data {
            font-size: 0.65rem !important;
            padding-top: 2px !important;
            padding-bottom: 2px !important;
        }

        .compact-grid .rz-column-title {
            font-size: 0.65rem !important;
        }

        .compact-grid .rz-footer {
            font-size: 0.65rem !important;
        }

    .compact-input {
        font-size: 0.65rem !important;
        height: 26px !important;
        padding: 2px 6px !important;
    }
</style>

@if (IsLoading)
{
    <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large">
        <Template>Loading...</Template>
    </RadzenProgressBarCircular>
}
else
{
    <RadzenStack Gap="0.25rem">

        <!-- Page Header -->
        <RadzenRow>
            <RadzenColumn Size="12">
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H1" Style="margin:0; font-size:1rem; font-weight:700;">@PageTitle</RadzenText>
            </RadzenColumn>
        </RadzenRow>

        <!-- ============================================================
             MAIN ENTRY SECTION: Left Panel + Right Panel (2-column)
             ============================================================ -->
        <RadzenCard Style="padding: 0.4rem;">
            <RadzenRow Gap="0.4rem">

                <!-- ========================
                     LEFT PANEL
                     ======================== -->
                <RadzenColumn Size="12" SizeLG="4" Style="border-right: 1px solid #dee2e6; padding-right: 0.4rem;">
                    <RadzenStack Gap="0.2rem">

                        <!-- Supplier -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Supplier" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDropDown @bind-Value="Purchase.SupplierId"
                                                Data="@Suppliers"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select..."
                                                Style="width:100%; font-size:0.75rem;"
                                                AllowFiltering="true"
                                                Disabled="@IsProcessing" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- S.Bill No -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="S.Bill No" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenTextBox @bind-Value="Purchase.BillInvoiceNumber"
                                               Placeholder="Input Supplier Bill No"
                                               Disabled="@IsProcessing" 
                                               Style="width:100%; font-size:0.65rem; height:24px; padding:2px 6px;" />
                            </RadzenColumn>

                        </RadzenRow>

                        <!-- BillDate -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="BillDate" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDatePicker @bind-Value="Purchase.PurchaseDate"
                                                  Style="width:100%; font-size:0.75rem;"
                                                  DateFormat="dd/MM/yyyy"
                                                  Placeholder="Pick Date"
                                                  Disabled="@IsProcessing" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Type -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Type" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.3rem" AlignItems="AlignItems.Center" Style="flex-wrap:wrap;">
                                    <RadzenCheckBox @bind-Value="CurrentItem.IsSaleable" Name="typeSale" Visible="false" />
                                    <RadzenCheckBox @bind-Value="CurrentItem.IsConsume" Name="typeConsume" />
                                    <RadzenLabel Text="Consume" Component="typeConsume" Style="font-size:0.75rem;" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Store -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Store" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDropDown @bind-Value="Purchase.StoreId"
                                                Data="@Stores"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select..."
                                                Style="width:100%; font-size:0.75rem;"
                                                AllowFiltering="true"
                                                Disabled="@IsProcessing" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Group -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Group" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDropDown @bind-Value="CurrentItem.GroupId"
                                                Data="@Groups"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select..."
                                                Change="@(args => OnGroupChanged((int?)args))"
                                                Style="width:100%; font-size:0.75rem;"
                                                AllowFiltering="true"
                                                Disabled="@IsProcessing" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- SubProduct -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="SubProduct" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDropDown @bind-Value="CurrentItem.SubGroupId"
                                                Data="@SubGroups"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select..."
                                                Style="width:100%; font-size:0.75rem;"
                                                AllowFiltering="true"
                                                Change="@(args => OnSubGroupChanged((int?)args))"
                                                Disabled="@(IsProcessing || DisableItemFields)" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Design -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Product" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDropDown @bind-Value="CurrentItem.DesignId"
                                                Data="@Designs"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select Design..."
                                                Style="width:100%; font-size:0.75rem;"
                                                AllowFiltering="true"
                                                Change="@(args => OnDesignChanged(CurrentItem.DesignId))"
                                                Disabled="@(IsProcessing || !CurrentItem.SubGroupId.HasValue)" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Brand (Auto-Create Combo) -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Brand" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                                    <RadzenAutoComplete @bind-Value="BrandSearchText"
                                                        Data="@BrandSuggestions"
                                                        TextProperty="BrandName"
                                                        Style="width:100%; font-size:0.75rem;"
                                                        Placeholder="Search or create brand"
                                                        InputAttributes="@(new Dictionary<string,object>{ {"autocomplete","off"} })"
                                                        Change="OnBrandTextChanged"
                                                        Select="@((object val) => OnBrandSelected(val))"
                                                        Disabled="@(IsProcessing || DisableItemFields)" />
                                    @if (IsNewBrand)
                                    {
                                        <RadzenBadge Text="NEW — will be created on save" BadgeStyle="BadgeStyle.Warning" Style="font-size:0.65rem;" />
                                    }
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Features (Multi-Select Auto-Create) -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Features" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
                                    <RadzenDropDown @bind-Value="SelectedFeatureIds"
                                                    Data="@Features"
                                                    TextProperty="FeatureName"
                                                    ValueProperty="FeatureId"
                                                    Multiple="true"
                                                    AllowFiltering="true"
                                                    Placeholder="Select features..."
                                                    Style="width:100%; font-size:0.75rem;"
                                                    Disabled="@(IsProcessing || DisableItemFields)" />
                                    @if (NewFeatureNames.Any())
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.3rem" Style="flex-wrap:wrap; margin-top:0.1rem;">
                                            @foreach (var fname in NewFeatureNames)
                                            {
                                                <RadzenBadge Text="@($"NEW: {fname}")" BadgeStyle="BadgeStyle.Warning" Style="font-size:0.65rem; cursor:pointer;"
                                                             @onclick="@(() => RemoveNewFeature(fname))" />
                                            }
                                        </RadzenStack>
                                    }
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.2rem">
                                        <RadzenTextBox @bind-Value="NewFeatureInput"
                                                       Placeholder="Add new feature..."
                                                       Style="width:100%; font-size:0.65rem; height:26px; padding:2px 6px;"
                                                       Disabled="@(IsProcessing || DisableItemFields)"
                                                       @onkeypress="@(async args => { if (args.Key == "Enter") AddNewFeature(); })" />
                                        <RadzenButton Icon="add" Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Info"
                                                      Click="@AddNewFeature"
                                                      Disabled="@(IsProcessing || DisableItemFields || string.IsNullOrWhiteSpace(NewFeatureInput))" />
                                    </RadzenStack>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- UoM -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="UoM" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDropDown @bind-Value="CurrentItem.MesurementUnitId"
                                                Data="@Units"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select...."
                                                Style="width:100%; font-size:0.75rem;"
                                                AllowFiltering="true"
                                                Disabled="@(IsProcessing || DisableItemFields)" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Catalogue -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Catalogue" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenTextBox @bind-Value="CurrentItem.Catalogue"
                                               Style="width:100%; font-size:0.65rem; height:24px; padding:2px 6px;"
                                               Placeholder="Enter catalogue"
                                               ValueUpdateMode="ValueUpdateMode.OnInput"
                                               Change="@((string args) => OnCatalogueChanged(args))"
                                               Disabled="@(IsProcessing || DisableItemFields)" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Origin (Auto-Create Combo) -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Origin" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                                    <RadzenAutoComplete @bind-Value="OriginSearchText"
                                                        Data="@OriginSuggestions"
                                                        TextProperty="OriginName"
                                                        Style="width:100%; font-size:0.75rem;"
                                                        Placeholder="Search or create origin"
                                                        InputAttributes="@(new Dictionary<string,object>{ {"autocomplete","off"} })"
                                                        Change="OnOriginTextChanged"
                                                        Select="@((object val) => OnOriginSelected(val))"
                                                        Disabled="@(IsProcessing || DisableItemFields)" />
                                    @if (IsNewOrigin)
                                    {
                                        <RadzenBadge Text="NEW — will be created on save" BadgeStyle="BadgeStyle.Warning" Style="font-size:0.65rem;" />
                                    }
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- VAT Included -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="VAT" Style="font-weight:600; font-size:0.75rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                    <RadzenCheckBox @bind-Value="Purchase.IsVatIncluded" Name="vatIncluded" />
                                    <RadzenLabel Text="VAT Included" Component="vatIncluded" Style="font-size:0.75rem;" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Input Old Barcode — replaced with dropdown -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.15rem">
                            <RadzenColumn Size="12">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.3rem">
                                    <RadzenDropDownDataGrid @bind-Value="BarcodeSearchText"
                                                            Data="@AvailableItems"
                                                            TextProperty="Barcode"
                                                            ValueProperty="Barcode"
                                                            Placeholder="Select barcode..."
                                                            Style="flex:1; background:#fffde7; font-size:0.75rem;"
                                                            AllowFiltering="true"
                                                            AllowFilteringByAllStringColumns="true"
                                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                            Change="@OnBarcodeDropdownChanged"
                                                            Disabled="@(IsProcessing || IsSearchingBarcode)">
                                        <Columns>
                                            <RadzenDropDownDataGridColumn Property="Barcode" Title="Barcode" Width="140px" />
                                            <RadzenDropDownDataGridColumn Property="Name" Title="Item Name" Width="200px" />
                                        </Columns>
                                    </RadzenDropDownDataGrid>
                                    <RadzenButton Icon="close"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Size="ButtonSize.Small"
                                                  Click="@ClearBarcodeSearch"
                                                  Disabled="@IsProcessing" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                    </RadzenStack>
                </RadzenColumn>

                <!-- ========================
                     RIGHT PANEL
                     ======================== -->
                <RadzenColumn Size="12" SizeLG="8">
                    <RadzenStack Gap="0.2rem">

                        <!-- Top right: Barcode -->
                        <RadzenRow Gap="0.3rem" AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenLabel Text="Barcode" Style="width:100%; font-size:0.65rem; height:24px; padding:2px 6px;" />
                                <RadzenTextBox @bind-Value="CurrentItem.Barcode"
                                               Style="width:100%; font-size:0.65rem; height:24px; padding:2px 6px;"
                                               ReadOnly="true"
                                               Placeholder="Barcode" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenLabel Text="Product" Style="width:100%; font-size:0.65rem; height:24px; padding:2px 6px;" />
                                @if (DisableItemFields)
                                {
                                    <RadzenTextBox Value="@CurrentItem.ItemName" Style="width:100%; font-size:0.65rem; height:24px; padding:2px 6px;" ReadOnly="true" />
                                }
                                else
                                {
                                    <RadzenCheckBox @bind-Value="IsProductNameFieldChange" Style="display:none" />
                                    <RadzenTextBox @bind-Value="CurrentItem.ItemName"
                                                   Style="width:100%; font-size:0.65rem; height:24px; padding:2px 6px;"
                                                   Placeholder="Enter product name"
                                                   Change="@((string args) => OnProductNameChanged(args))"
                                                   Disabled="@IsProcessing" />
                                }
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Product / Color / Size -->
                        <RadzenRow Gap="0.3rem" AlignItems="AlignItems.Center">
                          
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="Color" Style="font-weight:600; font-size:0.75rem;" />
                                <RadzenDropDownDataGrid @bind-Value="CurrentItem.ColorId"
                                                        Data="@Colors"
                                                        ValueProperty="Id"
                                                        TextProperty="Name"
                                                        AllowFiltering="true"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        Style="width:100%"
                                                        Placeholder="Select"
                                                        Change="@(args => OnColorChanged((int?)args))"
                                                        AllowFilteringByAllStringColumns="true">
                                    <Columns>
                                        <RadzenDropDownDataGridColumn Width="40px" Filterable="false">
                                            <Template Context="color">
                                                <div style="width:14px;height:14px;border-radius:3px;border:1px solid #ccc;background-color:@(string.IsNullOrWhiteSpace(color.HexCode) ? "#fff" : color.HexCode)"></div>
                                            </Template>
                                        </RadzenDropDownDataGridColumn>
                                        <RadzenDropDownDataGridColumn Property="Name" Title="Color Name" />
                                        <RadzenDropDownDataGridColumn Property="ColorCode" Title="Code" />
                                    </Columns>
                                </RadzenDropDownDataGrid>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="Size" Style="font-weight:600; font-size:0.75rem;" />
                                <RadzenDropDown @bind-Value="CurrentItem.SizeId"
                                                Data="@Sizes"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select"
                                                Style="width:100%; font-size:0.75rem;"
                                                AllowFiltering="true"
                                                Disabled="@(IsProcessing || DisableItemFields)"
                                                Change="@(args => OnSizeChanged((int?)args))" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="ShadeNo" Style="font-weight:600; font-size:0.65rem;" />

                                <RadzenTextBox @bind-Value="CurrentItem.ShadeNo"
                                               Placeholder="Shade No"
                                               Disabled="@(IsProcessing || DisableItemFields)"
                                               Style="width:100%; font-size:0.65rem; height:26px; padding:2px 6px;" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- ShadeNo / ProductPrice / OperationCost / SalePrice -->
                        <RadzenRow Gap="0.3rem" AlignItems="AlignItems.Center">
                            <RadzenColumn Size="6" SizeMD="4">
                                <RadzenLabel Text="QTY" Style="font-weight:600; font-size:0.75rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.Quantity"
                                               Style="width:100%; font-size:0.75rem;"
                                               Min="0"
                                               TValue="decimal"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>
                            <RadzenColumn Size="6" SizeMD="4">
                                <RadzenLabel Text="ProductPrice" Style="font-weight:600; font-size:0.75rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.PurchasePrice"
                                               Style="width:100%; font-size:0.75rem;"
                                               Min="0"
                                               TValue="decimal"
                                               Change="@CalculateItemTotal"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>
                            <RadzenColumn Size="6" SizeMD="4">
                                <RadzenLabel Text="OperationCost" Style="font-weight:600; font-size:0.75rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.OtherCost"
                                               Style="width:100%; font-size:0.75rem;"
                                               Min="0"
                                               TValue="decimal?"
                                               Change="@CalculateItemTotal"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>
                            
                        </RadzenRow>

                        <!-- CarryingCost / VAT / TotalCost / Pur.QTY -->
                        <RadzenRow Gap="0.3rem" AlignItems="AlignItems.Center">
                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="CarryingCost" Style="font-weight:600; font-size:0.75rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.CarryingCost"
                                               Style="width:100%; font-size:0.75rem;"
                                               Min="0"
                                               TValue="decimal?"
                                               Change="@CalculateItemTotal"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>
                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="VAT Amt" Style="font-weight:600; font-size:0.75rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.VatPercentage"
                                               Style="width:100%; font-size:0.75rem;"
                                               Min="0"
                                               Max="100"
                                               TValue="decimal?"
                                               Change="@CalculateItemTotal"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>
                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="TotalCost" Style="font-weight:600; font-size:0.75rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.TotalAmount"
                                               Style="width:100%; font-size:0.75rem;"
                                               ReadOnly="true"
                                               TValue="decimal" />
                            </RadzenColumn>
                           
                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="SalePrice" Style="font-weight:600; font-size:0.75rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.SalePrice"
                                               Style="width:100%; font-size:0.75rem;"
                                               Min="0"
                                               TValue="decimal?"
                                               Disabled="@(IsProcessing || !CurrentItem.IsSaleable)" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="0.3rem" AlignItems="AlignItems.Center">
                            <!-- Checkboxes -->
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.6rem" AlignItems="AlignItems.Center" Style="padding-top:0.6rem; flex-wrap:wrap;">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                        <RadzenCheckBox @bind-Value="CurrentItem.IsSaleable" Name="isSaleable2" />
                                        <RadzenLabel Text="Is Saleable" Component="isSaleable2" Style="font-size:0.75rem;" />
                                    </RadzenStack>
                                    @if (IsNewItemMode)
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                            <RadzenCheckBox @bind-Value="CurrentItem.CountStockByColor" Name="byColor2" />
                                            <RadzenLabel Text="By Color" Component="byColor2" Style="font-size:0.75rem;" />
                                        </RadzenStack>
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                            <RadzenCheckBox @bind-Value="CurrentItem.CountStockBySize" Name="bySize2" />
                                            <RadzenLabel Text="By Size" Component="bySize2" Style="font-size:0.75rem;" />
                                        </RadzenStack>
                                    }
                                    <RadzenButton Icon="@(IsNewItemMode ? "close" : "add_circle")"
                                                  ButtonStyle="@(IsNewItemMode ? ButtonStyle.Warning : ButtonStyle.Info)"
                                                  Click="@ToggleCreateNewItem"
                                                  Size="ButtonSize.Small"
                                                  Disabled="@IsProcessing"
                                                  Text="@(IsNewItemMode ? "Cancel New" : "New Item")" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        @if (DisableItemFields)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" Style="padding:0.25rem 0.5rem; font-size:0.72rem;">
                                Existing item loaded. Fields are read-only. Clear to create new or search different item.
                            </RadzenAlert>
                        }
                        @if (IsNewItemMode)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" Style="padding:0.25rem 0.5rem; font-size:0.72rem;">
                                Create New Item Mode: Fill in all required fields to create a new item on the go.
                            </RadzenAlert>
                        }

                        <!-- Inner preview row -->
                        <RadzenRow Gap="0.15rem" Style="margin-top:0.25rem;">
                            <RadzenColumn Size="12">
                                <RadzenStack Gap="0.2rem">

                                    <!-- Header -->
                                    <div style="display:grid; grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr 1fr 1.5fr 1fr; gap:3px; background:#f0f0f0; padding:3px 5px; border-radius:3px; font-weight:700; font-size:0.7rem;">
                                        <span>Barcode</span>
                                        <span>SIZE</span>
                                        <span>UoM</span>
                                        <span>P.Rate</span>
                                        <span>S.Rate</span>
                                        <span>Quantity</span>
                                        <span>Total P.Amt</span>
                                        <span>StockQTY</span>
                                    </div>

                                    <!-- Data Row -->
                                    <div style="display:grid; grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr 1fr 1.5fr 1fr; gap:3px; padding:2px 5px; font-size:0.75rem; border:1px solid #e0e0e0; border-radius:3px; background:#fafafa;">
                                        <span>@(CurrentItem.Barcode ?? "-")</span>
                                        <span>@(CurrentItem.SizeName ?? "-")</span>
                                        <span>@(CurrentItem.MesurementUnitName ?? "-")</span>
                                        <span>@CurrentItem.PurchasePrice.ToString("N2")</span>
                                        <span>@(CurrentItem.SalePrice.HasValue? CurrentItem.SalePrice.Value.ToString("N2") : "-")</span>
                                        <span>@CurrentItem.Quantity.ToString("N2")</span>
                                        <span>@CurrentItem.TotalAmount.ToString("N2")</span>
                                        <span>-</span>
                                    </div>

                                    <!-- Total Row -->
                                    <div style="display:grid; grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr 1fr 1.5fr 1fr; gap:3px; padding:3px 5px; font-size:0.75rem; font-weight:700; border:1px solid #d0d0d0; border-radius:3px; background:#eef6ff;">
                                        <span>Total</span>
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                        <span>@PurchaseItems.Sum(x => x.Quantity).ToString("N2")</span>
                                        <span>@PurchaseItems.Sum(x => x.TotalAmount).ToString("N2")</span>
                                        <span></span>
                                    </div>
                                    <!-- Add Button -->
                                    <span style="text-align:right;">
                                        <RadzenButton Icon="add"
                                                      ButtonStyle="ButtonStyle.Success"
                                                      Click="@AddItemToGrid"
                                                      Disabled="@IsProcessing"
                                                      Size="ButtonSize.Small"
                                                      Text="Add Item"
                                                      Style="height:24px; font-size:0.7rem;" />
                                    </span>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- ============================================================
             ITEMS GRID
             ============================================================ -->
        <RadzenCard Style="padding: 0.3rem;">
            <RadzenDataGrid @ref="ItemsGrid"
                            Data="@PurchaseItems"
                            TItem="PurchaseItemDTO"
                            AllowPaging="true"
                            PageSize="5"
                            AllowSorting="true"
                            AllowFiltering="false"
                            EmptyText="No items added yet"
                            Class="compact-grid">
                <Columns>

                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="Barcode" Title="Barcode" Width="120px">
                        <FooterTemplate>
                        
                        </FooterTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="ItemName" Title="Product Name" Width="160px" />

                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="SizeName" Title="Size" Width="70px" />

                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="MesurementUnitName" Title="UOM" Width="65px" />

                   

                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="ColorName" Title="Color" Width="80px" />
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="BrandName" Title="Brand" Width="85px" />
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="OriginName" Title="Origin" Width="85px" />
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="FeaturesDisplay" Title="Features" Width="130px" />

                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Title="New" Width="55px">
                        <Template Context="item">
                            @if (item.IsNewItem)
                            {
                                <RadzenBadge Text="NEW" BadgeStyle="BadgeStyle.Info" />
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Title="Actions" Width="85px" Sortable="false" Filterable="false">
                        <Template Context="item">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                          Click="@(async () => await EditItem(item))"
                                          Disabled="@IsProcessing" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                          Click="@(() => DeleteItem(item))"
                                          Disabled="@IsProcessing" />
                        </Template>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
        <!-- ============================================================
             FOOTER
             ============================================================ -->
        <RadzenCard Style="padding: 0.4rem;">
            <RadzenRow Gap="0.4rem" AlignItems="AlignItems.End">

                <RadzenColumn Size="6" SizeMD="3" SizeLG="2">
                    <RadzenLabel Text="Total QTY" Style="font-weight:600; font-size:0.75rem;" />
                    <RadzenNumeric Value="@PurchaseItems.Sum(x => x.Quantity)"
                                   Style="width:100%; font-size:0.75rem;"
                                   ReadOnly="true"
                                   TValue="decimal" />
                </RadzenColumn>

                <RadzenColumn Size="6" SizeMD="3" SizeLG="2">
                    <RadzenLabel Text="Total Amount" Style="font-weight:600; font-size:0.75rem;" />
                    <RadzenNumeric @bind-Value="Purchase.TotalAmount" Style="width:100%; font-size:0.75rem;" ReadOnly="true" TValue="decimal" />
                </RadzenColumn>

                <RadzenColumn Size="6" SizeMD="3" SizeLG="2">
                    <RadzenLabel Text="Discount" Style="font-weight:600; font-size:0.75rem;" />
                    <RadzenNumeric @bind-Value="Purchase.DiscountAmount" Style="width:100%; font-size:0.75rem;" Min="0" TValue="decimal?" Change="@((decimal? _) => OnDiscountChanged())" Disabled="@IsProcessing" />
                </RadzenColumn>

                <RadzenColumn Size="6" SizeMD="3" SizeLG="2">
                    <RadzenLabel Text="VAT Amount" Style="font-weight:600; font-size:0.75rem;" />
                    <RadzenNumeric @bind-Value="Purchase.VatAmount" Style="width:100%; font-size:0.75rem;" Min="0" TValue="decimal?" Change="@((decimal? _) => OnVatChanged())" Disabled="@IsProcessing" />
                </RadzenColumn>

                <RadzenColumn Size="6" SizeMD="3" SizeLG="2">
                    <RadzenLabel Text="Net Amount" Style="font-weight:600; font-size:0.75rem;" />
                    <RadzenNumeric @bind-Value="Purchase.NetAmount" Style="width:100%; font-size:0.75rem;" ReadOnly="true" TValue="decimal" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                    <RadzenLabel Text="Remarks:" Style="font-weight:600; font-size:0.75rem;" />
                    <RadzenTextArea @bind-Value="Purchase.Remarks"
                                    Style="width:100%; font-size:0.75rem;"
                                    Rows="2"
                                    Placeholder="Enter any remarks..."
                                    Disabled="@IsProcessing" />
                </RadzenColumn>

                <RadzenColumn Size="12">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                        <RadzenButton Icon="drafts"
                                      ButtonStyle="ButtonStyle.Warning"
                                      Click="@SaveAsDraft"
                                      Disabled="@IsProcessing"
                                      Text="DRAFT"
                                      Size="ButtonSize.Small"
                                      Style="min-width:80px; font-weight:700;" />

                        <RadzenButton Icon="save"
                                      ButtonStyle="ButtonStyle.Success"
                                      Click="@SavePurchase"
                                      Disabled="@IsProcessing"
                                      Text="@(IsEditMode ? "UPDATE" : "SAVE")"
                                      Size="ButtonSize.Small"
                                      Style="min-width:80px; font-weight:700;" />

                        <RadzenButton Icon="cancel"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Click="@Cancel"
                                      Disabled="@IsProcessing"
                                      Text="CANCEL"
                                      Size="ButtonSize.Small"
                                      Style="min-width:80px; font-weight:700;" />
                    </RadzenStack>
                </RadzenColumn>

            </RadzenRow>
        </RadzenCard>

    </RadzenStack>
}
