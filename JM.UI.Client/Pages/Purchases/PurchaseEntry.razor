@page "/PurchaseEntry"
@page "/PurchaseEntry/Edit/{Id:int}"
@page "/PurchaseEntry/Draft/{DraftId:int}"

@using JM.UI.Entities.Model.PurchaseItems
@inherits PurchaseEntryComponent

<PageTitle>@PageTitle</PageTitle>

@if (IsLoading)
{
    <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large">
        <Template>Loading...</Template>
    </RadzenProgressBarCircular>
}
else
{
    <RadzenStack Gap="0.5rem">

        <!-- Page Header -->
        <RadzenRow>
            <RadzenColumn Size="12">
                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1">@PageTitle</RadzenText>
            </RadzenColumn>
        </RadzenRow>

        <!-- ============================================================
             MAIN ENTRY SECTION: Left Panel + Right Panel (2-column)
             ============================================================ -->
        <RadzenCard Style="padding: 0.75rem;">
            <RadzenRow Gap="0.75rem">

                <!-- ========================
                     LEFT PANEL
                     ======================== -->
                <RadzenColumn Size="12" SizeLG="4" Style="border-right: 1px solid #dee2e6; padding-right: 0.75rem;">
                    <RadzenStack Gap="0.4rem">

                        <!-- PurchaseDT / Default DT -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="PurchaseDT" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDatePicker @bind-Value="Purchase.PurchaseDate"
                                                  Style="width:100%"
                                                  DateFormat="dd/MM/yyyy"
                                                  Placeholder="Default DT (Not editable)"
                                                  Disabled="@IsProcessing" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Supplier -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Supplier" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDropDown @bind-Value="Purchase.SupplierId"
                                                Data="@Suppliers"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select from dropdown"
                                                Style="width:100%"
                                                AllowFiltering="true"
                                                Disabled="@IsProcessing" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- S.Bill No -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="S.Bill No" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenTextBox @bind-Value="Purchase.BillInvoiceNumber"
                                               Style="width:100%"
                                               Placeholder="Alphanumeric"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- BillDate -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="BillDate" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDatePicker @bind-Value="Purchase.PurchaseDate"
                                                  Style="width:100%"
                                                  DateFormat="dd/MM/yyyy"
                                                  Placeholder="Pick Date"
                                                  Disabled="@IsProcessing" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Type -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Type" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Style="flex-wrap:wrap;">
                                    <RadzenCheckBox @bind-Value="CurrentItem.IsSaleable" Name="typeSale" />
                                    <RadzenLabel Text="SaleAble" Component="typeSale" Style="font-size:0.8rem;" />
                                    @* <RadzenCheckBox @bind-Value="CurrentItem.IsRaw" Name="typeRaw" />
                                    <RadzenLabel Text="Raw" Component="typeRaw" Style="font-size:0.8rem;" />
                                    <RadzenCheckBox @bind-Value="CurrentItem.IsConsume" Name="typeConsume" /> *@
                                    <RadzenLabel Text="Consume" Component="typeConsume" Style="font-size:0.8rem;" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Store -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Store" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDropDown @bind-Value="Purchase.StoreId"
                                                Data="@Stores"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select from dropdown"
                                                Style="width:100%"
                                                AllowFiltering="true"
                                                Disabled="@IsProcessing" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Group -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Group" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDropDown @bind-Value="CurrentItem.GroupId"
                                                Data="@Groups"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select from dropdown"
                                                Change="@(args => OnGroupChanged(CurrentItem.GroupId))"
                                                Style="width:100%"
                                                AllowFiltering="true"
                                                Disabled="@IsProcessing" />
                            </RadzenColumn>
                        </RadzenRow>

                        @*<!-- Product -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Product" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                @if (DisableItemFields)
                                {
                                    <RadzenTextBox Value="@CurrentItem.ItemName" Style="width:100%" ReadOnly="true" />
                                }
                                else if (IsNewItemMode)
                                {
                                    <RadzenTextBox @bind-Value="CurrentItem.ItemName"
                                                   Style="width:100%"
                                                   Placeholder="Enter item name"
                                                   Disabled="@IsProcessing" />
                                }
                                else
                                {
                                    <RadzenDropDown @bind-Value="CurrentItem.ItemId"
                                                    Data="@Items"
                                                    TextProperty="Name"
                                                    ValueProperty="Id"
                                                    Placeholder="Select from dropdown"
                                                    Change="@(args => OnItemChanged(CurrentItem.ItemId))"
                                                    Style="width:100%"
                                                    Disabled="@IsProcessing" />
                                }
                            </RadzenColumn>
                        </RadzenRow>*@

                        <!-- SubProduct -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="SubProduct" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDropDown @bind-Value="CurrentItem.SubGroupId"
                                                Data="@SubGroups"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select from dropdown"
                                                Style="width:100%"
                                                AllowFiltering="true"
                                                Change="@(args => OnSubGroupChanged(CurrentItem.SubGroupId))"
                                                Disabled="@(IsProcessing || DisableItemFields)" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Design -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Design" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDropDown @bind-Value="CurrentItem.DesignId"
                                                Data="@Designs"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select Design..."
                                                Style="width:100%"
                                                AllowFiltering="true"
                                                Change="@(args => OnDesignChanged(CurrentItem.DesignId))"
                                                Disabled="@(IsProcessing || !CurrentItem.SubGroupId.HasValue)" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Brand -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Brand" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenTextBox @bind-Value="CurrentItem.BrandColor"
                                               Style="width:100%"
                                               Placeholder="Select / Create on the fly"
                                               Disabled="@(IsProcessing || DisableItemFields)" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Features -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Features" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenTextBox @bind-Value="CurrentItem.Features"
                                               Style="width:100%"
                                               Placeholder="Select multiple / create on the fly"
                                               Disabled="@(IsProcessing || DisableItemFields)" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Fabrics -->
                       @*  <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Fabrics" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenTextBox @bind-Value="CurrentItem.Fabrics"
                                               Style="width:100%"
                                               Placeholder="Select multiple / create on the fly"
                                               Disabled="@(IsProcessing || DisableItemFields)" />
                            </RadzenColumn>
                        </RadzenRow> *@

                        <!-- UoM -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="UoM" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDropDown @bind-Value="CurrentItem.MesurementUnitId"
                                                Data="@Units"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select / Create on the fly"
                                                Style="width:100%"
                                                AllowFiltering="true"
                                                Disabled="@(IsProcessing || DisableItemFields)" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Catalogue -->
                       @*  <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Catalogue" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenTextBox @bind-Value="CurrentItem.Catalogue"
                                               Style="width:100%"
                                               Placeholder="Select / Create on the fly"
                                               Disabled="@(IsProcessing || DisableItemFields)" />
                            </RadzenColumn>
                        </RadzenRow> *@

                        <!-- Origin -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="Origin" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenTextBox @bind-Value="CurrentItem.Origin"
                                               Style="width:100%"
                                               Placeholder="Select / Create on the fly"
                                               Disabled="@(IsProcessing || DisableItemFields)" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- VAT Included -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="4">
                                <RadzenLabel Text="VAT" Style="font-weight:600; font-size:0.85rem;" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                    <RadzenCheckBox @bind-Value="Purchase.IsVatIncluded" Name="vatIncluded" />
                                    <RadzenLabel Text="VAT Included" Component="vatIncluded" Style="font-size:0.85rem;" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Generate Barcode -->
                        <RadzenRow Gap="0.25rem">
                            <RadzenColumn Size="12">
                                <RadzenButton Icon="qr_code"
                                              ButtonStyle="ButtonStyle.Success"
                                              Click="@GenerateBarcode"
                                              Disabled="@IsProcessing"
                                              Text="GENERATE BARCODE"
                                              Style="width:100%; font-weight:700;" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Input Old Barcode -->
                        <RadzenRow AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenColumn Size="12">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.4rem">
                                    <RadzenTextBox @bind-Value="BarcodeSearchText"
                                                   Placeholder="Input Old Barcode"
                                                   Style="flex:1; background:#fffde7;"
                                                   Disabled="@IsProcessing"
                                                   @onkeypress="@(async args => { if (args.Key == "Enter") await SearchByBarcode(); })" />
                                    <RadzenButton Icon="search"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Click="@SearchByBarcode"
                                                  Disabled="@(IsProcessing || IsSearchingBarcode)" />
                                    <RadzenButton Icon="close"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Click="@ClearBarcodeSearch"
                                                  Disabled="@IsProcessing" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                    </RadzenStack>
                </RadzenColumn>

                <!-- ========================
                     RIGHT PANEL
                     ======================== -->
                <RadzenColumn Size="12" SizeLG="8">
                    <RadzenStack Gap="0.4rem">

                        <!-- Top right: ProductName + Barcode -->
                        <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center">
                            @* <RadzenColumn Size="12" SizeMD="6">
                                <RadzenLabel Text="ProductName" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenTextBox Value="@CurrentItem.ItemName"
                                               Style="width:100%"
                                               ReadOnly="@DisableItemFields"
                                               Placeholder="Product Name" />
                            </RadzenColumn> *@
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenLabel Text="Barcode" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenTextBox @bind-Value="CurrentItem.Barcode"
                                               Style="width:100%"
                                               ReadOnly="true"
                                               Placeholder="Barcode" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Color / Size / UID / ProductPrice / OperationCost / SalePrice -->
                        <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="Color" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenDropDownDataGrid @bind-Value="CurrentItem.ColorId"
                                                        Data="@Colors"
                                                        ValueProperty="Id"
                                                        TextProperty="Name"
                                                        AllowFiltering="true"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        Style="width:100%"
                                                        Placeholder="Select"
                                                        Change="@(args => OnColorChanged(CurrentItem.ColorId))"
                                                        AllowFilteringByAllStringColumns="true">
                                    <Columns>
                                        <RadzenDropDownDataGridColumn Width="40px" Filterable="false">
                                            <Template Context="color">
                                                <div style="width:14px;height:14px;border-radius:3px;border:1px solid #ccc;background-color:@(string.IsNullOrWhiteSpace(color.HexCode) ? "#fff" : color.HexCode)"></div>
                                            </Template>
                                        </RadzenDropDownDataGridColumn>
                                        <RadzenDropDownDataGridColumn Property="Name" Title="Color Name" />
                                        <RadzenDropDownDataGridColumn Property="ColorCode" Title="Code" />
                                    </Columns>
                                </RadzenDropDownDataGrid>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="Size" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenDropDown @bind-Value="CurrentItem.SizeId"
                                                Data="@Sizes"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select"
                                                Style="width:100%"
                                                AllowFiltering="true"
                                                Disabled="@(IsProcessing || DisableItemFields)"
                                                Change="@(args => OnSizeChanged(CurrentItem.SizeId))" />
                            </RadzenColumn>

                           @*  <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="UID" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenTextBox @bind-Value="CurrentItem.UID"
                                               Style="width:100%"
                                               Placeholder="UID"
                                               Disabled="@(IsProcessing || DisableItemFields)" />
                            </RadzenColumn> *@
                        </RadzenRow>

                        <!-- ShadeNo / CarryingCost / TransportCost / ProductPrice / VAT / TotalCost / SalePrice / Pur.QTY -->
                        <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center">
                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="ShadeNo" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenTextBox @bind-Value="CurrentItem.ShadeNo"
                                               Style="width:100%"
                                               Placeholder="Shade No"
                                               Disabled="@(IsProcessing || DisableItemFields)" />
                            </RadzenColumn>

                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="ProductPrice" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.PurchasePrice"
                                               Style="width:100%"
                                               Min="0"
                                               TValue="decimal"
                                               Change="@CalculateItemTotal"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>

                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="OperationCost" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.OtherCost"
                                               Style="width:100%"
                                               Min="0"
                                               TValue="decimal?"
                                               Change="@CalculateItemTotal"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>

                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="SalePrice" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.SalePrice"
                                               Style="width:100%"
                                               Min="0"
                                               TValue="decimal?"
                                               Disabled="@(IsProcessing || !CurrentItem.IsSaleable)" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center">
                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="CarryingCost" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.CarryingCost"
                                               Style="width:100%"
                                               Min="0"
                                               TValue="decimal?"
                                               Change="@CalculateItemTotal"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>

                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="VAT Amt" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.VatPercentage"
                                               Style="width:100%"
                                               Min="0"
                                               Max="100"
                                               TValue="decimal?"
                                               Change="@CalculateItemTotal"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>

                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="TotalCost" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.TotalAmount"
                                               Style="width:100%"
                                               ReadOnly="true"
                                               TValue="decimal" />
                            </RadzenColumn>

                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="Pur.QTY" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.Quantity"
                                               Style="width:100%"
                                               Min="0"
                                               TValue="decimal"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center">
                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="TransportCost" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenNumeric @bind-Value="CurrentItem.CarryingCost"
                                               Style="width:100%"
                                               Min="0"
                                               TValue="decimal?"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>

                            

                            <!-- Checkboxes -->
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center" Style="padding-top:1.2rem; flex-wrap:wrap;">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox @bind-Value="CurrentItem.IsSaleable" Name="isSaleable2" />
                                        <RadzenLabel Text="Is Saleable" Component="isSaleable2" Style="font-size:0.85rem;" />
                                    </RadzenStack>
                                    @if (IsNewItemMode)
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                            <RadzenCheckBox @bind-Value="CurrentItem.CountStockByColor" Name="byColor2" />
                                            <RadzenLabel Text="By Color" Component="byColor2" Style="font-size:0.85rem;" />
                                        </RadzenStack>
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                            <RadzenCheckBox @bind-Value="CurrentItem.CountStockBySize" Name="bySize2" />
                                            <RadzenLabel Text="By Size" Component="bySize2" Style="font-size:0.85rem;" />
                                        </RadzenStack>
                                    }
                                    <RadzenButton Icon="@(IsNewItemMode ? "close" : "add_circle")"
                                                  ButtonStyle="@(IsNewItemMode ? ButtonStyle.Warning : ButtonStyle.Info)"
                                                  Click="@ToggleCreateNewItem"
                                                  Size="ButtonSize.Small"
                                                  Disabled="@IsProcessing"
                                                  Text="@(IsNewItemMode ? "Cancel New" : "New Item")" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        @if (DisableItemFields)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" Style="padding:0.4rem 0.75rem; font-size:0.82rem;">
                                Existing item loaded. Fields are read-only. Clear to create new or search different item.
                            </RadzenAlert>
                        }
                        @if (IsNewItemMode)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" Style="padding:0.4rem 0.75rem; font-size:0.82rem;">
                                Create New Item Mode: Fill in all required fields to create a new item on the go.
                            </RadzenAlert>
                        }

                        <!-- Inner Grid: Barcode / SIZE / UoM / P.Rate / S.Rate / Qty / Total P.Amt / StockQTY -->
                        <RadzenRow Gap="0.25rem" Style="margin-top:0.5rem;">
                            <RadzenColumn Size="12">
                                <RadzenStack Gap="0.4rem">
                                    <!-- Mini grid header row -->
                                    <div style="display:grid; grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr 1fr 1.5fr 1fr; gap:4px; background:#f0f0f0; padding:4px 6px; border-radius:4px; font-weight:700; font-size:0.78rem;">
                                        <span>Barcode</span>
                                        <span>SIZE</span>
                                        <span>UoM</span>
                                        <span>P.Rate</span>
                                        <span>S.Rate</span>
                                        <span>Quantity</span>
                                        <span>Total P.Amt</span>
                                        <span>StockQTY</span>
                                    </div>
                                    <!-- Current item preview row -->
                                    <div style="display:grid; grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr 1fr 1.5fr 1fr; gap:4px; padding:2px 6px; font-size:0.82rem; border:1px solid #e0e0e0; border-radius:4px; background:#fafafa;">
                                        <span>@(CurrentItem.Barcode ?? "-")</span>
                                        <span>@(CurrentItem.SizeName ?? "-")</span>
                                        @* <span>@(CurrentItem.UomName ?? "-")</span> *@
                                        <span>@CurrentItem.PurchasePrice.ToString("N2")</span>
                                        <span>@(CurrentItem.SalePrice.HasValue? CurrentItem.SalePrice.Value.ToString("N2") : "-")</span>
                                        <span>@CurrentItem.Quantity.ToString("N2")</span>
                                        <span>@CurrentItem.TotalAmount.ToString("N2")</span>
                                        <span>-</span>
                                    </div>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Total QTY / TotalAmt summary (top area) -->
                        <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center" Style="margin-top:0.25rem;">
                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="Total QTY" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenNumeric Value="@PurchaseItems.Sum(x => x.Quantity)"
                                               Style="width:100%"
                                               ReadOnly="true"
                                               TValue="decimal" />
                            </RadzenColumn>
                            <RadzenColumn Size="6" SizeMD="3">
                                <RadzenLabel Text="TotalAmt" Style="font-weight:600; font-size:0.85rem;" />
                                <RadzenNumeric @bind-Value="Purchase.TotalAmount"
                                               Style="width:100%"
                                               ReadOnly="true"
                                               TValue="decimal" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6" Style="display:flex; align-items:flex-end; justify-content:flex-end;">
                                <RadzenButton Icon="add"
                                              ButtonStyle="ButtonStyle.Success"
                                              Click="@AddItemToGrid"
                                              Disabled="@IsProcessing"
                                              Text="Add Item"
                                              Style="min-width:120px;" />
                            </RadzenColumn>
                        </RadzenRow>

                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- ============================================================
             ITEMS GRID (Bottom table: Barcode / Product Name / Size / UOM / P.Rate / S.Rate / Qty / TotalPAmt)
             ============================================================ -->
        <RadzenCard Style="padding: 0.75rem;">
            <RadzenDataGrid @ref="ItemsGrid"
                            Data="@PurchaseItems"
                            TItem="PurchaseItemDTO"
                            AllowPaging="true"
                            PageSize="10"
                            AllowSorting="true"
                            AllowFiltering="false"
                            EmptyText="No items added yet"
                            Style="font-size:0.85rem;">
                <Columns>
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="Barcode" Title="Barcode" Width="140px" />
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="ItemName" Title="Product Name" Width="200px" />
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="SizeName" Title="Size" Width="90px" />
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="UomName" Title="UOM" Width="80px" />
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="PurchasePrice" Title="P.Rate" Width="90px">
                        <Template Context="item">@item.PurchasePrice.ToString("N2")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="SalePrice" Title="S.Rate" Width="90px">
                        <Template Context="item">@(item.SalePrice.HasValue? item.SalePrice.Value.ToString("N2") : "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="Quantity" Title="Quantity" Width="90px">
                        <Template Context="item">@item.Quantity.ToString("N2")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="TotalAmount" Title="TotalPAmt" Width="110px">
                        <Template Context="item">@item.TotalAmount.ToString("N2")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="ColorName" Title="Color" Width="90px" />
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Title="New" Width="65px">
                        <Template Context="item">
                            @if (item.IsNewItem)
                            {
                                <RadzenBadge Text="NEW" BadgeStyle="BadgeStyle.Info" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PurchaseItemDTO" Title="Actions" Width="100px" Sortable="false" Filterable="false">
                        <Template Context="item">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => EditItem(item))" Disabled="@IsProcessing" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteItem(item))" Disabled="@IsProcessing" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>

        <!-- ============================================================
             FOOTER: Total QTY / Summary / Remarks / Transfer / Buttons
             ============================================================ -->
        <RadzenCard Style="padding: 0.75rem;">
            <RadzenRow Gap="0.75rem" AlignItems="AlignItems.End">

                <!-- Totals -->
                <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                    <RadzenLabel Text="Total QTY" Style="font-weight:600; font-size:0.85rem;" />
                    <RadzenNumeric Value="@PurchaseItems.Sum(x => x.Quantity)"
                                   Style="width:100%"
                                   ReadOnly="true"
                                   TValue="decimal" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                    <RadzenLabel Text="Total Amount" Style="font-weight:600; font-size:0.85rem;" />
                    <RadzenNumeric @bind-Value="Purchase.TotalAmount" Style="width:100%" ReadOnly="true" TValue="decimal" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                    <RadzenLabel Text="Discount" Style="font-weight:600; font-size:0.85rem;" />
                    <RadzenNumeric @bind-Value="Purchase.DiscountAmount" Style="width:100%" Min="0" TValue="decimal?" Change="@OnDiscountChanged" Disabled="@IsProcessing" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                    <RadzenLabel Text="VAT Amount" Style="font-weight:600; font-size:0.85rem;" />
                    <RadzenNumeric @bind-Value="Purchase.VatAmount" Style="width:100%" Min="0" TValue="decimal?" Change="@OnVatChanged" Disabled="@IsProcessing" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                    <RadzenLabel Text="Net Amount" Style="font-weight:600; font-size:0.85rem;" />
                    <RadzenNumeric @bind-Value="Purchase.NetAmount" Style="width:100%" ReadOnly="true" TValue="decimal" />
                </RadzenColumn>

                <!-- Remarks -->
                <RadzenColumn Size="12" SizeMD="6" SizeLG="5">
                    <RadzenLabel Text="Remarks:" Style="font-weight:600; font-size:0.85rem;" />
                    <RadzenTextArea @bind-Value="Purchase.Remarks"
                                    Style="width:100%"
                                    Rows="2"
                                    Placeholder="Enter any remarks..."
                                    Disabled="@IsProcessing" />
                </RadzenColumn>

                <!-- Transfer To -->
              @*   <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                    <RadzenLabel Text="Transfer to" Style="font-weight:600; font-size:0.85rem;" />
                    <RadzenDropDown @bind-Value="Purchase.TransferToStoreId"
                                    Data="@Stores"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    Placeholder="Select Branch"
                                    Style="width:100%"
                                    Disabled="@IsProcessing" />
                </RadzenColumn> *@

                <!-- Action Buttons -->
                <RadzenColumn Size="12">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" JustifyContent="JustifyContent.End">
                        <RadzenButton Icon="drafts"
                                      ButtonStyle="ButtonStyle.Warning"
                                      Click="@SaveAsDraft"
                                      Disabled="@IsProcessing"
                                      Text="DRAFT"
                                      Style="min-width:100px; font-weight:700;" />

                        <RadzenButton Icon="save"
                                      ButtonStyle="ButtonStyle.Success"
                                      Click="@SavePurchase"
                                      Disabled="@IsProcessing"
                                      Text="@(IsEditMode ? "UPDATE" : "SAVE")"
                                      Style="min-width:100px; font-weight:700;" />

                        <RadzenButton Icon="cancel"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Click="@Cancel"
                                      Disabled="@IsProcessing"
                                      Text="CANCEL"
                                      Style="min-width:100px; font-weight:700;" />
                    </RadzenStack>
                </RadzenColumn>

            </RadzenRow>
        </RadzenCard>

    </RadzenStack>
}
