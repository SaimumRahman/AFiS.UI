@page "/PurchaseEntry"
@page "/PurchaseEntry/Edit/{Id:int}"
@page "/PurchaseEntry/Draft/{DraftId:int}"

@using JM.UI.Entities.Model.PurchaseItems
@inherits PurchaseEntryComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenStack Gap="1rem">
    @if (IsLoading)
    {
        <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large">
            <Template>Loading...</Template>
        </RadzenProgressBarCircular>
    }
    else
    {
        <!-- Page Header -->
        <RadzenRow>
            <RadzenColumn Size="12">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@PageTitle</RadzenText>
            </RadzenColumn>
        </RadzenRow>

        <!-- Purchase Header Section -->
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.H6">Purchase Information</RadzenText>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenLabel Text="Supplier *" />
                        <RadzenDropDown @bind-Value="Purchase.SupplierId"
                                        Data="@Suppliers"
                                        TextProperty="Name"
                                        ValueProperty="Id"
                                        Placeholder="Select Supplier"
                                        Style="width: 100%"
                                        Disabled="@IsProcessing" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenLabel Text="Store *" />
                        <RadzenDropDown @bind-Value="Purchase.StoreId"
                                        Data="@Stores"
                                        TextProperty="Name"
                                        ValueProperty="Id"
                                        Placeholder="Select Store"
                                        Style="width: 100%"
                                        Disabled="@IsProcessing" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenLabel Text="Purchase Date *" />
                        <RadzenDatePicker @bind-Value="Purchase.PurchaseDate"
                                          Style="width: 100%"
                                          DateFormat="dd/MM/yyyy"
                                          Disabled="@IsProcessing" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenLabel Text="Bill/Invoice Number" />
                        <RadzenTextBox @bind-Value="Purchase.BillInvoiceNumber"
                                       Style="width: 100%"
                                       Placeholder="Bill Number"
                                       Disabled="@IsProcessing" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenCheckBox @bind-Value="Purchase.IsVatIncluded" Name="vatIncluded" />
                    <RadzenLabel Text="VAT Included" Component="vatIncluded" Style="margin-left: 0.5rem" />
                </RadzenColumn>
                <RadzenRow Gap="1rem" Visible="false">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Bill/Invoice Name" />
                        <RadzenTextBox @bind-Value="Purchase.BillInvoiceName"
                                       Style="width: 100%"
                                       Placeholder="Bill Name"
                                       Disabled="@IsProcessing" />
                    </RadzenColumn>

                    
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>

        <!-- Item Entry Section -->
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenRow>
                    <RadzenColumn Size="12">
                        <RadzenText TextStyle="TextStyle.H6">Item Entry</RadzenText>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenCard Style="padding: 1rem;">
                    <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">

                        <!-- Barcode Search -->
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenLabel Text="Barcode Search" Style="font-weight: 600;" />
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Style="margin-top: 0.25rem;">
                                <RadzenTextBox @bind-Value="BarcodeSearchText"
                                               Placeholder="Enter or scan barcode"
                                               Style="flex: 1;"
                                               Disabled="@IsProcessing"
                                               @onkeypress="@(async args =>
                                               {
                                                   if (args.Key == "Enter")
                                                       await SearchByBarcode();
                                               })" />

                                <RadzenButton Icon="search"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Click="@SearchByBarcode"
                                              Disabled="@(IsProcessing || IsSearchingBarcode)" />

                                <RadzenButton Icon="close"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@ClearBarcodeSearch"
                                              Disabled="@IsProcessing" />
                            </RadzenStack>
                        </RadzenColumn>

                        <!-- Generate Barcode -->
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenLabel Text="Barcode Actions" Style="font-weight: 600;" />
                            <RadzenButton Icon="qr_code"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Click="@GenerateBarcode"
                                          Disabled="@IsProcessing"
                                          Text="Generate Barcode"
                                          Style="width: 100%; margin-top: 0.25rem;" />
                        </RadzenColumn>

                        <!-- Create New Item -->
                        <RadzenColumn Size="12" SizeLG="4">
                            <RadzenLabel Text="Item Management" Style="font-weight: 600;" />
                            <RadzenButton Icon="@(IsNewItemMode ? "close" : "add_circle")"
                                          ButtonStyle="@(IsNewItemMode ? ButtonStyle.Warning : ButtonStyle.Success)"
                                          Click="@ToggleCreateNewItem"
                                          Disabled="@IsProcessing"
                                          Text="@(IsNewItemMode ? "Cancel New Item" : "Create New Item")"
                                          Style="width: 100%; margin-top: 0.25rem;" />
                        </RadzenColumn>

                    </RadzenRow>
                </RadzenCard>


                @if (DisableItemFields)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="info" />
                            <RadzenText>Existing item loaded. Fields are read-only. Clear to create new or search different item.</RadzenText>
                        </RadzenStack>
                    </RadzenAlert>
                }

                @if (IsNewItemMode)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="add_circle" />
                            <RadzenText>Create New Item Mode: Fill in all required fields to create a new item on the go.</RadzenText>
                        </RadzenStack>
                    </RadzenAlert>
                }

                <!-- Item Selection / Creation Section -->
                <RadzenRow Gap="1rem">
                    @if (!DisableItemFields)
                    {

                        @if (IsNewItemMode)
                        {
                            <!-- New Item Name -->
                            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                                <RadzenLabel Text="Item Name *" />
                                <RadzenTextBox @bind-Value="CurrentItem.ItemName"
                                               Style="width: 100%"
                                               Placeholder="Enter item name"
                                               Disabled="@IsProcessing" />
                            </RadzenColumn>
                        }
                        else
                        {
                            <!-- Existing Item Selection -->
                            <RadzenColumn Size="12" SizeMD="4" SizeLG="3">
                                <RadzenLabel Text="Item *" />
                                <RadzenDropDown @bind-Value="CurrentItem.ItemId"
                                                Data="@Items"
                                                TextProperty="Name"
                                                ValueProperty="Id"
                                                Placeholder="Select Item"
                                                Change="@(args => OnItemChanged(CurrentItem.ItemId))"
                                                Style="width: 100%"
                                                Disabled="@IsProcessing" />
                            </RadzenColumn>
                        }
                    }
                    else
                    {
                        <!-- Read-only Item Display -->
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenLabel Text="Item Name" />
                            <RadzenTextBox Value="@CurrentItem.ItemName"
                                           Style="width: 100%"
                                           ReadOnly="true" />
                        </RadzenColumn>
                    }

                    <!-- Barcode (unchanged) -->
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenLabel Text="Barcode *" />
                        <RadzenTextBox @bind-Value="CurrentItem.Barcode"
                                       Style="width: 100%"
                                       Placeholder="Barcode"
                                       ReadOnly="true" />
                    </RadzenColumn>

                </RadzenRow>

                <!-- Additional Fields Row 1 -->
                <RadzenRow Gap="1rem">
                    @if (IsNewItemMode)
                    {
                        <!-- Group (always visible) -->
                        <RadzenColumn Size="12" SizeMD="4" SizeLG="3">
                            <RadzenLabel Text="Group *" />
                            <RadzenDropDown @bind-Value="CurrentItem.GroupId"
                                            Data="@Groups"
                                            TextProperty="Name"
                                            ValueProperty="Id"
                                            Placeholder="Select Group"
                                            Change="@(args => OnGroupChanged(CurrentItem.GroupId))"
                                            Style="width: 100%"
                                            Disabled="@IsProcessing" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4" SizeLG="3">
                            <RadzenLabel Text="Sub-Group *" />
                            <RadzenDropDown @bind-Value="CurrentItem.SubGroupId"
                                            Data="@SubGroups"
                                            TextProperty="Name"
                                            ValueProperty="Id"
                                            Placeholder="Select Sub-Group"
                                            Style="width: 100%"
                                            Disabled="@(IsProcessing || DisableItemFields)" />
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="4" SizeLG="3">
                            <RadzenLabel Text="Unit *" />
                            <RadzenDropDown @bind-Value="CurrentItem.MesurementUnitId"
                                            Data="@Units"
                                            TextProperty="Name"
                                            ValueProperty="Id"
                                            Placeholder="Select Unit"
                                            Style="width: 100%"
                                            Disabled="@(IsProcessing || DisableItemFields)" />
                        </RadzenColumn>
                    }

                    <RadzenColumn Size="12" SizeMD="4" SizeLG="2">
                        <RadzenLabel Text="Shade No" />
                        <RadzenTextBox @bind-Value="CurrentItem.ShadeNo"
                                       Style="width: 100%"
                                       Placeholder="Shade No"
                                       Disabled="@(IsProcessing || DisableItemFields)" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4" SizeLG="2">
                        <RadzenLabel Text="Color" />
                        <RadzenDropDown @bind-Value="CurrentItem.ColorId"
                                        Data="@Colors"
                                        TextProperty="Name"
                                        ValueProperty="Id"
                                        Placeholder="Select Color"
                                        Style="width: 100%"
                                        Disabled="@(IsProcessing || DisableItemFields)"
                                        Change="@(args => OnColorChanged(CurrentItem.ColorId))" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4" SizeLG="2">
                        <RadzenLabel Text="Size" />
                        <RadzenDropDown @bind-Value="CurrentItem.SizeId"
                                        Data="@Sizes"
                                        TextProperty="Name"
                                        ValueProperty="Id"
                                        Placeholder="Select Size"
                                        Style="width: 100%"
                                        Disabled="@(IsProcessing || DisableItemFields)"
                                        Change="@(args => OnSizeChanged(CurrentItem.SizeId))" />
                    </RadzenColumn>
                </RadzenRow>

                <!-- Additional Fields Row 2 -->
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="4" SizeLG="3">
                        <RadzenLabel Text="Material Type" />
                        <RadzenTextBox @bind-Value="CurrentItem.MaterialType"
                                       Style="width: 100%"
                                       Placeholder="Material Type"
                                       Disabled="@(IsProcessing || DisableItemFields)" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4" SizeLG="3">
                        <RadzenLabel Text="Origin" />
                        <RadzenTextBox @bind-Value="CurrentItem.Origin"
                                       Style="width: 100%"
                                       Placeholder="Origin"
                                       Disabled="@(IsProcessing || DisableItemFields)" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4" SizeLG="3">
                        <RadzenLabel Text="Brand/Color" />
                        <RadzenTextBox @bind-Value="CurrentItem.BrandColor"
                                       Style="width: 100%"
                                       Placeholder="Brand Color"
                                       Disabled="@(IsProcessing || DisableItemFields)" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4" SizeLG="3">
                        <RadzenLabel Text="Product Type" />
                        <RadzenDropDown @bind-Value="CurrentItem.ProductType"
                                        Data="@ProductTypes"
                                        Placeholder="Select Type"
                                        Style="width: 100%"
                                        Disabled="@(IsProcessing || DisableItemFields)" />
                    </RadzenColumn>
                </RadzenRow>

                <!-- Pricing and Quantity Row -->
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
                        <RadzenLabel Text="Quantity *" />
                        <RadzenNumeric @bind-Value="CurrentItem.Quantity"
                                       Style="width: 100%"
                                       Min="0"
                                       TValue="decimal"
                                       Disabled="@IsProcessing" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
                        <RadzenLabel Text="Purchase Price *" />
                        <RadzenNumeric @bind-Value="CurrentItem.PurchasePrice"
                                       Style="width: 100%"
                                       Min="0"
                                       TValue="decimal"
                                       Change="@CalculateItemTotal"
                                       Disabled="@IsProcessing" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
                        <RadzenLabel Text="Other Cost" />
                        <RadzenNumeric @bind-Value="CurrentItem.OtherCost"
                                       Style="width: 100%"
                                       Min="0"
                                       TValue="decimal?"
                                       Change="@CalculateItemTotal"
                                       Disabled="@IsProcessing" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
                        <RadzenLabel Text="Carrying Cost" />
                        <RadzenNumeric @bind-Value="CurrentItem.CarryingCost"
                                       Style="width: 100%"
                                       Min="0"
                                       TValue="decimal?"
                                       Change="@CalculateItemTotal"
                                       Disabled="@IsProcessing" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
                        <RadzenLabel Text="VAT %" />
                        <RadzenNumeric @bind-Value="CurrentItem.VatPercentage"
                                       Style="width: 100%"
                                       Min="0"
                                       Max="100"
                                       TValue="decimal?"
                                       Change="@CalculateItemTotal"
                                       Disabled="@IsProcessing" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
                        <RadzenLabel Text="Total" />
                        <RadzenNumeric @bind-Value="CurrentItem.TotalAmount"
                                       Style="width: 100%"
                                       ReadOnly="true"
                                       TValue="decimal" />
                    </RadzenColumn>
                </RadzenRow>

                <!-- Saleable Section -->
                <RadzenRow Gap="1rem" AlignItems="AlignItems.End">
                    <RadzenColumn Size="12" SizeMD="3" SizeLG="2">
                        <RadzenCheckBox @bind-Value="CurrentItem.IsSaleable" Name="saleable" />
                        <RadzenLabel Text="Is Saleable" Component="saleable" Style="margin-left: 0.5rem" />
                    </RadzenColumn>

                    @if (CurrentItem.IsSaleable)
                    {
                        <RadzenColumn Size="12" SizeMD="4" SizeLG="2">
                            <RadzenLabel Text="Sale Price *" />
                            <RadzenNumeric @bind-Value="CurrentItem.SalePrice"
                                           Style="width: 100%"
                                           Min="0"
                                           TValue="decimal?"
                                           Disabled="@IsProcessing" />
                        </RadzenColumn>
                    }

                    @if (IsNewItemMode)
                    {
                        <RadzenColumn Size="12" SizeMD="4" SizeLG="3">
                            <RadzenCheckBox @bind-Value="CurrentItem.CountStockByColor" Name="byColor" />
                            <RadzenLabel Text="Count Stock By Color" Component="byColor" Style="margin-left: 0.5rem" />
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="4" SizeLG="3">
                            <RadzenCheckBox @bind-Value="CurrentItem.CountStockBySize" Name="bySize" />
                            <RadzenLabel Text="Count Stock By Size" Component="bySize" Style="margin-left: 0.5rem" />
                        </RadzenColumn>
                    }

                    <RadzenColumn Size="12" SizeMD="12" SizeLG="2">
                        <RadzenButton Icon="add"
                                      ButtonStyle="ButtonStyle.Success"
                                      Click="@AddItemToGrid"
                                      Disabled="@IsProcessing"
                                      Text="Add Item"
                                      Style="width: 100%" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>

        <!-- Items Grid -->
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.H6">Purchase Items</RadzenText>

                <RadzenDataGrid @ref="ItemsGrid"
                                Data="@PurchaseItems"
                                TItem="PurchaseItemDTO"
                                AllowPaging="true"
                                PageSize="10"
                                AllowSorting="true"
                                AllowFiltering="false"
                                EmptyText="No items added yet">
                    <Columns>
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="ItemName" Title="Item" Width="200px" />
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="Barcode" Title="Barcode" Width="150px" />
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="ShadeNo" Title="Shade" Width="100px" />
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="ColorName" Title="Color" Width="100px" />
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="SizeName" Title="Size" Width="100px" />
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="Quantity" Title="Qty" Width="80px">
                            <Template Context="item">
                                @item.Quantity.ToString("N2")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="PurchasePrice" Title="Price" Width="100px">
                            <Template Context="item">
                                @item.PurchasePrice.ToString("N2")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="TotalAmount" Title="Total" Width="120px">
                            <Template Context="item">
                                @item.TotalAmount.ToString("N2")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="IsSaleable" Title="Saleable" Width="100px">
                            <Template Context="item">
                                <RadzenBadge Text="@(item.IsSaleable ? "Yes" : "No")"
                                             BadgeStyle="@(item.IsSaleable ? BadgeStyle.Success : BadgeStyle.Light)" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="SalePrice" Title="Sale Price" Width="100px">
                            <Template Context="item">
                                @(item.SalePrice.HasValue? item.SalePrice.Value.ToString("N2") : "-")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Title="New" Width="80px">
                            <Template Context="item">
                                @if (item.IsNewItem)
                                {
                                    <RadzenBadge Text="NEW" BadgeStyle="BadgeStyle.Info" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Title="Actions" Width="150px" Sortable="false" Filterable="false">
                            <Template Context="item">
                                <RadzenButton Icon="edit"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Click="@(() => EditItem(item))"
                                              Disabled="@IsProcessing" />
                                <RadzenButton Icon="delete"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Small"
                                              Click="@(() => DeleteItem(item))"
                                              Disabled="@IsProcessing" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </RadzenCard>

        <!-- Purchase Summary -->
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.H6">Purchase Summary</RadzenText>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenLabel Text="Total Items" />
                        <RadzenNumeric Value="@PurchaseItems.Count"
                                       Style="width: 100%"
                                       ReadOnly="true"
                                       TValue="int" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenLabel Text="Total Amount" />
                        <RadzenNumeric @bind-Value="Purchase.TotalAmount"
                                       Style="width: 100%"
                                       ReadOnly="true"
                                       TValue="decimal" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenLabel Text="Discount" />
                        <RadzenNumeric @bind-Value="Purchase.DiscountAmount"
                                       Style="width: 100%"
                                       Min="0"

                                       TValue="decimal?"
                                       Change="@OnDiscountChanged"
                                       Disabled="@IsProcessing" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenLabel Text="VAT Amount" />
                        <RadzenNumeric @bind-Value="Purchase.VatAmount"
                                       Style="width: 100%"
                                       Min="0"
                                       TValue="decimal?"
                                       Change="@OnVatChanged"
                                       Disabled="@IsProcessing" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenLabel Text="Net Amount" />
                        <RadzenNumeric @bind-Value="Purchase.NetAmount"
                                       Style="width: 100%"
                                       ReadOnly="true"
                                       TValue="decimal" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4" Visible="false">
                        <RadzenLabel Text="Paid Amount" />
                        <RadzenNumeric @bind-Value="Purchase.PaidAmount"
                                       Style="width: 100%"
                                       Min="0"
                                       TValue="decimal?"
                                       Change="@OnPaidAmountChanged"
                                       Disabled="@IsProcessing" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4" Visible="false">
                        <RadzenLabel Text="Due Amount" />
                        <RadzenNumeric @bind-Value="Purchase.DueAmount"
                                       Style="width: 100%"
                                       ReadOnly="true"
                                       TValue="decimal?" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn Size="12">
                        <RadzenLabel Text="Remarks" />
                        <RadzenTextArea @bind-Value="Purchase.Remarks"
                                        Style="width: 100%"
                                        Rows="3"
                                        Placeholder="Enter any remarks..."
                                        Disabled="@IsProcessing" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>

        <!-- Action Buttons -->
        <!-- Action Buttons -->
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End">
            <RadzenButton Icon="save"
                          ButtonStyle="ButtonStyle.Success"
                          Click="@SavePurchase"
                          Disabled="@IsProcessing"
                          Text="@(IsEditMode ? "Update Purchase" : "Save Purchase")" />

            <RadzenButton Icon="drafts"
                          ButtonStyle="ButtonStyle.Info"
                          Click="@SaveAsDraft"
                          Disabled="@IsProcessing"
                          Text="Save as Draft" />

            <RadzenButton Icon="cancel"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@Cancel"
                          Disabled="@IsProcessing"
                          Text="Cancel" />
        </RadzenStack>
    }
</RadzenStack>