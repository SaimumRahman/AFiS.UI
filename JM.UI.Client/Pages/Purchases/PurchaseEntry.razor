@page "/PurchaseEntry"
@page "/PurchaseEntry/{Id:int}"
@using JM.UI.Entities.Model.PurchaseItems
@attribute [Authorize]
@inherits PurchaseEntryComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading purchase...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header Card -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@Cancel"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="shopping_cart" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Reset"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Purchase Information Card -->
        <RadzenCard class="mb-4">
            <RadzenFieldset Text="Purchase Information" Icon="receipt">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Supplier *" Component="SupplierId" />
                            <RadzenDropDown @bind-Value="Purchase.SupplierId"
                                            Data="@Suppliers"
                                            TextProperty="Name"
                                            ValueProperty="Id"
                                            Placeholder="Select Supplier"
                                            Style="width: 100%;"
                                            Name="SupplierId" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Bill/Invoice Number" Component="BillInvoiceNumber" />
                            <RadzenTextBox @bind-Value="Purchase.BillInvoiceNumber"
                                           Placeholder="Enter bill number"
                                           Style="width: 100%;"
                                           MaxLength="100" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Bill/Invoice Name" Component="BillInvoiceName" />
                            <RadzenTextBox @bind-Value="Purchase.BillInvoiceName"
                                           Placeholder="Enter bill name"
                                           Style="width: 100%;"
                                           MaxLength="200" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Purchase Date *" Component="PurchaseDate" />
                            <RadzenDatePicker @bind-Value="Purchase.PurchaseDate"
                                              Style="width: 100%;"
                                              DateFormat="dd/MM/yyyy"
                                              ShowTime="false" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Store *" Component="StoreId" />
                            <RadzenDropDown @bind-Value="Purchase.StoreId"
                                            Data="@Stores"
                                            TextProperty="Name"
                                            ValueProperty="Id"
                                            Placeholder="Select Store"
                                            Style="width: 100%;"
                                            Name="StoreId" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="VAT Included/Excluded" Component="IsVatIncluded" />
                            <RadzenSwitch @bind-Value="Purchase.IsVatIncluded" />
                            <RadzenText TextStyle="TextStyle.Caption">
                                @(Purchase.IsVatIncluded ? "VAT Included in price" : "VAT Added on top")
                            </RadzenText>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
        </RadzenCard>

        <!-- Item Entry Card -->
        <RadzenCard class="mb-4">
            <RadzenFieldset Text="Item Entry" Icon="add_shopping_cart">
                <RadzenRow Gap="1rem" class="mb-3">
                    <!-- First Row: Product Selection -->
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Group *" Component="GroupId" />
                            <RadzenDropDown @bind-Value="CurrentItem.GroupId"
                                            Data="@Groups"
                                            TextProperty="Name"
                                            ValueProperty="Id"
                                            Change="@OnGroupChange"
                                            Placeholder="Select Group"
                                            Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Sub-Group *" Component="SubGroupId" />
                            <RadzenDropDown @bind-Value="CurrentItem.SubGroupId"
                                            Data="@SubGroups"
                                            TextProperty="Name"
                                            ValueProperty="Id"
                                            Change="@OnSubGroupChange"
                                            Placeholder="Select Sub-Group"
                                            Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Item *" Component="ItemId" />
                            <RadzenDropDown @bind-Value="CurrentItem.ItemId"
                                            Data="@Items"
                                            TextProperty="Name"
                                            ValueProperty="Id"
                                            Change="@OnItemChange"
                                            Placeholder="Select Item"
                                            Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Shade Number" Component="ShadeNo" />
                            <RadzenTextBox @bind-Value="CurrentItem.ShadeNo"
                                           Placeholder="Shade number"
                                           Style="width: 100%;"
                                           MaxLength="50" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem" class="mb-3">
                    <!-- Second Row: Color, Size, Product Type -->
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Color" Component="ColorId" />
                            <RadzenDropDown @bind-Value="CurrentItem.ColorId"
                                            Data="@Colors"
                                            TextProperty="Name"
                                            ValueProperty="Id"
                                            Placeholder="Select Color"
                                            Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Size" Component="SizeId" />
                            <RadzenDropDown @bind-Value="CurrentItem.SizeId"
                                            Data="@Sizes"
                                            TextProperty="Name"
                                            ValueProperty="Id"
                                            Placeholder="Select Size"
                                            Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Product Type *" Component="ProductType" />
                            <RadzenDropDown @bind-Value="CurrentItem.ProductType"
                                            Data="@ProductTypes"
                                            Placeholder="Select Type"
                                            Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Barcode *" Component="Barcode" />
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                <RadzenTextBox @bind-Value="CurrentItem.Barcode"
                                               Placeholder="Barcode"
                                               Style="flex: 1;"
                                               MaxLength="100" />
                                <RadzenButton Icon="qr_code_scanner"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Small"
                                              Click="@GenerateBarcode"
                                              title="Generate Barcode" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem" class="mb-3">
                    <!-- Third Row: Pricing -->
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Quantity *" Component="Quantity" />
                            <RadzenNumeric @bind-Value="CurrentItem.Quantity"
                                           Change="@((decimal _) => CalculateItemTotal(CurrentItem))"
                                           Min="0.01m"
                                           Style="width: 100%;" />

                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Purchase Price *" Component="PurchasePrice" />
                            <RadzenNumeric @bind-Value="CurrentItem.PurchasePrice"
                                           Change="@((decimal _) => CalculateItemTotal(CurrentItem))"
                                           Min="0"
                                           Format="c"
                                           Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Product Price %" Component="ProductPricePercentage" />
                            <RadzenNumeric @bind-Value="CurrentItem.ProductPricePercentage"
                                           Min="0"
                                           Max="100"
                                           Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Other Cost" Component="OtherCost" />
                            <RadzenNumeric @bind-Value="CurrentItem.OtherCost"
                                           Change="@((decimal? _) => CalculateItemTotal(CurrentItem))"
                                           Min="0"
                                           Format="c"
                                           Style="width: 100%;" />

                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Carrying Cost" Component="CarryingCost" />
                            <RadzenNumeric @bind-Value="CurrentItem.CarryingCost"
                                           Change="@((decimal? _) => CalculateItemTotal(CurrentItem))"
                                           Min="0"
                                           Format="c"
                                           Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Operational Cost" Component="OperationalCost" />
                            <RadzenNumeric @bind-Value="CurrentItem.OperationalCost"
                                           Change="@((decimal? _) => CalculateItemTotal(CurrentItem))"
                                           Min="0"
                                           Format="c"
                                           Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem" class="mb-3">
                    <!-- Fourth Row: VAT and Sale Price -->
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="VAT %" Component="VatPercentage" />
                            <RadzenNumeric @bind-Value="CurrentItem.VatPercentage"
                                           Change="@((decimal? _) => CalculateItemTotal(CurrentItem))"
                                           Min="0"
                                           Max="100"
                                           Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="VAT Amount" Component="VatAmount" />
                            <RadzenNumeric @bind-Value="CurrentItem.VatAmount"
                                           Disabled="true"
                                           Format="c"
                                           Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Total Amount" Component="TotalAmount" />
                            <RadzenNumeric @bind-Value="CurrentItem.TotalAmount"
                                           Disabled="true"
                                           Format="c"
                                           Style="width: 100%; font-weight: bold;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Saleable?" Component="IsSaleable" />
                            <RadzenSwitch @bind-Value="CurrentItem.IsSaleable" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Sale Price" Component="SalePrice" />
                            <RadzenNumeric @bind-Value="CurrentItem.SalePrice"
                                           Min="0"
                                           Format="c"
                                           Disabled="@(!CurrentItem.IsSaleable)"
                                           Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem" Style="padding-top: 1.5rem;">
                            <RadzenButton Text="Add Item"
                                          Icon="add"
                                          ButtonStyle="ButtonStyle.Success"
                                          Click="@AddItemToGrid"
                                          Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
        </RadzenCard>

        <!-- Items Grid Card -->
        <RadzenCard class="mb-4">
            <RadzenFieldset Text="Purchase Items" Icon="list">
                <RadzenDataGrid @ref="ItemsGrid"
                                Data="@PurchaseItems"
                                TItem="PurchaseItemDTO"
                                AllowFiltering="false"
                                AllowPaging="true"
                                AllowSorting="true"
                                PageSize="10"
                                PagerHorizontalAlign="HorizontalAlign.Center"
                                GridLines="DataGridGridLines.Both"
                                Density="Density.Compact">
                    <Columns>
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="ItemName" Title="Item" Width="180px" />
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="ShadeNo" Title="Shade" Width="100px" />
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="ColorName" Title="Color" Width="100px" />
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="SizeName" Title="Size" Width="80px" />
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="Barcode" Title="Barcode" Width="150px" />
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="Quantity" Title="Qty" Width="80px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="PurchasePrice" Title="Purchase Price" Width="120px" TextAlign="TextAlign.Right">
                            <Template Context="item">
                                @item.PurchasePrice.ToString("C")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="SalePrice" Title="Sale Price" Width="120px" TextAlign="TextAlign.Right">
                            <Template Context="item">
                                @(item.SalePrice?.ToString("C") ?? "N/A")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="TotalAmount" Title="Total" Width="120px" TextAlign="TextAlign.Right">
                            <Template Context="item">
                                @item.TotalAmount.ToString("C")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Property="IsSaleable" Title="Saleable" Width="90px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <RadzenBadge BadgeStyle="@(item.IsSaleable? BadgeStyle.Success: BadgeStyle.Danger)"
                                             Text="@(item.IsSaleable ? "Yes" : "No")" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PurchaseItemDTO" Title="Actions" Width="120px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                            <Template Context="item">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                                    <RadzenButton Icon="edit"
                                                  ButtonStyle="ButtonStyle.Info"
                                                  Size="ButtonSize.Small"
                                                  Variant="Variant.Flat"
                                                  Click="@(() => EditItem(item))" />
                                    <RadzenButton Icon="delete"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Size="ButtonSize.Small"
                                                  Variant="Variant.Flat"
                                                  Click="@(() => DeleteItem(item))" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenFieldset>
        </RadzenCard>

        <!-- Purchase Summary Card -->
        <RadzenCard class="mb-4">
            <RadzenFieldset Text="Purchase Summary" Icon="calculate">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Total Items" />
                            <RadzenText TextStyle="TextStyle.H6">@PurchaseItems.Count</RadzenText>
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Total Amount" />
                            <RadzenText TextStyle="TextStyle.H6">@Purchase.TotalAmount.ToString("C")</RadzenText>
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Discount" Component="DiscountAmount" />
                            <RadzenNumeric @bind-Value="Purchase.DiscountAmount"
                                           Change="@((decimal? _) => CalculateTotals(CurrentItem))"
                                           Min="0"
                                           Format="c"
                                           Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Net Amount" />
                            <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-success);">
                                @Purchase.NetAmount.ToString("C")
                            </RadzenText>
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Paid Amount" Component="PaidAmount" />
                            <RadzenNumeric @bind-Value="Purchase.PaidAmount"
                                           Change="@((decimal? _) => CalculateTotals(CurrentItem))"
                                           Min="0"
                                           Format="c"
                                           Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Due Amount" />
                            <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-danger);">
                                @Purchase.DueAmount?.ToString("C")
                            </RadzenText>
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="9">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Remarks" Component="Remarks" />
                            <RadzenTextArea @bind-Value="Purchase.Remarks"
                                            Placeholder="Enter any remarks or notes"
                                            Rows="2"
                                            Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
        </RadzenCard>

        <!-- Action Buttons Card -->
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                <RadzenButton Text="Cancel"
                              Icon="cancel"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Flat"
                              Click="@Cancel"
                              Disabled="@IsProcessing" />

                <RadzenButton Text="@(IsEditMode ? "Update Purchase" : "Save Purchase")"
                              Icon="@(IsEditMode ? "update" : "save")"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@Save"
                              IsBusy="@IsProcessing"
                              BusyText="@(IsEditMode ? "Updating..." : "Saving...")" />
            </RadzenStack>
        </RadzenCard>
    }
</RadzenContent>
