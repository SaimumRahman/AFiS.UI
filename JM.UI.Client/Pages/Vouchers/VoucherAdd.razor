@page "/VoucherAdd"
@page "/VoucherAdd/{Id:int}"
@using JM.UI.Entities.Model.Vouchers
@attribute [Authorize]
@inherits VoucherAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="@PageIcon" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenTemplateForm TItem="VoucherModelDTO" Data="@Voucher" Submit="@Save">
        @if (IsLoading)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        }
        else
        {
            <RadzenCard>
                <RadzenRow Gap="1rem">
                    <!-- Voucher Number -->
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="Voucher Number" Component="VoucherNo" />
                            <RadzenNumeric Name="VoucherNo" @bind-Value="@Voucher.VoucherNo" class="w-100" TValue="int" />
                        </RadzenStack>
                    </RadzenColumn>

                    <!-- Voucher Date -->
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="Voucher Date" Component="VoucherDate" />
                            <RadzenDatePicker Name="VoucherDate" @bind-Value="@Voucher.VoucherDate" class="w-100" DateFormat="d" />
                        </RadzenStack>
                    </RadzenColumn>

                    <!-- Voucher Type -->
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="Voucher Type" Component="VoucherType" />
                            <RadzenNumeric Name="VoucherType" @bind-Value="@Voucher.VoucherType" class="w-100" TValue="int" />
                        </RadzenStack>
                    </RadzenColumn>

                    <!-- Store Selection -->
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="Store" Component="StoreId" />
                            <RadzenDropDown TValue="int" @bind-Value="@Voucher.StoreId" 
                                            Data="@Stores" TextProperty="Name" ValueProperty="Id"
                                            Placeholder="Select Store..." class="w-100" Name="StoreId" />
                        </RadzenStack>
                    </RadzenColumn>

                    <!-- User Name -->
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="User Name" Component="UserName" />
                            <RadzenTextBox Name="UserName" @bind-Value="@Voucher.UserName" MaxLength="100" class="w-100" />
                        </RadzenStack>
                    </RadzenColumn>

                    <!-- Description -->
                    <RadzenColumn Size="12">
                        <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="Description" Component="Description" />
                            <RadzenTextArea Name="Description" @bind-Value="@Voucher.Description" MaxLength="1000" class="w-100" Rows="3" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                <!-- Action Buttons -->
                <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem" class="mt-4">
                    <RadzenButton Text="Cancel" 
                                  ButtonStyle="ButtonStyle.Light" 
                                  Click="@Cancel" 
                                  Icon="cancel" 
                                  Disabled="@IsProcessing" />
                    
                    <RadzenButton ButtonType="ButtonType.Submit" 
                                  Text="@(IsEditMode ? "Update" : "Save")" 
                                  ButtonStyle="ButtonStyle.Primary" 
                                  Icon="save" 
                                  IsBusy="@IsProcessing" />
                </RadzenRow>
            </RadzenCard>
        }
    </RadzenTemplateForm>
</RadzenContent>
