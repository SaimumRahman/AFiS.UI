@page "/VoucherList"
@using JM.UI.Entities.Model.Vouchers
@attribute [Authorize]
@inherits VoucherListComponent

<PageTitle>Vouchers</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="receipt" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Voucher Management</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Icon="add_circle_outline"
                                  Text="Add New Voucher"
                                  Click="@AddVoucher"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Medium" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenCard>
        <RadzenDataGrid @ref="VouchersGrid"
                        Data="@VouchersList"
                        TItem="VoucherModelDTO"
                        AllowFiltering="true"
                        AllowColumnResize="true"
                        AllowAlternatingRows="true"
                        AllowPaging="true"
                        AllowSorting="true"
                        PagerHorizontalAlign="HorizontalAlign.Center"
                        PageSize="10"
                        FilterMode="FilterMode.Advanced"
                        ShowPagingSummary="true"
                        IsLoading="@IsLoading"
                        GridLines="DataGridGridLines.Both"
                        Density="Density.Compact">

            <Columns>
                <RadzenDataGridColumn TItem="VoucherModelDTO" Property="VoucherNo" Title="Voucher No" Width="120px" Frozen="true" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="VoucherModelDTO" Property="VoucherDate" Title="Date" Width="150px" FormatString="{0:d}" />
                <RadzenDataGridColumn TItem="VoucherModelDTO" Property="VoucherType" Title="Type" Width="100px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="VoucherModelDTO" Property="StoreName" Title="Store" Width="150px" />
                <RadzenDataGridColumn TItem="VoucherModelDTO" Property="UserName" Title="User" Width="150px" />
                <RadzenDataGridColumn TItem="VoucherModelDTO" Property="Description" Title="Description" />
                
                <RadzenDataGridColumn TItem="VoucherModelDTO" Title="Actions" Width="120px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                    <Template Context="voucher">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                            <RadzenButton Icon="edit"
                                          ButtonStyle="ButtonStyle.Info"
                                          Size="ButtonSize.Small"
                                          Variant="Variant.Flat"
                                          Click="@(() => EditVoucher(voucher))" />

                            <RadzenButton Icon="delete"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Size="ButtonSize.Small"
                                          Variant="Variant.Flat"
                                          Click="@(() => DeleteVoucher(voucher))" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenContent>
