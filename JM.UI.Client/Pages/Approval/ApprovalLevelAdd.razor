@page "/ApprovalLevelAdd"
@page "/ApprovalLevelAdd/{Id:int}"
@using JM.UI.Entities.Model.Approval
@attribute [Authorize]
@inherits ApprovalLevelAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading approval level...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header Card -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@Cancel"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="@PageIcon" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                        @if (IsEditMode)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"#{ApprovalLevel.Id}")" />
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="@(IsEditMode ? "Reset Changes" : "Reset")"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Form Card -->
        <RadzenCard>
            <RadzenTemplateForm TItem="ApprovalLevelModelDTO" Data="@ApprovalLevel" Submit="@Save">
                <RadzenStack Gap="1.5rem">
                    <!-- Workflow and Level Information Section -->
                    <RadzenFieldset Text="Level Information" Icon="layers">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Workflow *" Component="Id" />
                                        <RadzenDropDown @bind-Value="ApprovalLevel.WorkflowID"
                                                        Data="@Workflows"
                                                        TextProperty="WorkflowName"
                                                        ValueProperty="Id"
                                                        Name="Id"
                                                        Placeholder="Select workflow"
                                                        Style="width: 100%;" />
                                        <RadzenRequiredValidator Component="Id" Text="Workflow is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Level Number *" Component="LevelNumber" />
                                        <RadzenNumeric @bind-Value="ApprovalLevel.LevelNumber"
                                                       Name="LevelNumber"
                                                       Placeholder="Enter level number"
                                                       Style="width: 100%;"
                                                       Min="1"
                                                       ShowUpDown="true" />
                                        <RadzenRequiredValidator Component="LevelNumber" Text="Level number is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Level Name *" Component="LevelName" />
                                        <RadzenTextBox @bind-Value="ApprovalLevel.LevelName"
                                                       Name="LevelName"
                                                       Placeholder="Enter level name"
                                                       Style="width: 100%;"
                                                       MaxLength="100" />
                                        <RadzenRequiredValidator Component="LevelName" Text="Level name is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow>
                                <RadzenColumn Size="12">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Level Description" Component="LevelDescription" />
                                        <RadzenTextArea @bind-Value="ApprovalLevel.LevelDescription"
                                                        Name="LevelDescription"
                                                        Placeholder="Enter level description"
                                                        Rows="3"
                                                        Style="width: 100%;"
                                                        MaxLength="500" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Approval Configuration Section -->
                    <RadzenFieldset Text="Approval Configuration" Icon="settings">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Required Approvers *" Component="RequiredApprovers" />
                                        <RadzenNumeric @bind-Value="ApprovalLevel.RequiredApprovers"
                                                       Name="RequiredApprovers"
                                                       Placeholder="Number of required approvers"
                                                       Style="width: 100%;"
                                                       Min="1"
                                                       ShowUpDown="true" />
                                        <RadzenRequiredValidator Component="RequiredApprovers" Text="Required approvers is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Parallel Approval" Component="IsParallelApproval" />
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="height: 36px;">
                                            <RadzenSwitch @bind-Value="ApprovalLevel.IsParallelApproval" Name="IsParallelApproval" />
                                            <RadzenText TextStyle="TextStyle.Body2">
                                                @(ApprovalLevel.IsParallelApproval ? "Multiple approvers can approve simultaneously" : "Sequential approval required")
                                            </RadzenText>
                                        </RadzenStack>
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Status" Component="IsActive" />
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="height: 36px;">
                                            <RadzenSwitch @bind-Value="ApprovalLevel.IsActive" Name="IsActive" />
                                            <RadzenBadge BadgeStyle="@(ApprovalLevel.IsActive? BadgeStyle.Success: BadgeStyle.Danger)"
                                                         Text="@(ApprovalLevel.IsActive ? "Active" : "Inactive")" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Metadata Section (Only in Edit Mode) -->
                    @if (IsEditMode)
                    {
                        <RadzenFieldset Text="Metadata" Icon="info">
                            <RadzenStack Gap="1rem">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Created Date" />
                                            <RadzenTextBox Value="@ApprovalLevel.CreatedDate?.ToString("dd MMM yyyy HH:mm")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Created By" />
                                            <RadzenTextBox Value="@ApprovalLevel.CreatedBy"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Last Modified Date" />
                                            <RadzenTextBox Value="@(ApprovalLevel.LastModifiedDate?.ToString("dd MMM yyyy HH:mm") ?? "N/A")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Last Modified By" />
                                            <RadzenTextBox Value="@(ApprovalLevel.LastModifiedBy ?? "N/A")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenFieldset>
                    }

                    <!-- Action Buttons -->
                    <RadzenCard class="mt-2">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat"
                                          Click="@Cancel"
                                          Disabled="@IsProcessing" />
                            @if (!IsEditMode)
                            {
                                <RadzenButton Text="Save & Add New"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Click="@SaveAndNew"
                                              IsBusy="@IsProcessing"
                                              Disabled="@IsProcessing" />
                            }
                            <RadzenButton Text="@(IsEditMode ? "Update" : "Save")"
                                          Icon="@(IsEditMode ? "update" : "save")"
                                          ButtonStyle="ButtonStyle.Primary"
                                          ButtonType="ButtonType.Submit"
                                          IsBusy="@IsProcessing"
                                          BusyText="@(IsEditMode ? "Updating..." : "Saving...")" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenContent>