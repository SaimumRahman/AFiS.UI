@page "/ApprovalWorkflowAdd"
@page "/ApprovalWorkflowAdd/{Id:int}"
@using JM.UI.Entities.Model.Approval
@attribute [Authorize]
@inherits ApprovalWorkflowAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading approval workflow...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header Card -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@Cancel"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="@PageIcon" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                        @if (IsEditMode)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"#{ApprovalWorkflow.Id}")" />
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="@(IsEditMode ? "Reset Changes" : "Reset")"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Form Card -->
        <RadzenCard>
            <RadzenTemplateForm TItem="ApprovalWorkflowModelDTO" Data="@ApprovalWorkflow" Submit="@Save">
                <RadzenStack Gap="1.5rem">
                    <!-- Workflow Information Section -->
                    <RadzenFieldset Text="Workflow Information" Icon="account_tree">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Workflow Name *" Component="WorkflowName" />
                                        <RadzenTextBox @bind-Value="ApprovalWorkflow.WorkflowName"
                                                       Name="WorkflowName"
                                                       Placeholder="Enter workflow name"
                                                       Style="width: 100%;"
                                                       MaxLength="200" />
                                        <RadzenRequiredValidator Component="WorkflowName" Text="Workflow name is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Entity Type" Component="EntityType" />
                                        <RadzenTextBox @bind-Value="ApprovalWorkflow.EntityType"
                                                       Name="EntityType"
                                                       Placeholder="Enter entity type"
                                                       Style="width: 100%;"
                                                       MaxLength="100" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Total Levels *" Component="TotalLevels" />
                                        <RadzenNumeric @bind-Value="ApprovalWorkflow.TotalLevels"
                                                       Name="TotalLevels"
                                                       Placeholder="Number of levels"
                                                       Style="width: 100%;"
                                                       Min="1"
                                                       ShowUpDown="true" />
                                        <RadzenRequiredValidator Component="TotalLevels" Text="Total levels is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow>
                                <RadzenColumn Size="12">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Workflow Description" Component="WorkflowDescription" />
                                        <RadzenTextArea @bind-Value="ApprovalWorkflow.WorkflowDescription"
                                                        Name="WorkflowDescription"
                                                        Placeholder="Enter workflow description"
                                                        Rows="4"
                                                        Style="width: 100%;" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Status Section -->
                    <RadzenFieldset Text="Status Configuration" Icon="toggle_on">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Workflow Status" Component="IsActive" />
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="height: 36px;">
                                            <RadzenSwitch @bind-Value="ApprovalWorkflow.IsActive" Name="IsActive" />
                                            <RadzenBadge BadgeStyle="@(ApprovalWorkflow.IsActive? BadgeStyle.Success: BadgeStyle.Danger)"
                                                         Text="@(ApprovalWorkflow.IsActive ? "Active" : "Inactive")" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Metadata Section (Only in Edit Mode) -->
                    @if (IsEditMode)
                    {
                        <RadzenFieldset Text="Metadata" Icon="info">
                            <RadzenStack Gap="1rem">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Created Date" />
                                            <RadzenTextBox Value="@ApprovalWorkflow.CreatedDate?.ToString("dd MMM yyyy HH:mm")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Created By" />
                                            <RadzenTextBox Value="@ApprovalWorkflow.CreatedBy?.ToString()"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Last Modified Date" />
                                            <RadzenTextBox Value="@(ApprovalWorkflow.LastModifiedDate?.ToString("dd MMM yyyy HH:mm") ?? "N/A")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Last Modified By" />
                                            <RadzenTextBox Value="@(ApprovalWorkflow.LastModifiedBy?.ToString() ?? "N/A")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenFieldset>
                    }

                    <!-- Action Buttons -->
                    <RadzenCard class="mt-2">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat"
                                          Click="@Cancel"
                                          Disabled="@IsProcessing" />
                            @if (!IsEditMode)
                            {
                                <RadzenButton Text="Save & Add New"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Click="@SaveAndNew"
                                              IsBusy="@IsProcessing"
                                              Disabled="@IsProcessing" />
                            }
                            <RadzenButton Text="@(IsEditMode ? "Update" : "Save")"
                                          Icon="@(IsEditMode ? "update" : "save")"
                                          ButtonStyle="ButtonStyle.Primary"
                                          ButtonType="ButtonType.Submit"
                                          IsBusy="@IsProcessing"
                                          BusyText="@(IsEditMode ? "Updating..." : "Saving...")" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenContent>