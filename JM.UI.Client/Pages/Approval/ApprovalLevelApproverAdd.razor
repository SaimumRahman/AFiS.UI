@page "/ApprovalLevelApproverAdd"
@page "/ApprovalLevelApproverAdd/{Id:int}"
@using JM.UI.Entities.Model.Approval
@inherits ApprovalLevelApproverAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading approver...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header Card -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@Cancel"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="@PageIcon" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                        @if (IsEditMode)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"#{ApprovalLevelApprover.Id}")" />
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="@(IsEditMode ? "Reset Changes" : "Reset")"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Form Card -->
        <RadzenCard>
            <RadzenTemplateForm TItem="ApprovalLevelApproverModelDTO" Data="@ApprovalLevelApprover" Submit="@Save">
                <RadzenStack Gap="1.5rem">
                    <!-- Approver Information Section -->
                    <RadzenFieldset Text="Approver Information" Icon="person">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Approval Level *" Component="ApprovalLevelID" />
                                        <RadzenDropDown @bind-Value="ApprovalLevelApprover.ApprovalLevelID"
                                                        Data="@ApprovalLevels"
                                                        TextProperty="LevelName"
                                                        ValueProperty="Id"
                                                        Name="ApprovalLevelID"
                                                        Placeholder="Select approval level"
                                                        Style="width: 100%;"
                                                        Change="@OnApprovalLevelChanged" />
                                        <RadzenRequiredValidator Component="ApprovalLevelID" Text="Approval level is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="User *" Component="UserID" />
                                        <RadzenDropDown @bind-Value="ApprovalLevelApprover.UserID"
                                                        Data="@Users"
                                                        TextProperty="UserName"
                                                        ValueProperty="UserId"
                                                        Name="UserID"
                                                        Placeholder="Select user"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        AllowFiltering="true"
                                                        Style="width: 100%;"
                                                        Change="@OnUserChanged" />
                                        <RadzenRequiredValidator Component="UserID" Text="User is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Approver Order *" Component="ApproverOrder" />
                                        <RadzenNumeric @bind-Value="ApprovalLevelApprover.ApproverOrder"
                                                       Name="ApproverOrder"
                                                       Placeholder="Enter approver order"
                                                       Style="width: 100%;"
                                                       Min="1"
                                                       ShowUpDown="true" />
                                        <RadzenRequiredValidator Component="ApproverOrder" Text="Approver order is required" />
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                            Order in which approvers should act (1, 2, 3...)
                                        </RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Assigned Date" Component="AssignedDate" />
                                        <RadzenDatePicker @bind-Value="ApprovalLevelApprover.AssignedDate"
                                                          Name="AssignedDate"
                                                          DateFormat="dd MMM yyyy"
                                                          Style="width: 100%;"
                                                          ShowTime="false" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Status" Component="IsActive" />
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="height: 36px;">
                                            <RadzenSwitch @bind-Value="ApprovalLevelApprover.IsActive" Name="IsActive" />
                                            <RadzenBadge BadgeStyle="@(ApprovalLevelApprover.IsActive? BadgeStyle.Success: BadgeStyle.Danger)"
                                                         Text="@(ApprovalLevelApprover.IsActive ? "Active" : "Inactive")" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Selected Level Details (If level is selected) -->
                    @if (ApprovalLevelApprover.ApprovalLevelID > 0 && !string.IsNullOrEmpty(SelectedLevelDetails))
                    {
                        <RadzenFieldset Text="Selected Level Details" Icon="info">
                            <RadzenStack Gap="0.5rem">
                                <RadzenText TextStyle="TextStyle.Body1">
                                    @SelectedLevelDetails
                                </RadzenText>
                            </RadzenStack>
                        </RadzenFieldset>
                    }

                    <!-- Metadata Section (Only in Edit Mode) -->
                    @if (IsEditMode)
                    {
                        <RadzenFieldset Text="Metadata" Icon="info">
                            <RadzenStack Gap="1rem">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Created Date" />
                                            <RadzenTextBox Value="@ApprovalLevelApprover.CreatedDate?.ToString("dd MMM yyyy HH:mm")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Created By" />
                                            <RadzenTextBox Value="@ApprovalLevelApprover.CreatedBy.ToString()"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Last Modified Date" />
                                            <RadzenTextBox Value="@(ApprovalLevelApprover.LastModifiedDate?.ToString("dd MMM yyyy HH:mm") ?? "N/A")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Last Modified By" />
                                            <RadzenTextBox Value="@(ApprovalLevelApprover.LastModifiedBy?.ToString() ?? "N/A")"
                                                           Disabled="true"
                                                           Style="width: 100%;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenFieldset>
                    }

                    <!-- Action Buttons -->
                    <RadzenCard class="mt-2">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat"
                                          Click="@Cancel"
                                          Disabled="@IsProcessing" />
                            @if (!IsEditMode)
                            {
                                <RadzenButton Text="Save & Add New"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Click="@SaveAndNew"
                                              IsBusy="@IsProcessing"
                                              Disabled="@IsProcessing" />
                            }
                            <RadzenButton Text="@(IsEditMode ? "Update" : "Save")"
                                          Icon="@(IsEditMode ? "update" : "save")"
                                          ButtonStyle="ButtonStyle.Primary"
                                          ButtonType="ButtonType.Submit"
                                          IsBusy="@IsProcessing"
                                          BusyText="@(IsEditMode ? "Updating..." : "Saving...")" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenContent>