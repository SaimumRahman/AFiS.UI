@page "/StockOpeningEntry"

@inherits JM.UI.Client.Pages.StockOpening.StockOpeningEntryComponent
@using JM.UI.Entities.Model.Colors

<PageTitle>@PageTitleOverride</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1">@PageTitleOverride</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6" Style="display: flex; justify-content: flex-end; align-items: center;">
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Cancel" Click="@Cancel" Style="margin-right: 10px;" />
            <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Save" Click="@SaveStockOpening" Disabled="@IsProcessing" />
        </RadzenColumn>
    </RadzenRow>

    @* Header Inputs *@
    <RadzenCard Style="padding: 1rem;">
        <RadzenRow Gap="1rem" Style="margin-bottom: 1rem;">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenLabel Text="Store" />
                <RadzenDropDown @bind-Value="StockOpening.StoreId" Data=@Stores TextProperty="Name" ValueProperty="Id" Style="width: 100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenLabel Text="Date" />
                <RadzenDatePicker @bind-Value="StockOpening.TransectionDate" DateFormat="dd MMM yyyy" Style="width: 100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                 <RadzenLabel Text="Remarks" />
                <RadzenTextBox @bind-Value="StockOpening.Remarks" Style="width: 100%;" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @* Item Input *@
    <RadzenCard Style="padding: 1rem;">
        <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4"><strong>Add Item Detail</strong></RadzenText>
        <RadzenRow Gap="1rem" class="rz-mb-4">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenLabel Text="Search Barcode" />
                <div class="d-flex">
                    <RadzenTextBox @bind-Value="BarcodeSearchText" Style="width: 100%;" Placeholder="Enter Barcode" />
                     <RadzenButton Icon="search" ButtonStyle="ButtonStyle.Primary" Click="SearchByBarcode" Style="margin-left: 5px;"/>
                </div>
            </RadzenColumn>

            @if(IsNewItemMode)
            {
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenLabel Text="New Item Name *" />
                    <RadzenTextBox @bind-Value="CurrentItem.ItemName" Style="width: 100%;" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                     <RadzenLabel Text="Group" />
                     <RadzenDropDown @bind-Value="CurrentItem.GroupId" Data=@Groups TextProperty="Name" ValueProperty="Id" Style="width: 100%;" Change=@(args => LoadSubGroups(args)) AllowClear="true" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                     <RadzenLabel Text="Sub-Group *" />
                     <div class="d-flex" style="gap:5px;">
                         <RadzenDropDown @bind-Value="CurrentItem.SubGroupId" Data=@SubGroups TextProperty="Name" ValueProperty="Id" Style="width: 100%;" AllowClear="true" />
                         <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Click="@(() => IsNewItemMode = false)" title="Cancel New Item" />
                     </div>
                </RadzenColumn>
            }
            else
            {
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenLabel Text="Select Item *" />
                    <RadzenDropDown @bind-Value="CurrentItem.ItemId" Data=@AvailableItems TextProperty="Name" ValueProperty="Id" 
                                    Style="width: 100%;" AllowFiltering="true" Change="@(args => OnItemSelected(args))" AllowClear="true" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3" Style="display: flex; align-items: flex-end;">
                    <RadzenButton ButtonStyle="ButtonStyle.Info" Text="Add New Item" Click="@(() => { IsNewItemMode = true; CurrentItem = CreateNewItem(); BarcodeSearchText = string.Empty; })" />
                </RadzenColumn>
            }
        </RadzenRow>

        <RadzenRow Gap="1rem" class="rz-mb-4">
            <RadzenColumn Size="12" SizeMD="2">
                 <RadzenLabel Text="Quantity *" />
                 <RadzenNumeric @bind-Value="CurrentItem.Quantity" Style="width: 100%;" />
            </RadzenColumn>
             <RadzenColumn Size="12" SizeMD="2">
                 <RadzenLabel Text="Trade Price *" />
                 <RadzenNumeric @bind-Value="CurrentItem.TradePrice" Style="width: 100%;" />
            </RadzenColumn>
             <RadzenColumn Size="12" SizeMD="2">
                 <RadzenLabel Text="Is Saleable" />
                 <div><RadzenSwitch @bind-Value="CurrentItem.IsSaleable" /></div>
            </RadzenColumn>
            @if(CurrentItem.IsSaleable)
            {
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenLabel Text="Sale Price (MRP) *" />
                    <RadzenNumeric @bind-Value="CurrentItem.SalePrice" Style="width: 100%;" />
                </RadzenColumn>
            }
        </RadzenRow>

        <RadzenRow Gap="1rem" class="rz-mb-4">
             <RadzenColumn Size="12" SizeMD="3">
                <RadzenLabel Text="Color" />
                <RadzenDropDown @bind-Value="CurrentItem.ColorId" Data=@Colors TextProperty="Name" ValueProperty="Id" Style="width: 100%;" AllowClear="true">
                    <Template Context="color">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <div style="width: 20px; height: 20px; border-radius: 4px; border: 1px solid #ccc; background-color: @((color as ColorsDTO).HexCode ?? "#fff")"></div>
                            <span>@((color as ColorsDTO).Name)</span>
                        </div>
                    </Template>
                    <ValueTemplate Context="color">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <div style="width: 20px; height: 20px; border-radius: 4px; border: 1px solid #ccc; background-color: @((color as ColorsDTO).HexCode ?? "#fff")"></div>
                            <span>@((color as ColorsDTO).Name)</span>
                        </div>
                    </ValueTemplate>
                </RadzenDropDown>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenLabel Text="Size" />
                <RadzenDropDown @bind-Value="CurrentItem.SizeId" Data=@Sizes TextProperty="Name" ValueProperty="Id" Style="width: 100%;" AllowClear="true" />
            </RadzenColumn>

            @if(IsNewItemMode)
            {
                 <RadzenColumn Size="12" SizeMD="3">
                    <RadzenLabel Text="Unit *" />
                    <RadzenDropDown @bind-Value="CurrentItem.MesurementUnitId" Data=@Units TextProperty="Name" ValueProperty="Id" Style="width: 100%;" />
                </RadzenColumn>
                 <RadzenColumn Size="12" SizeMD="3">
                    <RadzenLabel Text="Brand" />
                    <RadzenDropDown @bind-Value="CurrentItem.BrandId" Data=@Brands TextProperty="BrandName" ValueProperty="BrandId" Style="width: 100%;" AllowClear="true" />
                </RadzenColumn>
            }

        </RadzenRow>
        <RadzenRow>
            <RadzenColumn Size="12" Style="display: flex; justify-content: flex-end;">
                 <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Secondary" Text="Add to List" Click="AddItemToGrid" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @* Items Grid *@
    <RadzenCard Style="padding: 1rem;">
        <RadzenDataGrid @ref="ItemsGrid" 
                        Data="@StockOpening.Items" 
                        TItem="JM.UI.Entities.Model.StockOpening.StockOpeningItemDTO" 
                        AllowPaging="false" 
                        EmptyText="No items added yet.">
            <Columns>
                <RadzenDataGridColumn TItem="JM.UI.Entities.Model.StockOpening.StockOpeningItemDTO" Property="Barcode" Title="Barcode" Width="120px" />
                <RadzenDataGridColumn TItem="JM.UI.Entities.Model.StockOpening.StockOpeningItemDTO" Property="ItemName" Title="Item Name" />
                 <RadzenDataGridColumn TItem="JM.UI.Entities.Model.StockOpening.StockOpeningItemDTO" Title="Color" Width="150px">
                    <Template Context="item">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            @if(!string.IsNullOrEmpty(item.HexCode))
                            {
                                <div style="width: 20px; height: 20px; border-radius: 4px; border: 1px solid #ccc; background-color: @item.HexCode"></div>
                            }
                            <span>@item.ColorName</span>
                        </div>
                    </Template>
                 </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="JM.UI.Entities.Model.StockOpening.StockOpeningItemDTO" Property="SizeName" Title="Size" Width="100px" />
                <RadzenDataGridColumn TItem="JM.UI.Entities.Model.StockOpening.StockOpeningItemDTO" Property="Quantity" Title="Qty" Width="90px">
                     <Template Context="item">
                        @item.Quantity.ToString("N2")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="JM.UI.Entities.Model.StockOpening.StockOpeningItemDTO" Property="TradePrice" Title="Trade Price" Width="100px" />
                <RadzenDataGridColumn TItem="JM.UI.Entities.Model.StockOpening.StockOpeningItemDTO" Property="TotalAmount" Title="Total" Width="100px">
                     <Template Context="item">
                        @item.TotalAmount.ToString("N2")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="JM.UI.Entities.Model.StockOpening.StockOpeningItemDTO" Width="70px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(args => DeleteItem(item))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

