@page "/CustomerDetailsAdd"
@page "/CustomerDetailsAdd/{Id:int}"
@using JM.UI.Entities.Model.CustomerDetails
@using JM.UI.Entities.Model.MembershipType
@attribute [Authorize]
@inherits CustomerDetailsAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading customer...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Step 1: Quick Lookup (hidden in edit mode) -->
        @if (!IsEditMode && !ShowForm)
        {
            <RadzenCard class="mb-4">
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.H5">Step 1: Enter Mobile Number</RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <RadzenTextBox @bind-Value="LookupMobileInput" Placeholder="01XXXXXXXXX" Style="width:100%" />
                        <RadzenButton Icon="search" Text="Search" Click="@RunLookup" ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>

            @if (LookupDone)
            {
                <RadzenCard class="mb-4">
                    @if (FoundCustomers.Count == 0)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat">
                            No registered profile found for @LookupMobile.
                        </RadzenAlert>
                        <RadzenButton Text="Register New Customer" Icon="person_add" ButtonStyle="ButtonStyle.Success" Click="@OpenNewForm" class="mt-2" />
                    }
                    else
                    {
                        <RadzenText TextStyle="TextStyle.Subtitle1">@FoundCustomers.Count profile(s) found for this mobile number.</RadzenText>
                        <RadzenButton Text="Create New Profile (Same Mobile)" Icon="add" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Click="@OpenNewForm" class="mb-2" />
                        <RadzenDataGrid Data="@FoundCustomers" TItem="CustomerDetailsDTO" Density="Density.Compact" AllowPaging="false">
                            <Columns>
                                <RadzenDataGridColumn TItem="CustomerDetailsDTO" Title="Customer ID" Width="120px">
                                    <Template Context="c">@($"CUST-{c.Id}")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="CustomerDetailsDTO" Property="Name" Title="Name" />
                                <RadzenDataGridColumn TItem="CustomerDetailsDTO" Title="Company" Width="140px">
                                    <Template Context="c">
                                        @if (!string.IsNullOrWhiteSpace(c.CompanyCode))
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@c.CompanyCode" />
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="CustomerDetailsDTO" Title="Category" Width="140px">
                                    <Template Context="c">@(string.IsNullOrWhiteSpace(c.MembershipType) ? "N/A" : c.MembershipType)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="CustomerDetailsDTO" Title="Actions" Width="100px" TextAlign="TextAlign.Center">
                                    <Template Context="c">
                                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Variant="Variant.Flat" Click="@(() => OpenEditForm(c))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenCard>
            }
        }

        <!-- Step 2: Form -->
        @if (ShowForm)
        {
            <RadzenCard class="mb-4">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="mb-2">
                    <RadzenButton Icon="arrow_back" Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary" Click="@(() => { ShowForm = false; LookupDone = true; StateHasChanged(); })" />
                    <RadzenIcon Icon="@PageIcon" Style="font-size:2rem;color:var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                    @if (IsEditMode)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"#{Customer.Id}")" />
                    }
                </RadzenStack>
            </RadzenCard>

            <RadzenCard>
                <RadzenTemplateForm TItem="CustomerDetailsDTO" Data="@Customer" Submit="@Save">
                    <RadzenStack Gap="1.5rem">
                        <!-- Mode banner -->
                        <RadzenAlert AlertStyle="@(IsEditMode ? AlertStyle.Warning : AlertStyle.Success)" ShowIcon="false" Variant="Variant.Flat">
                            @(IsEditMode ? $"Editing existing profile: #{Customer.Id} - {Customer.Name}" : "Registering a new customer")
                        </RadzenAlert>

                        <!-- Primary Details -->
                        <RadzenFieldset Text="Primary Details" Icon="person">
                            <RadzenStack Gap="1rem">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Customer ID" />
                                            <RadzenTextBox Value="@(IsEditMode ? $"CUST-{Customer.Id}" : "Auto-generated")" ReadOnly="true" Style="width:100%;background:#f3f4f6;" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Mobile Number *" />
                                            <RadzenTextBox @bind-Value="Customer.Phone" Name="Phone" Style="width:100%" MaxLength="20" />
                                            <RadzenRequiredValidator Component="Phone" Text="Phone number is required" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Full Name *" />
                                            <RadzenTextBox @bind-Value="Customer.Name" Name="Name" Style="width:100%" MaxLength="100" />
                                            <RadzenRequiredValidator Component="Name" Text="Full name is required" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenFieldset>

                        <!-- CRM & Marketing -->
                        <RadzenFieldset Text="CRM & Marketing Profile" Icon="campaign">
                            <RadzenStack Gap="1rem">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                                <RadzenLabel Text="WhatsApp Number" />
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                                    <RadzenCheckBox @bind-Value="SameAsMobile" TValue="bool" />
                                                    <RadzenText TextStyle="TextStyle.Caption">Same as Mobile</RadzenText>
                                                </RadzenStack>
                                            </RadzenStack>
                                            <RadzenTextBox @bind-Value="Customer.WhatsApp" Style="width:100%" MaxLength="20" Disabled="@SameAsMobile" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Email" />
                                            <RadzenTextBox @bind-Value="Customer.Email" Name="Email" Style="width:100%" MaxLength="100" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Date of Birth" />
                                            <RadzenDatePicker @bind-Value="Customer.DateOfBirth" DateFormat="dd/MM/yyyy" Style="width:100%" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Anniversary" />
                                            <RadzenDatePicker @bind-Value="Customer.Anniversary" DateFormat="dd/MM/yyyy" Style="width:100%" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenFieldset>

                        <!-- Company Information -->
                        <RadzenFieldset Text="Company Information (all optional)" Icon="business">
                            <RadzenStack Gap="1rem">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Company Name" />
                                            <RadzenTextBox @bind-Value="CompanyText" Style="width:100%" @oninput="@(async (e) => await OnCompanyInput(e.Value?.ToString()))" />
                                            @if (CompanyResults.Any())
                                            {
                                                <div style="border:1px solid #e5e7eb;border-radius:6px;max-height:200px;overflow:auto;background:#fff;">
                                                    @foreach (var c in CompanyResults)
                                                    {
                                                        <div style="padding:8px;cursor:pointer;border-bottom:1px solid #f1f5f9;" @onclick="@(() => SelectCompany(c))">
                                                            <RadzenText TextStyle="TextStyle.Body2" Style="font-weight:600;">@c.Name <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@c.Code" /></RadzenText>
                                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@(c.Address ?? "")</RadzenText>
                                                        </div>
                                                    }
                                                    <div style="padding:8px;cursor:pointer;background:#f0fdf4;color:#166534;font-weight:600;" @onclick="@RegisterCompany">
                                                        + Register "@CompanyText" as a new company
                                                    </div>
                                                </div>
                                            }
                                            @if (Customer.CompanyId.HasValue)
                                            {
                                                <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="false" Variant="Variant.Flat" Size="AlertSize.Small">
                                                    Company code: <b>@Customer.CompanyCode</b> · @(Customer.CompanyName)
                                                </RadzenAlert>
                                            }
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Designation" />
                                            <RadzenTextBox @bind-Value="Customer.Designation" Style="width:100%" MaxLength="100" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Employee ID" />
                                            <RadzenTextBox @bind-Value="Customer.EmployeeId" Style="width:100%" MaxLength="50" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenFieldset>

                        <!-- Membership Category -->
                        <RadzenFieldset Text="Membership Category" Icon="card_membership">
                            <RadzenStack Gap="1rem">
                                <RadzenRow>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenLabel Text="Category (Discount %)" />
                                            <RadzenDropDown @bind-Value="Customer.MemberTypeId"
                                                            Data="@MembershipTypes"
                                                            TextProperty="Name"
                                                            ValueProperty="Id"
                                                            Style="width:100%"
                                                            AllowClear="true" />
                                            @if (Customer.DiscountRate.HasValue)
                                            {
                                                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">Discount: @Customer.DiscountRate%</RadzenText>
                                            }
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenFieldset>

                        <!-- Address Information -->
                        <RadzenFieldset Text="Address Information" Icon="location_on">
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary mb-2">Fill any or all. Select one as the default.</RadzenText>
                            <RadzenStack Gap="1rem">
                                @foreach (var addr in new[] { ("Home", Customer.AddressHome), ("Office", Customer.AddressOffice), ("Other", Customer.AddressOther) })
                                {
                                    <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenText TextStyle="TextStyle.Body2" Style="font-weight:600;">@addr.Item1 Address</RadzenText>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="8">
                                            @if (addr.Item1 == "Home")
                                            {
                                                <RadzenTextBox @bind-Value="Customer.AddressHome" Style="width:100%" />
                                            }
                                            else if (addr.Item1 == "Office")
                                            {
                                                <RadzenTextBox @bind-Value="Customer.AddressOffice" Style="width:100%" />
                                            }
                                            else
                                            {
                                                <RadzenTextBox @bind-Value="Customer.AddressOther" Style="width:100%" />
                                            }
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                                <input type="radio" name="default_address" value="@addr.Item1"
                                                       checked="@(Customer.DefaultAddressType == addr.Item1)"
                                                       @onchange="@(() => Customer.DefaultAddressType = addr.Item1)" />
                                                <RadzenText TextStyle="TextStyle.Caption">Default</RadzenText>
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>
                                }
                            </RadzenStack>
                        </RadzenFieldset>

                        <!-- Admin Remarks (admin only) -->
                        @if (IsAdmin)
                        {
                            <RadzenFieldset Text="Admin Remarks (Private)" Icon="lock">
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary mb-2">Visible to admins only.</RadzenText>
                                <RadzenStack Gap="0.5rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Start">
                                        <RadzenTextArea @bind-Value="RemarkInput" Rows="2" Style="width:100%" Placeholder="Write a remark about this customer..." />
                                        <RadzenButton Text="Add Remark" Icon="add" ButtonStyle="ButtonStyle.Dark" Click="@AddRemark" />
                                    </RadzenStack>
                                    @if (PendingRemarks.Any())
                                    {
                                        <RadzenStack Gap="0.25rem">
                                            @foreach (var r in PendingRemarks)
                                            {
                                                <RadzenCard Variant="Variant.Outlined" class="p-2">
                                                    <RadzenText TextStyle="TextStyle.Body2">@r.Text</RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@r.By · @r.At.ToString("dd/MM/yyyy HH:mm") · not saved yet</RadzenText>
                                                </RadzenCard>
                                            }
                                        </RadzenStack>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Customer.Remarks))
                                    {
                                        <RadzenCard Variant="Variant.Flat" class="p-2" Style="background:#f8fafc;">
                                            <RadzenText TextStyle="TextStyle.Body2" Style="white-space:pre-line;">@Customer.Remarks</RadzenText>
                                        </RadzenCard>
                                    }
                                </RadzenStack>
                            </RadzenFieldset>
                        }

                        <!-- Actions -->
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                            <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Click="@Cancel" Disabled="@IsProcessing" />
                            @if (!IsEditMode)
                            {
                                <RadzenButton Text="Save & Add New" Icon="add" ButtonStyle="ButtonStyle.Secondary" Click="@SaveAndNew" IsBusy="@IsProcessing" Disabled="@IsProcessing" />
                            }
                            <RadzenButton Text="@(IsEditMode ? "Update" : "Save & Generate ID")" Icon="@(IsEditMode ? "update" : "save")"
                                          ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" IsBusy="@IsProcessing" BusyText="@(IsEditMode ? "Updating..." : "Saving...")" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenTemplateForm>
            </RadzenCard>
        }
    }
</RadzenContent>
