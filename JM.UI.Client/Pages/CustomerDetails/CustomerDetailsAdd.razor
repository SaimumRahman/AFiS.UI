@page "/CustomerDetailsAdd"
@page "/CustomerDetailsAdd/{Id:int}"
@using JM.UI.Entities.Model.CustomerDetails
@attribute [Authorize]
@inherits CustomerDetailsAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading customer...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header Card -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@Cancel"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="@PageIcon" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                        @if (IsEditMode)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"#{Customer.Id}")" />
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="@(IsEditMode ? "Reset Changes" : "Reset")"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Form Card -->
        <RadzenCard>
            <RadzenTemplateForm TItem="CustomerDetailsDTO" Data="@Customer" Submit="@Save">
                <RadzenStack Gap="1.5rem">
                    <!-- Customer Information Section -->
                    <RadzenFieldset Text="Customer Information" Icon="person">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Name *" Component="Name" />
                                        <RadzenTextBox @bind-Value="Customer.Name"
                                                       Name="Name"
                                                       Placeholder="Enter customer name"
                                                       Style="width: 100%;"
                                                       MaxLength="100" />
                                        <RadzenRequiredValidator Component="Name" Text="Customer name is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Email" Component="Email" />
                                        <RadzenTextBox @bind-Value="Customer.Email"
                                                       Name="Email"
                                                       Placeholder="Enter email address"
                                                       Style="width: 100%;"
                                                       MaxLength="100" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Phone *" Component="Phone" />
                                        <RadzenTextBox @bind-Value="Customer.Phone"
                                                       Name="Phone"
                                                       Placeholder="Enter phone number"
                                                       Style="width: 100%;"
                                                       MaxLength="20" />
                                        <RadzenRequiredValidator Component="Phone" Text="Phone number is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Member Type ID" Component="MemberTypeId" />
                                        <RadzenDropDown @bind-Value="Customer.MemberTypeId"
                                                        Data="@MembershipTypes"
                                                        TextProperty="Name"
                                                        ValueProperty="Id"
                                                        Name="Id"
                                                        Placeholder="Select Membership Type"
                                                        Style="width: 100%;"
                                                        AllowClear="true"
                                                        AllowFiltering="true"/>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow>
                                <RadzenColumn Size="12">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Address" Component="Address" />
                                        <RadzenTextArea @bind-Value="Customer.Address"
                                                        Name="Address"
                                                        Placeholder="Enter address"
                                                        Rows="3"
                                                        MaxLength="200"
                                                        Style="width: 100%;" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Action Buttons -->
                    <RadzenCard class="mt-2">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat"
                                          Click="@Cancel"
                                          Disabled="@IsProcessing" />
                            @if (!IsEditMode)
                            {
                                <RadzenButton Text="Save & Add New"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Click="@SaveAndNew"
                                              IsBusy="@IsProcessing"
                                              Disabled="@IsProcessing" />
                            }
                            <RadzenButton Text="@(IsEditMode ? "Update" : "Save")"
                                          Icon="@(IsEditMode ? "update" : "save")"
                                          ButtonStyle="ButtonStyle.Primary"
                                          ButtonType="ButtonType.Submit"
                                          IsBusy="@IsProcessing"
                                          BusyText="@(IsEditMode ? "Updating..." : "Saving...")" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenContent>
