@page "/SmsSettings"
@using JM.UI.Entities.Model.Sms
@using JM.UI.Client.Pages.Dialog.Shared
@attribute [Authorize]
@inherits SmsSettingsComponent

<PageTitle>SMS Settings</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="sms" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">SMS Settings</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenBadge Text="@(Settings.IsActive ? "Active" : "Inactive")"
                                 BadgeStyle="@(Settings.IsActive ? BadgeStyle.Success : BadgeStyle.Light)" />
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelAsync" Disabled="@IsLoading" />
                    <RadzenButton Text="Save Settings" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@SaveAsync" IsBusy="@IsSaving" Disabled="@IsLoading" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @if (IsLoading)
    {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <!-- API Configuration -->
        <RadzenCard class="mb-4">
            <RadzenText TextStyle="TextStyle.H6" class="mb-3">API Configuration</RadzenText>
            <RadzenRow Gap="0.75rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="UserName" Variant="Variant.Outlined" Style="width:100%;">
                        <RadzenTextBox @bind-Value="Settings.UserName" Style="width:100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Password" Variant="Variant.Outlined" Style="width:100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Style="width:100%;">
                            @if (ShowPassword)
                            {
                                <RadzenTextBox @bind-Value="Settings.Password" Style="width:100%;" />
                            }
                            else
                            {
                                <RadzenPassword @bind-Value="Settings.Password" Style="width:100%;" />
                            }
                            <RadzenButton Icon="@(ShowPassword ? "visibility_off" : "visibility")" Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Light" Click="@(() => ShowPassword = !ShowPassword)" />
                        </RadzenStack>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="SID" Variant="Variant.Outlined" Style="width:100%;">
                        <RadzenTextBox @bind-Value="Settings.Sid" Placeholder="e.g. ASIAFASHION" Style="width:100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="SMS API Token" Variant="Variant.Outlined" Style="width:100%;">
                        <RadzenTextBox @bind-Value="Settings.ApiToken" Style="width:100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12">
                    <RadzenFormField Text="API Link" Variant="Variant.Outlined" Style="width:100%;">
                        <RadzenTextBox @bind-Value="Settings.ApiLink" Placeholder="https://api.sms-provider.com/v1/send" Style="width:100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenCheckBox @bind-Value="Settings.IsActive" />
                        <RadzenLabel Text="Active" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            <!-- Test API Connection -->
            <RadzenCard class="mt-3" Style="background: var(--rz-base-100);">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="mb-2">Test API Connection</RadzenText>
                <RadzenRow Gap="0.5rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Mobile Number" Variant="Variant.Outlined" Style="width:100%;">
                            <RadzenTextBox @bind-Value="TestMobile" Placeholder="Enter Mobile Number" Style="width:100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenFormField Text="Test Message" Variant="Variant.Outlined" Style="width:100%;">
                            <RadzenTextArea @bind-Value="TestMessage" Rows="2" Placeholder="Type your test SMS here..." Style="width:100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="mt-2">
                    <RadzenButton Text="Send Test SMS" Icon="send" ButtonStyle="ButtonStyle.Secondary" Click="@SendTestAsync" />
                    @if (!string.IsNullOrEmpty(TestResult))
                    {
                        <RadzenBadge Text="@TestResult" BadgeStyle="@(TestSuccess ? BadgeStyle.Success : BadgeStyle.Danger)" />
                    }
                </RadzenStack>
            </RadzenCard>
        </RadzenCard>

        <!-- SMS Templates -->
        <RadzenText TextStyle="TextStyle.H5" class="mb-2">SMS Templates</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="mb-3">System will automatically trigger the corresponding template based on the transaction type.</RadzenText>

        @foreach (var tmpl in Settings.Templates)
        {
            <RadzenCard class="mb-3">
                <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="mb-2">
                    <RadzenColumn>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenCheckBox @bind-Value="tmpl.IsEnabled" />
                            <RadzenText TextStyle="TextStyle.Subtitle1">@($"Enable {tmpl.TemplateName}")</RadzenText>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                            <RadzenLink Text="Load Default Template" Click="@(() => LoadDefault(tmpl))" Style="font-size:0.75rem;" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenText TextStyle="TextStyle.Caption" class="mb-1">Available Tags:</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.25rem" class="mb-2">
                    @foreach (var tag in tmpl.TagList)
                    {
                        <RadzenButton Text="@tag" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => InsertTag(tmpl, tag))" />
                    }
                </RadzenStack>

                <RadzenTextArea @bind-Value="tmpl.TemplateText" Rows="5" Style="width:100%;" />

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem" class="mt-1">
                    <RadzenText TextStyle="TextStyle.Caption">
                        Characters: <b>@CharCount(tmpl)/160</b>
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption">
                        Est. SMS per trigger: <b>@Segments(tmpl)</b>
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        }

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="pt-3">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelAsync" />
            <RadzenButton Text="Save Settings" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@SaveAsync" IsBusy="@IsSaving" />
        </RadzenStack>
    }
</RadzenContent>
