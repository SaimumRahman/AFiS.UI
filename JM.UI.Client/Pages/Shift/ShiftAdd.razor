@page "/ShiftAdd"
@page "/ShiftAdd/{Id:int}"
@using JM.UI.Entities.Model.Shift
@attribute [Authorize]
@inherits ShiftAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading Shift...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <!-- Header Card -->
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@Cancel"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="@PageIcon" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                        @if (IsEditMode)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"#{Shift.Id}")" />
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="@(IsEditMode ? "Reset Changes" : "Reset")"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <!-- Form Card -->
        <RadzenCard>
            <RadzenTemplateForm TItem="ShiftDTO" Data="@Shift" Submit="@Save">
                <RadzenStack Gap="1.5rem">
                    <!-- Main Shift Information -->
                    <RadzenFieldset Text="Shift Information" Icon="schedule">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Shift Name" Component="Name" />
                                        <RadzenTextBox @bind-Value="@Shift.Name"
                                                       Name="Name"
                                                       Placeholder="e.g. Morning Shift"
                                                       Style="width: 100%;"
                                                       MaxLength="100" />
                                    </RadzenStack>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Shift Code" Component="ShiftCode" />
                                        <RadzenTextBox @bind-Value="@Shift.ShiftCode"
                                                       Name="ShiftCode"
                                                       Placeholder="e.g. MORN-01"
                                                       Style="width: 100%;"
                                                       MaxLength="50" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem">
                                <!-- DutyType – required (int) -->
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Duty Type *" Component="DutyType" />
                                        <RadzenNumeric @bind-Value="@Shift.DutyType"
                                                       Name="DutyType"
                                                       Min="1"
                                                       Style="width: 100%;" />
                                        <RadzenRequiredValidator Component="DutyType" Text="Duty Type is required" />
                                    </RadzenStack>
                                </RadzenColumn>

                                <!-- Start Time – required -->
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Start Time *" Component="Start" />
                                        <RadzenDatePicker @bind-Value="@Shift.Start"
                                                          Name="Start"
                                                          DateFormat="HH:mm"
                                                          ShowTime="true"
                                                          ShowDate="false"
                                                          Style="width:100%;" />
                                        <RadzenRequiredValidator Component="Start" Text="Start time is required" />
                                    </RadzenStack>
                                </RadzenColumn>

                                <!-- End Time – required -->
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="End Time *" Component="End" />
                                        <RadzenDatePicker @bind-Value="@Shift.End"
                                                          Name="End"
                                                          DateFormat="HH:mm"
                                                          ShowTime="true"
                                                          ShowDate="false"
                                                          Style="width:100%;" />
                                        <RadzenRequiredValidator Component="End" Text="End time is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem">
                                <!-- CheckStart – required -->
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Check-In Start *" Component="CheckStart" />
                                        <RadzenDatePicker @bind-Value="@Shift.CheckStart"
                                                          Name="CheckStart"
                                                          DateFormat="HH:mm"
                                                          ShowTime="true"
                                                          ShowDate="false"
                                                          Style="width:100%;" />
                                        <RadzenRequiredValidator Component="CheckStart" Text="Check-in start time is required" />
                                    </RadzenStack>
                                </RadzenColumn>

                                <!-- CheckEnd – required -->
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Check-In End *" Component="CheckEnd" />
                                        <RadzenDatePicker @bind-Value="@Shift.CheckEnd"
                                                          Name="CheckEnd"
                                                          DateFormat="HH:mm"
                                                          ShowTime="true"
                                                          ShowDate="false"
                                                          Style="width:100%;" />
                                        <RadzenRequiredValidator Component="CheckEnd" Text="Check-in end time is required" />
                                    </RadzenStack>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Late Count From (min)" Component="LateCountFrom" />
                                        <RadzenNumeric @bind-Value="@Shift.LateCountFrom"
                                                       Name="LateCountFrom"
                                                       Min="0"
                                                       Style="width: 100%;" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <!-- Attendance Finish Window – both required -->
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Check-Out Start *" Component="CheckStartFinish" />
                                        <RadzenDatePicker @bind-Value="@Shift.CheckStartFinish"
                                                          Name="CheckStartFinish"
                                                          DateFormat="HH:mm"
                                                          ShowTime="true"
                                                          ShowDate="false"
                                                          Style="width:100%;" />
                                        <RadzenRequiredValidator Component="CheckStartFinish" Text="Check-out start is required" />
                                    </RadzenStack>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Check-Out End *" Component="CheckEndFinish" />
                                        <RadzenDatePicker @bind-Value="@Shift.CheckEndFinish"
                                                          Name="CheckEndFinish"
                                                          DateFormat="HH:mm"
                                                          ShowTime="true"
                                                          ShowDate="false"
                                                          Style="width:100%;" />
                                        <RadzenRequiredValidator Component="CheckEndFinish" Text="Check-out end is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <!-- Late & Overtime Rules – all required -->
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Late Deduction Hour *" Component="LateDeductionHour" />
                                        <RadzenNumeric @bind-Value="@Shift.LateDeductionHour"
                                                       Name="LateDeductionHour"
                                                       Min="0"
                                                       Step="0.5"
                                                       Style="width: 100%;" />
                                        <RadzenRequiredValidator Component="LateDeductionHour" Text="Late deduction hour is required" />
                                    </RadzenStack>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Late Deduction Days *" Component="LateDeductionDays" />
                                        <RadzenNumeric @bind-Value="@Shift.LateDeductionDays"
                                                       Name="LateDeductionDays"
                                                       Min="0"
                                                       Style="width: 100%;" />
                                        <RadzenRequiredValidator Component="LateDeductionDays" Text="Late deduction days is required" />
                                    </RadzenStack>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Overtime Salary %" Component="OvertimeSalaryPercentage" />
                                        <RadzenNumeric @bind-Value="@Shift.OvertimeSalaryPercentage"
                                                       Name="OvertimeSalaryPercentage"
                                                       Min="0"
                                                       Max="500"
                                                       Step="0.5"
                                                       Style="width: 100%;" />
                                        <RadzenRequiredValidator Component="OvertimeSalaryPercentage" Text="Overtime percentage is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <!-- StoreId – required -->
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Store ID *" Component="StoreId" />
                                        <RadzenNumeric @bind-Value="@Shift.StoreId"
                                                       Name="StoreId"
                                                       Min="1"
                                                       Style="width: 100%;" />
                                        <RadzenRequiredValidator Component="StoreId" Text="Store ID is required" />
                                    </RadzenStack>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Total Hours" />
                                        <RadzenNumeric @bind-Value="@Shift.TotalHours"
                                                       Disabled="false"
                                                       Style="width: 100%;" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Audit Information (read-only) -->
                    @if (IsEditMode)
                    {
                        <RadzenFieldset Text="Audit Information" Icon="info">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn SizeMD="3">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Created On" />
                                        <RadzenTextBox Value="@Shift.CreatedOn?.ToString("dd MMM yyyy HH:mm")" Disabled="true" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn SizeMD="3">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Created By" />
                                        <RadzenTextBox Value="@Shift.CreatedBy" Disabled="true" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn SizeMD="3">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Modified On" />
                                        <RadzenTextBox Value="@(Shift.ModifiedOn?.ToString("dd MMM yyyy HH:mm") ?? "N/A")" Disabled="true" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn SizeMD="3">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Modified By" />
                                        <RadzenTextBox Value="@(Shift.ModifiedBy ?? "N/A")" Disabled="true" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenFieldset>
                    }

                    <!-- Action Buttons -->
                    <RadzenCard class="mt-2">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat"
                                          Click="@Cancel"
                                          Disabled="@IsProcessing" />
                            @if (!IsEditMode)
                            {
                                <RadzenButton Text="Save & Add New"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Click="@SaveAndNew"
                                              IsBusy="@IsProcessing"
                                              Disabled="@IsProcessing" />
                            }
                            <RadzenButton Text="@(IsEditMode ? "Update" : "Save")"
                                          Icon="@(IsEditMode ? "update" : "save")"
                                          ButtonStyle="ButtonStyle.Primary"
                                          ButtonType="ButtonType.Submit"
                                          IsBusy="@IsProcessing"
                                          BusyText="@(IsEditMode ? "Updating..." : "Saving...")" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenContent>