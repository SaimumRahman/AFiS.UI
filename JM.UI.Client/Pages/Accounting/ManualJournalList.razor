@page "/ManualJournalList"
@using JM.UI.Entities.Model.Accounting_D
@attribute [Authorize]
@inherits ManualJournalListComponent

<PageTitle>Manual Journal</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-3">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="menu_book" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <div>
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">Manual Journal</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color:#64748b;">
                            Double-entry vouchers (JRN) entered by hand
                        </RadzenText>
                    </div>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Icon="refresh" Text="Refresh" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => Grid!.Reload())" Disabled="@IsLoading" />
                    <RadzenButton Icon="add" Text="New Journal" ButtonStyle="ButtonStyle.Primary"
                                  Click="NewJournal" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenCard class="mb-3">
        <RadzenRow Gap="0.75rem" AlignItems="AlignItems.End">
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel Text="From" />
                <RadzenDatePicker TValue="DateTime" @bind-Value="FromDate" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel Text="To" />
                <RadzenDatePicker TValue="DateTime" @bind-Value="ToDate" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel Text="Branch" />
                <RadzenDropDown TValue="string" Data="@Branches" ValueProperty="Code" TextProperty="Display"
                                @bind-Value="BranchFilter" AllowClear="true" Placeholder="All branches"
                                Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel Text="Status" />
                <RadzenDropDown TValue="string" Data="@StatusOptions" @bind-Value="StatusFilter"
                                AllowClear="true" Placeholder="All" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenLabel Text="Search" />
                <RadzenTextBox @bind-Value="SearchText" Placeholder="Narration, reference or voucher no."
                               Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="1">
                <RadzenButton Icon="search" Text="Search" ButtonStyle="ButtonStyle.Primary"
                              Click="@(() => Grid!.Reload())" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenCard>
        <RadzenDataGrid @ref="Grid"
                        TItem="ManualJournalSummaryDTO"
                        Data="@Items"
                        Count="@TotalCount"
                        LoadData="@LoadData"
                        IsLoading="@IsLoading"
                        AllowPaging="true"
                        AllowSorting="false"
                        AllowFiltering="false"
                        AllowAlternatingRows="true"
                        PagerHorizontalAlign="HorizontalAlign.Center"
                        PageSize="20"
                        PageSizeOptions="@(new int[] { 10, 20, 50, 100 })"
                        ShowPagingSummary="true"
                        PagingSummaryFormat="Page {0} of {1} ({2} journals)"
                        GridLines="DataGridGridLines.Both"
                        Density="Density.Compact">

            <Columns>
                <RadzenDataGridColumn TItem="ManualJournalSummaryDTO" Property="VoucherNo" Title="Voucher" Width="110px">
                    <Template Context="item">
                        @if (item.VoucherNo.HasValue)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="@item.VoucherDisplay" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="DRAFT" />
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ManualJournalSummaryDTO" Property="EntryDate" Title="Date" Width="110px">
                    <Template Context="item">@item.EntryDate.ToString("dd-MMM-yyyy")</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ManualJournalSummaryDTO" Property="BranchCode" Title="Branch" Width="90px" />

                <RadzenDataGridColumn TItem="ManualJournalSummaryDTO" Property="Narration" Title="Narration">
                    <Template Context="item">
                        <div style="white-space:normal;">@item.Narration</div>
                        @if (!string.IsNullOrWhiteSpace(item.ReferenceNo))
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color:#64748b;">
                                Ref: @item.ReferenceNo
                            </RadzenText>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ManualJournalSummaryDTO" Property="TotalDebit" Title="Debit" Width="120px"
                                      TextAlign="TextAlign.Right">
                    <Template Context="item">@item.TotalDebit.ToString("N2")</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ManualJournalSummaryDTO" Property="TotalCredit" Title="Credit" Width="120px"
                                      TextAlign="TextAlign.Right">
                    <Template Context="item">@item.TotalCredit.ToString("N2")</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ManualJournalSummaryDTO" Property="Status" Title="Status" Width="120px"
                                      TextAlign="TextAlign.Center">
                    <Template Context="item">
                        <RadzenBadge BadgeStyle="@StatusBadge(item.Status)" Text="@item.Status" />
                        @if (item.ReversedByVoucherNo.HasValue)
                        {
                            <div>
                                <RadzenText TextStyle="TextStyle.Caption" Style="color:#64748b;">
                                    by JRN-@item.ReversedByVoucherNo
                                </RadzenText>
                            </div>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ManualJournalSummaryDTO" Title="Actions" Width="200px"
                                      TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem"
                                     JustifyContent="JustifyContent.Center">
                            @if (item.Status == "DRAFT")
                            {
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              Click="@(() => Open(item))" title="Edit draft" />
                                <RadzenButton Icon="task_alt" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                              Click="@(() => PostJournal(item))" title="Post" />
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              Click="@(() => DeleteDraft(item))" title="Delete draft" />
                            }
                            else
                            {
                                <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              Click="@(() => Open(item))" title="View" />
                                @if (item.Status == "POSTED")
                                {
                                    <RadzenButton Icon="undo" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                                  Click="@(() => ReverseJournal(item))" title="Reverse" />
                                }
                            }
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenContent>
