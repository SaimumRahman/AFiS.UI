@page "/OpeningBalance"
@using JM.UI.Entities.Model.Accounting_D
@attribute [Authorize]
@inherits OpeningBalanceComponent

<PageTitle>Opening Balance</PageTitle>

<style>
    .ob-wrap { max-width: 1200px; }
    .ob-grid { width: 100%; border-collapse: collapse; }
    .ob-grid th {
        text-align: left; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.05em; color: #64748b; padding: 0.5rem 0.6rem;
        border-bottom: 1px solid #e2e8f0; background: #f8fafc;
    }
    .ob-grid td { padding: 0.35rem 0.6rem; border-bottom: 1px solid #f1f5f9; vertical-align: top; }
    .ob-grid tr:hover td { background: #f8fafc; }
    .ob-total {
        display: flex; gap: 2rem; justify-content: flex-end; align-items: center;
        padding: 0.6rem 0.6rem; border-top: 2px solid #e2e8f0; font-weight: 700; color: #1e293b;
    }
    .ob-total span.lbl { color: #64748b; font-weight: 600; font-size: 0.8rem; }
    .ob-badge {
        display: inline-block; padding: 2px 10px; border-radius: 999px;
        font-size: 0.7rem; font-weight: 700; letter-spacing: 0.02em;
    }
    .rz-dropdown-tree-popup {
        display: none;
        position: absolute;
        overflow: hidden;
        width: 380px;
        border: var(--rz-panel-border);
        background-color: var(--rz-panel-background-color);
        box-shadow: var(--rz-panel-shadow);
        border-radius: var(--rz-border-radius);
        z-index: 1000;
    }
</style>

<RadzenContent Container="main" class="p-4">
    <RadzenCard>
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="mb-3">
            <RadzenColumn Size="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="account_balance_wallet" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Opening Balance</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                    @if (ExistingEntryId > 0)
                    {
                        <span class="ob-badge" style="background:#dcfce7;color:#15803d; align-self:center;">
                            Posted &middot; entry @ExistingEntryId
                        </span>
                    }
                    <RadzenButton Icon="refresh" Text="Refresh" ButtonStyle="ButtonStyle.Secondary"
                                  Click="@(() => LoadOpeningBalance())" Disabled="@IsLoading" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        @if (IsLoading)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        }
        else
        {
            <div class="ob-wrap">
                <RadzenRow Gap="0.75rem">
                    <RadzenColumn Size="4">
                        <RadzenLabel Text="Branch *" Component="Branch" />
                        <RadzenDropDown TValue="string" Name="Branch" Data="@Branches"
                                        ValueProperty="Code" TextProperty="Display"
                                        @bind-Value="SelectedBranchCode"
                                        Change="@(args => OnHeaderChanged())"
                                        Disabled="@IsLocked" Style="width:100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenLabel Text="Fiscal Year *" Component="FiscalYear" />
                        <RadzenDropDown TValue="short" Name="FiscalYear" Data="@FiscalYears"
                                        ValueProperty="FiscalYearId" TextProperty="Display"
                                        @bind-Value="SelectedFiscalYearId"
                                        Change="@(args => OnHeaderChanged())"
                                        Disabled="@IsLocked" Style="width:100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenLabel Text="Entry Date" Component="EntryDate" />
                        <RadzenDatePicker TValue="DateTime" Name="EntryDate" @bind-Value="EntryDate"
                                          Disabled="true" Style="width:100%;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.75rem" class="mt-2">
                    <RadzenColumn Size="12">
                        <RadzenLabel Text="Narration" Component="Narration" />
                        <RadzenTextBox Name="Narration" @bind-Value="Narration" Disabled="@IsLocked" Style="width:100%;" />
                    </RadzenColumn>
                </RadzenRow>

                @if (IsLocked)
                {
                    <RadzenAlert class="mt-3" AllowClose="false" Variant="Variant.Flat"
                                 Severity="AlertSeverity.Warning" Shade="Shade.Lighter">
                        <RadzenIcon Icon="lock" Style="vertical-align:middle; margin-right:0.35rem;" />
                        @LockReason
                    </RadzenAlert>
                }

                <div class="mt-3" style="overflow-x:auto;">
                    <table class="ob-grid">
                        <thead>
                            <tr>
                                <th style="width:34%;">Ledger</th>
                                <th style="width:20%;">Party</th>
                                <th style="width:14%; text-align:right;">Debit</th>
                                <th style="width:14%; text-align:right;">Credit</th>
                                <th style="width:14%;">Memo</th>
                                <th style="width:4%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Rows)
                            {
                                <tr>
                                    <td>
                                        <div @ref="row.Trigger" @onclick="() => OpenTree(row)"
                                             style="position:relative; cursor:pointer;">
                                            <RadzenTextBox ReadOnly="true" Value="@LedgerDisplay(row.AccountCode)"
                                                           Placeholder="Select account"
                                                           Disabled="@IsLocked" Style="width:100%; cursor:pointer; padding-right:1.5rem;" />
                                            <RadzenIcon Icon="arrow_drop_down"
                                                        Style="position:absolute; right:8px; top:50%; transform:translateY(-50%); pointer-events:none; color:#64748b;" />
                                        </div>
                                    </td>
                                    <td>
                                        @if (RowRequiresParty(row))
                                        {
                                            <RadzenDropDown TValue="int?" Data="@GetPartyOptions(row)"
                                                            ValueProperty="PartyId" TextProperty="Display"
                                                            @bind-Value="row.PartyId"
                                                            Disabled="@IsLocked" Placeholder="Select party"
                                                            Style="width:100%;" />
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">&mdash;</span>
                                        }
                                    </td>
                                    <td>
                                        <RadzenNumeric TValue="decimal?" @bind-Value="row.Debit"
                                                       Disabled="@IsLocked" Style="width:100%;" />
                                    </td>
                                    <td>
                                        <RadzenNumeric TValue="decimal?" @bind-Value="row.Credit"
                                                       Disabled="@IsLocked" Style="width:100%;" />
                                    </td>
                                    <td>
                                        <RadzenTextBox @bind-Value="row.Memo" Disabled="@IsLocked" Style="width:100%;" />
                                    </td>
                                    <td style="text-align:center;">
                                        @if (!IsLocked && Rows.Count > 1)
                                        {
                                            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.Small" Click="@(() => RemoveRow(row))" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!IsLocked)
                {
                    <div class="mt-2">
                        <RadzenButton Icon="add" Text="Add Line" ButtonStyle="ButtonStyle.Light" Click="AddRow" />
                    </div>
                }

                <div class="ob-total mt-3">
                    <span><span class="lbl">Total Debit:</span> @TotalDebit.ToString("N2")</span>
                    <span><span class="lbl">Total Credit:</span> @TotalCredit.ToString("N2")</span>
                    <span>
                        <span class="lbl">Contra 314001:</span>
                        @if (ContraAmount == 0)
                        {
                            <span>0.00</span>
                        }
                        else
                        {
                            <span>@(ContraIsDebit ? "Dr" : "Cr") @ContraAmount.ToString("N2")</span>
                        }
                    </span>
                </div>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                             JustifyContent="JustifyContent.End" class="mt-3">
                    <RadzenButton Text="Post Opening Balance" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                  Click="Save" IsBusy="@IsProcessing" Disabled="@IsLocked" />
                </RadzenStack>
            </div>
        }
    </RadzenCard>

    <RadzenPopup @ref="popup" Style="padding:0;" class="rz-dropdown-tree-popup"
                 CloseOnClickOutside="true" Close="OnTreeClose">
        <RadzenTree Style="width:100%; max-height:320px; overflow:auto;" Data="@AccountTree"
                    @bind-Value="@TreeSelection" Change="@OnTreeSelect">
            <RadzenTreeLevel Text="@(e => ((AccountTreeNode)e).Display)" ChildrenProperty="Children"
                             HasChildren="@(e => ((AccountTreeNode)e).Children.Any())" Expanded="@(e => true)" />
        </RadzenTree>
    </RadzenPopup>
</RadzenContent>
