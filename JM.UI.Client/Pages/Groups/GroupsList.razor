@page "/GroupsList"
@using JM.UI.Entities.Model.Groups
@attribute [Authorize]
@inherits GroupsListComponent

<PageTitle>Groups</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="group" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Groups Management</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Icon="add_circle_outline"
                                  Text="Add New Group"
                                  Click="@AddGroup"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Medium" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @if (IsLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <RadzenCard>
            <RadzenDataGrid @ref="GroupsGrid" 
                            Data="@GroupsList" 
                            TItem="GroupModelDTO" 
                            AllowFiltering="true" 
                            AllowColumnResize="true"
                            AllowAlternatingRows="true"
                            AllowPaging="true" 
                            AllowSorting="true"
                            PagerHorizontalAlign="HorizontalAlign.Center"
                            PageSize="10"
                            PageSizeOptions="@(new int[] { 5, 10, 20, 50 })"
                            FilterMode="FilterMode.Advanced"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="@("Displaying page {0} of {1} (total {2} records)")"
                            IsLoading="@IsLoading"
                            GridLines="DataGridGridLines.Both"
                            Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="GroupModelDTO" Visible="false" Property="Id" Title="ID" Width="80px" Frozen="true" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="GroupModelDTO" Property="Name" Title="Name" />
                    <RadzenDataGridColumn TItem="GroupModelDTO" Property="Code" Title="Group Code" />
                    <RadzenDataGridColumn TItem="GroupModelDTO" Property="VAT" Title="VAT"/>
                    
                    <RadzenDataGridColumn TItem="GroupModelDTO" Title="Actions" Width="120px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                        <Template Context="group">
                             <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                                <RadzenButton Icon="edit" 
                                              ButtonStyle="ButtonStyle.Info" 
                                              Size="ButtonSize.Small" 
                                              Variant="Variant.Flat"
                                              Click="@(args => EditGroup(group))" 
                                              MouseEnter="@(args => TooltipService.Open(args, "Edit Group"))" />
                                <RadzenButton Icon="delete" 
                                              ButtonStyle="ButtonStyle.Danger" 
                                              Size="ButtonSize.Small" 
                                              Variant="Variant.Flat"
                                              Click="@(args => DeleteGroup(group))" 
                                              MouseEnter="@(args => TooltipService.Open(args, "Delete Group"))" />
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
</RadzenContent>
