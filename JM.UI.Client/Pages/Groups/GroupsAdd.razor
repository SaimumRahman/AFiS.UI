@page "/GroupsAdd"
@page "/GroupsAdd/{Id:int}"
@using JM.UI.Entities.Model.Groups
@attribute [Authorize]
@inherits GroupsAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="group" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenTemplateForm TItem="GroupModelDTO" Data="@Group" Submit="@Save">
        @if (IsLoading)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        }
        else
        {
            <RadzenCard>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="Name" Component="Name" />
                            <RadzenTextBox Name="Name" @bind-Value="@Group.Name" class="w-100" />
                            <RadzenRequiredValidator Component="Name" Text="Name is required" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Gap="0.5rem">
                            <RadzenLabel Text="Group Code" Component="Code" />
                            <RadzenTextBox Name="Code" @bind-Value="@Group.Code" class="w-100" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem" class="mt-4">
                    <RadzenButton Text="Cancel" 
                                  ButtonStyle="ButtonStyle.Light" 
                                  Click="@Cancel" 
                                  Icon="cancel" 
                                  Disabled="@IsProcessing" />
                    <RadzenButton ButtonType="ButtonType.Submit" 
                                  Text="@(IsEditMode ? "Update" : "Save")" 
                                  ButtonStyle="ButtonStyle.Primary" 
                                  Icon="save" 
                                  IsBusy="@IsProcessing" />
                </RadzenRow>
            </RadzenCard>
        }
    </RadzenTemplateForm>
</RadzenContent>
