@page "/ItemsList"
@using JM.UI.Entities.Model.Items
@attribute [Authorize]
@inherits ItemsListComponent

<PageTitle>Items</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="inventory_2" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Items Management</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @if (IsLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <RadzenCard>
            <RadzenDataGrid @ref="ItemsGrid" 
                            Data="@ItemsList" 
                            TItem="ItemDTO" 
                            AllowFiltering="true" 
                            AllowColumnResize="true"
                            AllowAlternatingRows="true"
                            AllowPaging="true" 
                            AllowSorting="true"
                            PagerHorizontalAlign="HorizontalAlign.Center"
                            PageSize="10"
                            PageSizeOptions="@(new int[] { 5, 10, 20, 50 })"
                            FilterMode="FilterMode.Advanced"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="@("Displaying page {0} of {1} (total {2} records)")"
                            IsLoading="@IsLoading"
                            GridLines="DataGridGridLines.Both"
                            Density="Density.Compact"
                            Responsive="true">
                <Columns>
                    <RadzenDataGridColumn TItem="ItemDTO" Property="Id" Visible="false" Title="ID" Width="80px" Frozen="true" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="ItemDTO" Property="Name" Title="Name" Width="200px" />
                    <RadzenDataGridColumn TItem="ItemDTO" Property="SubGroupName" Title="SubGroup" Width="150px" />
                    <RadzenDataGridColumn TItem="ItemDTO" Property="MesurementUnitName" Title="Unit" Width="100px" />
                    <RadzenDataGridColumn TItem="ItemDTO" Property="SupplierName" Title="Supplier" Width="150px" />
                    <RadzenDataGridColumn TItem="ItemDTO" Property="BrandName" Title="Brand" Width="130px" />
                    <RadzenDataGridColumn TItem="ItemDTO" Property="OriginName" Title="Origin" Width="130px" />
                    <RadzenDataGridColumn TItem="ItemDTO" Property="Features" Title="Features" Width="160px" />
                    <RadzenDataGridColumn TItem="ItemDTO" Property="SalePrice" Title="Sale Price" Width="120px" FormatString="{0:N2}" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="ItemDTO" Property="WholeSalePrice" Title="W.Sale Price" Width="120px" FormatString="{0:N2}" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="ItemDTO" Property="AlarmLevel" Title="Alarm" Width="100px" FormatString="{0:N2}" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="ItemDTO" Property="Barcode" Title="Barcode" Width="150px" />
                    
                    <RadzenDataGridColumn TItem="ItemDTO" Title="Actions" Width="120px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                        <Template Context="item">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                                <RadzenButton Icon="edit" 
                                              ButtonStyle="ButtonStyle.Info" 
                                              Size="ButtonSize.Small" 
                                              Variant="Variant.Flat"
                                              Click="@(args => EditItem(item))" 
                                              MouseEnter="@(args => TooltipService.Open(args, "Edit Item"))" />
                                <RadzenButton Icon="delete" 
                                              ButtonStyle="ButtonStyle.Danger" 
                                              Size="ButtonSize.Small" 
                                              Variant="Variant.Flat"
                                              Click="@(args => DeleteItem(item))" 
                                              MouseEnter="@(args => TooltipService.Open(args, "Delete Item"))" />
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
</RadzenContent>
