@page "/CouponTypeList"
@using JM.UI.Entities.Model.Coupon
@inherits CouponTypeListComponent
@attribute [Authorize]
<PageTitle>Coupon Types</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="local_offer" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">Coupon Type Management</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Icon="add_circle_outline"
                                  Text="Add New Coupon Type"
                                  Click="@AddCouponType"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Medium" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenCard>
        <RadzenDataGrid @ref="CouponTypesGrid"
                        Data="@CouponTypes"
                        TItem="CouponTypeDTO"
                        AllowFiltering="true"
                        AllowColumnResize="true"
                        AllowAlternatingRows="true"
                        AllowPaging="true"
                        AllowSorting="true"
                        PagerHorizontalAlign="HorizontalAlign.Center"
                        PageSize="10"
                        PageSizeOptions="@(new int[] { 5, 10, 20, 50 })"
                        FilterMode="FilterMode.Advanced"
                        ShowPagingSummary="true"
                        PagingSummaryFormat="@("Displaying page {0} of {1} (total {2} records)")"
                        IsLoading="@IsLoading"
                        GridLines="DataGridGridLines.Both"
                        Density="Density.Compact">

            <Columns>
                <RadzenDataGridColumn TItem="CouponTypeDTO" Visible="false" Property="Id" Title="ID" Width="80px" Frozen="true" TextAlign="TextAlign.Center">
                    <Template Context="item">
                        <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@($"#{item.Id}")" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="CouponTypeDTO" Property="TypeName" Title="Type Name" Width="300px">
                    <Template Context="item">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="label" Style="color: var(--rz-primary);" />
                            <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 500;">
                                @item.TypeName
                            </RadzenText>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="CouponTypeDTO" Title="Actions" Width="140px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                    <Template Context="item">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                            <RadzenButton Icon="edit"
                                          ButtonStyle="ButtonStyle.Info"
                                          Size="ButtonSize.Small"
                                          Variant="Variant.Flat"
                                          Click="@(() => EditCouponType(item))"
                                          MouseEnter="@(args => ShowTooltip(args, "Edit Coupon Type"))" />

                            <RadzenButton Icon="delete"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Size="ButtonSize.Small"
                                          Variant="Variant.Flat"
                                          Click="@(() => DeleteCouponType(item))"
                                          MouseEnter="@(args => ShowTooltip(args, "Delete Coupon Type"))" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenContent>
