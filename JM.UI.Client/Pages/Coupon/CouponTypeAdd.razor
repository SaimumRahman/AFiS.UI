@page "/CouponTypeAdd"
@page "/CouponTypeAdd/{Id:int}"
@using JM.UI.Entities.Model.Coupon
@attribute [Authorize]
@inherits CouponTypeAddComponent

<PageTitle>@PageTitle</PageTitle>

<RadzenContent Container="main" class="p-4">
    @if (IsLoading)
    {
        <RadzenCard class="text-center p-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body1" class="mt-3">Loading coupon type...</RadzenText>
        </RadzenCard>
    }
    else
    {
        <RadzenCard class="mb-4">
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Icon="arrow_back"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@Cancel"
                                      Size="ButtonSize.Medium" />
                        <RadzenIcon Icon="local_offer" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H4" class="mb-0">@PageTitle</RadzenText>
                        @if (IsEditMode)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"#{CouponType.Id}")" />
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="@(IsEditMode ? "Reset Changes" : "Reset")"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Click="@Reset"
                                      Disabled="@IsProcessing" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <RadzenCard>
            <RadzenTemplateForm TItem="CouponTypeDTO" Data="@CouponType" Submit="@Save">
                <RadzenStack Gap="1.5rem">
                    <RadzenFieldset Text="Coupon Type Information" Icon="local_offer">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenLabel Text="Type Name *" Component="TypeName" />
                                        <RadzenTextBox @bind-Value="CouponType.TypeName"
                                                       Name="TypeName"
                                                       Placeholder="Enter coupon type name"
                                                       Style="width: 100%;"
                                                       MaxLength="100" />
                                        <RadzenRequiredValidator Component="TypeName" Text="Coupon type name is required" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <RadzenCard class="mt-2">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Flat"
                                          Click="@Cancel"
                                          Disabled="@IsProcessing" />
                            @if (!IsEditMode)
                            {
                                <RadzenButton Text="Save & Add New"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Click="@SaveAndNew"
                                              IsBusy="@IsProcessing"
                                              Disabled="@IsProcessing" />
                            }
                            <RadzenButton Text="@(IsEditMode ? "Update" : "Save")"
                                          Icon="@(IsEditMode ? "update" : "save")"
                                          ButtonStyle="ButtonStyle.Primary"
                                          ButtonType="ButtonType.Submit"
                                          IsBusy="@IsProcessing"
                                          BusyText="@(IsEditMode ? "Updating..." : "Saving...")" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenContent>
