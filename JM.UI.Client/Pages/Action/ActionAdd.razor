@page "/ActionAdd"
@page "/ActionAdd/{ActionId:int}"
@using JM.UI.Entities.Model.Actions
@attribute [Authorize]
@inherits ActionAddComponent

<PageTitle>@(ActionId > 0 ? "Edit Action" : "Add Action")</PageTitle>

<RadzenContent Container="main" class="p-4">
    <!-- Header Card -->
    <RadzenCard class="mb-4">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenButton Icon="arrow_back"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Medium"
                          Click="@GoBack" />
            <RadzenIcon Icon="play_circle" Style="font-size: 2rem; color: var(--rz-primary);" />
            <RadzenText TextStyle="TextStyle.H4" class="mb-0">
                @(ActionId > 0 ? "Edit Action" : "Add New Action")
            </RadzenText>
        </RadzenStack>
    </RadzenCard>

    <!-- Form Card -->
    <RadzenCard>
        <RadzenTemplateForm Data="@ActionModel" Submit="@(async (ActionDTO model) => await HandleSubmit(model))">
            <RadzenRow Gap="1rem">
                <!-- Action Key -->
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Action Key" Variant="@Variant.Outlined" class="w-100">
                        <RadzenTextBox @bind-Value="@ActionModel.ActionKey"
                                       Name="ActionKey"
                                       MaxLength="50"
                                       Placeholder="Enter action key (e.g., CREATE, EDIT)"
                                       Style="width: 100%;" />
                        <RadzenRequiredValidator Component="ActionKey" Text="Action Key is required" />
                        <RadzenLengthValidator Component="ActionKey" Max="50" Text="Action Key must be 50 characters or less" />
                    </RadzenFormField>
                </RadzenColumn>

                <!-- Description -->
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Description" Variant="@Variant.Outlined" class="w-100">
                        <RadzenTextBox @bind-Value="@ActionModel.Description"
                                       Name="Description"
                                       MaxLength="200"
                                       Placeholder="Enter description"
                                       Style="width: 100%;" />
                        <RadzenLengthValidator Component="Description" Max="200" Text="Description must be 200 characters or less" />
                    </RadzenFormField>
                </RadzenColumn>

                <!-- Action Buttons -->
                <RadzenColumn Size="12">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="mt-3">
                        <RadzenButton ButtonType="ButtonType.Button"
                                      Icon="cancel"
                                      Text="Cancel"
                                      Click="@GoBack"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Medium" />

                        <RadzenButton ButtonType="ButtonType.Submit"
                                      Icon="save"
                                      Text="@(ActionId > 0 ? "Update" : "Save")"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Medium"
                                      IsBusy="@IsSaving" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenContent>