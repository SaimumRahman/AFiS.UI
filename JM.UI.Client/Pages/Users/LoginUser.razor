@page "/"
@using JM.UI.Client.Pages.Users
@using JM.UI.Client.Shared
@layout LoginLayout
@inherits LoginUserComponent

<style>
    .centerBtnsLog {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    .register-link {
        text-align: center;
        margin-top: 15px;
        font-size: 14px;
    }

        .register-link a {
            color: #007bff;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
        }

            .register-link a:hover {
                color: #0056b3;
                text-decoration: underline;
            }

    /* ✅ Error message styles */
    .error-message {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
        border-radius: 4px;
        padding: 12px 15px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        animation: slideDown 0.3s ease-out;
    }

    .error-icon {
        color: #721c24;
        font-size: 18px;
        flex-shrink: 0;
    }

    .error-close {
        margin-left: auto;
        background: none;
        border: none;
        color: #721c24;
        cursor: pointer;
        font-size: 20px;
        line-height: 1;
        padding: 0;
        opacity: 0.7;
        transition: opacity 0.2s;
    }

        .error-close:hover {
            opacity: 1;
        }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ✅ Loading state for button */
    .btn-loading {
        opacity: 0.6;
        pointer-events: none;
    }
</style>

<div class="wrapper" style="background-image: url('images/bg-registration-form-1.jpg');">
    <div class="inner">
        <div class="image-holder">
            <img src="images/AsiaFashionLogo.png" alt="">
        </div>
        <form action="">
            <h3>Login</h3>

            @* ✅ Error Message Display *@
            @if (showError)
            {
                <div class="error-message">
                    <span class="error-icon">⚠️</span>
                    <span>@errorMessage</span>
                    <button type="button" class="error-close" @onclick="@(() => showError = false)">×</button>
                </div>
            }

            <div class="form-wrapper">
                <input type="text"
                       placeholder="Username"
                       class="form-control"
                       @bind-value="loginRequestDAO.LoginId"
                       disabled="@isLoading">
                <i class="zmdi zmdi-account"></i>
            </div>

            <div class="form-wrapper">
                <input type="password"
                       placeholder="Password"
                       class="form-control"
                       @bind-value="loginRequestDAO.Password"
                       disabled="@isLoading"
                       @onkeypress="@(async (e) => { if (e.Key == "Enter") await OnClick("Success button"); })">
                <i class="zmdi zmdi-lock"></i>
            </div>

            <div class="centerBtnsLog">
                <RadzenButton Click="@(args => OnClick("Success button"))"
                              Text="@(isLoading ? "LOGGING IN..." : "LOGIN")"
                              ButtonStyle="ButtonStyle.Success"
                              Disabled="@isLoading" />
            </div>

            <div class="register-link">
                @* <p>Don't have an account? <a href="/UserRegistration">Register here</a></p> *@
            </div>
            <br>
        </form>
    </div>
</div>