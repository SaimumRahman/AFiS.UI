@page "/"
@using JM.UI.Client.Pages.Users
@using JM.UI.Client.Shared
@layout LoginLayout
@inherits LoginUserComponent

<style>
    .centerBtnsLog {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    .register-link {
        text-align: center;
        margin-top: 15px;
        font-size: 14px;
    }

        .register-link a {
            color: #007bff;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
        }

            .register-link a:hover {
                color: #0056b3;
                text-decoration: underline;
            }
</style>

<div class="wrapper" style="background-image: url('images/bg-registration-form-1.jpg');">
    <div class="inner">
        <div class="image-holder">
            <img src="images/loginpageimg.png" alt="">
        </div>
        <form action="">
            <h3>Login</h3>
            <div class="form-wrapper">
                <input type="text" placeholder="Username" class="form-control" @bind-value="loginRequestDAO.LoginId">
                <i class="zmdi zmdi-account"></i>
            </div>
            <div class="form-wrapper">
                <input type="password" placeholder="Password" class="form-control" @bind-value="loginRequestDAO.Password">
                <i class="zmdi zmdi-lock"></i>
            </div>
            <div class="centerBtnsLog">
                <RadzenButton class="btn btn-primary"
                              Click=@(args => OnClick("Success button"))
                              Text="LOGIN"
                              ButtonStyle="ButtonStyle.Success" />
            </div>
            <div class="register-link">
                <p>Don't have an account? <a href="/UserRegistration">Register here</a></p>
            </div>
            <br>
        </form>
    </div>
</div>