@page "/SmsLog"
@using JM.UI.Entities.Model.Sms
@using JM.UI.Entities.Model.Stores
@attribute [Authorize]
@inherits SmsLogComponent

<PageTitle>SMS Log</PageTitle>

<RadzenContent Container="main" class="p-4">
    <RadzenCard class="mb-4">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="history" Style="font-size: 2rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" class="mb-0">SMS Log</RadzenText>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenBadge Text="@($"Today: {Result.Items.Count(i => i.SentDate.Date == DateTime.Today)} Sent")" BadgeStyle="BadgeStyle.Light" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <!-- Filters -->
    <RadzenCard class="mb-4">
        <RadzenRow Gap="0.75rem" AlignItems="AlignItems.End">
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenFormField Text="From Date" Variant="Variant.Outlined" Style="width:100%;">
                    <RadzenDatePicker @bind-Value="FromDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenFormField Text="To Date" Variant="Variant.Outlined" Style="width:100%;">
                    <RadzenDatePicker @bind-Value="ToDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Branch Filter" Variant="Variant.Outlined" Style="width:100%;">
                    <RadzenDropDown Data="@StoreList"
                                    @bind-Value="SelectedStoreIds"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    Multiple="true"
                                    Chips="true"
                                    AllowClear="true"
                                    Disabled="@(!CanSelectAnyStore)"
                                    Placeholder="All Branches"
                                    Style="width:100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Search Mobile / Ref No." Variant="Variant.Outlined" Style="width:100%;">
                    <RadzenTextBox @bind-Value="SearchText" Placeholder="017... or INV-..." Style="width:100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="Filter" Icon="filter_alt" ButtonStyle="ButtonStyle.Primary" Click="@ApplyFilters" IsBusy="@IsLoading" />
                    <RadzenButton Text="Clear" ButtonStyle="ButtonStyle.Light" Click="@ClearFilters" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <!-- Table -->
    <RadzenCard>
        <RadzenDataGrid Data="@Result.Items" TItem="SmsLogDTO" AllowSorting="true" AllowPaging="true" PageSize="@PageSize"
                        Density="Density.Compact" GridLines="DataGridGridLines.Both" IsLoading="@IsLoading"
                        EmptyText="No SMS log entries for the selected filters.">
            <Columns>
                <RadzenDataGridColumn TItem="SmsLogDTO" Property="SentDate" Title="Date & Time" Width="130px">
                    <Template Context="row">
                        <div>@row.SentDate.ToString("dd MMM yyyy")</div>
                        <div class="text-xs text-gray-500">@row.SentDate.ToString("hh:mm tt")</div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SmsLogDTO" Property="MobileNo" Title="Mobile No" Width="130px" />
                <RadzenDataGridColumn TItem="SmsLogDTO" Property="ReferenceNo" Title="Reference No" Width="150px">
                    <Template Context="row">
                        <div>@row.ReferenceNo</div>
                        <div class="text-xs text-blue-600 font-medium">@row.BranchName</div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SmsLogDTO" Property="SmsType" Title="Type" Width="110px" />
                <RadzenDataGridColumn TItem="SmsLogDTO" Property="MessageBody" Title="Message Body" Width="320px">
                    <Template Context="row">
                        <span title="@row.MessageBody" class="text-xs text-gray-600" style="display:block;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                            @row.MessageBody
                        </span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SmsLogDTO" Property="Status" Title="Status" Width="110px">
                    <Template Context="row">
                        <RadzenBadge Text="@row.Status" BadgeStyle="@(row.Status.Equals("Delivered", StringComparison.OrdinalIgnoreCase) ? BadgeStyle.Success : BadgeStyle.Danger)" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SmsLogDTO" Title="View" Width="70px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                    <Template Context="row">
                        <RadzenButton Icon="description" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => OpenDetail(row))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
        <div class="mt-2 text-xs text-gray-500">Showing @Result.Items.Count of @Result.TotalCount results</div>
    </RadzenCard>
</RadzenContent>
