@using JM.UI.Client.Pages
@using JM.UI.Client.Services
@using JM.UI.Client.Shared
@using JM.UI.Entities.Model.Users
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Newtonsoft.Json
@inject IPermissionService permissionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager navigationManager
@inject ProtectedLocalStorage sessionStorage
@implements IDisposable

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Routes).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="rz-text-align-center rz-p-12">
                            <h3>Access Denied</h3>
                            <p>You are not authorized to access this page.</p>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="rz-text-align-center rz-p-12">
                        <div class="rz-mt-12">
                            <i class="rzi rzi-refresh rzi-spin" style="font-size: 48px;"></i>
                            <div class="rz-mt-4">Checking authorization...</div>
                        </div>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <NotFound />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    // Track an ongoing check so we can cancel stale ones
    private CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        navigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckRoutePermissionAsync(_cts.Token);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Cancel any previous in-flight check
        await _cts.CancelAsync();
        _cts = new CancellationTokenSource();

        try
        {
            await CheckRoutePermissionAsync(_cts.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Navigation changed again before this check finished — safe to ignore
        }
        catch
        {
            // log if needed
        }
    }

    private async Task CheckRoutePermissionAsync(CancellationToken ct)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            ct.ThrowIfCancellationRequested();

            var user = authState.User;
            if (user.Identity?.IsAuthenticated != true)
                return;

            var userId = await GetUserInfoAsync();
            ct.ThrowIfCancellationRequested();

            // Admins always have access
            if (userId == 1)
                return;

            var relativePath = navigationManager.ToBaseRelativePath(navigationManager.Uri);
            var routePath = "/" + relativePath.Split('?')[0];

            // Normalize dynamic segments before checking permission
                routePath = NormalizeRoutePath(routePath);

            if (routePath == "/" || routePath == "/dashboard")
                return;

            var hasAccess = await permissionService.CanAccessRoute(routePath);
            ct.ThrowIfCancellationRequested();

            if (!hasAccess)
            {
                await InvokeAsync(() => navigationManager.NavigateTo("/UnAuthorized"));
            }
        }
        catch (OperationCanceledException)
        {
            throw; // let caller handle
        }
    }

    private async Task<int> GetUserInfoAsync()
    {
        var userInfoResult = await sessionStorage.GetAsync<string>("UserId");

        if (!string.IsNullOrEmpty(userInfoResult.Value))
        {
            var userInfo = JsonConvert.DeserializeObject<string>(userInfoResult.Value);
            return Convert.ToInt32(userInfo);
        }

        return 0;
    }
    private string NormalizeRoutePath(string path)
    {
        // Handle /PurchaseEntry/Edit/5  --> /PurchaseEntry/Edit/{Id:int}
        // Handle /PurchaseEntry/Draft/5 --> /PurchaseEntry/Draft/{DraftId:int}
        // Handle /ItemTransfer/Edit/5   --> /ItemTransfer/Edit/{Id:int}
        // Handle all other /SomePage/5  --> /SomePage/{Id:int}

        return System.Text.RegularExpressions.Regex.Replace(
                path,
                @"/\d+$",
                match =>
                {
                    // Check which parameter name to use based on path
                    if (path.Contains("/GroupRoutePermissionAdd") || path.Contains("/GroupActionPermissionsAdd"))
                        return "/{GroupId:int}";
                    if (path.Contains("/PurchaseEntry/Draft"))
                        return "/{DraftId:int}";
                    if (path.Contains("/AccountsGroupsAdd"))
                        return "/{AccountsGroupsID:int}";
                    if (path.Contains("/BanksAdd"))
                        return "/{BanksID:int}";
                    if (path.Contains("/DesignationAdd"))
                        return "/{DesignationID:int}";
                    if (path.Contains("/SizesAdd"))
                        return "/{SizesID:int}";
                    if (path.Contains("/ActionAdd"))
                        return "/{ActionId:int}";

                    // Default for all others
                    return "/{Id:int}";
                }
            );
    }
    public void Dispose()
    {
        navigationManager.LocationChanged -= OnLocationChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}