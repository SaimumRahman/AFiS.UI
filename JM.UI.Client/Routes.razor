@using JM.UI.Client.Pages
@using JM.UI.Client.Services
@using JM.UI.Client.Shared
@using JM.UI.Entities.Model.Users
@using JM.UI.Service.UnitOfWork
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Newtonsoft.Json
@inject IPermissionService permissionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager navigationManager
@inject ProtectedSessionStorage sessionStorage
@implements IDisposable

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Routes).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized Context="authContext">
                    @if (authContext.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        @if (_isCheckingPermission)
                        {
                            <div class="rz-text-align-center rz-p-12">
                                <i class="rzi rzi-refresh rzi-spin" style="font-size: 48px;"></i>
                                <div class="rz-mt-4">Checking permissions...</div>
                            </div>
                        }
                        else if (!_hasRoutePermission)
                        {
                            <div class="rz-text-align-center rz-p-12">
                                <h3>Access Denied</h3>
                                <p>You do not have permission to access this page.</p>
                            </div>
                        }
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="rz-text-align-center rz-p-12">
                        <i class="rzi rzi-refresh rzi-spin" style="font-size: 48px;"></i>
                        <div class="rz-mt-4">Checking authorization...</div>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <NotFound />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private bool _hasRoutePermission = true;
    private bool _isCheckingPermission = false;
    protected override void OnInitialized()
    {
        navigationManager.LocationChanged += OnLocationChangedAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckRoutePermissionAsync();
    }

    private async void OnLocationChangedAsync(object? sender, LocationChangedEventArgs e)
    {
        // Fire-and-forget is okay here, but wrap in try/catch to avoid unhandled exceptions
        try
        {
            await CheckRoutePermissionAsync();
            StateHasChanged();
        }
        catch
        {
            // log or ignore
        }
    }

    private async Task CheckRoutePermissionAsync()
    {
        _isCheckingPermission = true;
        _hasRoutePermission = true;
        int userId = 0; 
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                _isCheckingPermission = false;
                return;
            }

            userId = (await GetUserInfoAsync());

            // Get current route
            var relativePath = navigationManager.ToBaseRelativePath(navigationManager.Uri);
            var routePath = "/" + relativePath.Split('?')[0];

            // // Check permission using your service
            if (userId == 1)
            {
                _hasRoutePermission = true;
                return;
            }
            if (routePath != "/" && routePath != "/dashboard")
            {
                _hasRoutePermission = await permissionService.CanAccessRoute(routePath);
                if (_hasRoutePermission == false)
                {
                    navigationManager.NavigateTo("/Logout");
                }
            }

        }
        finally
        {
            _isCheckingPermission = false;
        }
    }
    private async Task<int> GetUserInfoAsync()
    {
        var userObj = await sessionStorage.GetAsync<string>("UserId");
        int userId = 0;

        if (!string.IsNullOrEmpty(userObj.Value))
        {
            int.TryParse(userObj.Value, out userId);
        }
        return userId;
    }

    public void Dispose()
    {
        navigationManager.LocationChanged -= OnLocationChangedAsync;
    }
}
